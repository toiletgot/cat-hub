local missileCache = {}

local function refreshCache()
	table.clear(missileCache)
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local ok, isModel = checkGrabbable(obj)
			if ok then
				local root = obj.AssemblyRootPart or obj
				local model = obj:FindFirstAncestorOfClass("Model")
				local correctionName = obj.Name
				if model then correctionName = model.Name end
				missileCache[root] = {
					isModel = isModel,
					model = model,
					correction = getOrientationCorrection(correctionName),
				}
			end
		end
	end
end

refreshCache()
task.spawn(function()
	while true do
		task.wait(3)
		if not controlling then
			refreshCache()
		end
	end
end)

local function isAlreadyControlled(root)
	for _, entry in ipairs(controlledObjects) do
		if entry.originalRoot == root or entry.root == root then return true end
	end
	return false
end

local function findNearbyObjects()
	local char = player.Character
	if not char then return {} end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return {} end
	local origin = hrp.Position

	local results = {}
	for root, info in pairs(missileCache) do
		if root and root.Parent and not isAlreadyControlled(root) then
			local dist = (root.Position - origin).Magnitude
			if dist <= GRAB_RADIUS then
				table.insert(results, { root = root, dist = dist, info = info })
			end
		end
	end

	table.sort(results, function(a, b) return a.dist < b.dist end)
	return results
end

----------------------------------------------------------------
-- 3. 三人称カメラ
----------------------------------------------------------------

local function updateThirdPersonCamera(dt)
	if #controlledObjects == 0 then return end
	currentYaw = currentYaw + (cameraYaw - currentYaw) * math.clamp(dt * CAMERA_SMOOTHNESS, 0, 1)
	currentPitch = currentPitch + (cameraPitch - currentPitch) * math.clamp(dt * CAMERA_SMOOTHNESS, 0, 1)
	local yawRad = math.rad(currentYaw)
	local pitchRad = math.rad(currentPitch)
	local offset = Vector3.new(
		math.cos(pitchRad) * math.sin(yawRad),
		math.sin(pitchRad),
		math.cos(pitchRad) * math.cos(yawRad)
	) * CAMERA_DISTANCE
	local avgPos = Vector3.zero
	local count = 0
	for _, entry in ipairs(controlledObjects) do
		if entry.root and entry.root.Parent then
			avgPos = avgPos + entry.root.Position
			count = count + 1
		end
	end
	if count == 0 then return end
	avgPos = avgPos / count
	camera.CFrame = CFrame.lookAt(avgPos + offset, avgPos)
end

