--[[
    ミサイル専用（やわらか吸収 + 360度発射機能対応版）
    - ミサイル同士は CollisionGroup で衝突しない
    - 発射位置・方向をランダム分散（精度改善版）
    - プレイヤーの視線（上・下・前）の方向に発射可能
    - 発射したミサイルは二度と吸い込まない
]]

local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/BlizTBr/scripts/main/Orion X"))()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local PhysicsService = game:GetService("PhysicsService")
local player = Players.LocalPlayer

-- ===== CollisionGroup 設定 =====
pcall(function()
    PhysicsService:RegisterCollisionGroup("Missiles")
end)
pcall(function()
    PhysicsService:CollisionGroupSetCollidable("Missiles", "Missiles", false) -- ミサイル同士は衝突しない
end)

local settings = {
    speed = 0.025,
    width = 14,
    height = 5,
    density = 1.0,
    depth = 0,
    maxObjects = 30,
    range = 80,
    invertDirection = false,
    pullStrength = 12,
    softAbsorbTime = 1.6,
    launchSpeed = 180,        -- 発射速度
    launchUpwardBias = 0,     -- 視線にプラスして上向きに力を加える補正
    rapidFireInterval = 0.18, 
    launchCooldown = 0.08,
    spreadRadius = 12,
    spreadAngle = 12,
    collidableDelay = 3,
}

local mode = "None"
local hoveringObjects = {}
local objectList = {}
local objectData = {}
local launchedObjects = {}
local ignoredObjects = {}
local timeCounter = 0
local scanCooldown = 0
local isStopped = false
local isRapidFiring = false
local lastRapidFire = 0
local lastLaunch = 0
local launchIndex = 0

local function isMissile(obj)
    local name = string.lower(obj.Name)
    return string.find(name, "missile") or string.find(name, "bomb")
end

local function isSelectableObject(part, character)
    if not part:IsA("BasePart") or part.Anchored then return false end
    if character and part:IsDescendantOf(character) then return false end
    if part.Parent:FindFirstChild("Humanoid") then return false end
    if part.Parent.Parent and part.Parent.Parent:FindFirstChild("Humanoid") then return false end

    local ignore = {"Baseplate", "Terrain", "SpawnLocation", "Sky", "Map", "Wall", "Floor", "Grid"}
    if table.find(ignore, part.Name) then return false end

    local target = part.Parent:IsA("Model") and part.Parent or part
    if not isMissile(target) and not isMissile(part) then
        return false
    end

    local isOwner = false
    pcall(function()
        if part:GetNetworkOwner() == player then isOwner = true end
    end)
    if isOwner or part:FindFirstChild("creator") or part.Name == "Handle" or part:GetAttribute("Creator") == player.UserId then
        return true
    end

    return part.Size.X < 40 and part.Size.Y < 40 and part.Size.Z < 40
end

local function getRoot(obj)
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    end
    return obj
end

local function setCollisionGroup(obj)
    pcall(function()
        if obj:IsA("Model") then
            for _, p in ipairs(obj:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CollisionGroup = "Missiles"
                end
            end
        elseif obj:IsA("BasePart") then
            obj.CollisionGroup = "Missiles"
        end
    end)
end

local function setCanCollide(obj, value)
    pcall(function()
        if obj:IsA("Model") then
            for _, p in ipairs(obj:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = value end
            end
        elseif obj:IsA("BasePart") then
            obj.CanCollide = value
        end
    end)
end

local function registerPart(part)
    if isStopped then return end
    local character = player.Character
    if not isSelectableObject(part, character) then return end

    local target = part.Parent:IsA("Model") and part.Parent or part

    if ignoredObjects[target] or ignoredObjects[part] then return end
    if hoveringObjects[target] then return end
    if #objectList >= settings.maxObjects then return end

    hoveringObjects[target] = true
    table.insert(objectList, target)

    objectData[target] = {
        seed = math.random() * 100,
        absorbStart = tick()
    }

    local root = part
    if target:IsA("Model") then
        if not target.PrimaryPart then
            target.PrimaryPart = part
        end
        root = target.PrimaryPart

        for _, p in ipairs(target:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.Anchored = false
                if p ~= root and not p:FindFirstChildOfClass("WeldConstraint") then
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = root
                    weld.Part1 = p
                    weld.Parent = p
                end
            end
        end
    else
        part.CanCollide = false
    end

    setCollisionGroup(target)

    local bv = Instance.new("BodyVelocity")
    bv.Name = "SyncForce"
    bv.MaxForce = Vector3.new(5e6, 5e6, 5e6)
    bv.P = 1000
    bv.Velocity = Vector3.zero
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.Name = "SyncGyro"
    bg.MaxTorque = Vector3.new(5e6, 5e6, 5e6)
    bg.P = 1000
    bg.Parent = root

    pcall(function() root:SetNetworkOwner(player) end)
end

local function clearObjects()
    for _, obj in ipairs(objectList) do
        local root = getRoot(obj)
        if root then
            pcall(function()
                setCanCollide(obj, true)
                if root:FindFirstChild("SyncForce") then root.SyncForce:Destroy() end
                if root:FindFirstChild("SyncGyro") then root.SyncGyro:Destroy() end
            end)
        end
    end
    hoveringObjects = {}
    objectList = {}
    objectData = {}
end

-- ミサイルを1発発射（上下方向対応版）
local function launchOne()
    if #objectList == 0 then return end

    local now = tick()
    if now - lastLaunch < settings.launchCooldown then return end
    lastLaunch = now

    local obj = table.remove(objectList, 1)
    hoveringObjects[obj] = nil
    objectData[obj] = nil

    local root = getRoot(obj)
    if not root then return end

    if root:FindFirstChild("SyncForce") then root.SyncForce:Destroy() end
    if root:FindFirstChild("SyncGyro") then root.SyncGyro:Destroy() end

    setCollisionGroup(obj)
    setCanCollide(obj, false)

    launchedObjects[obj] = tick()
    ignoredObjects[obj] = true
    if obj:IsA("Model") then
        for _, p in ipairs(obj:GetDescendants()) do
            if p:IsA("BasePart") then
                ignoredObjects[p] = true
            end
        end
    end

    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local cam = workspace.CurrentCamera
    -- カメラ（またはキャラクター）の向いている方向を基準にする（上下に対応）
    local look = cam.CFrame.LookVector
    local right = cam.CFrame.RightVector

    launchIndex = launchIndex + 1
    local angle = math.random() * math.pi * 2
    local radius = settings.spreadRadius * (0.5 + math.random() * 0.5)

    -- 視線の向きに合わせて発射位置を計算
    local spawnPos = hrp.Position + (look * 8) + (right * (math.cos(angle) * radius)) + Vector3.new(0, math.sin(angle) * radius * 0.5, 0)

    if root:IsA("BasePart") then
        root.CFrame = CFrame.new(spawnPos) * root.CFrame.Rotation
    end

    -- 発射方向（上下の視線を完全に反映）
    local spreadRad = math.rad(settings.spreadAngle)
    local spreadAngle = (math.random() - 0.5) * spreadRad
    local launchDir = (CFrame.Angles(0, spreadAngle, 0) * look)
    
    -- 上方向のバイアス（必要に応じて上に少し曲げたい時用）
    launchDir = (launchDir + Vector3.new(0, settings.launchUpwardBias * 0.01, 0)).Unit

    local bv = Instance.new("BodyVelocity")
    bv.Name = "LaunchForce"
    bv.MaxForce = Vector3.new(1e7, 1e7, 1e7)
    bv.Velocity = launchDir * settings.launchSpeed
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.Name = "LaunchGyro"
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.CFrame = CFrame.lookAt(root.Position, root.Position + launchDir)
    bg.Parent = root

    task.delay(settings.collidableDelay, function()
        pcall(function()
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
        end)
    end)
end

local function launchAll()
    while #objectList > 0 do
        launchOne()
        task.wait(0.03)
    end
end

