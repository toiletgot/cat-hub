local function connectCharacter(char)
    char:WaitForChild("HumanoidRootPart")
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("BasePart") then
            v.Touched:Connect(function(hit)
                if mode == "Orbit" then
                    registerPart(hit)
                end
            end)
        end
    end
end
player.CharacterAdded:Connect(connectCharacter)
if player.Character then connectCharacter(player.Character) end

RunService.Heartbeat:Connect(function()
    local now = tick()
    for obj, launchTime in pairs(launchedObjects) do
        if not obj or not obj.Parent then
            ignoredObjects[obj] = nil
            launchedObjects[obj] = nil
        elseif now - launchTime > settings.collidableDelay then
            setCanCollide(obj, true)
            launchedObjects[obj] = nil
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if isRapidFiring and #objectList > 0 then
        if tick() - lastRapidFire >= settings.rapidFireInterval then
            lastRapidFire = tick()
            launchOne()
        end
    end

    if mode ~= "Orbit" then return end

    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    timeCounter = timeCounter + settings.speed
    local now = tick()

    for i = #objectList, 1, -1 do
        local obj = objectList[i]
        local root = getRoot(obj)
        if not obj or not obj.Parent or not root or not root:FindFirstChild("SyncForce") then
            table.remove(objectList, i)
            hoveringObjects[obj] = nil
            objectData[obj] = nil
        end
    end

    scanCooldown = scanCooldown + RunService.Heartbeat:Wait()
    if scanCooldown >= 0.15 then
        scanCooldown = 0
        if not isStopped and #objectList < settings.maxObjects then
            local found = workspace:GetPartBoundsInRadius(hrp.Position, settings.range)
            for _, p in ipairs(found) do
                if #objectList >= settings.maxObjects then break end
                if isSelectableObject(p, player.Character) then
                    registerPart(p)
                end
            end
        end
    end

    local total = #objectList
    if total == 0 then return end

    local lookCFrame = hrp.CFrame
    local baseCenter = hrp.Position + (lookCFrame.LookVector * settings.depth)
    local directionAngle = settings.invertDirection and CFrame.Angles(0, math.pi, 0) or CFrame.identity

    for i, obj in ipairs(objectList) do
        local root = getRoot(obj)
        local data = objectData[obj]
        if root and root:FindFirstChild("SyncForce") and data then
            local angle = timeCounter + ((i - 1) / total) * math.pi * 2 * settings.density
            local targetPos = baseCenter + Vector3.new(
                math.cos(angle) * settings.width,
                settings.height,
                math.sin(angle) * settings.width
          )
            local rotCFrame = CFrame.lookAt(targetPos, baseCenter) * directionAngle

            local elapsed = now - (data.absorbStart or now)
            local softFactor = math.clamp(elapsed / settings.softAbsorbTime, 0.12, 1)
            local currentPull = settings.pullStrength * softFactor

            root.SyncForce.Velocity = (targetPos - root.Position) * currentPull
            root.SyncGyro.CFrame = rotCFrame

            if math.random() > 0.85 then
                pcall(function() root:SetNetworkOwner(player) end)
          end
      end
  end
end)

