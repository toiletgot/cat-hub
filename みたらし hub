      btn.TextSize = 14
      btn.Parent = SideBar
      Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
      return btn
   end

   local TabPlayerBtn = createTabBtn("👤 Player", 10)
   local TabCombatBtn = createTabBtn("⚔️ Combat", 50)
   local TabVisualsBtn = createTabBtn("👁️ Visuals", 90)

   TabPlayerBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
   TabPlayerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

   local function switchTab(activeBtn, activePage)
      PlayerPage.Visible = false; CombatPage.Visible = false; VisualsPage.Visible = false
      TabPlayerBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40); TabPlayerBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
      TabCombatBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40); TabCombatBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
      TabVisualsBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40); TabVisualsBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
      
      activePage.Visible = true
      activeBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
      activeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
   end

   TabPlayerBtn.MouseButton1Click:Connect(function() switchTab(TabPlayerBtn, PlayerPage) end)
   TabCombatBtn.MouseButton1Click:Connect(function() switchTab(TabCombatBtn, CombatPage) end)
   TabVisualsBtn.MouseButton1Click:Connect(function() switchTab(TabVisualsBtn, VisualsPage) end)

   local function createToggle(name, posy, parent, callback)
      local btn = Instance.new("TextButton")
      btn.Size = UDim2.new(1, -10, 0, 45)
      btn.Position = UDim2.new(0, 0, 0, posy)
      btn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
      btn.Text = name .. ": OFF"
      btn.TextColor3 = Color3.fromRGB(255, 255, 255)
      btn.TextSize = 15
      btn.Font = Enum.Font.SourceSans
      btn.Parent = parent
      Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

      local enabled = false
      btn.MouseButton1Click:Connect(function()
         enabled = not enabled
         if enabled then
            btn.Text = name .. ": ON"
            btn.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
         else
            btn.Text = name .. ": OFF"
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
         end
         callback(enabled)
      end)
      return btn
   end

