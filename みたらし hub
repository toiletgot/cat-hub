   ChangePartBtn.Position = UDim2.new(0, 0, 0, 65)
   ChangePartBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
   ChangePartBtn.Text = "Aimbot 部位: 体 (Torso)"
   ChangePartBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
   ChangePartBtn.TextSize = 15
   ChangePartBtn.Font = Enum.Font.SourceSans
   ChangePartBtn.Parent = CombatPage
   Instance.new("UICorner", ChangePartBtn).CornerRadius = UDim.new(0, 8)

   ChangePartBtn.MouseButton1Click:Connect(function()
      if aimPart == "HumanoidRootPart" then
         aimPart = "Head"
         ChangePartBtn.Text = "Aimbot 部位: 頭 (Head)"
         ChangePartBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
      else
         aimPart = "HumanoidRootPart"
         ChangePartBtn.Text = "Aimbot 部位: 体 (Torso)"
         ChangePartBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
      end
   end)

   createToggle("Player ESP (透視)", 10, VisualsPage, function(v)
      isEspEnabled = v
      if not v then
         for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("SiratamaESP") then
               p.Character.SiratamaESP:Destroy()
            end
         end
      end
   end)

   createToggle("Fullbright (常時昼間)", 65, VisualsPage, function(v)
      isFullbrightEnabled = v
      local lighting = game:GetService("Lighting")
      if not v then
         lighting.Ambient = origAmbient
      end
   end)

   UserInputService.InputBegan:Connect(function(input, gameProcessed)
      if gameProcessed then return end
      if input.KeyCode == Enum.KeyCode.LeftControl then
         MainFrame.Visible = not MainFrame.Visible
      end
   end)

   local function getClosestPlayer()
      local closestPlayer = nil
      local shortestDistance = math.huge
      for _, v in pairs(Players:GetPlayers()) do
         if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local distance = (player.Character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
            if distance < shortestDistance then
               closestPlayer = v
               shortestDistance = distance
            end
         end
      end
      return closestPlayer
   end

   UserInputService.JumpRequest:Connect(function()
      if isInfiniteJumpEnabled then
         local character = player.Character
         local humanoid = character and character:FindFirstChildOfClass("Humanoid")
         if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
         end
      end
   end)

   RunService.RenderStepped:Connect(function()
      local char = player.Character
      if not char then return end

      if isNoclipEnabled then
         for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
               part.CanCollide = false
            end
         end
      end

      if isFullbrightEnabled then
         game:GetService("Lighting").Ambient = Color3.fromRGB(255, 255, 255)
      end

      if isAimbotEnabled and char:FindFirstChild("HumanoidRootPart") then
         local target = getClosestPlayer()
         if target and target.Character and target.Character:FindFirstChild(aimPart) then
            camera.CFrame = CFrame.new(camera.CFrame.Position, target.Character[aimPart].Position)
         end
      end

      if isEspEnabled then
         for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
               if p.Character.Humanoid.Health > 0 then
                  if not p.Character:FindFirstChild("SiratamaESP") then
                     local highlight = Instance.new("Highlight")
                     highlight.Name = "SiratamaESP"
                     highlight.FillColor = Color3.fromRGB(255, 0, 100)
                     highlight.FillTransparency = 0.5
                     highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                     highlight.OutlineTransparency = 0
                     highlight.Parent = p.Character
                  end
               else
                  if p.Character:FindFirstChild("SiratamaESP") then p.Character.SiratamaESP:Destroy() end
               end
            end
         end
      end
   end)
end

