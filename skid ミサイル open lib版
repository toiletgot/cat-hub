stickKnob.Position = UDim2.new(0.5, -20, 0.5, -20)
stickKnob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
local knobCorner = Instance.new("UICorner")
knobCorner.CornerRadius = UDim.new(1, 0)
knobCorner.Parent = stickKnob
stickKnob.Parent = stickBase

local stickRadius = 45
local stickCenter = Vector2.new(45, 45)
local stickInput = Vector2.new(0, 0)
local activeStickTouch = nil

local function updateKnob(delta)
	local clamped = delta
	if clamped.Magnitude > stickRadius then clamped = clamped.Unit * stickRadius end
	stickKnob.Position = UDim2.new(0.5, clamped.X - 20, 0.5, clamped.Y - 20)
	stickInput = Vector2.new(clamped.X / stickRadius, clamped.Y / stickRadius)
	if clamped.Magnitude > 3 then
		manualStop = false
	end
end

local function resetKnob()
	stickKnob.Position = UDim2.new(0.5, -20, 0.5, -20)
	stickInput = Vector2.new(0, 0)
end

stickBase.InputBegan:Connect(function(input)
	if not controlling then return end
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
		activeStickTouch = input
		local pos = input.Position
		local basePos = stickBase.AbsolutePosition
		updateKnob(Vector2.new(pos.X, pos.Y) - basePos - stickCenter)
	end
end)

----------------------------------------------------------------
-- 入力処理
----------------------------------------------------------------

local activeCameraTouch = nil
local lastCameraTouchPos = nil
local MIN_PITCH = -80
local MAX_PITCH = 80
local keyboardInput = Vector3.zero

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not controlling then return end
	if gameProcessed then return end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.W then keyboardInput = keyboardInput + Vector3.new(0, 0, -1) end
		if input.KeyCode == Enum.KeyCode.S then keyboardInput = keyboardInput + Vector3.new(0, 0, 1) end
		if input.KeyCode == Enum.KeyCode.A then keyboardInput = keyboardInput + Vector3.new(-1, 0, 0) end
		if input.KeyCode == Enum.KeyCode.D then keyboardInput = keyboardInput + Vector3.new(1, 0, 0) end
		if input.KeyCode == Enum.KeyCode.Space then keyboardInput = keyboardInput + Vector3.new(0, 1, 0) end
		if input.KeyCode == Enum.KeyCode.LeftShift then keyboardInput = keyboardInput + Vector3.new(0, -1, 0) end
		if keyboardInput.Magnitude > 0 then
			manualStop = false
		end
		return
	end

	if input.UserInputType ~= Enum.UserInputType.Touch
		and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

	local pos = input.Position
	local stickAbsPos = stickBase.AbsolutePosition
	local stickAbsSize = stickBase.AbsoluteSize
	local inStick = pos.X >= stickAbsPos.X and pos.X <= stickAbsPos.X + stickAbsSize.X
		and pos.Y >= stickAbsPos.Y and pos.Y <= stickAbsPos.Y + stickAbsSize.Y
	if inStick then return end

	local screenWidth = camera.ViewportSize.X
	if pos.X < screenWidth * 0.5 then return end

	activeCameraTouch = input
	lastCameraTouchPos = Vector2.new(pos.X, pos.Y)
end)

UserInputService.InputChanged:Connect(function(input)
	if not controlling then return end
	if activeStickTouch == input
		and (input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseMovement) then
		local pos = input.Position
		local basePos = stickBase.AbsolutePosition
		updateKnob(Vector2.new(pos.X, pos.Y) - basePos - stickCenter)
	end
	if activeCameraTouch == input
		and (input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseMovement) then
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		local delta = pos - lastCameraTouchPos
		lastCameraTouchPos = pos
		cameraYaw = cameraYaw - delta.X * CAMERA_SENSITIVITY
		cameraPitch = math.clamp(cameraPitch + delta.Y * CAMERA_SENSITIVITY, MIN_PITCH, MAX_PITCH)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if activeStickTouch == input then
		activeStickTouch = nil
		resetKnob()
	end
	if activeCameraTouch == input then
		activeCameraTouch = nil
		lastCameraTouchPos = nil
	end
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.W then keyboardInput = keyboardInput - Vector3.new(0, 0, -1) end
		if input.KeyCode == Enum.KeyCode.S then keyboardInput = keyboardInput - Vector3.new(0, 0, 1) end
		if input.KeyCode == Enum.KeyCode.A then keyboardInput = keyboardInput - Vector3.new(-1, 0, 0) end
		if input.KeyCode == Enum.KeyCode.D then keyboardInput = keyboardInput - Vector3.new(1, 0, 0) end
		if input.KeyCode == Enum.KeyCode.Space then keyboardInput = keyboardInput - Vector3.new(0, 1, 0) end
		if input.KeyCode == Enum.KeyCode.LeftShift then keyboardInput = keyboardInput - Vector3.new(0, -1, 0) end
	end
end)

----------------------------------------------------------------
-- Heartbeat
----------------------------------------------------------------

RunService.Heartbeat:Connect(function(dt)
	if not controlling or #controlledObjects == 0 then
		return
	end

	for i = #controlledObjects, 1, -1 do
		local entry = controlledObjects[i]
		if not entry.root or not entry.root.Parent or not entry.root:IsDescendantOf(workspace) then
			destroyEntry(entry)
			table.remove(controlledObjects, i)
		end
	end

	if #controlledObjects == 0 then
		stopControl()
		stickBase.Visible = false
		OrionLib:MakeNotification({
			Name = "GrabMove",
			Content = "操作を終了しました",
			Image = "rbxassetid://4483345998",
			Time = 3
		})
		return
	end

	updateThirdPersonCamera(dt)
	local camCF = camera.CFrame

	local targetVel
	if manualStop then
		targetVel = Vector3.zero
		CURRENT_VELOCITY = Vector3.zero
	else
		local forwardVel = camCF.LookVector * CURRENT_SPEED
		local rightVel = camCF.RightVector * (stickInput.X * CURRENT_SPEED)
		local upVel = Vector3.new(0, 1, 0) * (-stickInput.Y * CURRENT_SPEED)

		local kbForward = camCF.LookVector * (keyboardInput.Z * CURRENT_SPEED)
		local kbRight = camCF.RightVector * (keyboardInput.X * CURRENT_SPEED)
		local kbUp = Vector3.new(0, 1, 0) * (keyboardInput.Y * CURRENT_SPEED)

		targetVel = forwardVel + rightVel + upVel + kbForward + kbRight + kbUp
		CURRENT_VELOCITY = CURRENT_VELOCITY:Lerp(targetVel, math.clamp(dt * ACCELERATION, 0, 1))
	end

	local lookBase = nil
	if CURRENT_VELOCITY.Magnitude > 0.5 then
		lookBase = CFrame.lookAt(Vector3.zero, CURRENT_VELOCITY.Unit)
	end

	for _, entry in ipairs(controlledObjects) do
		if entry.mover and entry.mover.Parent then
			entry.mover.Velocity = CURRENT_VELOCITY
		end
		if lookBase and entry.alignMover and entry.alignMover.Parent then
			entry.alignMover.CFrame = lookBase * entry.correction
		end
	end
end)

