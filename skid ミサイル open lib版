----------------------------------------------------------------
-- 向き補正テーブル
----------------------------------------------------------------

local ORIENTATION_CORRECTIONS = {
	["BombMissile"]           = CFrame.Angles(0, math.rad(-90), 0) * CFrame.Angles(math.rad(90), 0, 0),
	["FlyingToyHelicopter"]   = CFrame.new(),
	["TractorGreen"]          = CFrame.Angles(0, math.rad(-90), 0),
	["Ufo"]                   = CFrame.new(),
	["UFO"]                   = CFrame.new(),
	["PaperPlane"]            = CFrame.Angles(0, math.rad(180), 0),
}

local ORIENTATION_PATTERNS = {
	{ pattern = "Missile",     cf = CFrame.Angles(0, math.rad(-90), 0) * CFrame.Angles(math.rad(90), 0, 0) },
	{ pattern = "Toy",         cf = CFrame.new() },
	{ pattern = "Tractor",     cf = CFrame.Angles(0, math.rad(-90), 0) },
	{ pattern = "Helicopter",  cf = CFrame.new() },
	{ pattern = "Ufo",         cf = CFrame.new() },
	{ pattern = "UFO",         cf = CFrame.new() },
	{ pattern = "PaperPlane",  cf = CFrame.Angles(0, math.rad(180), 0) },
	{ pattern = "Paper",       cf = CFrame.Angles(0, math.rad(180), 0) },
}

local function getOrientationCorrection(name)
	if ORIENTATION_CORRECTIONS[name] then
		return ORIENTATION_CORRECTIONS[name]
	end
	for _, entry in ipairs(ORIENTATION_PATTERNS) do
		if string.find(name, entry.pattern, 1, true) then
			return entry.cf
		end
	end
	return CFrame.new()
end

----------------------------------------------------------------
-- 掴めるオブジェクト定義
----------------------------------------------------------------

local SINGLE_PART_NAMES = { BombMissile = true }
local MODEL_NAMES = {
	FlyingToyHelicopter = true,
	TractorGreen = true,
	Ufo = true,
	UFO = true,
	PaperPlane = true,
}

local SINGLE_PART_PATTERNS = { "Missile" }
local MODEL_PATTERNS = { "Toy", "Tractor", "Helicopter", "Ufo", "UFO", "PaperPlane", "Paper" }

local function matchesAny(name, list, patterns)
	if list[name] then return true end
	for _, pattern in ipairs(patterns) do
		if string.find(name, pattern, 1, true) then
			return true
		end
	end
	return false
end

local function isForceMoveName(name)
	return string.find(name, "Ufo", 1, true)
		or string.find(name, "UFO", 1, true)
		or string.find(name, "PaperPlane", 1, true)
		or string.find(name, "Paper", 1, true)
end

local function checkGrabbable(part)
	if not part or not part:IsA("BasePart") then return false, false end

	local model = part:FindFirstAncestorOfClass("Model")
	local nameToCheck = part.Name
	if model then nameToCheck = model.Name end
	local forceMove = isForceMoveName(nameToCheck) or isForceMoveName(part.Name)
	if part.Anchored and not forceMove then
		return false, false
	end

	if matchesAny(part.Name, SINGLE_PART_NAMES, SINGLE_PART_PATTERNS) then
		return true, false
	end
	if matchesAny(part.Name, MODEL_NAMES, MODEL_PATTERNS) then
		return true, true
	end

	if model then
		if matchesAny(model.Name, SINGLE_PART_NAMES, SINGLE_PART_PATTERNS) then
			return true, false
		end
		if matchesAny(model.Name, MODEL_NAMES, MODEL_PATTERNS) then
			return true, true
		end
	end

	return false, false
end

----------------------------------------------------------------
-- キャッシュ
----------------------------------------------------------------

local missileCache = {}

local function refreshCache()
	table.clear(missileCache)
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local ok, isModel = checkGrabbable(obj)
			if ok then
				local root = obj.AssemblyRootPart or obj
				local model = obj:FindFirstAncestorOfClass("Model")
				local correctionName = obj.Name
				if model then correctionName = model.Name end
				missileCache[root] = {
					isModel = isModel,
					model = model,
					correction = getOrientationCorrection(correctionName),
				}
			end
		end
	end
end

refreshCache()
task.spawn(function()
	while true do
		task.wait(3)
		if not controlling then
			refreshCache()
		end
	end
end)

local function isAlreadyControlled(root)
	for _, entry in ipairs(controlledObjects) do
		if entry.originalRoot == root or entry.root == root then return true end
	end
	return false
end

local function findNearbyObjects()
	local char = player.Character
	if not char then return {} end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return {} end
	local origin = hrp.Position

	local results = {}
	for root, info in pairs(missileCache) do
		if root and root.Parent and not isAlreadyControlled(root) then
			local dist = (root.Position - origin).Magnitude
			if dist <= GRAB_RADIUS then
				table.insert(results, { root = root, dist = dist, info = info })
			end
		end
	end

	table.sort(results, function(a, b) return a.dist < b.dist end)
	return results
end

----------------------------------------------------------------
-- 三人称カメラ
----------------------------------------------------------------

local function updateThirdPersonCamera(dt)
	if #controlledObjects == 0 then return end
	currentYaw = currentYaw + (cameraYaw - currentYaw) * math.clamp(dt * CAMERA_SMOOTHNESS, 0, 1)
	currentPitch = currentPitch + (cameraPitch - currentPitch) * math.clamp(dt * CAMERA_SMOOTHNESS, 0, 1)
	local yawRad = math.rad(currentYaw)
	local pitchRad = math.rad(currentPitch)
	local offset = Vector3.new(
		math.cos(pitchRad) * math.sin(yawRad),
		math.sin(pitchRad),
		math.cos(pitchRad) * math.cos(yawRad)
	) * CAMERA_DISTANCE
	local avgPos = Vector3.zero
	local count = 0
	for _, entry in ipairs(controlledObjects) do
		if entry.root and entry.root.Parent then
			avgPos = avgPos + entry.root.Position
			count = count + 1
		end
	end
	if count == 0 then return end
	avgPos = avgPos / count
	camera.CFrame = CFrame.lookAt(avgPos + offset, avgPos)
end

----------------------------------------------------------------
-- Mover関連
----------------------------------------------------------------

local MAX_FORCE_SINGLE = 100000
local MAX_FORCE_MODEL  = 30000

local function destroyEntry(entry)
	local toDestroy = { entry.mover, entry.alignMover, entry.attachment }
	for _, obj in ipairs(toDestroy) do
		if obj and obj.Parent then
			pcall(function() obj:Destroy() end)
		end
	end
end

local function destroyAllMovers()
	for _, entry in ipairs(controlledObjects) do
		destroyEntry(entry)
	end
	controlledObjects = {}
	CURRENT_VELOCITY = Vector3.zero
	manualStop = false
end

local function setRobloxJumpButtonVisible(visible)
	pcall(function()
		local touchGui = playerGui:FindFirstChild("TouchGui")
		if touchGui then
			local f = touchGui:FindFirstChild("TouchControlFrame")
			if f then
				local jb = f:FindFirstChild("JumpButton")
				if jb then jb.Visible = visible end
			end
		end
	end)
end

local function attachMoverToPart(root, isModel, correction)
	local targetPart = root
	local model = nil
	if isModel then
		model = root:FindFirstAncestorOfClass("Model")
		if model and model.PrimaryPart then
			targetPart = model.PrimaryPart
		end
	end

	local forceMove = isForceMoveName(targetPart.Name) or (model and isForceMoveName(model.Name))
	if forceMove or targetPart.Anchored then
		pcall(function()
			targetPart.Anchored = false
			if model then
				for _, desc in ipairs(model:GetDescendants()) do
					if desc:IsA("BasePart") then
						desc.Anchored = false
					end
				end
			end
		end)
	end

	local mover = Instance.new("BodyVelocity")
	mover.Name = "GrabMoveVelocity"
	local force = forceMove and 500000 or (isModel and MAX_FORCE_MODEL or MAX_FORCE_SINGLE)
	mover.MaxForce = Vector3.new(force, force, force)
	mover.P = 12500
	mover.Velocity = Vector3.zero
	mover.Parent = targetPart

	local attachment = Instance.new("Attachment")
	attachment.Name = "GrabMoveAttachment"
	attachment.Parent = targetPart

	local alignMover = Instance.new("AlignOrientation")
	alignMover.Name = "GrabMoveOrientation"
	alignMover.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignMover.Attachment0 = attachment
	alignMover.MaxTorque = forceMove and 2000000 or (isModel and 500000 or 1000000)
	alignMover.Responsiveness = forceMove and 25 or (isModel and 10 or 20)
	alignMover.Parent = targetPart

	return {
		root = targetPart,
		originalRoot = root,
		model = model,
		mover = mover,
		alignMover = alignMover,
		attachment = attachment,
		isModel = isModel,
		correction = correction or CFrame.new(),
	}
end

local function grabNearbyObjects()
	if #controlledObjects >= MAX_OBJECTS then
		return 0, "MAX"
	end

	refreshCache()

	local nearby = findNearbyObjects()
	if #nearby == 0 then
		return 0, "NONE"
	end

	if #controlledObjects == 0 then
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				savedPlayerCFrame = hrp.CFrame
				hrp.CFrame = CFrame.new(PLAYER_FIXED_POSITION)
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
		end

		cameraYaw = 0
		cameraPitch = -20
		currentYaw = 0
		currentPitch = -20
		CURRENT_VELOCITY = Vector3.zero
		manualStop = false
		camera.CameraType = Enum.CameraType.Scriptable
		controlling = true
		setRobloxJumpButtonVisible(false)
	end

	local added = 0
	for _, item in ipairs(nearby) do
		if #controlledObjects >= MAX_OBJECTS then break end
		local entry = attachMoverToPart(item.root, item.info.isModel, item.info.correction)
		table.insert(controlledObjects, entry)
		added = added + 1
	end

	updateThirdPersonCamera(0)
	return added
end

local function stopControl()
	destroyAllMovers()
	if savedPlayerCFrame then
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.CFrame = savedPlayerCFrame
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
		end
		savedPlayerCFrame = nil
	end
	controlling = false
	camera.CameraType = Enum.CameraType.Custom
	setRobloxJumpButtonVisible(true)
end

