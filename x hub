-- 🔄 毎フレームのレンダリング同期ループ
RS.RenderStepped:Connect(function()
    local h = Color3.fromHSV(tick()%5/5, 1, 1)
    ms.Color, ts.Color, ttS.Color, tgl.TextColor3 = h, h, h, h
    ctS.Color, customText.TextColor3, l1.BackgroundColor3, l2.BackgroundColor3 = h, h, h, h
    crossRotator.Rotation = (tick() * 1800) % 360
    
    if states["Gemini Void"] then
        Lighting.ClockTime = (math.floor(tick() * 30) % 2 == 0) and 0 or 12
    end

    local char = lp.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp, hum = char.HumanoidRootPart, char.Humanoid
        
        -- 🛠️ ヘッドレス強制修正維持
        if states["Headless"] and char:FindFirstChild("Head") then
            pcall(function()
                char.Head.Transparency = 1
                for _, child in pairs(char.Head:GetChildren()) do
                    if child:IsA("Decal") or child:IsA("SpecialMesh") then child.Transparency = 1 end
                end
            end)
        end

        if states["Gemini Spin"] then hrp.CFrame *= CFrame.Angles(math.rad(10), math.rad(50), math.rad(10)) end
        if states["Gemini Fly 10"] then hrp.CFrame += hum.MoveDirection * 10 end
        if states["Gemini Shake"] then hrp.CFrame *= CFrame.new(math.sin(tick()*30)*1.5, 0, 0) end
        if states["Gemini Kill Aura"] then
            for _, p in pairs(game.Players:GetPlayers()) do
                if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    p.Character.HumanoidRootPart.Size, p.Character.HumanoidRootPart.Transparency = Vector3.new(20,20,20), 0.7
                end
            end
        end
        if states["Gemini Rainbow"] and not states["Gemini Invisible"] then
            for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.Color, p.Material = h, "Neon" end end
        end
    end
end)

