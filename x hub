-- 🛠️ ボタン生成システム
local states = {}
local function b(name, func, isGemini)
    states[name] = false
    local btn = Instance.new("TextButton", funcFrame)
    btn.Text = isGemini and "♊ " .. name or name
    btn.BackgroundColor3, btn.Font, btn.TextSize = Color3.new(0,0,0), "FredokaOne", 9
    btn.TextColor3 = Color3.new(1,0,0)
    local bs = SetupUI(btn, false)
    btn.MouseButton1Click:Connect(function()
        states[name] = not states[name]
        btn.TextColor3 = states[name] and Color3.new(0,1,0) or Color3.new(1,0,0)
        func(states[name])
    end)
    RS.RenderStepped:Connect(function() bs.Color = Color3.fromHSV(tick()%5/5, 1, 1) end)
end

-- 🔄 プレイヤー追従オービット(周回)処理
local circling = false
local circlingThread
local function ToggleCircling(v)
    circling = v
    if circling then
        if circlingThread then task.cancel(circlingThread) end
        circlingThread = task.spawn(function()
            local angle = 0
            while circling do
                if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = lp.Character.HumanoidRootPart
                    local targetPlayer
                    for _, p in pairs(game.Players:GetPlayers()) do
                        if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then targetPlayer = p break end
                    end
                    if targetPlayer then
                        local targetHrp = targetPlayer.Character.HumanoidRootPart
                        local offset = Vector3.new(math.sin(angle) * 10, 0, math.cos(angle) * 10)
                        hrp.CFrame = targetHrp.CFrame + offset angle = angle + 0.1
                    end
                end
                task.wait(0.01)
            end
        end)
    else
        if circlingThread then task.cancel(circlingThread) end
    end
end

