    BlueColor = Color3.fromRGB(0, 100, 255),
    RedColor = Color3.fromRGB(255, 50, 50),
    EffectTransparency = 0.5,
    LineThickness = 0.05,
}

local hoveringObjects = {}
local ignoreList = {} 

-- [[ 物理セットアップ関数 ]]
local function SetupJujutsuPhysics(p)
    if not p then return end
    local bp = p:FindFirstChild("JujutsuPosition") or Instance.new("BodyPosition", p)
    bp.Name = "JujutsuPosition"
    bp.MaxForce = Vector3.new(1, 1, 1) * 1e8
    
    local sb = p:FindFirstChild("BlueEffect") or Instance.new("SelectionBox", p)
    sb.Name = "BlueEffect"
    sb.Adornee = p
    sb.Transparency = Config.EffectTransparency
    
    p.CanCollide = false
    p.Massless = true
    return bp
end

local function ClearPhysics(p)
    if not p then return end
    local names = {"JujutsuPosition", "BlueEffect", "PurpleVelocity", "BodyForce"}
    for _, name in ipairs(names) do
        local found = p:FindFirstChild(name)
        if found then found:Destroy() end
    end
    p.CanCollide = true
    p.Massless = false
end

-- [[ メイン制御ロジック ]]
RunService.Heartbeat:Connect(function()
    if not Config.OrbitEnabled or Config.IsCharging then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- 1. 新規パーツの検知 (StopAttractingがfalseの時のみ)
    if not Config.StopAttracting then
        for _, p in ipairs(workspace:GetDescendants()) do
            if p:IsA("BasePart") and not p.Anchored and not p:IsDescendantOf(char) then
                if p.Name:lower() == "baseplate" or p.Size.Magnitude > Config.MaxPartSize or ignoreList[p] or hoveringObjects[p] then continue end
                if p.Parent:FindFirstChild("Humanoid") then continue end
                
                local dist = (p.Position - hrp.Position).Magnitude
                if dist < Config.AttractRange and dist > Config.MinDistance then
                    hoveringObjects[p] = {index = #hoveringObjects + 1}
                    SetupJujutsuPhysics(p)
                end
            end
        end
    end

    -- 2. 所有パーツの座標更新
    local total = 0
    for _ in pairs(hoveringObjects) do total = total + 1 end
    local i = 0
    for p, _ in pairs(hoveringObjects) do
        if p and p.Parent and p:FindFirstChild("JujutsuPosition") then
            i = i + 1
            local t = tick() * Config.RotateSpeed
            local targetPos
            
            if Config.Formation == "円環" then
                local angle = (i / total) * math.pi * 2 + t
                targetPos = (hrp.CFrame * CFrame.new(math.cos(angle) * Config.CircleRadius, Config.OrbitHeight + math.sin(t+i) * Config.WaveIntensity, math.sin(angle) * Config.CircleRadius)).p
            elseif Config.Formation == "左右展開" then
                local side = (i % 2 == 0) and 1 or -1
                targetPos = (hrp.CFrame * CFrame.new(Config.OrbitDistanceX * side, Config.OrbitHeight + math.sin(t + i) * Config.WaveIntensity, Config.OrbitOffsetZ)).p
            elseif Config.Formation == "螺旋" then
                local angle = i * 0.5 + t
                targetPos = (hrp.CFrame * CFrame.new(math.cos(angle) * Config.OrbitDistanceX, (i - total/2) * Config.SpiralHeightMult + Config.OrbitHeight, math.sin(angle) * Config.OrbitDistanceX)).p
            end

            p.JujutsuPosition.Position = targetPos
            p.JujutsuPosition.P = Config.AttractPower
            p.JujutsuPosition.D = Config.AttractDamping
            if p:FindFirstChild("BlueEffect") then
                p.BlueEffect.Color3 = (i % 2 == 0) and Config.BlueColor or Config.RedColor
                p.BlueEffect.Transparency = Config.EffectTransparency
            end
        else
            hoveringObjects[p] = nil
        end
    end
end)

-- 足止め処理
RunService.Stepped:Connect(function()
    if Config.IsCharging and Config.FreezePlayer then
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
    end
end)

-- [[ GUI構築 ]]
local Window = OrionLib:MakeWindow({Name = "Hollow Purple: Absolute Dominion", HidePremium = true, SaveConfig = false})

-- 【メインタブ】
local MainTab = Window:MakeTab({Name = "術式実行"})
MainTab:AddToggle({Name = "術式準備 (ON/OFF)", Default = false, Callback = function(v) Config.OrbitEnabled = v end})
MainTab:AddToggle({Name = "新規吸引を停止 (現在の物を維持)", Default = false, Callback = function(v) Config.StopAttracting = v end})

MainTab:AddButton({
    Name = "虚式「茈」発動",
    Callback = function()
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp or not next(hoveringObjects) then return end

        local firingList = {}
        for p, _ in pairs(hoveringObjects) do firingList[p] = true; ignoreList[p] = true end
        hoveringObjects = {}
        Config.IsCharging = true

        -- 超凝縮チャージ
        local chargeStart = tick()
        while tick() - chargeStart < Config.ChargeTime do
            RunService.Heartbeat:Wait()
            local chargeTarget = (hrp.CFrame * CFrame.new(0, Config.ChargeHeightOffset, -Config.ChargeDistance)).p
            for p, _ in pairs(firingList) do
                if p and p.Parent and p:FindFirstChild("JujutsuPosition") then
                    p.JujutsuPosition.Position = chargeTarget
                    p.JujutsuPosition.P = Config.ChargeTightness
                end
            end
        end

        Config.IsCharging = false
        local shootDir = camera.CFrame.LookVector

        for p, _ in pairs(firingList) do
            if p and p.Parent then
                if p:FindFirstChild("JujutsuPosition") then p.JujutsuPosition:Destroy() end
                local bv = Instance.new("BodyVelocity", p)
                bv.Name = "PurpleVelocity"
                bv.MaxForce = Vector3.new(1, 1, 1) * 1e9
                bv.Velocity = (shootDir + Vector3.new(math.random(-Config.ShootSpread, Config.ShootSpread)/100, 0, math.random(-Config.ShootSpread, Config.ShootSpread)/100)).Unit * Config.ShootSpeed
                
                task.spawn(function()
                    task.wait(Config.ReturnDelay)
                    if Config.BoomerangMode then
                        local connection
                        connection = RunService.Heartbeat:Connect(function()
                            local currentHrp = player.Character:FindFirstChild("HumanoidRootPart")
                            if p and p.Parent and currentHrp and bv.Parent then
                                local diff = (currentHrp.Position - p.Position)
                                bv.Velocity = diff.Unit * (Config.ShootSpeed * Config.ReturnSpeedMult)
                                p.AssemblyAngularVelocity = Vector3.new(0, Config.ReturnSpin, 0)
                                if diff.Magnitude < Config.ReturnThreshold then 
                                    connection:Disconnect()
                                    if bv then bv:Destroy() end
                                    ignoreList[p] = nil
                                    hoveringObjects[p] = {index = 1} 
                                    SetupJujutsuPhysics(p)
                                end
                            else
                                if connection then connection:Disconnect() end
                                ignoreList[p] = nil
                            end
                        end)
                    else
                        task.wait(Config.DestroyTime)
                        ClearPhysics(p)
                        ignoreList[p] = nil
                    end
                end)
            end
        end
    end
})

