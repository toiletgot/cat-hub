local Config = {
    -- システム基本
    OrbitEnabled = false,
    StopAttracting = false, -- 新規吸引のみ停止
    IsCharging = false,
    
    -- 吸引物理 (Attract)
    AttractRange = 150,
    AttractPower = 30000,
    AttractDamping = 1200,
    MaxPartSize = 50,
    MinDistance = 5,
    
    -- 陣形・配置 (Formation)
    Formation = "左右展開", 
    OrbitDistanceX = 12,
    OrbitHeight = 7,
    OrbitOffsetZ = 0,
    RotateSpeed = 1.2,
    WaveIntensity = 1.0,
    CircleRadius = 15,
    SpiralHeightMult = 2.0,
    
    -- チャージ・凝縮 (Charge)
    ChargeTime = 1.5,
    ChargeTightness = 10000000,
    ChargeDistance = 10,
    ChargeHeightOffset = 2,
    FreezePlayer = true, -- チャージ中に足を止めるか
    
    -- 射出 (Shoot)
    ShootSpeed = 2000,
    ShootSpread = 0, -- 拡散率
    DestroyTime = 5.0, -- ブーメランOFF時の消滅時間
    
