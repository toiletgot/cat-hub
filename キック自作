-- =========================================================================
--  改善版：超高速バースト＋自分含む全員TP (安定性・パフォーマンス向上)
--  発動: F / 停止: Ctrl+F (モバイルはUIボタン)
-- =========================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ---- 設定（調整可能） ----
local CONFIG = {
    GRAB_REPEAT = 5,          -- 1人あたりの掴み連射回数
    GRAB_INTERVAL = 0.02,     -- 連射間隔（秒）
    HOLD_TIME = 0.1,          -- 掴みホールド時間（秒）
    KICK_VELOCITY = 120,      -- キック時の初速
    TELEPORT_POS = Vector3.new(0, 50, 0),
    REMOTE_BURST = 3,         -- 1回のFireServer連射数（調整）
}

-- ---- 状態変数 ----
local Character = nil
local isExecuting = false
local stopRequested = false
local actionMethod = "Kick (超高速)"
local OrionLib = nil

-- ---- 簡易通知（OrionLibフォールバック付き） ----
local function notify(title, content, time)
    if OrionLib and type(OrionLib) == "table" and OrionLib.MakeNotification then
        OrionLib:MakeNotification({Name = title, Content = content, Time = time or 2})
    else
        print(string.format("[%s] %s", title, content))
        -- ゲーム内チャットにも表示（任意）
        -- game:GetService("StarterGui"):SetCore("SendNotification", {Title=title, Text=content, Duration=time or 2})
    end
end

-- ---- Character初期化 ----
local function initializeCharacter(newCharacter)
    Character = newCharacter
end

if LocalPlayer.Character then 
    task.wait(0.1)
    initializeCharacter(LocalPlayer.Character) 
end
LocalPlayer.CharacterAdded:Connect(function(newChar)
    task.wait(0.1)
    initializeCharacter(newChar)
end)

-- ---- ブロブマン探索（動的・堅牢） ----
local function getBlob()
    if not Character then return nil end

    -- 1. 専用フォルダ内を検索
    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and child.Name:find("CreatureBlobman") then
                return child
            end
        end
    end

    -- 2. Characterの子孫から検索
    for _, desc in ipairs(Character:GetDescendants()) do
        if desc:IsA("Model") and desc.Name:find("CreatureBlobman") then
            return desc
        end
    end

    -- 3. Workspace全体をスキャン（ただしパフォーマンス注意）
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("Model") and desc.Name:find("CreatureBlobman") then
            local vs = desc:FindFirstChild("VehicleSeat")
            if vs then
                local seatWeld = vs:FindFirstChild("SeatWeld")
                if seatWeld and seatWeld:IsA("Weld") and seatWeld.Part1 then
                    if seatWeld.Part1:IsDescendantOf(Character) then
                        return desc
                    end
                end
            end
        end
    end
    return nil
end

-- ---- 生存ターゲット取得 ----
local function getAliveTargets()
    local result = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildWhichIsA("Humanoid")
            if hrp and hum and hum.Health > 0 then
                table.insert(result, p)
            end
        end
    end
    return result
end

-- ---- 全プレイヤー（自分含む）取得 ----
local function getAllPlayersWithSelf()
    local result = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            table.insert(result, p)
        end
    end
    return result
end

-- ---- 安全なテレポート（アンカー＋速度リセット） ----
local function safeTeleport(hrp, pos)
    if not hrp then return end
    local anchor = hrp.Anchored
    hrp.Anchored = true
    hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
    hrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
    hrp.CFrame = CFrame.new(pos)
    task.wait(0.02)
    hrp.Anchored = anchor
end

-- ---- 全員テレポート ----
local function teleportEveryone()
    local all = getAllPlayersWithSelf()
    for _, player in ipairs(all) do
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            safeTeleport(hrp, CONFIG.TELEPORT_POS)
        end
    end
end

-- ---- クリーンアップ（Weld削除等） ----
local function cleanUpWelds(detector)
    if not detector then return end
    for _, child in ipairs(detector:GetChildren()) do
        if child:IsA("Weld") or child:IsA("ManualWeld") then
            child:Destroy()
        end
    end
end

-- ---- メインルーチン（改善版） ----
local function executeLoop()
    if isExecuting then return end
    isExecuting = true
    stopRequested = false

    local blob = getBlob()
    if not blob then
        notify("エラー", "ブロブマンに乗ってください", 2)
        isExecuting = false
        return
    end

    local bScript = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
    if not bScript then
        notify("エラー", "BlobmanSeatAndOwnerScript が見つかりません", 2)
        isExecuting = false
        return
    end

    local grabRemote = bScript:FindFirstChild("CreatureGrab")
    local releaseRemote = bScript:FindFirstChild("CreatureRelease")
    local dropRemote = bScript:FindFirstChild("CreatureDrop")
    local rDet = blob:FindFirstChild("RightDetector")
    local rw = rDet and rDet:FindFirstChild("RightWeld")

    if not grabRemote or not rDet then
        notify("エラー", "必須パーツ不足 (grabRemote or rDet)", 2)
        isExecuting = false
        return
    end

    notify("開始", "改善版ループ開始！", 1.5)

    while not stopRequested do
        local targets = getAliveTargets()

        -- ===== フェーズ1: 掴みバースト =====
        for _, target in ipairs(targets) do
            if stopRequested then break end

            local tChar = target.Character
            if not tChar then continue end
            local tHrp = tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar:FindFirstChildWhichIsA("Humanoid")
            if not tHrp or not tHum or tHum.Health <= 0 then continue end

            -- 1人あたり CONFIG.GRAB_REPEAT 回
            for rep = 1, CONFIG.GRAB_REPEAT do
                if stopRequested then break end
                if not target.Character or not tHrp.Parent then break end

                local success, err = pcall(function()
                    -- 速度リセット
                    tHrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    tHrp.AssemblyAngularVelocity = Vector3.new(0,0,0)

                    -- Weldクリーンアップ
                    cleanUpWelds(rDet)

                    -- 右手を密着
                    local armOffset = blob:GetPivot():Inverse() * rDet.CFrame
                    blob:PivotTo(tHrp.CFrame * armOffset:Inverse())

                    -- リモート連射（バースト回数）
                    for _ = 1, CONFIG.REMOTE_BURST do
                        if stopRequested then break end
                        grabRemote:FireServer(rDet, tHrp, rw)
                        task.wait(CONFIG.GRAB_INTERVAL)
                    end

                    -- ホールド
                    local holdStart = tick()
                    while tick() - holdStart < CONFIG.HOLD_TIME do
                        if stopRequested then break end
                        task.wait(0.01)
                    end

                    if stopRequested then return end

                    -- 離す or キル
                    if actionMethod == "Kick (超高速)" then
                        local bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)  -- 適正値
                        local randomDir = Vector3.new(
                            math.random(-10, 10),
                            math.random(8, 18),
                            math.random(-10, 10)
                        ).Unit
                        bv.Velocity = randomDir * CONFIG.KICK_VELOCITY
                        bv.Parent = tHrp

                        if releaseRemote then releaseRemote:FireServer() end
                        if dropRemote then dropRemote:FireServer() end

                        cleanUpWelds(rDet)

                        task.delay(0.05, function()
                            if bv then bv:Destroy() end
                        end)

                    elseif actionMethod == "Kill (掴み即死)" then
                        tHum.Health = 0
                        tHum:TakeDamage(99999)
                        if releaseRemote then releaseRemote:FireServer() end
                        if dropRemote then dropRemote:FireServer() end
                        cleanUpWelds(rDet)
                    end
                end)

                if not success then
                    warn("掴みエラー:", err)
                    cleanUpWelds(rDet)  -- エラー時もクリーンアップ
                end

                task.wait(0.01)  -- 次の掴みへ
            end
        end

        if stopRequested then break end

        -- ===== フェーズ2: 全員テレポート =====
        notify("テレポート", "自分含む全員を移動中...", 0.8)
        teleportEveryone()
        task.wait(0.05)

        -- ブロブ自身も移動
        blob:PivotTo(CFrame.new(CONFIG.TELEPORT_POS))
        task.wait(0.05)

        if #getAliveTargets() == 0 then
            notify("終了", "全員死亡しました", 2)
            break
        end

        -- ループ間の短い待機（停止チェック含む）
        for _ = 1, 3 do
            if stopRequested then break end
            task.wait(0.05)
        end
    end

    notify("停止", "ループを終了しました", 1.5)
    isExecuting = false
end

-- ========== ホットキー ==========
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.F then
        task.spawn(executeLoop)
    end

    if input.KeyCode == Enum.KeyCode.F and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        stopRequested = true
        notify("停止", "強制停止リクエスト送信", 1)
    end
end)

-- ===================== OrionLib UI（フォールバック対応） =====================
local function loadOrion()
    local success, lib = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Orion/main/source"))()
    end)
    if not success or type(lib) ~= "table" then
        success, lib = pcall(function()
            return loadstring(game:HttpGet("https://raw.githubusercontent.com/Siro-script/FtaP.90hub/refs/heads/main/Orion"))()
        end)
    end
    return success and lib or nil
end

OrionLib = loadOrion()

if OrionLib then
    local Window = OrionLib:MakeWindow({
        Name = "改善版 超高速バースト+TP",
        IntroText = "F=開始 / Ctrl+F=停止",
        HidePremium = false,
        SaveConfig = false
    })
    local MainTab = Window:MakeTab({ Name = "メイン", Icon = "rbxassetid://4483345998" })

    MainTab:AddDropdown({
        Name = "動作", Default = "Kick (超高速)", Options = {"Kick (超高速)", "Kill (掴み即死)"},
        Callback = function(Value) actionMethod = Value end
    })

    MainTab:AddButton({
        Name = "▶️ ループ開始 (F)",
        Callback = function() task.spawn(executeLoop) end
    })

    MainTab:AddButton({
        Name = "⏹ 強制停止 (Ctrl+F)",
        Callback = function()
            stopRequested = true
            notify("停止", "強制停止リクエスト送信", 1)
        end
    })

    OrionLib:Init()
else
    -- フォールバック: 簡易UI（Fキーで開始/停止）
    notify("注意", "OrionLib読込失敗 → 簡易モード (Fキーで開始/停止)", 3)
