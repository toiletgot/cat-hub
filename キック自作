-- =========================================================================
--  掴みサイクル 0.1秒版（GRAB_REPEAT で調整）
--  発動: F / 停止: Ctrl+F
--  対象選択（ドロップダウン）・Kill(Direct)・Fling 追加版
-- =========================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ---- 設定 ----
local CONFIG = {
    GRAB_REPEAT = 6,
    GRAB_INTERVAL = 0.001,
    HOLD_TIME = 0.01,
    KICK_VELOCITY = 1,
    FLING_VELOCITY = 500,
    TELEPORT_POS = Vector3.new(0, 50, 0),
    REMOTE_BURST = 6,
    USE_NETWORK_OWNER = true,
    STOP_IF_DISMOUNT = true,
}

local Character = nil
local isExecuting = false
local stopRequested = false
local actionMethod = "Kick (超高速)"
local targetMode = "全員"            -- "全員" または "プレイヤー選択"
local selectedPlayerName = nil      -- 選択されたプレイヤー名（一人）
local OrionLib = nil

local function notify(title, content, time)
    if OrionLib and type(OrionLib) == "table" and OrionLib.MakeNotification then
        OrionLib:MakeNotification({Name = title, Content = content, Time = time or 2})
    else
        print(string.format("[%s] %s", title, content))
    end
end

local function initializeCharacter(newCharacter)
    Character = newCharacter
end
if LocalPlayer.Character then task.wait(0.1) initializeCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(newChar) task.wait(0.1) initializeCharacter(newChar) end)

local function getBlob()
    if not Character then return nil end
    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and child.Name:find("CreatureBlobman") then
                return child
            end
        end
    end
    for _, desc in ipairs(Character:GetDescendants()) do
        if desc:IsA("Model") and desc.Name:find("CreatureBlobman") then
            return desc
        end
    end
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("Model") and desc.Name:find("CreatureBlobman") then
            local vs = desc:FindFirstChild("VehicleSeat")
            if vs then
                local seatWeld = vs:FindFirstChild("SeatWeld")
                if seatWeld and seatWeld:IsA("Weld") and seatWeld.Part1 then
                    if seatWeld.Part1:IsDescendantOf(Character) then return desc end
                end
            end
        end
    end
    return nil
end

local function isSeated(blob)
    if not blob then return false end
    local seat = blob:FindFirstChild("VehicleSeat")
    if seat and seat:IsA("VehicleSeat") then
        return seat.Occupant == Character.Humanoid
    end
    return false
end

-- 対象プレイヤーをフィルタリング
local function getFilteredTargets()
    local all = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildWhichIsA("Humanoid")
            if hrp and hum and hum.Health > 0 then
                table.insert(all, p)
            end
        end
    end

    if targetMode == "全員" then
        return all
    else
        -- プレイヤー選択モード：selectedPlayerName と一致するプレイヤーのみ
        if not selectedPlayerName then return {} end
        local filtered = {}
        for _, p in ipairs(all) do
            if string.lower(p.Name) == string.lower(selectedPlayerName) then
                table.insert(filtered, p)
                break
            end
        end
        return filtered
    end
end

local function getAllPlayersWithSelf()
    local result = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then table.insert(result, p) end
    end
    return result
end

local function safeTeleport(hrp, pos, useNetworkOwner)
    if not hrp then return end
    if useNetworkOwner then pcall(function() hrp:SetNetworkOwner(LocalPlayer) end) end
    local anchor = hrp.Anchored
    hrp.Anchored = true
    hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
    hrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
    hrp.CFrame = CFrame.new(pos)
    task.wait(0.01)
    hrp.Anchored = anchor
    if useNetworkOwner then pcall(function() hrp:SetNetworkOwner(nil) end) end
end

local function teleportEveryone()
    local all = getAllPlayersWithSelf()
    for _, player in ipairs(all) do
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then safeTeleport(hrp, CONFIG.TELEPORT_POS, CONFIG.USE_NETWORK_OWNER) end
    end
end

local function cleanUpWelds(detector)
    if not detector then return end
    for _, child in ipairs(detector:GetChildren()) do
        if child:IsA("Weld") or child:IsA("ManualWeld") then
            child:Destroy()
        end
    end
end

local function executeLoop()
    if isExecuting then return end
    isExecuting = true
    stopRequested = false

    local blob = getBlob()
    if not blob then
        notify("エラー", "ブロブマンに乗ってください", 2)
        isExecuting = false
        return
    end

    local bScript = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
    if not bScript then
        notify("エラー", "BlobmanSeatAndOwnerScript が見つかりません", 2)
        isExecuting = false
        return
    end

    local grabRemote = bScript:FindFirstChild("CreatureGrab")
    local releaseRemote = bScript:FindFirstChild("CreatureRelease")
    local dropRemote = bScript:FindFirstChild("CreatureDrop")
    local rDet = blob:FindFirstChild("RightDetector")
    local rw = rDet and rDet:FindFirstChild("RightWeld")

    if not grabRemote or not rDet then
        notify("エラー", "必須パーツ不足", 2)
        isExecuting = false
        return
    end

    local targetDesc = (targetMode == "全員") and "全員" or ("プレイヤー: " .. (selectedPlayerName or "未選択"))
    notify("開始", string.format("モード: %s  対象: %s", actionMethod, targetDesc), 1.5)

    while not stopRequested do
        if CONFIG.STOP_IF_DISMOUNT and not isSeated(blob) then
            notify("停止", "降車したため停止", 2)
            break
        end

        local targets = getFilteredTargets()
        for _, target in ipairs(targets) do
            if stopRequested then break end
            if CONFIG.STOP_IF_DISMOUNT and not isSeated(blob) then break end

            local tChar = target.Character
            if not tChar then continue end
            local tHrp = tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar:FindFirstChildWhichIsA("Humanoid")
            if not tHrp or not tHum or tHum.Health <= 0 then continue end

            if CONFIG.USE_NETWORK_OWNER then
                pcall(function() tHrp:SetNetworkOwner(LocalPlayer) end)
            end

            for rep = 1, CONFIG.GRAB_REPEAT do
                if stopRequested then break end
                if CONFIG.STOP_IF_DISMOUNT and not isSeated(blob) then break end
                if not target.Character or not tHrp.Parent then break end

                local success, err = pcall(function()
                    tHrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    tHrp.AssemblyAngularVelocity = Vector3.new(0,0,0)

                    cleanUpWelds(rDet)

                    local armOffset = blob:GetPivot():Inverse() * rDet.CFrame
                    blob:PivotTo(tHrp.CFrame * armOffset:Inverse())

                    for _ = 1, CONFIG.REMOTE_BURST do
                        if stopRequested then break end
                        grabRemote:FireServer(rDet, tHrp, rw)
                        task.wait(CONFIG.GRAB_INTERVAL)
                    end

                    local holdStart = tick()
                    while tick() - holdStart < CONFIG.HOLD_TIME do
                        if stopRequested then break end
                        task.wait(0.01)
                    end

                    if stopRequested then return end

                    -- ===== モード分岐 =====
                    if actionMethod == "Kill (Direct)" then
                        tHum.Health = 0
                        tHrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                        tHrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
                    elseif actionMethod == "Fling" then
                        local bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                        local randomDir = Vector3.new(
                            math.random(-10, 10),
                            math.random(5, 15),
                            math.random(-10, 10)
                        ).Unit
                        bv.Velocity = randomDir * CONFIG.FLING_VELOCITY
                        bv.Parent = tHrp
                        task.delay(0.1, function() if bv then bv:Destroy() end end)
                    else
                        local bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                        local randomDir = Vector3.new(
                            math.random(-10, 10),
                            math.random(8, 18),
                            math.random(-10, 10)
                        ).Unit
                        bv.Velocity = randomDir * CONFIG.KICK_VELOCITY
                        bv.Parent = tHrp
                        task.delay(0.05, function() if bv then bv:Destroy() end end)
                    end

                    if releaseRemote then releaseRemote:FireServer() end
                    if dropRemote then dropRemote:FireServer() end

                    cleanUpWelds(rDet)
                end)

                if not success then
                    warn("掴みエラー:", err)
                    cleanUpWelds(rDet)
                end

                task.wait(0.001)
            end

            if CONFIG.USE_NETWORK_OWNER then
                pcall(function() tHrp:SetNetworkOwner(nil) end)
            end
        end

        if stopRequested then break end
        if CONFIG.STOP_IF_DISMOUNT and not isSeated(blob) then
            notify("停止", "降車したためTPをスキップ", 1)
            break
        end

        if actionMethod == "Fling" then
            local hrp = Character and Character:FindFirstChild("HumanoidRootPart")
            if hrp then safeTeleport(hrp, CONFIG.TELEPORT_POS, CONFIG.USE_NETWORK_OWNER) end
            blob:PivotTo(CFrame.new(CONFIG.TELEPORT_POS))
        else
            teleportEveryone()
            blob:PivotTo(CFrame.new(CONFIG.TELEPORT_POS))
        end

        if #getFilteredTargets() == 0 then
            notify("終了", "対象プレイヤーが全員死亡/不在", 2)
            break
        end

        task.wait()
    end

    notify("停止", "ループを終了しました", 1.5)
    isExecuting = false
end

-- ========== ホットキー ==========
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F then
        task.spawn(executeLoop)
    end
    if input.KeyCode == Enum.KeyCode.F and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        stopRequested = true
        notify("停止", "強制停止リクエスト送信", 1)
    end
end)

-- ===================== OrionLib UI =====================
local function loadOrion()
    local success, lib = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Orion/main/source"))()
    end)
    if not success or type(lib) ~= "table" then
        success, lib = pcall(function()
            return loadstring(game:HttpGet("https://raw.githubusercontent.com/Siro-script/FtaP.90hub/refs/heads/main/Orion"))()
        end)
    end
    return success and lib or nil
end

OrionLib = loadOrion()

if OrionLib then
    local Window = OrionLib:MakeWindow({
        Name = "掴み速度調整版 + 対象選択/Kill/Fling",
        IntroText = "F=開始 / Ctrl+F=停止",
        HidePremium = false,
        SaveConfig = false
    })
    local MainTab = Window:MakeTab({ Name = "メイン", Icon = "rbxassetid://4483345998" })

    -- 動作モード
    MainTab:AddDropdown({
        Name = "動作",
        Default = "Kick (超高速)",
        Options = {"Kick (超高速)", "Kill (Direct)", "Fling"},
        Callback = function(Value) actionMethod = Value end
    })

    -- 対象モード（全員 or プレイヤー選択）
    local playerNames = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(playerNames, p.Name)
        end
    end
    table.sort(playerNames)

    MainTab:AddDropdown({
        Name = "対象モード",
        Default = "全員",
        Options = {"全員", "プレイヤー選択"},
        Callback = function(Value)
            targetMode = Value
            -- プレイヤー選択モードに切り替わったら、最初のプレイヤーを自動選択（任意）
            if Value == "プレイヤー選択" and #playerNames > 0 then
                selectedPlayerName = playerNames[1]
            else
                selectedPlayerName = nil
            end
        end
    })

    -- プレイヤー選択用ドロップダウン（常に表示、対象モードが「プレイヤー選択」のときのみ有効）
    MainTab:AddDropdown({
        Name = "プレイヤー選択（一人）",
        Default = (playerNames[1] or "---"),
        Options = playerNames,
        Callback = function(Value)
            selectedPlayerName = Value
        end
    })

    -- 速度調整（掴み回数）
    MainTab:AddSlider({
        Name = "掴み回数（速度調整）",
        Min = 2,
        Max = 20,
        Default = 6,
        Increment = 1,
        Callback = function(Value)
            CONFIG.GRAB_REPEAT = Value
            notify("速度変更", string.format("約%.2f秒/人", (CONFIG.REMOTE_BURST*CONFIG.GRAB_INTERVAL+CONFIG.HOLD_TIME+0.001)*Value), 1)
        end
    })

    -- Fling速度
    MainTab:AddSlider({
        Name = "Fling速度",
        Min = 100,
        Max = 2000,
        Default = 500,
        Increment = 50,
        Callback = function(Value)
            CONFIG.FLING_VELOCITY = Value
        end
    })

    -- トグル類
    MainTab:AddToggle({
        Name = "降車時自動停止",
        Default = true,
        Callback = function(Value) CONFIG.STOP_IF_DISMOUNT = Value end
    })

    MainTab:AddToggle({
        Name = "ネットワーク所有権使用",
        Default = true,
        Callback = function(Value) CONFIG.USE_NETWORK_OWNER = Value end
    })

    -- ボタン
    MainTab:AddButton({
        Name = "▶️ ループ開始 (F)",
        Callback = function() task.spawn(executeLoop) end
    })

    MainTab:AddButton({
        Name = "⏹ 強制停止 (Ctrl+F)",
        Callback = function()
            stopRequested = true
            notify("停止", "強制停止リクエスト送信", 1)
        end
    })

    OrionLib:Init()
else
    notify("注意", "OrionLib読込失敗 → 簡易モード (Fキーで開始/停止)", 3)
end
