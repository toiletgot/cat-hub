local function GetPoseConfig()
    return POSES[POSE_MODE] or POSES.front
end

local function GetBackpackPlayerList()
    local opts = {}
    for _, p in pairs(PS:GetPlayers()) do
        if p ~= Player then
            table.insert(opts, p.DisplayName .. " (" .. p.Name .. ")")
        end
    end
    return opts
end

local function GetBackpackUserName(displayString)
    if not displayString or displayString == "" then return nil end
    local startPos = string.find(displayString, "%(")
    if startPos then
        return string.sub(displayString, startPos + 1, -2)
    end
    return nil
end

local function BackpackClaimNetwork(part)
    pcall(function()
        local GE = RS:FindFirstChild("GrabEvents")
        if GE and GE:FindFirstChild("SetNetworkOwner") then
            GE.SetNetworkOwner:FireServer(part, part.CFrame)
        end
    end)
end

local backpackNoclipConnection = nil

local function BackpackEnableNoclip(targetChar)
    if backpackNoclipConnection then
        backpackNoclipConnection:Disconnect()
    end
    if not targetChar then return end
    for _, part in pairs(targetChar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    backpackNoclipConnection = targetChar.DescendantAdded:Connect(function(part)
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end)
end

local function BackpackDisableNoclip(targetChar)
    if backpackNoclipConnection then
        backpackNoclipConnection:Disconnect()
        backpackNoclipConnection = nil
    end
    if not targetChar then return end
    for _, part in pairs(targetChar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

local function ApplyPose(targetChar, baseCF, pose, rotateY)
    if not targetChar or not baseCF then return end
    
    local rotCF = CFrame.Angles(0, math.rad(rotateY or 0), 0)
    
    local head = targetChar:FindFirstChild("Head")
    if head then
        head.CFrame = baseCF * rotCF * CFrame.new(pose.head.pos) * CFrame.Angles(
            math.rad(pose.head.ang.X),
            math.rad(pose.head.ang.Y),
            math.rad(pose.head.ang.Z)
        )
        head.Velocity = Vector3.zero
        head.RotVelocity = Vector3.zero
    end
    
    local leftArm = targetChar:FindFirstChild("Left Arm") or targetChar:FindFirstChild("LeftArm")
    if leftArm then
        leftArm.CFrame = baseCF * rotCF * CFrame.new(pose.larm.pos) * CFrame.Angles(
            math.rad(pose.larm.ang.X),
            math.rad(pose.larm.ang.Y),
            math.rad(pose.larm.ang.Z)
        )
        leftArm.Velocity = Vector3.zero
        leftArm.RotVelocity = Vector3.zero
    end
    
    local rightArm = targetChar:FindFirstChild("Right Arm") or targetChar:FindFirstChild("RightArm")
    if rightArm then
        rightArm.CFrame = baseCF * rotCF * CFrame.new(pose.rarm.pos) * CFrame.Angles(
            math.rad(pose.rarm.ang.X),
            math.rad(pose.rarm.ang.Y),
            math.rad(pose.rarm.ang.Z)
        )
        rightArm.Velocity = Vector3.zero
        rightArm.RotVelocity = Vector3.zero
    end
    
    local leftLeg = targetChar:FindFirstChild("Left Leg") or targetChar:FindFirstChild("LeftLeg")
    if leftLeg then
        leftLeg.CFrame = baseCF * rotCF * CFrame.new(pose.lleg.pos) * CFrame.Angles(
            math.rad(pose.lleg.ang.X),
            math.rad(pose.lleg.ang.Y),
            math.rad(pose.lleg.ang.Z)
        )
        leftLeg.Velocity = Vector3.zero
        leftLeg.RotVelocity = Vector3.zero
    end
    
    local rightLeg = targetChar:FindFirstChild("Right Leg") or targetChar:FindFirstChild("RightLeg")
    if rightLeg then
        rightLeg.CFrame = baseCF * rotCF * CFrame.new(pose.rleg.pos) * CFrame.Angles(
            math.rad(pose.rleg.ang.X),
            math.rad(pose.rleg.ang.Y),
            math.rad(pose.rleg.ang.Z)
        )
        rightLeg.Velocity = Vector3.zero
        rightLeg.RotVelocity = Vector3.zero
    end
    
    local torso = targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("UpperTorso")
    if torso then
        torso.CFrame = baseCF * rotCF
        torso.Velocity = Vector3.zero
        torso.RotVelocity = Vector3.zero
    end
end

local function BackpackMainLoop()
    while backpackActive do
        local target = PS:FindFirstChild(backpackTargetName)
        if not target then
            task.wait(0.5)
            continue
        end
        local targetChar = target.Character
        if not targetChar then
            task.wait(0.1)
            continue
        end
        local tHRP = targetChar:FindFirstChild("HumanoidRootPart")
        local tHum = targetChar:FindFirstChild("Humanoid")
        if not tHRP or not tHum or tHum.Health <= 0 then
            task.wait(0.1)
            continue
        end
        BackpackEnableNoclip(targetChar)
        local myChar = Player.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then
            task.wait(0.1)
            continue
        end
        
        local pose = GetPoseConfig()
        
        while backpackActive do
            local target = PS:FindFirstChild(backpackTargetName)
            if not target then break end
            local tChar = target.Character
            if not tChar then break end
            local tHRP = tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar:FindFirstChild("Humanoid")
            if not tHRP or not tHum then break end
            if tHum.Health <= 0 then break end
            BackpackEnableNoclip(tChar)
            local myChar = Player.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myHRP then break end
            
            local baseCF = myHRP.CFrame * CFrame.new(pose.offset)
            tHRP.CFrame = baseCF * CFrame.Angles(0, math.rad(pose.rotateY or 0), 0)
            tHRP.Velocity = Vector3.zero
            tHRP.RotVelocity = Vector3.zero
            
            ApplyPose(tChar, baseCF, pose, pose.rotateY or 0)
            BackpackClaimNetwork(tHRP)
            RunService.Heartbeat:Wait()
        end
        BackpackDisableNoclip(targetChar)
        task.wait(0.1)
    end
end

