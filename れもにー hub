-- おんぶトグル
BackpackRightGroup:AddToggle("BackpackToggle", {
    Text = "🍋 おんぶ (Backpack)",
    Default = false,
    Callback = function(Value)
        backpackActive = Value
        if Value then
            if backpackTargetName and backpackTargetName ~= "" then
                backpackTask = task.spawn(BackpackMainLoop)
                Library:Notify({ Title = "🍋 おんぶ", Description = "起動: " .. backpackTargetName, Time = 3 })
            else
                backpackActive = false
                Library:Notify({ Title = "Error", Description = "先にターゲットを選択してください！", Time = 3 })
            end
        else
            if backpackTask then
                task.cancel(backpackTask)
                backpackTask = nil
            end
            local target = PS:FindFirstChild(backpackTargetName)
            if target and target.Character then
                BackpackDisableNoclip(target.Character)
            end
            Library:Notify({ Title = "🍋 おんぶ", Description = "停止しました", Time = 2 })
        end
    end
})

