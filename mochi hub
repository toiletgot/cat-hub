-- === [幾何学マトリクスエンジン (Mochi Side)] ===
local function updateArtGeometry(dt)
    if ArtConfig.CurrentMode == "None" then return end
    local targetUser = Player
    if ArtConfig.AttachToTarget and Config.TargetName ~= "" then
        local foundPlr = Players:FindFirstChild(Config.TargetName) if foundPlr then targetUser = foundPlr end
    end
    if not targetUser.Character then return end
    local root = targetUser.Character:FindFirstChild("HumanoidRootPart") if not root then return end
    
    local toys = findObjects() if #toys == 0 then return end
    ArtTime = ArtTime + dt * ArtConfig.Speed
    local useCount = math.min(#toys, ArtConfig.MaxObjects)
    
    local customRotation = CFrame.Angles(math.rad(ArtConfig.RotX), math.rad(ArtConfig.RotY), math.rad(ArtConfig.RotZ))
    local verticalPartBase = CFrame.Angles(math.rad(90), 0, 0)
    
    for i = 1, useCount do
        local toy = toys[i]
        local pPart = getPrimaryPart(toy)
        if pPart then
            for _, c in ipairs(toy:GetChildren()) do if c:IsA("BasePart") then c.CanCollide = false; c.CanTouch = false end end
            local bg, bp = attachPhysics(pPart) if not bp or not bg then continue end
            
            local targetPos = root.Position
            local targetRot = root.CFrame * verticalPartBase * customRotation
            local mode = ArtConfig.CurrentMode
            
            if mode == "NormalWings" then
                local isRightWing = (i % 2 == 0)
                local sideSign = isRightWing and 1 or -1
                local idx = math.floor((i - 1) / 2) + 1
                local totalSide = math.max(1, math.floor(useCount / 2))
                local t = idx / totalSide
                local wingSpread = t * ArtConfig.Radius * 1.1
                local flap = math.sin(ArtTime * 3.0) * 2.0 * t
                targetPos = root.Position + (root.CFrame.RightVector * wingSpread * sideSign) + (root.CFrame.LookVector * -1.5) + Vector3.new(0, ArtConfig.Height + (t * 4) + flap, 0)

            elseif mode == "AngelHaloWings" then
                local haloCount = math.min(30, math.floor(useCount * 0.25))
                if i <= haloCount then
                    local haloAngle = (i * math.pi * 2 / haloCount) + (ArtTime * 2.0)
                    local currentHaloRadius = ArtConfig.HaloSize
                    targetPos = root.Position + (root.CFrame.RightVector * math.cos(haloAngle) * currentHaloRadius) + (root.CFrame.LookVector * math.sin(haloAngle) * currentHaloRadius) + Vector3.new(0, 5.5, 0)
                else
                    local wingIdx = i - haloCount
                    local wingTotal = useCount - haloCount
                    local isRightWing = (wingIdx % 2 == 0)
                    local sideSign = isRightWing and 1 or -1
                    local idx = math.floor((wingIdx - 1) / 2) + 1
                    local totalSide = math.max(1, math.floor(wingTotal / 2))
                    local t = (idx / totalSide) * 0.8 + 0.2
                    local flap = math.sin(ArtTime * 2.5) * 2.0 * t
                    local currentRadius = ArtConfig.Radius * t * 1.3
                    targetPos = root.Position + (root.CFrame.RightVector * currentRadius * sideSign) + (root.CFrame.LookVector * -1.5) + Vector3.new(0, ArtConfig.Height + (t * 3.5) + flap, 0)
                end

            elseif mode == "DragonOrbit" then
                local isRightWing = (i % 2 == 0)
                local sideSign = isRightWing and 1 or -1
                local idx = math.floor((i - 1) / 2) + 1
                local totalSide = math.max(1, math.floor(useCount / 2))
                local t = idx / totalSide
                local wingSpread = t * ArtConfig.Radius * 1.2
                local lagSpacing = idx * 0.20
                local waveClock = ArtTime * 3.5
                local dragonFlap = math.sin(waveClock - lagSpacing) * (2.5 * t + 1.0)
                local dragonWaveZ = math.cos(waveClock * 0.8 - lagSpacing) * (1.8 * t)
                targetPos = root.Position + (root.CFrame.RightVector * wingSpread * sideSign) + (root.CFrame.LookVector * (-1.5 + dragonWaveZ)) + Vector3.new(0, ArtConfig.Height + (t * 2.0) + dragonFlap, 0)

            elseif mode == "Tornado" then
                local ratio = i / useCount
                local angle = (ratio * math.pi * 12) + (ArtTime * 4.0)
                local currentRadius = ratio * ArtConfig.Radius
                local heightOffset = (ratio - 0.5) * 25 + ArtConfig.Height
                
                local offsetX = math.cos(angle) * currentRadius
                local offsetZ = math.sin(angle) * currentRadius
                targetPos = root.Position + (root.CFrame.RightVector * offsetX) + (root.CFrame.LookVector * offsetZ) + Vector3.new(0, heightOffset, 0)
                targetRot = CFrame.lookAt(targetPos, root.Position) * verticalPartBase * customRotation

            elseif mode == "Circle" then
                local angle = (i * math.pi * 2 / useCount) + ArtTime
                local offsetX = math.cos(angle) * ArtConfig.Radius
                local offsetZ = math.sin(angle) * ArtConfig.Radius
                targetPos = root.Position + (root.CFrame.RightVector * offsetX) + (root.CFrame.LookVector * offsetZ) + Vector3.new(0, ArtConfig.Height, 0)
                targetRot = CFrame.lookAt(targetPos, root.Position) * verticalPartBase * customRotation
            end
            
            bp.Position = targetPos bg.CFrame = targetRot
        end
    end
end

