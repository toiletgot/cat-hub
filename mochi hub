-- 3. 裏処理常駐システムループ
-- ====================================================

RunService.RenderStepped:Connect(function(dt)
    -- Anti-Grab 防衛ロジック
    if Config.AntiGrabActive and Player.Character then
        local grabbed = false
        for _, v in ipairs(Player.Character:GetDescendants()) do
            if v:IsA("Weld") or v:IsA("Constraint") or v:IsA("BallSocketConstraint") or v:IsA("RopeConstraint") then
                if v.Name ~= "RootJoint" and v.Name ~= "Neck" and not v.Name:find("Left") and not v.Name:find("Right") then
                    v:Destroy()
                    grabbed = true
                end
            end
        end
        if grabbed and (os.clock() - lastGrabNotify > 2) then
            OrionLib:MakeNotification({Name = "🛡️ 防衛成功！", Content = "不審な掴み攻撃を検知し、自動で破壊しました！", Image = "rbxassetid://4483345998", Time = 3})
            lastGrabNotify = os.clock()
        end
    end

    -- Firework システム制御コア
    if not rowConfig.enabled then return end
    local character = getFireworkTargetCharacter()
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    FireworkTime = FireworkTime + dt * rowConfig.waveSpeed
    
    local charCFrame = humanoidRootPart.CFrame
    local rightVector = charCFrame.RightVector
    local lookVector = charCFrame.LookVector
    local upVector = charCFrame.UpVector
    local basePosition = humanoidRootPart.Position + Vector3.new(0, rowConfig.heightOffset, 0) + (lookVector * rowConfig.forwardOffset)
    
    local totalPoints = #rowPoints
    local activeHaloCount = math.min(rowConfig.haloCount, totalPoints)
    
    for idx, point in ipairs(rowPoints) do
        local toy = point.assignedToy
        if toy and toy.Pallet and toy.BP and toy.BG then
            
            -- 【条件分岐】 最初のインデックス群を天使の輪（Halo）として頭上に隔離追従させる
            if idx <= activeHaloCount and activeHaloCount > 0 then
                local angle = (idx * math.pi * 2 / activeHaloCount) + (FireworkTime * 0.8)
                local currentRadius = rowConfig.haloSize
                
                local offsetX = math.cos(angle) * currentRadius
                local offsetZ = math.sin(angle) * currentRadius
                
                local targetPosition = humanoidRootPart.Position + (charCFrame.RightVector * offsetX) + (charCFrame.LookVector * offsetZ) + Vector3.new(0, rowConfig.haloHeight, 0)
                toy.BP.Position = toy.BP.Position:Lerp(targetPosition, rowConfig.smoothness)
                
                local verticalPartBase = CFrame.Angles(math.rad(90), 0, 0)
                local targetCFrame = CFrame.lookAt(targetPosition, humanoidRootPart.Position + Vector3.new(0, rowConfig.haloHeight, 0)) * verticalPartBase
                toy.BG.CFrame = toy.BG.CFrame:Lerp(targetCFrame, rowConfig.smoothness)
                
            else
                -- 【元の処理そのまま】本来の Wave & Line Art (羽ばたきモーション)
                local distFromCenter = math.abs(toy.baseOffsetX)
                local currentAmplitude = rowConfig.baseAmplitude + (distFromCenter * rowConfig.distanceMultiplier)
                
                local waveY = math.sin(FireworkTime - (distFromCenter * rowConfig.phaseOffset)) * currentAmplitude
                local waveX = math.cos(FireworkTime - (distFromCenter * rowConfig.phaseOffset)) * rowConfig.horizontalWaveAmount
                
                local sign = toy.baseOffsetX >= 0 and 1 or -1
                local finalOffsetX = toy.baseOffsetX - (waveX * sign)
                local targetPosition = basePosition + (rightVector * finalOffsetX) + (upVector * waveY)
                
                toy.BP.Position = toy.BP.Position:Lerp(targetPosition, rowConfig.smoothness)
                
                local _, playerYRot, _ = charCFrame:ToOrientation()
                local targetCFrame = CFrame.new(toy.BP.Position)
                targetCFrame = targetCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation), 0)
                targetCFrame = targetCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                targetCFrame = targetCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                toy.BG.CFrame = toy.BG.CFrame:Lerp(targetCFrame, rowConfig.smoothness)
            end
        end
    end
end)

