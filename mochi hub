local function findObjects()
    local toys = {}
    local targetName = ObjectIDConfig.CurrentObjectID
    for _, item in ipairs(Workspace:GetDescendants()) do
        if item:IsA("Model") then
            local lowerName = string.lower(item.Name)
            if targetName == "Tetracube1" then
                if string.find(lowerName, "tetracube") then table.insert(toys, item) end
            elseif targetName == "🚽 Toilet" then
                if string.find(lowerName, "toilet") then table.insert(toys, item) end
            elseif targetName == "📺 Flatscreen Television" then
                if string.find(lowerName, "television") or string.find(lowerName, "tv") or string.find(lowerName, "flatscreen") then table.insert(toys, item) end
            elseif targetName == "💩 Poop" then
                if string.find(lowerName, "poop") or string.find(lowerName, "💩") then table.insert(toys, item) end
            elseif targetName == "🔥 Campfire" then
                if string.find(lowerName, "campfire") then table.insert(toys, item) end
            elseif targetName == "🏮 Paper Lantern" then
                if string.find(lowerName, "paper lantern") or string.find(lowerName, "lantern") then table.insert(toys, item) end
            elseif item.Name == targetName then
                table.insert(toys, item)
            end
        end
    end
    return toys
end

-- === [Firework アート用オブジェクト検出] ===
local function findFireworkSparklers()
    local toys = {}
    for _, item in ipairs(Workspace:GetDescendants()) do
        if item:IsA("Model") and item.Name == "FireworkSparkler" then
            local alreadyAdded = false
            for _, existingToy in ipairs(toys) do
                if existingToy == item then alreadyAdded = true; break end
            end
            if not alreadyAdded then table.insert(toys, item) end
        end
    end
    table.sort(toys, function(a, b) return a.Name < b.Name end)
    return toys
end

