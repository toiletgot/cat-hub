Workspace.ChildAdded:Connect(function(model)
    if model.Name ~= "GrabParts" then return end
    task.wait(0.1)
    local grabPart = model:FindFirstChild("GrabPart")
    if not grabPart then return end
    local wc = grabPart:FindFirstChild("WeldConstraint")
    local part1 = wc and wc.Part1
    if not part1 or (Player.Character and part1:IsDescendantOf(Player.Character)) then return end
    
    local targetChar = part1.Parent
    local forceMultiplier = _G.strength or 500
    
    -- 1. キルグラブ
    if grabFlags.KillGrab then 
        pcall(function() targetChar:BreakJoints() end) 
    end
    
    -- 2. スカイグラブ
    if grabFlags.SkyGrab then
        local bv = Instance.new("BodyVelocity", part1)
        bv.Velocity = Vector3.new(0, forceMultiplier, 0)
        bv.MaxForce = Vector3.new(0, math.huge, 0)
        Debris:AddItem(bv, 1.5)
    end
    
    -- 3. フリンググラブ
    if grabFlags.FlingGrab then
        local bv = Instance.new("BodyVelocity", part1)
        bv.Velocity = Vector3.new(math.random(-1, 1), 1.5, math.random(-1, 1)).Unit * forceMultiplier
        bv.MaxForce = Vector3.one * math.huge
        Debris:AddItem(bv, 1)
    end
    
    -- 4. ボイドグラブ (奈落送り)
    if grabFlags.VoidGrab then
        local bv = Instance.new("BodyVelocity", part1)
        bv.Velocity = Vector3.new(0, -forceMultiplier, 0)
        bv.MaxForce = Vector3.one * math.huge
        Debris:AddItem(bv, 1)
    end
    
    -- 5. スピングラブ
    if grabFlags.SpinGrab then
        local bav = Instance.new("BodyAngularVelocity", part1)
        bav.AngularVelocity = Vector3.new(0, (forceMultiplier / 10), 0)
        bav.MaxTorque = Vector3.one * math.huge
        Debris:AddItem(bav, 2)
    end

    -- 6. フリーズグラブ (固定化)
    if grabFlags.FreezeGrab then
        for _, part in ipairs(targetChar:GetChildren()) do
            if part:IsA("BasePart") then
                pcall(function() 
                    part.Anchored = true 
                    task.delay(3, function() part.Anchored = false end) -- 3秒後に解除
                end)
            end
        end
    end

    -- 7. ポイズングラブ (ヘルス持続削り)
    if grabFlags.PoisonGrab then
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        if hum then
            task.spawn(function()
                for i = 1, 10 do
                    if hum and hum.Parent then hum.Health = hum.Health - 5 task.wait(0.2) end
                end
            end)
        end
    end

    -- 8. ラグドールグラブ
    if grabFlags.RagdollGrab then
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.PlatformStand = true task.delay(3, function() hum.PlatformStand = false end) end) end
    end

    -- 9. ファイアグラブ (エフェクト点火)
    if grabFlags.FireGrab then
        local root = targetChar:FindFirstChild("HumanoidRootPart")
        if root then
            local fire = Instance.new("Fire", root)
            fire.Size = 10
            Debris:AddItem(fire, 4)
        end
    end

    -- 10. 壁抜けグラブ (CanCollide判定破壊)
    if grabFlags.NoclipGrab then
        task.spawn(function()
            local startTime = os.clock()
            while os.clock() - startTime < 3 do
                for _, part in ipairs(targetChar:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
                task.wait(0.1)
            end
        end)
    end
