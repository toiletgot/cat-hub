local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local Mouse = Player:GetMouse()

-- ウィンドウ作成
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/Obsidian/main/Library.lua"))()
local Window = Library:CreateWindow({
    Title = "Ragdoll",
    Footer = "Snowball Spammer",
    NotifySide = "Right",
})

local Tabs = {
    Main = Window:AddTab("Main", "skull", "Snowball spammer")
}

local MainGroup = Tabs.Main:AddLeftGroupbox("Snowball Settings")

local selectedTarget = nil

-- プレイヤーリスト取得
local function getPlayerList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            table.insert(list, plr.DisplayName .. " (" .. plr.Name .. ")")
        end
    end
    return list
end

-- 選択からプレイヤーを取得
local function getPlayerFromSelection(selection)
    if not selection then return nil end
    local username = selection:match("%((.-)%)")
    if username then
        return Players:FindFirstChild(username)
    end
    return nil
end

-- ターゲット選択
MainGroup:AddDropdown("TargetSelect", {
    Text = "Select Target",
    Values = getPlayerList(),
    Default = 1,
    Callback = function(Value)
        selectedTarget = getPlayerFromSelection(Value)
    end
})

-- リフレッシュボタン
MainGroup:AddButton({
    Text = "Refresh Player List",
    Func = function()
        Library.Options.TargetSelect:SetValues(getPlayerList())
        Library.Options.TargetSelect:SetValue(nil)
        selectedTarget = nil
    end
})

-- メイン機能
MainGroup:AddCheckbox("SnowballSpam", {
    Text = "Ragdoll Snowball",
    Default = false,
    Callback = function(Value)
        _G.RagdollSnowballActive = Value

        if not Value then return end

        task.spawn(function()
            local SpawnRemote = RS:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
            local ToyFolderName = Player.Name .. "SpawnedInToys"

            while _G.RagdollSnowballActive do
                local target = selectedTarget

                if target and target.Character then
                    local tChar = target.Character
                    local torso = tChar:FindFirstChild("HumanoidRootPart") 
                        or tChar:FindFirstChild("UpperTorso") 
                        or tChar:FindFirstChild("Torso")

                    if torso then
                        -- スノーボールをスポーン
                        pcall(function()
                            local offset = Vector3.new(
                                math.random(-50, 50) / 100,
                                math.random(-50, 50) / 100,
                                math.random(-50, 50) / 100
                            )
                            task.spawn(function()
                                SpawnRemote:InvokeServer(
                                    "BallSnowball",
                                    torso.CFrame * CFrame.new(offset),
                                    Vector3.zero
                                )
                            end)
                        end)

                        -- 既存のスノーボールをターゲットにテレポート
                        local folder = Workspace:FindFirstChild(ToyFolderName)
                        if folder then
                            for _, snowball in ipairs(folder:GetChildren()) do
                                if snowball.Name == "BallSnowball" then
                                    local part = snowball:IsA("BasePart") and snowball 
                                        or snowball.PrimaryPart 
                                        or snowball:FindFirstChildWhichIsA("BasePart")
                                    if part then
                                        part.CFrame = torso.CFrame
                                        part.AssemblyLinearVelocity = Vector3.zero
                                    end
                                end
                            end
                        end
                    end
                end

                RunService.Heartbeat:Wait()
            end
        end)
    end
})

