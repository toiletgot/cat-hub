BlobTab:CreateSection("Blob Kill")
local bk_active = false

local function blob_kick(blob, hrp, rl, v)
    local detec = blob:FindFirstChild(rl .. "Detector")
    if not detec then return end
    local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
    if not script then return end
    local weld = detec:FindFirstChild(rl .. "Weld")
    
    if v == "Default" and script:FindFirstChild("CreatureGrab") then
        script.CreatureGrab:FireServer(detec, hrp, weld)
    elseif v == "DDrop" and script:FindFirstChild("CreatureDrop") then
        script.CreatureDrop:FireServer(weld)
    elseif v == "Release" and script:FindFirstChild("CreatureRelease") then
        script.CreatureRelease:FireServer(weld, hrp)
    end
end

local function BlobKill(targetPlayerName)
    local MyBlob
    Rayfield:Notify({Title = "Blob Kill", Content = "Blobに乗るまで待機中...", Duration = 3})
    while bk_active do
        local mychar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local myhum = FWC(mychar, "Humanoid")
        if myhum and myhum.SeatPart then
            MyBlob = myhum.SeatPart.Parent
            break
        end
        task.wait(0.2)
    end
    
    if not bk_active then return end
    Rayfield:Notify({Title = "Blob Kill", Content = targetPlayerName .. " を攻撃開始", Duration = 4})
    
    while bk_active and task.wait() do
        local mychar = LocalPlayer.Character
        local myHRP = mychar and FWC(mychar, "HumanoidRootPart")
        local myhum = mychar and FWC(mychar, "Humanoid")
        
        if not myhum or not myhum.SeatPart then
            bk_active = false
            Rayfield:Notify({Title = "Blob Kill", Content = "Blobから降りました。停止します。", Duration = 3})
            break
        end
        if myhum.SeatPart.Parent ~= MyBlob then
            bk_active = false
            Rayfield:Notify({Title = "Blob Kill", Content = "Blobが変わりました。停止します。", Duration = 3})
            break
        end
        
        local plr = Players:FindFirstChild(targetPlayerName)
        if not plr then task.wait(1) continue end
        local char = plr.Character
        if not char then task.wait(1) continue end
        local hum = FWC(char, "Humanoid", 2)
        local HRP = FWC(char, "HumanoidRootPart", 2)
        if not (hum and HRP) then task.wait(1) continue end
        if hum.Health <= 0 then task.wait(1.5) continue end
        
        local LD = MyBlob:FindFirstChild("LeftDetector")
        local LW = LD and LD:FindFirstChild("LeftWeld")
        if LD and LW then
            while LW.Attachment0 ~= HRP.RootAttachment and bk_active do
                local SavedPosition = myHRP.CFrame
                while hum.SeatPart and bk_active do
                    task.spawn(SetOwnerGrab, HRP)
                    task.wait()
                end
                
                for i = 1, 4 do
                    if not myhum.SeatPart then bk_active = false break end
                    myHRP.CFrame = HRP.CFrame - Vector3.new(0, 10, 0)
                    blob_kick(MyBlob, HRP, "Left", "Default")
                    task.wait(0.05)
                    blob_kick(MyBlob, HRP, "Left", "Release")
                    hum.Health = 0
                    task.wait()
                end
                if not bk_active then break end
                myHRP.CFrame = SavedPosition
            end
        end
    end
end

