BlobTab:CreateSection("GUCCI BINDER")
local gucciRunId = 0

local function toy_spawn_gucci(name, cframe, vector)
    local menuToys = ReplicatedStorage:FindFirstChild("MenuToys")
    if not menuToys then return nil end
    local ToySpawn = menuToys:FindFirstChild("SpawnToyRemoteFunction")
    if not ToySpawn then return nil end
    task.spawn(function() ToySpawn:InvokeServer(name, cframe, vector or Vector3.new()) end)
    
    local folder = Workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys", 5)
    local toy, start = nil, tick()
    while tick() - start < 3 do
        toy = folder and folder:FindFirstChild(name)
        if toy then break end
        task.wait(0.1)
    end
    return toy
end

local function GucciAntiGrab()
    gucciRunId = gucciRunId + 1
    local MyId = gucciRunId
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = FWC(char, "Humanoid")
    local hrp = FWC(char, "HumanoidRootPart")
    if not hum or not hrp then return end
    
    hum.Sit = true
    task.wait(0.02)
    hum.Sit = false
    task.wait(0.02)
    
    task.spawn(function()
        local t = tick()
        while tick() - t < 0.8 do
            for _, v in pairs(char:GetChildren()) do
                if v:IsA("BasePart") then v.Velocity = Vector3.zero end
            end
            task.wait(0.01)
        end
    end)
    
    local Blob, BHead = nil, nil
    task.spawn(function()
        while not Blob and MyId == gucciRunId do task.wait(0.01) end
        if MyId ~= gucciRunId then return end
        BHead = FWC(Blob, "Head")
        local HitBox = FWC(Blob, "GrabbableHitbox")
        while MyId == gucciRunId and BHead do
            if not BHead:FindFirstChild("PartOwner") or BHead.PartOwner.Value ~= LocalPlayer.Name then
                SetOwnerGrab(HitBox)
            end
            task.wait(0.01)
        end
    end)
    
    Blob = toy_spawn_gucci("CreatureBlobman", hrp.CFrame * CFrame.new(0, 0, -5), Vector3.new(0, -15.716, 0))
    if not Blob then
        Rayfield:Notify({Title = "GUCCI", Content = "Blobの生成に失敗しました", Duration = 4})
        return
    end
    local Seat = FWC(Blob, "VehicleSeat")
    
    task.defer(function()
        local startTime = tick()
        while tick() - startTime < 0.35 and MyId == gucciRunId do
            if Seat then Seat:Sit(hum) end
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            task.wait(0.03)
        end
    end)
    
    task.defer(function()
        while MyId == gucciRunId do
            local RE = ReplicatedStorage:FindFirstChild("CharacterEvents")
            if RE and RE:FindFirstChild("RagdollRemote") then
                RE.RagdollRemote:FireServer(hrp, 0.095)
            end
            task.wait(0.01)
        end
    end)
    
    task.wait(0.45)
    if MyId ~= gucciRunId then return end
    hum.Sit = false
    Blob.Name = "Gucci"
    
    task.defer(function()
        while MyId == gucciRunId and Blob and BHead do
            BHead.CFrame = CFrame.new(BHead.Position.X, 100000, BHead.Position.Z)
            task.wait(0.01)
        end
    end)
    Rayfield:Notify({Title = "✅ GUCCI SUCCESS", Content = "Gucciが正常に作成されました！", Duration = 5})
end

