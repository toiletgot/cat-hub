CombatTab:CreateSection("Fast Loop Kill")
local loopKillActive = false

local function LoopKillFunction(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target then return end
    local GE = ReplicatedStorage:WaitForChild("GrabEvents")
    local RagdollRemote = ReplicatedStorage:FindFirstChild("CharacterEvents") and ReplicatedStorage.CharacterEvents:FindFirstChild("RagdollRemote")
    
    while loopKillActive and target and target.Parent do
        if not target.Character then task.wait(0.3) continue end
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local tChar = target.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChild("Humanoid")
        
        if tRoot and tHum and tHum.Health > 0 and myRoot then
            local currentPos = myRoot.CFrame
            local attackStart = tick()
            while tick() - attackStart < 0.7 and loopKillActive do
                if not tRoot.Parent then break end
                myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2)
                myRoot.Velocity = Vector3.zero
                pcall(function()
                    for i = 1, 3 do GE.SetNetworkOwner:FireServer(tRoot, myRoot.CFrame) end
                    tHum:ChangeState(Enum.HumanoidStateType.Dead)
                    tHum.Health = 0
                    if RagdollRemote then RagdollRemote:FireServer(tRoot, 0) end
                    GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                    GE.DestroyGrabLine:FireServer(tRoot)
                end)
                RunService.Heartbeat:Wait()
            end
            if myRoot then
                myRoot.CFrame = currentPos
                myRoot.Velocity = Vector3.zero
            end
            task.wait(0.45)
        else
            task.wait(0.3)
        end
    end
end

CombatTab:CreateToggle({
    Name = "🔴 Loop Kill (高速版)",
    CurrentValue = false,
    Callback = function(Value)
        loopKillActive = Value
        if Value then
            if GlobalTarget ~= "" then
                Rayfield:Notify({Title = "Loop Kill", Content = GlobalTarget .. " に高速攻撃中...", Duration = 3})
                task.spawn(LoopKillFunction, GlobalTarget)
