--================================================================================
-- 💓 メインループ
--================================================================================

local scanAccum  = 0
local labelAccum = 0

RunService.Heartbeat:Connect(function(dt)
    scanAccum  = scanAccum  + dt
    labelAccum = labelAccum + dt

    if STATE.ESPEnabled and scanAccum >= STATE.RefreshRate then
        scanAccum = 0
        ScanForObjects()
    end

    if STATE.ESPEnabled then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local myPos = root and root.Position or Camera.CFrame.Position

        for obj, data in pairs(STATE.Detected) do
            if not obj or not obj.Parent then
                RemoveESP(obj)
            else
                local pos = GetTargetPosition(obj)
                if not pos then
                    RemoveESP(obj)
                else
                    local dist = (pos - myPos).Magnitude
                    if dist < STATE.MinDistance or dist > STATE.MaxDistance then
                        RemoveESP(obj)
                    else
                        local parts = {}
                        if STATE.ShowName then table.insert(parts, obj.Name) end
                        if STATE.ShowClassName then table.insert(parts, "[" .. obj.ClassName .. "]") end
                        if STATE.ShowDistance then table.insert(parts, string.format("%.0fm", dist)) end
                        if STATE.ShowPath then table.insert(parts, "(" .. GetFullPath(obj) .. ")") end
                        if data.Label then data.Label.Text = table.concat(parts, " | ") end

                        if data.Highlight then
                            data.Highlight.FillColor    = STATE.ESPColor
                            data.Highlight.OutlineColor = STATE.ESPColor
                        end
                    end
                end
            end
        end
    end

    if labelAccum >= 0.5 then
        labelAccum = 0
        if CountLabel then CountLabel:Set("検出数: " .. STATE.Count) end
        if DebugLabel then DebugLabel:Set(string.format("候補: %d / 検出: %d", STATE.Count, STATE.Count)) end
    end
end)

