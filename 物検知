-- 🛠️ ユーティリティ
--================================================================================

local function ParseKeywords(text)
    local list = {}
    for word in string.gmatch(text, "([^,]+)") do
        word = word:match("^%s*(.-)%s*$"):lower()
        if word ~= "" then table.insert(list, word) end
    end
    return list
end

local function GetKeywordList()
    return STATE.KeywordList
end

local function GetTargetPosition(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local okp, pivot = pcall(function() return obj:GetPivot() end)
        if okp and pivot then return pivot.Position end
        -- フォールバック：PrimaryPartまたは最初のBasePart
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local first = obj:FindFirstChildWhichIsA("BasePart", true)
        if first then return first.Position end
    end
    return nil
end

local function IsLocalCharacterPart(obj)
    local char = LocalPlayer.Character
    return char and obj:IsDescendantOf(char) or false
end

local function IsPlayerPart(obj)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and obj:IsDescendantOf(p.Character) then return true end
    end
    return false
end

-- 🆕 フルパス取得
local function GetFullPath(obj)
    local parts = {}
    local cur = obj
    while cur and cur ~= Workspace and cur ~= game do
        table.insert(parts, 1, cur.Name)
        cur = cur.Parent
    end
    return table.concat(parts, "/")
end

local GROUND_KEYWORDS = {
    "baseplate", "floor", "ground", "terrain", "grass", "road",
    "wall", "ceiling", "roof", "platform", "spawn", "spawnlocation",
    "water", "lava", "sand", "path", "map", "world", "earth",
    "tile", "block_ground", "foundation", "bottom"
}

local function IsGroundPart(obj)
    local n = obj.Name:lower()
    for _, k in ipairs(GROUND_KEYWORDS) do
        if string.find(n, k, 1, true) then return true end
    end
    if obj:IsA("Terrain") then return true end
    if obj:IsA("SpawnLocation") then return true end

    if STATE.IgnoreAnchored and obj:IsA("BasePart") and obj.Anchored then
        if obj.Parent == Workspace then return true end
        if STATE.IgnoreBigParts then
            local sz = obj.Size
            if sz.X > STATE.MaxPartSize or sz.Y > STATE.MaxPartSize or sz.Z > STATE.MaxPartSize then
                return true
            end
        end
    end

    if STATE.IgnoreFlat and obj:IsA("BasePart") then
        local sz = obj.Size
        local sorted = { sz.X, sz.Y, sz.Z }
        table.sort(sorted)
        if sorted[1] < 2 and sorted[3] >= 10 then return true end
    end

    if STATE.IgnoreBigParts and obj:IsA("BasePart") then
        local sz = obj.Size
        if sz.X > STATE.MaxPartSize or sz.Y > STATE.MaxPartSize or sz.Z > STATE.MaxPartSize then
            return true
        end
    end

    return false
end

local EFFECT_KEYWORDS = {
    "effect", "particle", "smoke", "spark", "trail", "beam",
    "flash", "aura", "glow", "vfx", "fx", "debris"
}

local function IsEffectPart(obj)
    local n = obj.Name:lower()
    for _, k in ipairs(EFFECT_KEYWORDS) do
        if string.find(n, k, 1, true) then return true end
    end
    return false
end

--================================================================================
-- 🎯 キーワードマッチ（改良版：自分の名前・親Model・祖先・ClassName）
--================================================================================

local function MatchesKeywords(obj, keywords)
    if #keywords == 0 then return true end

    -- 1. 自身の名前
    local n = obj.Name:lower()
    for _, k in ipairs(keywords) do
        if string.find(n, k, 1, true) then return true end
    end

    -- 2. ClassName
    local cn = obj.ClassName:lower()
    for _, k in ipairs(keywords) do
        if string.find(cn, k, 1, true) then return true end
    end

    -- 3. 祖先Model（数階層上まで）
    local parent = obj.Parent
    local depth = 0
    while parent and parent ~= Workspace and depth < 5 do
        local pn = parent.Name:lower()
        for _, k in ipairs(keywords) do
            if string.find(pn, k, 1, true) then return true end
        end
        parent = parent.Parent
        depth = depth + 1
    end

    -- 4. 子パーツ（Modelの場合）
    if obj:IsA("Model") then
        for _, child in ipairs(obj:GetChildren()) do
            local cnn = child.Name:lower()
            for _, k in ipairs(keywords) do
                if string.find(cnn, k, 1, true) then return true end
            end
        end
    end

    return false
end

--================================================================================
-- 🎯 検出判定
--================================================================================

local function ShouldDetect(obj)
    if not obj or not obj.Parent then return false end
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false end

    if STATE.IgnoreTerrain and obj:IsA("Terrain") then return false end
    if IsGroundPart(obj) then return false end

    -- BasePart固有チェック
    if obj:IsA("BasePart") then
        if obj.Transparency >= 1 then return false end
        if obj.Size.Magnitude < 0.05 then return false end
    end

    -- Model固有チェック（全パーツが透明 or 小さすぎる場合は除外）
    if obj:IsA("Model") then
        local hasVisible = false
        for _, p in ipairs(obj:GetDescendants()) do
            if p:IsA("BasePart") and p.Transparency < 1 and p.Size.Magnitude >= 0.05 then
                hasVisible = true
                break
            end
        end
        if not hasVisible then return false end
    end

    if STATE.IgnoreLocalChar and IsLocalCharacterPart(obj) then return false end
    if STATE.IgnorePlayers and IsPlayerPart(obj) then return false end
    if STATE.IgnoreEffects and IsEffectPart(obj) then return false end

    if STATE.ClassFilter ~= "All" then
        if not obj:IsA(STATE.ClassFilter) then return false end
    end

    if STATE.DetectMode == "KEYWORD" then
        if not MatchesKeywords(obj, GetKeywordList()) then return false end
    end

    return true
end

--================================================================================
-- ✨ ESP
--================================================================================

local function ApplyBillboardStyle(data)
    if not data then return end
    if data.Billboard then
        data.Billboard.Size = UDim2.new(0, STATE.BillboardWidth, 0, STATE.BillboardHeight)
        data.Billboard.StudsOffsetWorldSpace = Vector3.new(0, STATE.HeightOffset, 0)
    end
    if data.Label then
        data.Label.TextSize   = STATE.TextSize
        data.Label.TextScaled = false
    end
end

local function CreateESP(obj)
    if STATE.Detected[obj] then
        ApplyBillboardStyle(STATE.Detected[obj])
        return STATE.Detected[obj]
    end

    local highlight = Instance.new("Highlight")
    highlight.Name                = "DetectorHighlight"
    highlight.FillColor           = STATE.ESPColor
    highlight.OutlineColor        = STATE.ESPColor
    highlight.FillTransparency    = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee             = obj
    highlight.Parent              = obj

    local billboard = Instance.new("BillboardGui")
    billboard.Name                  = "DetectorBillboard"
    billboard.Size                  = UDim2.new(0, STATE.BillboardWidth, 0, STATE.BillboardHeight)
    billboard.AlwaysOnTop           = true
    billboard.StudsOffsetWorldSpace = Vector3.new(0, STATE.HeightOffset, 0)
    billboard.Adornee               = obj
    billboard.Parent                = obj

    local label = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3             = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
    label.Font                   = Enum.Font.GothamBold
    label.TextScaled             = false
    label.TextSize               = STATE.TextSize
    label.Text                   = obj.Name
    label.Parent                 = billboard

    STATE.Detected[obj] = {
        Highlight = highlight,
        Billboard = billboard,
        Label     = label,
        ClassName = obj.ClassName
    }
    return STATE.Detected[obj]
end

local function RemoveESP(obj)
    local data = STATE.Detected[obj]
    if not data then return end
    if data.Highlight then data.Highlight:Destroy() end
    if data.Billboard then data.Billboard:Destroy() end
    STATE.Detected[obj] = nil
end

local function CleanupAllESP()
    for obj in pairs(STATE.Detected) do
        RemoveESP(obj)
    end
end

--================================================================================
-- 🔍 スキャン（3方式 + Modelグループ化）
--================================================================================

-- Model化できるならModelを優先して親を返す
local function ResolveTargetObject(obj)
    if not STATE.GroupByModel then return obj end
    if obj:IsA("Model") then return obj end

    -- BasePartがModelに属するならModelを返す（Workspace直下ならPartのまま）
    local model = obj:FindFirstAncestorOfClass("Model")
    if model and model.Parent ~= Workspace then
        return model
    end
    return obj
end

local function ScanByRadius()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return {} end

    local scanR = math.max(STATE.ScanRadius, STATE.MaxDistance)
    return Workspace:GetPartBoundsInRadius(root.Position, scanR)
end

local function ScanByDescendant()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return {} end

    local scanR = math.max(STATE.ScanRadius, STATE.MaxDistance)
    local r2 = scanR * scanR
    local result = {}

    -- Workspace直下のModel/BasePartを走査（入れ子対応）
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local d = (obj.Position - root.Position).Magnitude
            if d <= scanR then
                table.insert(result, obj)
            end
        elseif obj:IsA("Model") then
            local pos = GetTargetPosition(obj)
            if pos and (pos - root.Position).Magnitude <= scanR then
                table.insert(result, obj)
            end
        end
    end
    return result
end

local function ScanForObjects()
    local raw = {}

    if STATE.ScanMethod == "RADIUS" then
        raw = ScanByRadius()
    elseif STATE.ScanMethod == "DESCENDANT" then
        raw = ScanByDescendant()
    else -- BOTH
        local a = ScanByRadius()
        local b = ScanByDescendant()
        local seen = {}
        for _, o in ipairs(a) do
            if not seen[o] then seen[o] = true table.insert(raw, o) end
        end
        for _, o in ipairs(b) do
            if not seen[o] then seen[o] = true table.insert(raw, o) end
        end
    end

    -- 🆕 Modelグループ化 + 重複排除
    local resolved = {}
    local seen = {}
    for _, obj in ipairs(raw) do
        local target = ResolveTargetObject(obj)
        if not seen[target] then
            seen[target] = true
            table.insert(resolved, target)
        end
    end

    local count = 0
    for _, obj in ipairs(resolved) do
        if count >= STATE.MaxObjects then break end
        if ShouldDetect(obj) then
            if not STATE.Detected[obj] then
                CreateESP(obj)
            end
            count = count + 1
        end
    end

    STATE.Count = count
end

