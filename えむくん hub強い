gucciData.setup = function()
    gucciData.spawnGucci()
    local playerName = gucciData.LP.Name
    local character = gucciData.LP.Character or gucciData.LP.CharacterAdded:Wait()
    local spawnedToysGroup = Workspace:FindFirstChild(playerName .. "SpawnedInToys")
    local blobman = spawnedToysGroup and spawnedToysGroup:FindFirstChild("CreatureBlobman")
    local head = blobman and blobman:FindFirstChild("Head")
    if head then
        head.CFrame = CFrame.new(0, 50000, 0)
        head.Anchored = true
    end
    task.wait(0.1)
    local humanoid = character:WaitForChild("Humanoid")
    local hrp = character:WaitForChild("HumanoidRootPart")
    local originalPos = hrp.Position
    local sitting = false
    local vehicleSeat = blobman and blobman:FindFirstChild("VehicleSeat")
    if vehicleSeat and vehicleSeat:IsA("VehicleSeat") then
        hrp.CFrame = vehicleSeat.CFrame + Vector3.new(0, 2, 0)
        vehicleSeat.Sit(humanoid)
        sitting = true
    end
    humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
        if sitting and humanoid.Jump then
            task.wait(0.02)
            hrp.CFrame = CFrame.new(originalPos)
            sitting = false
        end
    end)
    gucciData.ragdollConn = gucciData.RunService.Heartbeat:Connect(function()
        if gucciData.enabled and sitting then
            pcall(function()
                local ragdollRemoteLocal = gucciData.ReplicatedStorage:FindFirstChild("CharacterEvents") and gucciData.ReplicatedStorage.CharacterEvents:FindFirstChild("RagdollRemote")
                if ragdollRemoteLocal then
                    ragdollRemoteLocal:FireServer(Workspace[playerName].HumanoidRootPart, 0)
                end
            end)
        end
    end)
    gucciData.posCheckConn = gucciData.RunService.Heartbeat:Connect(function()
        if gucciData.enabled and (hrp.Position - originalPos).Magnitude < 1 then
            sitting = false
        end
    end)
end

