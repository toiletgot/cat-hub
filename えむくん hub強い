-- Anti Blob Kill
local antiBlobKillEnabled = false
local AntiBlobKillProc = false
local AntiBlobKillWalk = false
local struggleRemote = ReplicatedStorage:FindFirstChild("CharacterEvents") and ReplicatedStorage.CharacterEvents:FindFirstChild("Struggle")
local ragdollRemoteABK = ReplicatedStorage:FindFirstChild("CharacterEvents") and ReplicatedStorage.CharacterEvents:FindFirstChild("RagdollRemote")

local function FWCABK(Parent, Name, Time)
    return Parent:FindFirstChild(Name) or Parent:WaitForChild(Name, Time or 5)
end

local function setupAntiBlobKill(char)
    if not char or not antiBlobKillEnabled then return end
    
    local hrp = FWCABK(char, "HumanoidRootPart")
    local hum = FWCABK(char, "Humanoid")
    local head = FWCABK(char, "Head")

    head.ChildAdded:Connect(function(PartOwner)
        if PartOwner.Name == "PartOwner" then
            if not AntiBlobKillProc then
                AntiBlobKillProc = true
                hum.Sit = false
                if struggleRemote then struggleRemote:FireServer(LocalPlayer) end
                task.spawn(function()
                    while (head and head:FindFirstChild("PartOwner")) or LocalPlayer.IsHeld.Value do
                        if struggleRemote then struggleRemote:FireServer(LocalPlayer) end
                        if ragdollRemoteABK then ragdollRemoteABK:FireServer(hrp, 0) end
                        task.wait()
                    end
                end)
                hrp.Anchored = true
                if not AntiBlobKillWalk then
                    AntiBlobKillWalk = true
                    while LocalPlayer.IsHeld.Value and task.wait() do
                        hrp.CFrame = hrp.CFrame + hum.MoveDirection * 0.43
                    end
                end
                hrp.Anchored = false
                AntiBlobKillProc = false
                AntiBlobKillWalk = false
            end
        end
    end)

    local ragdolled = FWCABK(hum, "Ragdolled")
    ragdolled.Changed:Connect(function()
        if ragdolled.Value then
            for _, v in pairs(char:GetChildren()) do
                if v:IsA("BasePart") and v:FindFirstChild("BallSocketConstraint") and v.Name ~= "Head" then
                    v.BallSocketConstraint.Enabled = false
                    if v:FindFirstChild("RagdollLimbPart") then
                        v.RagdollLimbPart.WeldConstraint.Enabled = false
                    end
                end
            end
        end
    end)

    local weldHRP = FWCABK(hrp, "WeldHRP")
    weldHRP.Changed:Connect(function()
        if weldHRP.Enabled then
            while not hum.Sit do task.wait() end
            hum.Sit = false
            hum.AutoRotate = true
            hum.HipHeight = 1
            while weldHRP.Enabled and task.wait() do
                head.CFrame = hrp.CFrame + Vector3.new(0, 1.35, 0)
            end
            hum.HipHeight = 0
        end
    end)

    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") and v:FindFirstChild("BallSocketConstraint") and v.Name ~= "Head" then
            v.BallSocketConstraint.Enabled = false
            if v:FindFirstChild("RagdollLimbPart") then
                v.RagdollLimbPart.WeldConstraint.Enabled = false
            end
        end
    end
end

local function startAntiBlobKill()
    if LocalPlayer.Character then 
        setupAntiBlobKill(LocalPlayer.Character) 
    end
    LocalPlayer.CharacterAdded:Connect(function(char)
        AntiBlobKillProc = false
        AntiBlobKillWalk = false
        if antiBlobKillEnabled then
            task.defer(setupAntiBlobKill, char)
        end
    end)
end

