local SpamGroup = Tabs.SpamKick:AddLeftGroupbox("スパムキック")

local currentTarget = nil
local currentSpamTask = nil
local currentMainTask = nil
local currentBodyPosition = nil
local currentBodyGyro = nil
local savedPosition = nil
local dragging = false
local grabStartTime = 0
local checkStartTime = 0
local isSpamActive = false
local noclipConnectionSpam = nil

local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
local setNetworkOwnerEvent = GrabEvents and GrabEvents:FindFirstChild("SetNetworkOwner")
local destroyGrabLineEvent = GrabEvents and GrabEvents:FindFirstChild("DestroyGrabLine")

local function SetNoclipSpam(enabled)
    if noclipConnectionSpam then
        noclipConnectionSpam:Disconnect()
        noclipConnectionSpam = nil
    end
    if enabled then
        noclipConnectionSpam = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end

local function SetNetworkOwnerForTarget(targetRoot)
    if not targetRoot or not setNetworkOwnerEvent then return end
    pcall(function()
        setNetworkOwnerEvent:FireServer(targetRoot, targetRoot.CFrame)
    end)
end

local function DoDestroyGrabLine(targetRoot)
    if not targetRoot or not destroyGrabLineEvent then return end
    pcall(function()
        destroyGrabLineEvent:FireServer(targetRoot)
    end)
end

local function CreateBodies(targetRoot, pos)
    if currentBodyPosition then
        currentBodyPosition:Destroy()
        currentBodyPosition = nil
    end
    if currentBodyGyro then
        currentBodyGyro:Destroy()
        currentBodyGyro = nil
    end
    
    currentBodyPosition = Instance.new("BodyPosition")
    currentBodyPosition.MaxForce = Vector3.new(1e8, 1e8, 1e8)
    currentBodyPosition.P = 100000
    currentBodyPosition.D = 1000
    currentBodyPosition.Position = pos
    currentBodyPosition.Parent = targetRoot
    
    currentBodyGyro = Instance.new("BodyGyro")
    currentBodyGyro.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
    currentBodyGyro.P = 100000
    currentBodyGyro.D = 1000
    currentBodyGyro.CFrame = CFrame.new(pos)
    currentBodyGyro.Parent = targetRoot
end

local function CleanupBodies()
    if currentBodyPosition then
        currentBodyPosition:Destroy()
        currentBodyPosition = nil
    end
    if currentBodyGyro then
        currentBodyGyro:Destroy()
        currentBodyGyro = nil
    end
end

local function StopAllSpam()
    isSpamActive = false
    if currentSpamTask then
        task.cancel(currentSpamTask)
        currentSpamTask = nil
    end
    if currentMainTask then
        task.cancel(currentMainTask)
        currentMainTask = nil
    end
    CleanupBodies()
    SetNoclipSpam(false)
    dragging = false
    grabStartTime = 0
    checkStartTime = 0
end

local function GetPlayerDisplayList()
    local opts = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(opts, p.DisplayName .. " (" .. p.Name .. ")")
        end
    end
    return opts
end

local function GetUserNameFromDisplay(displayString)
    if not displayString or displayString == "" then return nil end
    local startPos, endPos = string.find(displayString, "%(")
    if startPos then
        local userName = string.sub(displayString, startPos + 1, -2)
        return userName
    end
    return nil
end

