local ESPTab = Tabs.ESP
local ESPGroup = ESPTab:AddLeftGroupbox("ESP設定")

local espEnabled = false
local showIds = false
local espData = {}

local function cleanESP()
    for _, data in pairs(espData) do
        if data.highlight then data.highlight:Destroy() end
        if data.nameBillboard then data.nameBillboard:Destroy() end
        if data.idBillboard then data.idBillboard:Destroy() end
    end
    espData = {}
end

local function updateESP()
    if not espEnabled then
        cleanESP()
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local data = espData[player.UserId]
        if not data then
            data = {}
            espData[player.UserId] = data
        end

        local char = player.Character
        if char then
            if not data.highlight then
                local highlight = Instance.new("Highlight")
                highlight.Parent = char
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                data.highlight = highlight
            end

            if not data.nameBillboard then
                local bill = Instance.new("BillboardGui")
                bill.Name = "ESP_Name"
                bill.Size = UDim2.new(0, 200, 0, 50)
                bill.AlwaysOnTop = true
                bill.StudsOffset = Vector3.new(0, 3, 0)
                local label = Instance.new("TextLabel", bill)
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.TextScaled = true
                label.TextColor3 = Color3.fromRGB(255, 255, 255)
                label.Text = player.DisplayName
                local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                if head then
                    bill.Parent = head
                    data.nameBillboard = bill
                else
                    bill:Destroy()
                end
            end

            if showIds then
                if not data.idBillboard then
                    local bill = Instance.new("BillboardGui")
                    bill.Name = "ESP_ID"
                    bill.Size = UDim2.new(0, 200, 0, 30)
                    bill.AlwaysOnTop = true
                    bill.StudsOffset = Vector3.new(0, -2, 0)
                    local label = Instance.new("TextLabel", bill)
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.TextScaled = true
                    label.TextColor3 = Color3.fromRGB(255, 255, 0)
                    label.Text = "ID: " .. player.UserId
                    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    if head then
                        bill.Parent = head
                        data.idBillboard = bill
                    else
                        bill:Destroy()
                    end
                end
            else
                if data.idBillboard then
                    data.idBillboard:Destroy()
                    data.idBillboard = nil
                end
            end
        else
            if data.highlight then data.highlight:Destroy() end
            if data.nameBillboard then data.nameBillboard:Destroy() end
            if data.idBillboard then data.idBillboard:Destroy() end
            espData[player.UserId] = nil
        end
    end
end

ESPGroup:AddToggle("ESP_Toggle", {
    Text = "ESP 有効化 (ハイライト＆ネーム表示)",
