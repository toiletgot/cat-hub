gucciData.spawnGucci = function()
    local spawnToyRemote = gucciData.ReplicatedStorage:FindFirstChild("MenuToys") and gucciData.ReplicatedStorage.MenuToys:FindFirstChild("SpawnToyRemoteFunction")
    if spawnToyRemote then
        return spawnToyRemote:InvokeServer("CreatureBlobman", CFrame.new(0, 50000, 0) * CFrame.Angles(-0.7351, 0.9028, 0.6173), Vector3.new(0, 59.667, 0))
    end
