InvGroup:AddToggle("AntiFire", {
    Text = "Anti Fire",
    Default = false,
    Callback = function(v)
        local fireData = { p = LocalPlayer, rs = RunService, w = Workspace, mon = false, con = nil }
        local extinguishPart = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Hole") and Workspace.Map.Hole:FindFirstChild("PoisonBigHole") and Workspace.Map.Hole.PoisonBigHole:FindFirstChild("ExtinguishPart")
        if not extinguishPart then
            Library:Notify("ExtinguishPart not found", 3)
            return
        end
        local originalPos = extinguishPart.Position
        local function checkAndExtinguish()
            local char = fireData.p.Character or fireData.p.CharacterAdded:Wait()
            local hrp = char:WaitForChild("HumanoidRootPart")
            local fireLight = hrp:FindFirstChild("FireLight")
            local fireParticle = hrp:FindFirstChild("FireParticleEmitter")
            if fireLight or fireParticle then
                extinguishPart.CFrame = CFrame.new(hrp.Position)
                while (fireLight or fireParticle) and fireData.mon do
                    task.wait(0.1)
                    fireLight = hrp:FindFirstChild("FireLight")
                    fireParticle = hrp:FindFirstChild("FireParticleEmitter")
                    extinguishPart.CFrame = CFrame.new(hrp.Position)
                end
                extinguishPart.CFrame = CFrame.new(originalPos)
            end
        end
        fireData.mon = v
        if v then
            if not fireData.con then
                fireData.con = fireData.rs.Heartbeat:Connect(function()
                    if fireData.mon then checkAndExtinguish() end
                end)
            end
        else
            extinguishPart.CFrame = CFrame.new(originalPos)
            if fireData.con then
                fireData.con:Disconnect()
                fireData.con = nil
            end
        end
    end
})

