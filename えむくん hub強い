local function blobKillLoop()
    while blobkillLoopEnabled do
        local target = Players:FindFirstChild(blobkillTargetName)
        if not target then
            task.wait(0.5)
            continue
        end
        
        local targetChar = target.Character
        if not targetChar then
            task.wait(0.5)
            continue
        end
        
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetRoot then
            task.wait(0.5)
            continue
        end
        
        local myRoot = getLocalRootBK()
        if not myRoot then
            task.wait(0.5)
            continue
        end
        
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
        task.wait(0.1)
        
        local blob = getBlobmanBK()
        if not blob then
            blob = spawnBlobmanBK()
            if not blob then
                task.wait(0.5)
                continue
            end
        end
        
        if not sitOnBlobmanBK() then
            task.wait(0.5)
            continue
        end
        
        pcall(function()
            blobGrabBK(blob, targetRoot, "Left")
            task.wait(0.1)
            
            local ge = ReplicatedStorage:FindFirstChild("GrabEvents")
            if ge and ge:FindFirstChild("DestroyGrabLine") then
                ge.DestroyGrabLine:FireServer(targetRoot)
            end
            task.wait(0.1)
            
            blobGrabBK(blob, targetRoot, "Left")
            task.wait(0.1)
            
            blobGrabBK(blob, targetRoot, "Right")
            task.wait(0.1)
            
            blobDropBK(blob, targetRoot, "Left")
            task.wait(0.1)
            
            if ge and ge:FindFirstChild("DestroyGrabLine") then
                ge.DestroyGrabLine:FireServer(targetRoot)
            end
        end)
        
        destroyBlobmanBK()
        task.wait(0.3)
    end
end

