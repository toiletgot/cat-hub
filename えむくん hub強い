end

local function GrabReleaseV3(blob, targetPlayer)
    if not blob or not targetPlayer or not targetPlayer.Character or IsWhitelistedV3(targetPlayer) then return end
    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
    if not script then return end
    pcall(function()
        if script:FindFirstChild("CreatureGrab") then
            script.CreatureGrab:FireServer(blob.LeftDetector, targetRoot, blob.LeftDetector.LeftWeld)
        end
        if script:FindFirstChild("CreatureRelease") then
            script.CreatureRelease:FireServer(blob.LeftDetector.LeftWeld)
        end
    end)
end

local function KickBothV3(blob, targetPlayer)
    if not blob or not targetPlayer or not targetPlayer.Character or IsWhitelistedV3(targetPlayer) then return end
    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
    if not script or not script:FindFirstChild("CreatureGrab") then return end
    pcall(function()
        script.CreatureGrab:FireServer(blob.LeftDetector, targetRoot, blob.LeftDetector.LeftWeld)
        script.CreatureGrab:FireServer(blob.RightDetector, targetRoot, blob.RightDetector.RightWeld)
    end)
end

local function AnchorBlobV3(blob)
    if not blob then return end
    for _, part in ipairs(blob:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() part.Anchored = true end)
        end
    end
end

local function UnanchorBlobV3(blob)
    if not blob then return end
    for _, part in ipairs(blob:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() part.Anchored = false end)
        end
    end
end

local function DoGrabV3(targetPart)
    if not targetPart then return false end
    local grabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
    if not grabEvents then return false end
    pcall(function()
        if grabEvents:FindFirstChild("SetNetworkOwner") then
            grabEvents.SetNetworkOwner:FireServer(targetPart, CFrame.new(targetPart.Position))
        end
        if grabEvents:FindFirstChild("DestroyGrabLine") then
            grabEvents.DestroyGrabLine:FireServer(targetPart)
        end
    end)
    return true
end

local function KickAllV3()
    local allPlayers = GetNonWhitelistedPlayersV3()
    if #allPlayers == 0 then
        Library:Notify("キックできるプレイヤーがいません (ホワイトリスト確認)", 3)
        return
    end
    local blob = SpawnAndRideBlobmanV3()
    if not blob then
        Library:Notify("Blobmanに乗れませんでした", 3)
        return
    end
    task.wait(0.3)
    local myRoot = GetMyRootV3()
    if not myRoot then return end

    for _, target in ipairs(allPlayers) do
        local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            TeleportToTargetV3(targetRoot)
            SetNetworkOwnerV3(targetRoot)
            for j = 1, 3 do
                GrabReleaseV3(blob, target)
                if j < 3 then task.wait(0.08) end
            end
        end
    end

    myRoot.CFrame = CFrame.new(0, 100, 0)
    task.wait(0.1)
    AnchorBlobV3(blob)
    task.wait(0.1)

    local centerX, centerZ = 0, 0
    if placementModeV3 == "circle" then
        TeleportPlayersToPositionsV3(allPlayers, centerX, centerZ, 0, GetCirclePositionsV3, circleRadiusV3, #allPlayers)
    elseif placementModeV3 == "double" then
        TeleportPlayersToPositionsV3(allPlayers, centerX, centerZ, 0, GetDoubleCirclePositionsV3, innerRadiusV3, outerRadiusV3, #allPlayers)
    elseif placementModeV3 == "spiral" then
        TeleportPlayersToPositionsV3(allPlayers, centerX, centerZ, 0, GetSpiralPositionsV3, spiralStartV3, spiralEndV3, #allPlayers)
    end

    task.wait(0.1)
    for _, target in ipairs(allPlayers) do
        local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then DoGrabV3(targetRoot) end
    end
    task.wait(0.1)
    for _, target in ipairs(allPlayers) do
        local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then DoGrabV3(targetRoot) end
    end
    task.wait(0.3)
    for i = 1, 3 do
        for _, target in ipairs(allPlayers) do
            KickBothV3(blob, target)
        end
        if i < 3 then task.wait(0.08) end
    end
    task.wait(0.1)
    UnanchorBlobV3(blob)

    Library:Notify("Kick All v3 完了: " .. #allPlayers .. "人", 3)
end

