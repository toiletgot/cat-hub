-- =========================================================
-- ===== 🛠️ 演出用ギミック関数（サウンド＆画面揺らし） =====
-- =========================================================
local function playTpSound(hrp)
    if not _G.EnableSound then return end
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://200785210"
    sound.Volume = 1
    sound.Parent = hrp
    sound:Play()
    game:GetService("Debris"):AddItem(sound, 1)
end

local function shakeCamera()
    if not _G.EnableCamShake then return end
    local cam = workspace.CurrentCamera
    for i = 1, 4 do
        cam.CFrame = cam.CFrame * CFrame.new(math.random(-5,5)/10, math.random(-5,5)/10, 0)
        task.wait(0.02)
    end
end

-- =========================================================
-- ===== 🚀 核心：すべての設定が連動するTP処理コア =====
-- =========================================================
local function teleportCharacter(isLeft)
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        
        local horizontalMultiplier = isLeft and -_G.TpDistance or _G.TpDistance
        local offset = (hrp.CFrame.RightVector * horizontalMultiplier) + Vector3.new(0, _G.VerticalDistance, 0)
        
        hrp.CFrame = hrp.CFrame + offset
        
        playTpSound(hrp)
        shakeCamera()
    end
end

