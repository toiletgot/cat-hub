-- アニメーション
local function clickAnimate(button)
    button:TweenSize(UDim2.new(0.5, -4, 0.9, -4), "Out", "Quad", 0.05, true, function()
        button:TweenSize(UDim2.new(0.5, -2, 1, -4), "Out", "Quad", 0.05, true)
    end)
end

-- ボタンイベント
LeftBtn.MouseButton1Down:Connect(function()
    leftLooping = true
    teleportCharacter(true)
    clickAnimate(LeftBtn)
    if _G.AutoTp then
        task.spawn(function()
            while leftLooping and _G.AutoTp do
                task.wait(_G.AutoTpDelay)
                if leftLooping then teleportCharacter(true) end
            end
        end)
    end
end)
LeftBtn.MouseButton1Up:Connect(function() leftLooping = false end)

RightBtn.MouseButton1Down:Connect(function()
    rightLooping = true
    teleportCharacter(false)
    clickAnimate(RightBtn)
    if _G.AutoTp then
        task.spawn(function()
            while rightLooping and _G.AutoTp do
                task.wait(_G.AutoTpDelay)
                if rightLooping then teleportCharacter(false) end
            end
        end)
    end
end)
RightBtn.MouseButton1Up:Connect(function() rightLooping = false end)

-- PCユーザー用
local UserInputService = game:GetService("UserInputService")
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    local leftEnum = Enum.KeyCode[_G.LeftKey]
    local rightEnum = Enum.KeyCode[_G.RightKey]
    
    if input.KeyCode == leftEnum then
        teleportCharacter(true)
    elseif input.KeyCode == rightEnum then
        teleportCharacter(false)
    end
end)
