local function setupAntiKill(enabled)
    if enabled then
        if antiKillConnection then return end
        local hum = getHum()
        if not hum then return end
        local lastHealth = hum.Health
        antiKillConnection = RunService.Heartbeat:Connect(function()
            local currentHum = getHum()
            if currentHum then
                if currentHum.Health < lastHealth then
                    currentHum.Health = lastHealth
                else
                    lastHealth = currentHum.Health
                end
            end
        end)
    else
        if antiKillConnection then antiKillConnection:Disconnect(); antiKillConnection = nil end
    end
end

local function setupAntiRoga(enabled)
    if enabled then
        if antiRogaConnection then return end
        local lastPos = HRP() and HRP().Position or Vector3.new(0,0,0)
        antiRogaConnection = RunService.Heartbeat:Connect(function()
            local hrp = HRP()
            if hrp then
                if (hrp.Position - lastPos).Magnitude > 100 then
                    hrp.CFrame = CFrame.new(lastPos)
                end
                lastPos = hrp.Position
            end
        end)
