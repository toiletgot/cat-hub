local function SpawnItems(modelNames, position, countPerModel)
    for _, modelName in ipairs(modelNames) do
        local model = nil
        for _, container in pairs(ReplicatedStorage:GetChildren()) do
            local found = container:FindFirstChild(modelName)
            if found then model = found break end
        end
        if not model then
            model = Workspace:FindFirstChild(modelName)
        end
        if not model then continue end
        for i = 1, countPerModel do
            local clone = model:Clone()
            local offset = Vector3.new(math.random(-10, 10), 0, math.random(-10, 10))
            clone.Position = position + offset
            clone.Parent = Workspace
            task.wait(0.005)
        end
    end
end

-- 自動キック監視（Noob Hub スタイル）
local autoKickRunning = false
local autoKickThread = nil
local function StartAutoKickMonitor()
    if autoKickRunning then return end
    autoKickRunning = true
    autoKickThread = coroutine.create(function()
        while autoKickRunning do
            for userId, data in pairs(frozenPlayers) do
                local player = data.player
                if not player or not player.Character then
                    frozenPlayers[userId] = nil
                    continue
                end
                if tick() - data.frozenTime > 5 and player ~= LP then
                    pcall(function()
                        KickPlayerFromServer(player.Name)
                        frozenPlayers[userId] = nil
                    end)
                end
            end
            task.wait(0.5)
        end
        autoKickRunning = false
    end)
    coroutine.resume(autoKickThread)
end
local function StopAutoKickMonitor()
    autoKickRunning = false
    if autoKickThread then
        coroutine.close(autoKickThread)
        autoKickThread = nil
    end
end

-- ============================================
-- 【Aura 用】Lag Aura 関連
-- ============================================
local lagAuraEnabled = false
local lagAuraRange = 20
local lagAuraMonitor = {}  -- プレイヤー監視テーブル { [UserId] = { pos, time, inAir } }
local lagAuraConnection = nil

local function processLagAura()
    if not lagAuraEnabled then return end
    local myRoot = GetMyRoot()
    if not myRoot then return end
    local now = tick()
    local groundY = myRoot.Position.Y - 5

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        if not player.Character then continue end
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local dist = (hrp.Position - myRoot.Position).Magnitude
        if dist > lagAuraRange then
            lagAuraMonitor[player.UserId] = nil
            continue
        end

        pcall(function()
            local createLine = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")
            if createLine then
                createLine:FireServer(hrp, CFrame.new(hrp.Position) * CFrame.new(math.random(-100,100), 0, math.random(-100,100)))
            end
        end)

        local data = lagAuraMonitor[player.UserId]
        if not data then
            data = { pos = hrp.Position, time = now, inAir = false }
            lagAuraMonitor[player.UserId] = data
        else
            local moved = (hrp.Position - data.pos).Magnitude > 0.5
            if moved then
                data.pos = hrp.Position
                data.time = now
                data.inAir = (hrp.Position.Y > groundY + 3)
            else
                local elapsed = now - data.time
                local isInAir = (hrp.Position.Y > groundY + 3)
                if isInAir and elapsed >= 3 then
                    pcall(function() KickPlayerFromServer(player.Name) end)
                    lagAuraMonitor[player.UserId] = nil
                elseif not isInAir and elapsed >= 2 then
                    pcall(function() KickPlayerFromServer(player.Name) end)
                    lagAuraMonitor[player.UserId] = nil
                end
            end
        end
    end
end

local function toggleLagAura(state)
    lagAuraEnabled = state
    if state then
        if lagAuraConnection then lagAuraConnection:Disconnect() end
        lagAuraConnection = RunService.Heartbeat:Connect(function()
            task.spawn(processLagAura)
        end)
        OrionLib:MakeNotification({Name="Lag Aura", Content="有効化（近接プレイヤーにラグ＆自動キック）", Time=3})
    else
        if lagAuraConnection then lagAuraConnection:Disconnect(); lagAuraConnection = nil end
        lagAuraMonitor = {}
        OrionLib:MakeNotification({Name="Lag Aura", Content="無効化", Time=2})
    end
end

-- ============================================
-- 既存 Aura 処理（BlobmanAura, KickAura, KillAura, GrabAura など）
-- ============================================
local auraSettings = {
    Range = 20,
    Interval = 0.5,
    BlobmanAuraKick = false,
    BlobmanAuraKill = false,
    KickAura = false,
    KillAura = false,
    GrabKickAura = false,
    GrabKillAura = false
}
local auraConnection = nil
local lastAuraTime = 0

local function processAura()
    if not LP.Character then return end
    local myRoot = GetMyRoot()
    if not myRoot then return end
    local range = auraSettings.Range
    local players = getAllPlayers()
    for _, target in ipairs(players) do
        if not target.Character then continue end
        local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
        if not tRoot then continue end
        if (tRoot.Position - myRoot.Position).Magnitude > range then continue end
        local tHum = target.Character:FindFirstChildOfClass("Humanoid")
        if not tHum or tHum.Health <= 0 then continue end

        if auraSettings.BlobmanAuraKick then
            local blob = findBlobmanForLocalPlayer()
            if blob then
                blobKick(blob, tRoot, "Left")
                task.wait(0.05)
                blobKick(blob, tRoot, "Right")
            end
        end
        if auraSettings.BlobmanAuraKill then
            local blob = findBlobmanForLocalPlayer()
            if blob then
                pcall(function()
                    blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(blob.LeftDetector, tRoot, blob.LeftDetector.LeftWeld)
                    blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(blob.RightDetector, tRoot, blob.RightDetector.RightWeld)
                    task.wait(0.1)
                    tHum.Health = 0
                end)
            end
        end
        if auraSettings.KickAura then
            DoGrab(tRoot)
        end
        if auraSettings.KillAura then
            tHum.Health = 0
        end
        if auraSettings.GrabKickAura then
            pcall(function()
                ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                ReplicatedStorage.GrabEvents.DestroyGrabLine:FireServer(tRoot)
            end)
        end
        if auraSettings.GrabKillAura then
            pcall(function()
                ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                task.wait(0.05)
                tRoot:BreakJoints()
            end)
        end
    end
end

local function toggleAura(state)
    if state then
        if auraConnection then return end
        lastAuraTime = tick()
        auraConnection = RunService.Heartbeat:Connect(function()
            if tick() - lastAuraTime >= auraSettings.Interval then
                lastAuraTime = tick()
                task.spawn(processAura)
            end
        end)
    else
        if auraConnection then auraConnection:Disconnect(); auraConnection = nil end
    end
end

