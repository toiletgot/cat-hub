                        if GE.DestroyGrabLine then GE.DestroyGrabLine:FireServer(target.Character.HumanoidRootPart) end
                    end
                end)
                blobRoot.CFrame = SavedPos
                blobRoot.AssemblyLinearVelocity = Vector3.zero
            end
            orbitRunning = false
            OrionLib:MakeNotification({Name="Drift Kick", Content="終了", Time=2})
        end)
    end})

