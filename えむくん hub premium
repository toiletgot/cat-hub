-- 半透明青化
local blueEffectEnabled = false
local originalColors = {}
local blueEffectConnection = nil
local BLUE_COLOR = Color3.fromRGB(0, 100, 255)
local BLUE_TRANSPARENCY = 0.5

function toggleBlueEffect(state)
    blueEffectEnabled = state
    if state then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP then task.spawn(function() applyBlueEffectToPlayer(player) end) end
        end
        if blueEffectConnection then blueEffectConnection:Disconnect() end
        blueEffectConnection = Players.PlayerAdded:Connect(function(player)
            if player ~= LP then task.wait(0.5); applyBlueEffectToPlayer(player) end
        end)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP then
                player.CharacterAdded:Connect(function()
                    task.wait(0.5)
                    if blueEffectEnabled then applyBlueEffectToPlayer(player) end
                end)
            end
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP then restorePlayerColors(player) end
        end
        if blueEffectConnection then blueEffectConnection:Disconnect(); blueEffectConnection = nil end
        originalColors = {}
    end
end
function applyBlueEffectToPlayer(player)
    if not player or player == LP then return end
    local char = player.Character
    if not char then return end
    local userId = player.UserId
    if not originalColors[userId] then originalColors[userId] = {} end
    local saved = originalColors[userId]
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if not saved[part] then saved[part] = {Color = part.Color, Transparency = part.Transparency} end
            part.Color = BLUE_COLOR
            part.Transparency = BLUE_TRANSPARENCY
        end
    end
end
function restorePlayerColors(player)
    if not player or player == LP then return end
    local userId = player.UserId
    local saved = originalColors[userId]
    if not saved then return end
    local char = player.Character
    if not char then return end
    for part, data in pairs(saved) do
        if part and part.Parent then
            pcall(function() part.Color = data.Color; part.Transparency = data.Transparency end)
        end
    end
    originalColors[userId] = nil
end

