-- [[ QUANTUM CORE SYSTEM v3.1 - SILENT & AUTOMATIC ]] --
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- 設定：すべて自動で常時ON
local infiniteJump = true
local godMode = true

-- ==========================================
--  システムロジック (UIなし・完全自動実行)
-- ==========================================

-- 無限ジャンプの物理処理
UserInputService.JumpRequest:Connect(function()
    if infiniteJump then
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if hrp and humanoid then
            -- ジャンプパワーの取得と適用
            local jumpPower = humanoid.UseJumpPower and humanoid.JumpPower or 50
            hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, jumpPower, hrp.AssemblyLinearVelocity.Z)
        end
    end
end)

-- キャラクターに対する無敵・即死防止処理
local function applyGodMode(character)
    if not godMode then return end
    
    local humanoid = character:WaitForChild("Humanoid", 5)
    if humanoid then
        -- 死亡ステートおよび落下ダメージ（FallingDown）などの危険なステートを強制無効化
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        
        -- ローカル側での体力クランプ（即死・落下死の瞬間的な判定を軽減）
        humanoid.HealthChanged:Connect(function(health)
            if godMode and health < humanoid.MaxHealth and health > 0 then
                humanoid.Health = humanoid.MaxHealth
            end
        end)
    end
end

-- 毎フレームの超高速監視（Healthの維持とステート固定）
RunService.Heartbeat:Connect(function()
    if godMode then
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- 常時ステートを上書きして死亡を阻止
            if humanoid:GetStateEnabled(Enum.HumanoidStateType.Dead) then
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            end
            
            -- 体力全回復
            if humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = humanoid.MaxHealth
            end
        end
    end
end)

-- 初期キャラクターへの適用およびリスポーン時の自動再適用
if LocalPlayer.Character then
    task.spawn(applyGodMode, LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.spawn(applyGodMode, char)
end)
