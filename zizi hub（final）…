    {Vector3.new(-1,2,0), Vector3.new(1,2,0)}, {Vector3.new(-1,2,0), Vector3.new(-1,0,0)}, {Vector3.new(1,2,0), Vector3.new(1,0,0)},
    {Vector3.new(-1,0,0), Vector3.new(1,0,0)}, {Vector3.new(-1,0,0), Vector3.new(-1,-2,0)}, {Vector3.new(1,0,0), Vector3.new(1,-2,0)},
