KickTab:AddToggle({
    Name = "drift kick", Default = false,
    Callback = function(v)
        orbitRunning = v
        orbitCurrentLoopId = orbitCurrentLoopId + 1
        local myLoopId = orbitCurrentLoopId
        if not v then return end
        local target = Players:FindFirstChild(selectedActionTargetName)
        if target and target ~= LocalPlayer and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local blobman = nil
            local spawned = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
            if spawned then blobman = spawned:FindFirstChild("CreatureBlobman") end
            if not blobman then
                local mt = ReplicatedStorage:FindFirstChild("MenuToys")
                if mt and mt:FindFirstChild("SpawnToyRemoteFunction") then
                    mt.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", LocalPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0), Vector3.zero)
                    task.wait(0.8)
                    spawned = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                    blobman = spawned and spawned:FindFirstChild("CreatureBlobman")
                end
            end
            if blobman then
                local seat = blobman:FindFirstChild("VehicleSeat")
                if seat and LocalPlayer.Character:FindFirstChild("Humanoid") then seat:Sit(LocalPlayer.Character.Humanoid) end
                task.spawn(function()
                    local blobRoot = blobman:FindFirstChild("HumanoidRootPart") or blobman.PrimaryPart
                    local Det = blobman:FindFirstChild("RightDetector") or blobman:FindFirstChild("LeftDetector")
                    local Weld = Det and (Det:FindFirstChildWhichIsA("Weld") or Det:FindFirstChild("RigidConstraint"))
                    local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
                    local lastTime = tick()
                    while orbitRunning and blobman and blobman.Parent do
                        if myLoopId ~= orbitCurrentLoopId or not target.Parent or not target.Character then break end
                        local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
                        if tRoot and blobRoot then
                            local dt = tick() - lastTime
                            lastTime = tick()
                            orbitAngle = orbitAngle + (orbitSpeed * dt)
                            local targetPos = tRoot.Position + Vector3.new(math.cos(orbitAngle)*orbitRadius, orbitHeightOffset, math.sin(orbitAngle)*orbitRadius)
                            blobRoot.CFrame = CFrame.new(targetPos, tRoot.Position)
                            pcall(function()
                                blobman.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(Det, tRoot, Weld)
                                GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                            end)
                        end
                        RunService.Heartbeat:Wait()
                    end
                end)
            end
        end
    end
})

