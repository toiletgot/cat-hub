-- モノクロエフェクト（黒・グレー・白を往復するストローク制御）
local function applyMonochromeGradientEffect()
    local CoreGui = game:GetService("CoreGui")
    local time = 0
    local strokes = {}
    
    local function register(obj) if obj:IsA("UIStroke") then table.insert(strokes, obj) end end
    local function scan(gui)
        for _, v in ipairs(gui:GetDescendants()) do register(v) end
        gui.DescendantAdded:Connect(register)
    end
    
    if LocalPlayer then
        scan(CoreGui)
        scan(LocalPlayer:WaitForChild("PlayerGui"))
    end
    
    local function getMonochromeColor(t)
        local customColors = { Color3.fromRGB(0,0,0), Color3.fromRGB(128,128,128), Color3.fromRGB(255,255,255) }
        local position = (math.sin(t * 2) + 1) / 2
        if position < 0.5 then
            return customColors[1]:Lerp(customColors[2], position * 2)
        else
            return customColors[2]:Lerp(customColors[3], (position - 0.5) * 2)
        end
    end
    
    RunService.RenderStepped:Connect(function(dt)
        time = time + dt * 0.5
        for i = #strokes, 1, -1 do
            local stroke = strokes[i]
            if stroke and stroke.Parent then stroke.Color = getMonochromeColor(time + (i * 0.01)) else table.remove(strokes, i) end
        end
    end)
end
pcall(applyMonochromeGradientEffect)

