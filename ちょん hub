-- 回転・配置システム（家対応 & 新形状拡張版）
local currentToys = {}
local isRotating = false
local rotationConn = nil
local lastTime = 0
local accumulatedTime = 0

local RotationConfig = {
    Radius = 8,
    Speed = 2.0,
    Height = 3.2,
    CurrentMode = "円形"
}

local function findToys()
    currentToys = {}
    local targetName = ObjectIDConfig.CurrentObjectID
    
    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if folder then
        for _, model in ipairs(folder:GetChildren()) do
            if model.Name == targetName then
                local primary = model:FindFirstChild("Handle") or model:FindFirstChild("Main") or model:FindFirstChildOfClass("BasePart")
                if primary then table.insert(currentToys, {Model = model, Primary = primary}) end
            end
        end
    end
    
    local plotItems = Workspace:FindFirstChild("PlotItems")
    if plotItems then
        for _, plot in ipairs(plotItems:GetChildren()) do
            local ownerAttr = plot:GetAttribute("Owner") or (plot:FindFirstChild("Owner") and plot.Owner.Value)
            if ownerAttr == LocalPlayer.Name or plot.Name == "PlayersInPlots" and plot:FindFirstChild(LocalPlayer.Name) or string.find(plot.Name, "^Plot") then
                for _, model in ipairs(plot:GetDescendants()) do
                    if model.Name == targetName and model:IsA("Model") then
                        local primary = model:FindFirstChild("Handle") or model:FindFirstChild("Main") or model:FindFirstChildOfClass("BasePart")
                        if primary then table.insert(currentToys, {Model = model, Primary = primary}) end
                    end
                end
            end
        end
    end
end

local function attachPhysics(part)
    if not part then return end
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("BodyPosition") or child:IsA("BodyGyro") then child:Destroy() end
    end
    local BP = Instance.new("BodyPosition")
    local BG = Instance.new("BodyGyro")
    BP.P = 50000; BP.D = 250; BP.MaxForce = Vector3.new(1e6,1e6,1e6)
    BG.P = 50000; BG.D = 250; BG.MaxTorque = Vector3.new(1e6,1e6,1e6)
    BP.Parent = part; BG.Parent = part
    return BP, BG
end

local function StopRotation()
    isRotating = false
    if rotationConn then rotationConn:Disconnect(); rotationConn = nil end
    for _, toy in ipairs(currentToys) do
        if toy.BP then toy.BP:Destroy() end
        if toy.BG then toy.BG:Destroy() end
    end
    currentToys = {}
end

local function StartRotation()
    if isRotating then StopRotation() end
    findToys()
    if #currentToys == 0 then
        OrionLib:MakeNotification({Name = "エラー", Content = "おもちゃが見つかりません", Time = 4})
        return
    end

    isRotating = true
    lastTime = tick()
    accumulatedTime = 0

    for _, toy in ipairs(currentToys) do
        local BP, BG = attachPhysics(toy.Primary)
        toy.BP = BP; toy.BG = BG
    end

    rotationConn = RunService.Heartbeat:Connect(function()
        if not isRotating then return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local now = tick()
        local dt = now - lastTime
        lastTime = now
        accumulatedTime = accumulatedTime + (dt * RotationConfig.Speed)

        local mode = RotationConfig.CurrentMode
        local total = #currentToys

        for i, toy in ipairs(currentToys) do
            if toy.Primary and toy.BP and toy.BG then
                local angle = accumulatedTime + (i * (2 * math.pi / total))
                local targetPos = root.Position
                local targetCFrame = root.CFrame

                if mode == "円形" then
                    local x = math.cos(angle) * RotationConfig.Radius
                    local z = math.sin(angle) * RotationConfig.Radius
                    targetPos = root.Position + Vector3.new(x, RotationConfig.Height, z)
                    targetCFrame = CFrame.new(targetPos, root.Position)
                elseif mode == "羽モード" then
                    local side = (i % 2 == 0) and 1 or -1
                    local wave = math.sin(accumulatedTime * 2 + i) * (RotationConfig.Height * 0.3)
                    targetPos = (root.CFrame * CFrame.new(side * (2 + i * (RotationConfig.Radius * 0.1)), wave, 2 + i * 0.5)).Position
                    targetCFrame = root.CFrame * CFrame.Angles(0, math.rad(90 * side), 0)
                elseif mode == "球体" then
                    local phi = math.acos(-1 + (2 * i) / total)
                    local theta = angle
                    local x = math.sin(phi) * math.cos(theta) * RotationConfig.Radius
                    local y = math.sin(phi) * math.sin(theta) * RotationConfig.Radius
                    local z = math.cos(phi) * RotationConfig.Radius
                    targetPos = root.Position + Vector3.new(x, RotationConfig.Height + y, z)
                    targetCFrame = CFrame.new(targetPos, root.Position)
                elseif mode == "観覧車" then
                    local y = math.cos(angle) * RotationConfig.Radius
                    local z = math.sin(angle) * RotationConfig.Radius
                    targetPos = (root.CFrame * CFrame.new(0, RotationConfig.Height + y, -z)).Position
                    targetCFrame = root.CFrame
                elseif mode == "大規模" then
                    local bigRadius = RotationConfig.Radius * 2.5
                    local x = math.cos(angle) * bigRadius
                    local z = math.sin(angle) * bigRadius
                    targetPos = root.Position + Vector3.new(x, RotationConfig.Height + math.sin(accumulatedTime) * 5, z)
                    targetCFrame = CFrame.new(targetPos, root.Position)
                elseif mode == "頭上固定" then
                    if i == 1 then
                        targetPos = root.Position + Vector3.new(0, RotationConfig.Height, 0)
                        targetCFrame = root.CFrame
                    else
                        targetPos = Vector3.new(0, -999, 0)
                    end
                elseif mode == "王冠（冠回転）" then
                    if i == 1 then
                        targetPos = root.Position + Vector3.new(0, RotationConfig.Height, 0)
                        targetCFrame = root.CFrame
                    else
                        local crownAngle = accumulatedTime * 1.5 + (i * (2 * math.pi / (total - 1)))
                        local x = math.cos(crownAngle) * (RotationConfig.Radius * 0.35)
                        local z = math.sin(crownAngle) * (RotationConfig.Radius * 0.35)
                        targetPos = root.Position + Vector3.new(x, RotationConfig.Height, z)
                        targetCFrame = CFrame.new(targetPos, root.Position + Vector3.new(0, RotationConfig.Height, 0))
                    end
                elseif mode == "らせん(螺旋)" then
                    local h = RotationConfig.Height + (i * (15 / total)) - 7.5
                    local r = RotationConfig.Radius * (1 - (i / (total * 2)))
                    local x = math.cos(angle) * r
                    local z = math.sin(angle) * r
                    targetPos = root.Position + Vector3.new(x, h, z)
                    targetCFrame = CFrame.new(targetPos, root.Position + Vector3.new(0, h, 0))
                elseif mode == "V字シールド" then
                    local spread = i - (total / 2)
                    targetPos = (root.CFrame * CFrame.new(spread * (RotationConfig.Radius * 0.4), RotationConfig.Height, -math.abs(spread) * 1.5)).Position
                    targetCFrame = root.CFrame
                elseif mode == "DNA二重らせん" then
                    local strand = (i % 2 == 0) and 1 or -1
                    local h = RotationConfig.Height + (i * (12 / total)) - 6
                    local dnaAngle = accumulatedTime + (i * (math.pi / total)) * 3
                    local x = math.cos(dnaAngle) * RotationConfig.Radius * strand
                    local z = math.sin(dnaAngle) * RotationConfig.Radius * strand
                    targetPos = root.Position + Vector3.new(x, h, z)
                    targetCFrame = CFrame.new(targetPos, root.Position + Vector3.new(0, h, 0))
                elseif mode == "無限インフィニティ" then
                    local t = angle * 2
                    local x = (math.cos(t) / (1 + math.sin(t)^2)) * RotationConfig.Radius * 1.5
                    local z = ((math.sin(t) * math.cos(t)) / (1 + math.sin(t)^2)) * RotationConfig.Radius * 1.5
                    targetPos = (root.CFrame * CFrame.new(x, RotationConfig.Height, -5 + z)).Position
                    targetCFrame = root.CFrame
                end

                toy.BP.Position = targetPos
                toy.BG.CFrame = targetCFrame
            end
        end
    end)
end

