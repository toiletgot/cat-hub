local isJumping = false
UserInputService.JumpRequest:Connect(function()
    isJumping = true
    if settings.infJump and player.Character then local hum = player.Character:FindFirstChildOfClass("Humanoid"); if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end end
end)

RunService.Stepped:Connect(function()
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if settings.flyEnabled then
            flyBV.Parent = hrp; flyBG.Parent = hrp; flyBG.CFrame = camera.CFrame
            local moveDir = hum.MoveDirection
            local flyVel = moveDir * settings.flySpeed
            if isJumping then flyVel = flyVel + Vector3.new(0, settings.flySpeed, 0); isJumping = false end
            flyBV.Velocity = flyVel.Magnitude > 0 and flyVel or Vector3.new(0, 0.1, 0)
            hum.PlatformStand = true
        else
            flyBV.Parent = nil; flyBG.Parent = nil
            if hum then hum.PlatformStand = false; hum.WalkSpeed = settings.speedEnabled and settings.customSpeed or 16; hum.JumpPower = settings.jumpEnabled and settings.customJump or 50 end
        end
    end
    camera.FieldOfView = settings.fov
end)

-- --- 物理計算（v10 Grad + v7 Modes） ---
local timeCounter = 0
RunService.Heartbeat:Connect(function()
    timeCounter = timeCounter + settings.speed
    
    -- パーツ自動登録
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                if (hrp.Position - player.Character.HumanoidRootPart.Position).Magnitude <= grabRange then
                    for _, part in ipairs(p.Character:GetChildren()) do
                        if part:IsA("BasePart") then registerPart(part) end
                    end
                end
            end
        end
    end

    local currentParts = {}
    for o in pairs(hoveringObjects) do 
        if o and o.Parent then table.insert(currentParts, o) else hoveringObjects[o] = nil end 
    end
    if #currentParts == 0 then return end

    -- ものおーる（v7ロジック優先）
    if monoAllEnabled then
        local others = {}
        for _, p in ipairs(Players:GetPlayers()) do if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then table.insert(others, p.Character.HumanoidRootPart) end end
        if #others > 0 then
            for i, o in ipairs(currentParts) do
                local force = o:FindFirstChild("SyncForce")
                if force then
                    local tHRP = others[(i % #others) + 1]
                    local pA = (timeCounter * monoAllSpeed) + (i * 0.5)
                    local tPos = tHRP.Position + Vector3.new(math.cos(pA)*5, math.sin(timeCounter*3+i)*2, math.sin(pA)*5)
                    force.Velocity = (tPos - o.Position) * 35
                end
            end
            return
        end
    end

    local tPlayer = flingAraEnabled and getNearestPlayer() or (presentEnabled and Players:FindFirstChild(selectedGiftTarget) or Players:FindFirstChild(selectedTargetName))
    local targetHRP = tPlayer and tPlayer.Character and tPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    for i, o in ipairs(currentParts) do
        local force = o:FindFirstChild("SyncForce")
        local gyro = o:FindFirstChild("SyncGyro")
        
        if force and gyro then
            local currentPos = o.Position
            local targetVel = Vector3.zero
            local angle = (timeCounter) + (i / #currentParts * math.pi * 2)

            -- Gradロジック（v10計算式）
            if grabEnabled then
                targetVel = (Vector3.new(posX, posY, posZ) - currentPos) * 35
            elseif mode ~= "None" and targetHRP then
                -- v7のモード計算を適用
                local tPos = nil
                if mode == "Spin" then tPos = targetHRP.Position + Vector3.new(math.cos(angle*2)*settings.width, math.sin(timeCounter*5+i)*(settings.width/2), math.sin(angle*2)*settings.width)
                elseif mode == "Orbit" then tPos = targetHRP.Position + Vector3.new(math.cos(angle)*settings.width, settings.height, math.sin(angle)*settings.width)
                elseif mode == "MagicCircle" then local x = math.sign(math.cos(angle))*math.pow(math.abs(math.cos(angle)),0.15)*(settings.width/2); local z = math.sign(math.sin(angle))*math.pow(math.abs(math.sin(angle)),0.15)*(settings.width/2); tPos = targetHRP.Position + Vector3.new(x, settings.height, z)
                elseif mode == "Ghost" then local t = timeCounter+(objectData[o] and objectData[o].seed or 0); tPos = targetHRP.Position + Vector3.new(math.sin(t*0.7)*settings.width, math.cos(t*0.5)*(settings.width*0.5)+settings.height, math.sin(t*0.3)*settings.width)
                elseif mode == "Manji" then local a = ((i-1)%4*math.pi/2) + (timeCounter*1.5); local r = math.min(1, math.floor((i-1)/4)/(math.max(1,#currentParts/4)*0.6+0.1)); tPos = targetHRP.Position + Vector3.new(math.cos(a)*(r*settings.width), settings.height, math.sin(a)*(r*settings.width))
                elseif mode == "Divine" then tPos = targetHRP.Position + Vector3.new(math.cos(angle)*settings.width, settings.height+math.sin(timeCounter+i), math.sin(angle)*settings.width)
                elseif mode == "Geometry" then local sA = timeCounter*1.5+(objectData[o] and objectData[o].phase or 0); local lA = ((i-1)%12/12)*math.pi*2+(timeCounter*0.2); tPos = targetHRP.Position + Vector3.new(math.cos(lA)*settings.width+math.cos(sA)*5, settings.height, math.sin(lA)*settings.width+math.sin(sA)*5)
                end
                if tPos then targetVel = (tPos - currentPos) * 35 end
            elseif flingAraEnabled and targetHRP then
                local fA = (timeCounter * 3) + angle
                local tPos = targetHRP.Position + Vector3.new(math.cos(fA)*3, math.sin(timeCounter*2+i)*2, math.sin(fA)*3)
                targetVel = (tPos - currentPos) * 40
            elseif presentEnabled and targetHRP then
                local pA = (timeCounter*(presentSpeed/10))+angle
                local tPos = targetHRP.Position + Vector3.new(math.cos(pA)*4, math.sin(timeCounter*2+i)*2, math.sin(pA)*4)
                targetVel = (tPos - currentPos) * presentFollowSpeed
            end

            -- 上下・カオス加算
            if slowUpEnabled then targetVel = targetVel + Vector3.new(0, 10, 0)
            elseif slowDownEnabled then targetVel = targetVel + Vector3.new(0, -10, 0) end
            
            if chaosEnabled then
                targetVel = targetVel + Vector3.new(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100))
                gyro.CFrame = CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)))
            else
                gyro.CFrame = targetHRP and CFrame.new(currentPos, targetHRP.Position) or CFrame.new(currentPos, currentPos + Vector3.new(0, 0, 1))
            end
            force.Velocity = targetVel
        end
    end
end)

