local function CalculateOffset(index, total, t, cfg, targetRoot)
    local r, h, s = cfg.Radius, cfg.Height, cfg.Speed
    local angle = (index * (math.pi * 2) / (total > 0 and total or 1)) + (t * (s / 5))
    local side = (index % 2 == 0) and 1 or -1
    local progress = index / (total > 0 and total or 1)
    
    -- 安全な四捨五入用の関数
    local function safeRound(val)
        return math.floor(val + 0.5)
    end

    if cfg.CurrentShape == "ハート" then
        local th = progress * math.pi * 2
        local x = 16 * math.sin(th)^3
        local z = -(13 * math.cos(th) - 5 * math.cos(2 * th) - 2 * math.cos(3 * th) - math.cos(4 * th))
        local rotX = x * math.cos(t * (s / 5)) - z * math.sin(t * (s / 5))
        local rotZ = x * math.sin(t * (s / 5)) + z * math.cos(t * (s / 5))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(rotX * (r/16), h, rotZ * (r/16)))
        
    elseif cfg.CurrentShape == "巨大球体" then
        local denom = (total - 1 > 0) and (total - 1) or 1
        local phi = math.acos(1 - 2 * (index - 1) / denom)
        local theta = math.pi * (1 + 5^0.5) * (index - 1) + (t * (s / 5))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.sin(phi) * math.cos(theta) * r, math.cos(phi) * r + h, math.sin(phi) * math.sin(theta) * r))

    elseif cfg.CurrentShape == "螺旋タワー" then
        local localAngle = progress * math.pi * 8 + (t * (s / 3))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(localAngle) * (r * (1 - progress * 0.5)), h + (progress * 30), math.sin(localAngle) * (r * (1 - progress * 0.5))))

    elseif cfg.CurrentShape == "無限大" then
        local th = progress * math.pi * 2 + (t * (s / 5))
        local denom = 1 + math.sin(th)^2
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new((r * math.cos(th)) / denom, h, (r * math.sin(th) * math.cos(th)) / denom))

    elseif cfg.CurrentShape == "星型" then
        local th = progress * math.pi * 2 + (t * (s / 5))
        local starRad = r * (0.6 + 0.4 * math.abs(math.sin(th * 2.5)))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(th) * starRad, h, math.sin(th) * starRad))

    elseif cfg.CurrentShape == "二重リング" then
        local half = (total / 2 > 0) and (total / 2) or 1
        local isInner = index <= half
        local localAngle = (index * (math.pi * 2) / half) + (t * (s / 5) * (isInner and 1 or -1))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(localAngle) * (isInner and r*0.5 or r), h, math.sin(localAngle) * (isInner and r*0.5 or r)))

    elseif cfg.CurrentShape == "トルネード" then
        local localAngle = progress * math.pi * 12 + (t * s)
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(localAngle) * (progress * r), h + (progress * 25), math.sin(localAngle) * (progress * r)))

    elseif cfg.CurrentShape == "立方体枠" then
        local chunks = math.ceil(total / 3)
        chunks = chunks > 0 and chunks or 1
        local seg = (index % chunks) / chunks * 2 - 1
        local size = r * 0.7
        local x, y, z = seg * size, h + (side == 1 and size or -size), seg * size
        if index <= chunks then x = size; z = (index/chunks * 2 - 1) * size
        elseif index <= chunks * 2 then z = size; x = ((index-chunks)/chunks * 2 - 1) * size end
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(x, y, z))

    elseif cfg.CurrentShape == "ピラミッド" then
        local localAngle = (index % 4) * (math.pi / 2) + (t * (s / 10))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(localAngle) * (r * (1 - progress)), h + (progress * r), math.sin(localAngle) * (r * (1 - progress))))

    elseif cfg.CurrentShape == "砂時計" then
        local p = progress * 2 - 1
        local localAngle = p * math.pi * 4 + (t * (s / 4))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(localAngle) * (math.abs(p) * r), h + (p * (r/2)), math.sin(localAngle) * (math.abs(p) * r)))

    elseif cfg.CurrentShape == "波打つ円盤" then
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(angle) * r, h + math.sin(progress * math.pi * 8 + (t * (s / 2))) * 5, math.sin(angle) * r))

    elseif cfg.CurrentShape == "クローバー" then
        local th = progress * math.pi * 2 + (t * (s / 5))
        local clovRad = r * math.abs(math.cos(2 * th))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(th) * clovRad, h, math.sin(th) * clovRad))

    elseif cfg.CurrentShape == "五芒星" then
        local th = progress * math.pi * 4 + (t * (s / 5))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(th) * r, h + (math.sin(th * 2) * 3), math.sin(th) * r))

    elseif cfg.CurrentShape == "UFO" then
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(angle) * r, h + (math.cos(angle * 3) * (r * 0.2)), math.sin(angle) * r))

    elseif cfg.CurrentShape == "万華鏡" then
        local modAngle = (index * math.pi * 4 / (total > 0 and total or 1)) + (t * (s / 3))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(modAngle) * (r * (0.5 + 0.5 * math.cos(angle * 3))), h + math.sin(t) * 2, math.sin(modAngle) * (r * (0.5 + 0.5 * math.cos(angle * 3)))))

    elseif cfg.CurrentShape == "らせん階段" then
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(progress * math.pi * 6 + (t * (s / 4))) * r, h + (progress * 15), math.sin(progress * math.pi * 6 + (t * (s / 4))) * r))

    elseif cfg.CurrentShape == "クロス星" then
        local axis = index % 4
        local dist = (progress * r)
        if axis == 0 then return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(dist, h, 0))
        elseif axis == 1 then return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(-dist, h, 0))
        elseif axis == 2 then return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(0, h, dist))
        else return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(0, h, -dist)) end

    elseif cfg.CurrentShape == "バタフライ" then
        local th = progress * math.pi * 2 + (t * (s / 5))
        local rad = r * (math.exp(math.cos(th)) - 2 * math.cos(4 * th) - math.sin(th / 12)^5) * 0.25
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.sin(th) * rad, h + (side * math.abs(math.cos(th)) * 3), math.cos(th) * rad))

    elseif cfg.CurrentShape == "アトム原子" then
        local sub = index % 3
        local localAngle = progress * math.pi * 6 + (t * (s / 3))
        local x, y, z = math.cos(localAngle) * r, h, math.sin(localAngle) * r
        if sub == 1 then return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(x, h + math.sin(localAngle) * r * 0.5, z * 0.5))
        elseif sub == 2 then return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(x * 0.5, h + math.cos(localAngle) * r * 0.5, z)) end
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(x, y, z))

    elseif cfg.CurrentShape == "DNAスパイラル" then
        local hPos = progress * (r * 1.5) - (r * 0.75)
        local dnaAngle = hPos * 0.5 + (t * (s / 3))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(dnaAngle + (side * math.pi)) * (r * 0.4), h + hPos, math.sin(dnaAngle + (side * math.pi)) * (r * 0.4)))

    elseif cfg.CurrentShape == "ハートタワー" then
        local layer = math.floor(progress * 4)
        local chunk = math.ceil(total / 4)
        chunk = chunk > 0 and chunk or 1
        local th = (index % chunk) / chunk * math.pi * 2 + (t * (s / 5))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(16 * math.sin(th)^3 * (r/24), h + (layer * 6), -(13 * math.cos(th) - 5 * math.cos(2 * th)) * (r/24)))

    elseif cfg.CurrentShape == "球体リング" then
        if progress <= 0.6 then
            local denom = math.ceil(total * 0.6) - 1
            denom = denom > 0 and denom or 1
            local phi = math.acos(1 - 2 * (index - 1) / denom)
            local theta = math.pi * (1 + 5^0.5) * (index - 1) + (t * (s / 5))
            return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.sin(phi) * math.cos(theta) * (r*0.6), math.cos(phi) * (r*0.6) + h, math.sin(phi) * math.sin(theta) * (r*0.6)))
        else
            local denom = math.ceil(total * 0.4)
            denom = denom > 0 and denom or 1
            local ringAngle = (index * (math.pi * 2) / denom) + (t * (s / 3))
            return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(ringAngle) * r, h, math.sin(ringAngle) * r))
        end

    elseif cfg.CurrentShape == "正八面体" then
        local section = index % 3
        local localDist = (progress * r)
        if section == 0 then return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(localDist * side, h, 0))
        elseif section == 1 then return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(0, h, localDist * side))
        else return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(0, h + localDist * side, 0)) end

    elseif cfg.CurrentShape == "円錐タワー" then
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(angle) * (r * (1 - progress)), h + (progress * r), math.sin(angle) * (r * (1 - progress))))

    elseif cfg.CurrentShape == "トーラスドーナツ" then
        local u = progress * math.pi * 2
        local v = angle
        local ringRad, tubeRad = r, r * 0.3
        local x = (ringRad + tubeRad * math.cos(v)) * math.cos(u)
        local z = (ringRad + tubeRad * math.cos(v)) * math.sin(u)
        local y = tubeRad * math.sin(v) + h
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(x, y, z))

    elseif cfg.CurrentShape == "メビウスの帯" then
        local u = progress * math.pi * 2
        local v = (side * 0.5) * (r * 0.4)
        local x = (r + v * math.cos(u / 2)) * math.cos(u)
        local z = (r + v * math.cos(u / 2)) * math.sin(u)
        local y = v * math.sin(u / 2) + h
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(x, y, z))

    elseif cfg.CurrentShape == "二十面体" then
        local phi = math.acos(1 - 2 * progress)
        local theta = angle * 2
        local snapX = safeRound(math.sin(phi) * math.cos(theta) * 5) / 5 * r
        local snapZ = safeRound(math.sin(phi) * math.sin(theta) * 5) / 5 * r
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(snapX, math.cos(phi) * r + h, snapZ))

    elseif cfg.CurrentShape == "二重螺旋円柱" then
        local yPos = progress * r - (r/2)
        local rot = yPos * 0.5 + (t * (s / 3)) + (side * math.pi)
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(rot) * r, h + yPos, math.sin(rot) * r))

    elseif cfg.CurrentShape == "クリスタル" then
        local localAngle = (index % 6) * (math.pi / 3) + (t * (s / 10))
        local factor = progress < 0.5 and (progress * 2) or (2 * (1 - progress))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(localAngle) * r * factor, h + (progress * r), math.sin(localAngle) * r * factor))

    elseif cfg.CurrentShape == "ダイヤモンドカット" then
        local hLevel = math.floor(progress * 5) / 5
        local localAngle = angle + (hLevel * math.pi)
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(localAngle) * (r * (1 - hLevel * 0.5)), h + hLevel * r, math.sin(localAngle) * (r * (1 - hLevel * 0.5))))

    elseif cfg.CurrentShape == "円柱ケージ" then
        local hLevel = math.floor(progress * 6) / 6 * r
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(angle) * r, h + hLevel, math.sin(angle) * r))

    elseif cfg.CurrentShape == "歪んだ立方体" then
        local th = angle + (progress * math.pi)
        local size = r * 0.7
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.clamp(math.cos(th)*size*2, -size, size), h + math.clamp(math.sin(th)*size*2, -size, size), side * size))

    elseif cfg.CurrentShape == "シリンダーウェーブ" then
        local yPos = progress * r
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(angle) * r, h + yPos + math.sin(angle * 3 + t * s) * 3, math.sin(angle) * r))

    elseif cfg.CurrentShape == "入れ子球体" then
        local chunk = math.ceil(total/2)
        chunk = chunk > 0 and chunk or 1
        local sphereRad = index <= chunk and r or (r * 0.5)
        local phi = math.acos(1 - 2 * (index % chunk) / chunk)
        local theta = angle
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.sin(phi)*math.cos(theta)*sphereRad, math.cos(phi)*sphereRad + h, math.sin(phi)*math.sin(theta)*sphereRad))

    elseif cfg.CurrentShape == "スパイク球" then
        local phi = math.acos(1 - 2 * progress)
        local theta = angle
        local spike = 1 + (0.3 * math.sin(phi * 10) * math.cos(theta * 10))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.sin(phi)*math.cos(theta)*r*spike, math.cos(phi)*r*spike + h, math.sin(phi)*math.sin(theta)*r*spike))

    elseif cfg.CurrentShape == "ギザギザリング" then
        local rAmp = r + (side * 4 * math.sin(t * s))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(angle) * rAmp, h, math.sin(angle) * rAmp))

    elseif cfg.CurrentShape == "同心円4重奏" then
        local q = math.floor(progress * 3.99) + 1
        local localAngle = angle * q
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(localAngle) * (r * (q/4)), h, math.sin(localAngle) * (r * (q/4))))

    elseif cfg.CurrentShape == "スクエアグリッド" then
        local grid = math.ceil(math.sqrt(total))
        grid = grid > 0 and grid or 1
        local localX = (index % grid) - (grid / 2)
        local localZ = math.floor(index / grid) - (grid / 2)
        local spacing = r / grid * 2
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(localX * spacing, h, localZ * spacing))

    elseif cfg.CurrentShape == "ヘキサゴン" then
        local hex = (index % 6) * (math.pi / 3) + (t * (s / 5))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(hex) * r, h, math.sin(hex) * r))

    elseif cfg.CurrentShape == "八芒星" then
        local oct = progress * math.pi * 2 + (t * (s / 5))
        local octRad = r * (0.7 + 0.3 * math.abs(math.sin(oct * 4)))
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(oct) * octRad, h, math.sin(oct) * octRad))

    elseif cfg.CurrentShape == "折り紙ツリー" then
        local tier = math.floor(progress * 3) / 3
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(angle) * r * (1 - tier), h + (tier * r), math.sin(angle) * r * (1 - tier)))

    elseif cfg.CurrentShape == "ファンブレード" then
        local chunk = math.ceil(total / 4)
        chunk = chunk > 0 and chunk or 1
        local blade = math.floor(progress * 4) * (math.pi / 2) + (t * s * 0.1)
        local dist = (index % chunk) / chunk * r
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(blade) * dist, h + (side * 2), math.sin(blade) * dist))

    elseif cfg.CurrentShape == "ローレンツアトラクタ" then
        local x, y, z = 0.1, 0.1, 0.1
        for i = 1, 15 + (index % 10) do
            local dx = 10 * (y - x)
            local dy = x * (28 - z) - y
            local dz = x * y - (8 / 3) * z
            x = x + dx * 0.01; y = y + dy * 0.01; z = z + dz * 0.01
        end
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(x * (r/20), h + (z * (r/20)) - 10, y * (r/20)))

    elseif cfg.CurrentShape == "ローゼンバーグ" then
        local a = angle + (t * s * 0.1)
        return targetRoot.CFrame:VectorToWorldSpace(Vector3.new(math.cos(a)*r, h + math.sin(a*4)*5, math.sin(a*2)*r*0.5))

    elseif cfg.CurrentShape == "ブラックホール" then
        local pull = 1 - progress
