-- ==========================================
-- Anti Gucci (Train) ロジック
-- ==========================================
local antiGucciConnectionTrain
local safePositionTrain
local restoreFramesTrain = 0
local autoGucciActiveTrain = false

local function safeResetPlayer()
	local p = game.Players.LocalPlayer
	local char = p and p.Character
	local hum = char and char:FindFirstChild("Humanoid")
	if hum then
		hum.Health = 0
	else
		if typeof(ResetPlayer) == "function" then
			pcall(function() ResetPlayer(p) end)
		elseif char then
			char:BreakJoints()
		end
	end
end

local function startAntiGucciTrain()
	local p = game.Players.LocalPlayer
	local character = p.Character or p.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")
	local rootPart = character:WaitForChild("HumanoidRootPart")
	safePositionTrain = rootPart.Position
	
	local mapFolder = workspace:FindFirstChild("Map")
	local folder = mapFolder and mapFolder:FindFirstChild("AlwaysHereTweenedObjects")
	local train = folder and folder:FindFirstChild("Train")
	local seat
	
	if train then
		for _, d in ipairs(train:GetDescendants()) do
			if d:IsA("Seat") then
				seat = d
				break
			end
		end
	end

	if seat then 
		rootPart.CFrame = seat.CFrame + Vector3.new(0, 2, 0) 
		seat:Sit(humanoid) 
	end
	
	humanoid:GetPropertyChangedSignal("Jump"):Connect(function() 
		if humanoid.Jump and humanoid.Sit then 
			restoreFramesTrain = 15 
			safePositionTrain = rootPart.Position 
		end 
	end)
	
	if antiGucciConnectionTrain then antiGucciConnectionTrain:Disconnect() end
	
	antiGucciConnectionTrain = game:GetService("RunService").Heartbeat:Connect(function()
		if not rootPart or not humanoid then return end
		
		local charEvents = game.ReplicatedStorage:FindFirstChild("CharacterEvents")
		local ragdollRemote = charEvents and charEvents:FindFirstChild("RagdollRemote")
		if ragdollRemote then
			pcall(function()
				ragdollRemote:FireServer(rootPart, 0)
			end)
		end
		
		if restoreFramesTrain > 0 then 
			rootPart.CFrame = CFrame.new(safePositionTrain) 
			restoreFramesTrain = restoreFramesTrain - 1 
		end
	end)
	
	task.spawn(function() 
		while humanoid and humanoid.Sit do 
			task.wait(1) 
		end 
		task.wait(0.5) 
		if rootPart then
			rootPart.CFrame = CFrame.new(safePositionTrain) 
		end
	end)
end

local function stopAntiGucciTrain()
	if antiGucciConnectionTrain then 
		antiGucciConnectionTrain:Disconnect() 
		antiGucciConnectionTrain = nil 
	end
	
	local mapFolder = workspace:FindFirstChild("Map")
	local trainFolder = mapFolder and mapFolder:FindFirstChild("AlwaysHereTweenedObjects")
	
	if trainFolder and trainFolder:FindFirstChild("Train") then 
		safeResetPlayer()
	end
end

