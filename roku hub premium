-- スパムキック実行処理 (遅延ゼロ・超即座固定版)
local function StartSpamKick()
    StopAll()
    
    if not currentTarget then 
        OrionLib:MakeNotification({Name = "エラー", Content = "ターゲットが選択されていません！", Time = 3})
        return 
    end
    
    isSpamActive = true
    orbitAngle = 0
    
    -- メインループを即座に起動（余計なウェイトを排除）
    currentSpamTask = task.spawn(function()
        local lastTime = tick()

        while isSpamActive do
            RunService.RenderStepped:Wait()
            if not isSpamActive then break end

            local currentTime = tick()
            local deltaTime = currentTime - lastTime
            lastTime = currentTime

            -- ターゲットの生存確認を最速で行う
            if currentTarget and currentTarget.Parent then
                local tChar = currentTarget.Character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChild("Humanoid")
                
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

                if tRoot and tHum and tHum.Health > 0 and myRoot then
                    -- ネットワークオーナーを毎フレーム奪取
                    ForceNetworkOwner(tRoot)

                    -- 物理的な速度を完全にリセット
                    pcall(function()
                        tRoot.AssemblyLinearVelocity = Vector3.zero
                        tRoot.AssemblyAngularVelocity = Vector3.zero
                    end)

                    -- 自分の頭上の位置を計算
                    local baseCFrame = myRoot.CFrame * CFrame.new(0, 12, 0)
                    local finalCFrame = baseCFrame

                    if isOrbitEnabled then
                        orbitAngle = orbitAngle + (deltaTime * orbitSpeed)
                        local offsetX = math.cos(orbitAngle) * orbitDistance
                        local offsetZ = math.sin(orbitAngle) * orbitDistance
                        finalCFrame = baseCFrame + Vector3.new(offsetX, 0, offsetZ)
                    end

                    -- タイムラグなしで即座にCFrameを強制固定
                    pcall(function()
                        tRoot.CFrame = finalCFrame
                    end)
                end
            else
                if not isAutoLoopActive then
                    break
                end
            end
        end
    end)
end

