                            if GE and grabRemote and dropRemote and ((lDet and lWeld) or (rDet and rWeld)) then
                                OrionLib:MakeNotification({ Name = "実行", Content = "ターゲットを追跡/キャッチします", Time = 2 })

                                local blobRoot = blobman:FindFirstChild("HumanoidRootPart") or blobman.PrimaryPart
                                local Det = rDet or lDet
                                local Weld = rWeld or lWeld
                                
                                local bringStart = tick()
                                while tick() - bringStart < 0.1 do
                                    if myLoopId ~= orbitCurrentLoopId or not orbitRunning or not blobman or not blobman.Parent then break end
                                    if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                                        local tRoot = target.Character.HumanoidRootPart
                                        
                                        -- 乗り物をターゲットの少し下に配置（重なり防止）
                                        blobRoot.CFrame = tRoot.CFrame * CFrame.new(0, -3, 0)
                                        blobRoot.AssemblyLinearVelocity = Vector3.zero
                                        
                                        pcall(function()
                                            if Det then grabRemote:FireServer(Det, tRoot, Weld) end
                                            GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                                            GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                                        end)
                                    end
                                    RunService.Heartbeat:Wait()
                                end
                                
                                if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                                    local SavedPos = target.Character.HumanoidRootPart.CFrame
                                    
                                    local lastTime = tick()
                                    local lastDropTime = tick()
                                    local dropCount = 0
                                    
                                    while orbitRunning and blobman and blobman.Parent and myLoopId == orbitCurrentLoopId do
                                        if not target or not target.Parent or not target.Character then break end
                                        
                                        local tChar = target.Character
                                        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
                                        local currentHum = tChar:FindFirstChild("Humanoid")
                                        
                                        if not currentHum or currentHum.Health <= 0 then 
                                            OrionLib:MakeNotification({ Name = "待機", Content = "ターゲットの死亡を検知。リスポーンを待っています...", Time = 3 })
                                            break 
                                        end
                                        
                                        if dropCount < 2 and (tick() - lastDropTime) > dropInterval then
                                            dropCount = dropCount + 1
                                            
                                            pcall(function()
                                                local currentWeld = Det:FindFirstChild("RightWeld") or Det:FindFirstChild("LeftWeld") or Det:FindFirstChildWhichIsA("Weld") or Det:FindFirstChild("RigidConstraint")
                                                if currentWeld then
                                                    dropRemote:FireServer(currentWeld)
                                                end
                                                GE.DestroyGrabLine:FireServer(tRoot)
                                            end)
                                            
                                            blobRoot.CFrame = SavedPos
                                            blobRoot.AssemblyLinearVelocity = Vector3.zero
                                            
                                            task.wait(0.1)
                                            
                                            local reCaptureStart = tick()
                                            while tick() - reCaptureStart < NKB_captureInterval do
                                                if myLoopId ~= orbitCurrentLoopId or not orbitRunning or not blobman or not blobman.Parent then break end
                                                if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                                                    local currentTRoot = target.Character.HumanoidRootPart
                                                    
                                                    -- 乗り物をターゲットの少し下に配置
                                                    blobRoot.CFrame = currentTRoot.CFrame * CFrame.new(0, -3, 0)
                                                    blobRoot.AssemblyLinearVelocity = Vector3.zero
                                                    
                                                    pcall(function()
                                                        if Det then grabRemote:FireServer(Det, currentTRoot, Weld) end
                                                        GE.CreateGrabLine:FireServer(currentTRoot, Vector3.zero, currentTRoot.Position, false)
                                                        GE.SetNetworkOwner:FireServer(currentTRoot, blobRoot.CFrame)
                                                    end)
                                                end
                                                RunService.Heartbeat:Wait()
                                            end
                                            
                                            lastTime = tick()
                                            lastDropTime = tick()
                                        end

                                        if tRoot and blobRoot then
                                            local currentTime = tick()
                                            local dt = currentTime - lastTime
                                            lastTime = currentTime

                                            -- 1. 高さとオフセットの計算
                                            local speed = NKB_speed * 0.2
                                            local amplitude = NKB_radius
                                            local heightBase = NKB_heightOffset
                                            
                                            local yOffset = heightBase + (math.sin(currentTime * speed) * amplitude)
                                            local localOffset = Vector3.new(0, yOffset, 0)

                                            -- 2. 自分の足元・頭上基準で位置を決定
                                            local myChar = LocalPlayer.Character
                                            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
                                            
                                            if myHRP then
                                                -- 乗り物の基準位置
                                                local targetPos = myHRP.CFrame * CFrame.new(localOffset)

                                                -- 乗り物の位置を更新
                                                blobRoot.CFrame = targetPos
                                                blobRoot.AssemblyLinearVelocity = Vector3.zero
                                                blobRoot.AssemblyAngularVelocity = Vector3.zero

                                                -- ターゲットの位置を乗り物の少し上（+3）にズラす
                                                local targetOffsetCFrame = targetPos * CFrame.new(0, 3, 0)
                                                tRoot.CFrame = targetOffsetCFrame
                                                tRoot.AssemblyLinearVelocity = Vector3.zero
                                                tRoot.AssemblyAngularVelocity = Vector3.zero

                                                pcall(function()
                                                    currentHum.PlatformStand = true
                                                    currentHum.Sit = true
                                                    GE.SetNetworkOwner:FireServer(tRoot, targetOffsetCFrame)
                                                    
                                                    local currentWeld = Det:FindFirstChild("RightWeld") or Det:FindFirstChild("LeftWeld") or Det:FindFirstChildWhichIsA("Weld") or Det:FindFirstChild("RigidConstraint")
                                                    if currentWeld then
                                                        dropRemote:FireServer(currentWeld)
                                                    end
                                                    
                                                    GE.DestroyGrabLine:FireServer(tRoot)
                                                    if Det then grabRemote:FireServer(Det, tRoot, Weld) end
                                                    GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, targetOffsetCFrame.Position, false)
                                                end)
                                            end
                                        end
                                        RunService.Heartbeat:Wait()
                                    end
                                    
                                    pcall(function()
                                        local currentWeld = Det:FindFirstChild("RightWeld") or Det:FindFirstChild("LeftWeld") or Det:FindFirstChildWhichIsA("Weld") or Det:FindFirstChild("RigidConstraint")
                                        if currentWeld then dropRemote:FireServer(currentWeld) end
                                        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                                            GE.DestroyGrabLine:FireServer(target.Character.HumanoidRootPart)
                                        end
                                    end)
                                end
                            else
                                OrionLib:MakeNotification({ Name = "エラー", Content = "必要なRemoteEventやDetectorが見つかりません", Time = 5 })
                                break
                            end
                        else
                            task.wait(1)
                        end
                    else
                        task.wait(0.5)
                    end
                else
                    task.wait(0.5)
                end
                RunService.Heartbeat:Wait()
            end
        end)
    end
})

