-- Grab Events の取得
local GrabEvents = ReplicatedStorage:WaitForChild("GrabEvents", 10)
local setNetworkOwnerEvent = GrabEvents and GrabEvents:WaitForChild("SetNetworkOwner", 5)
local destroyGrabLineEvent = GrabEvents and GrabEvents:WaitForChild("DestroyGrabLine", 5)

-- ネットワークオーナー強制奪取
local function ForceNetworkOwner(targetRoot)
    if not targetRoot or not targetRoot.Parent then return end
    pcall(function()
        if setNetworkOwnerEvent then
            setNetworkOwnerEvent:FireServer(targetRoot, targetRoot.CFrame)
        end
        if destroyGrabLineEvent then
            destroyGrabLineEvent:FireServer(targetRoot)
        end
    end)
end

-- すべての処理を完全に止める関数
local function StopAll()
    isSpamActive = false
    if currentSpamTask then 
        task.cancel(currentSpamTask) 
        currentSpamTask = nil 
    end
end

-- プレイヤー一覧の取得
local function GetPlayerDisplayList()
    local opts = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(opts, p.DisplayName .. " (" .. p.Name .. ")")
        end
    end
    if #opts == 0 then
        table.insert(opts, "プレイヤーがいません")
    end
    return opts
end

-- 表示名からユーザー名（Name）を抽出
local function GetUserNameFromDisplay(displayString)
    if not displayString or displayString == "" or displayString == "プレイヤーがいません" then return nil end
    local startPos = string.find(displayString, "%(")
    if startPos then
        return string.sub(displayString, startPos + 1, -2)
    end
    return nil
end

