	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
		LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = Value
	end
end})

-- 2. ジャンプ力
Tab3:AddSlider({Name = "ジャンプ力 (JumpPower)", Min = 50, Max = 500, Default = 50, Color = Color3.fromRGB(255,255,255), Callback = function(Value)
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.UseJumpPower = true
		hum.JumpPower = Value
	end
end})

-- 3. フライモード
Tab3:AddToggle({Name = "フライモード (空中自由飛行)", Default = false, Callback = function(Value)
	flying = Value
	local root = GetMyRoot()
	if flying and root then
		local bv = Instance.new("BodyVelocity")
		bv.Name = "RokuFlyBV"
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.new(0, 0, 0)
		bv.Parent = root
		
		task.spawn(function()
			while flying and root.Parent and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") do
				local cam = Workspace.CurrentCamera
				local moveDir = LocalPlayer.Character:FindFirstChildOfClass("Humanoid").MoveDirection
				if moveDir.Magnitude > 0 then
					bv.Velocity = cam.CFrame.LookVector * moveDir.Magnitude * flySpeed + Vector3.new(0, 0, 0)
				else
					bv.Velocity = Vector3.new(0, 0, 0)
				end
				task.wait()
			end
			if bv then bv:Destroy() end
		end)
	else
		if root and root:FindFirstChild("RokuFlyBV") then
			root.RokuFlyBV:Destroy()
		end
	end
end})

