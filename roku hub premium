RunService.Stepped:Connect(function()
    local character = game.Players.LocalPlayer.Character
    if not character then return end
    
    -- 壁抜け処理
    if NoclipEnabled then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    -- 壁のぼり処理（壁に接触中にWキーで上昇）
    if WallClimbEnabled then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {character}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude

            -- プレイヤーの前方にレイを飛ばして壁を検知
            local rayResult = workspace:Raycast(hrp.Position, hrp.CFrame.LookVector * 1.5, raycastParams)
            if rayResult then
                local UserInputService = game:GetService("UserInputService")
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    hrp.Velocity = Vector3.new(hrp.Velocity.X, 35, hrp.Velocity.Z) -- 上昇速度
                end
            end
        end
    end

    -- 画面ロックの維持（解除されないように強制適用）
    if MouseLockEnabled then
        game:GetService("UserInputService").MouseBehavior = Enum.MouseBehavior.LockCenter
    end
end)

