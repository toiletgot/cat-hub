--  掴む機能 (Grab)
-- ========================================================================
local grabEnabled = false
local grabTarget = nil
local grabDistance = 5
local grabHold = false

local function startGrab()
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = player.Character.HumanoidRootPart
    local found = workspace:GetPartBoundsInRadius(hrp.Position, grabDistance)
    for _, part in ipairs(found) do
        if part:IsA("BasePart") and not part.Anchored then
            local target = part.Parent:IsA("Model") and part.Parent or part
            if target:IsA("Model") and target:IsA("Workspace") then target = part end
            if not hoveringObjects[target] then
                registerPart(part)
                grabTarget = target
                grabHold = true
                return
            end
        end
    end
end

local function releaseGrab()
    grabHold = false
    if grabTarget then
        unregisterObject(grabTarget)
        grabTarget = nil
    end
end

-- 掴み続けるためのループ
RunService.Heartbeat:Connect(function()
    if grabEnabled and grabHold and grabTarget then
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp and grabTarget and grabTarget.Parent then
            local root = grabTarget:IsA("Model") and grabTarget.PrimaryPart or grabTarget
            if root and root:FindFirstChild("SyncForce") then
                local targetPos = hrp.Position + hrp.CFrame.LookVector * grabDistance
                root.SyncForce.Velocity = (targetPos - root.Position) * 50
            end
        else
            releaseGrab()
        end
    end
end)

