local frameCounter = 0
local lastValidPositions = {}
local positionStability = {}

-- 型崩れ防止のための安定化関数
local function stabilizePosition(obj, currentPos, targetPos)
    if not obj or not targetPos then return targetPos end
    local key = tostring(obj)
    local lastPos = lastValidPositions[key]
    local stability = positionStability[key] or 0
    
    if lastPos then
        local dist = (targetPos - lastPos).Magnitude
        -- 急激な移動（ラグによる型崩れ）を検出
        if dist > 50 then
            stability = stability + 1
            if stability > 5 then
                -- 異常な移動を検出したら、前回の有効な位置に戻す
                targetPos = lastPos
                stability = 0
            end
        else
            stability = math.max(0, stability - 0.5)
        end
    end
    
    positionStability[key] = stability
    lastValidPositions[key] = targetPos
    return targetPos
end

