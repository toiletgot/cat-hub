-- --- 便利関数 ---
local function getPlayerList()
    local list = {player.Name}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p.Name) end
    end
    return list
end

local function clearObjects()
    for obj in pairs(hoveringObjects) do
        pcall(function()
            if obj and obj.Parent then
                local parts = obj:IsA("Model") and obj:GetDescendants() or {obj}
                for _, p in ipairs(parts) do
                    if p:IsA("BasePart") then p.CanCollide = true end
                end
                local root = obj:IsA("Model") and obj.PrimaryPart or obj
                if root then
                    if root:FindFirstChild("SyncForce") then root.SyncForce:Destroy() end
                    if root:FindFirstChild("SyncGyro") then root.SyncGyro:Destroy() end
                end
            end
        end)
    end
    hoveringObjects = {}; objectData = {}
end

local function isPlayerPart(part)
    if not part or not part.Parent then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and part:IsDescendantOf(p.Character) then
            return true
        end
    end
    return false
end

local function isSelectableObject(part)
    if not part:IsA("BasePart") or part.Anchored then return false end
    if player.Character and part:IsDescendantOf(player.Character) then return false end
    if isPlayerPart(part) then return false end
    local ignoreNames = {"Baseplate", "Terrain", "SpawnLocation", "Sky", "Map", "Wall", "Floor", "Grid"}
    if table.find(ignoreNames, part.Name) then return false end
    local isOwner = false
    pcall(function() if part:GetNetworkOwner() == player then isOwner = true end end)
    if isOwner or part:FindFirstChild("creator") or part:GetAttribute("Creator") == player.UserId then 
        return true 
    end
    if part.Size.X > 30 or part.Size.Y > 30 or part.Size.Z > 30 then
        return false
    end
    return true
end

local function registerPart(part)
    if isSuikomiStopped then return end 
    if not part:IsA("BasePart") or part.Anchored then return end
    if not isSelectableObject(part) then return end
    local target = part.Parent:IsA("Model") and part.Parent or part
    if target:IsA("Model") and target:IsA("Workspace") then target = part end
    if hoveringObjects[target] then return end
    hoveringObjects[target] = true
    objectData[target] = { 
        seed = math.random() * 100, 
        phase = math.random() * math.pi * 2, 
        offsetZ = math.random(-5, 5),
        randX = math.random(-15, 15),
        randZ = math.random(-15, 15),
        fallSpeed = math.random(15, 30),
        id = tick() + math.random() -- 安定ソート用
    }
    local rootPart = part
    if target:IsA("Model") then
        if not target.PrimaryPart then target.PrimaryPart = part end
        rootPart = target.PrimaryPart
        for _, p in ipairs(target:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.Anchored = false 
                if p ~= rootPart and not p:FindFirstChildOfClass("WeldConstraint") then
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = rootPart
                    weld.Part1 = p
                    weld.Parent = p
                end
            end
        end
    else
        part.CanCollide = false
    end
    local bv = Instance.new("BodyVelocity")
    bv.Name = "SyncForce"; bv.MaxForce = Vector3.new(1,1,1)*1e7; bv.Velocity = Vector3.zero; bv.Parent = rootPart
    local bg = Instance.new("BodyGyro")
    bg.Name = "SyncGyro"; bg.MaxTorque = Vector3.new(1,1,1)*1e7; bg.Parent = rootPart
    pcall(function() rootPart:SetNetworkOwner(player) end)
end

