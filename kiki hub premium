local grabToggleStates = {Kill=false, Sky=false, Down=false, Stable=false}
local grabConnections = {}

local function handleGrabPart(model, mode)
    if model.Name == "GrabParts" then
        local part = model:FindFirstChild("GrabPart")
        if part and part:FindFirstChild("WeldConstraint") then
            local target = part.WeldConstraint.Part1
            if mode == "Kill" and target then target.Parent:BreakJoints(); return end
            local bv = Instance.new("BodyVelocity", part)
            if mode == "Sky" then bv.Velocity = Vector3.new(0,20,0)
            elseif mode == "Down" then bv.Velocity = Vector3.new(0,-20,0)
            else bv.Velocity = Vector3.new(0,0,0) end
            bv.MaxForce = Vector3.new(0,math.huge,0)
        end
    end
end

local function toggleGrab(flag, mode)
    if grabToggleStates[flag] then
        if grabConnections[flag] then grabConnections[flag]:Disconnect() end
        grabConnections[flag] = Workspace.ChildAdded:Connect(function(m) handleGrabPart(m, mode) end)
    elseif grabConnections[flag] then
        grabConnections[flag]:Disconnect(); grabConnections[flag] = nil
    end
end

