RunService.RenderStepped:Connect(function(dt)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if ufoSpinEnabled and #ufoHitboxes > 0 then
        ufoAngle = ufoAngle + dt * ufoSpinSpeed
        local count = #ufoHitboxes
        for i, hitbox in ipairs(ufoHitboxes) do
            if hitbox and hitbox.Parent then
                local offset = (i / count) * 2 * math.pi
                local x = math.sin(ufoAngle + offset) * ufoRadius
                local z = math.cos(ufoAngle + offset) * ufoRadius
                hitbox.CFrame = CFrame.new(hrp.Position + Vector3.new(x, ufoHeight, z))
            end
        end
    elseif ufoFollowEnabled and #ufoHitboxes > 0 then
        for _, hitbox in ipairs(ufoHitboxes) do
            if hitbox and hitbox.Parent then
                hitbox.CFrame = CFrame.new(hrp.Position + Vector3.new(0, ufoHeight + 3, 0))
            end
        end
    end
end)

-- ========== バリア破壊タブ ==========
local barrierRunning = false
local function executeBarrierBreak()
    if barrierRunning then return false end
    barrierRunning = true
    local success, err = pcall(function()
        local plotItems = Workspace:FindFirstChild("PlotItems")
        if plotItems and plotItems:FindFirstChild("PlayersInPlots") and plotItems.PlayersInPlots:FindFirstChild(player.Name) then
            OrionLib:MakeNotification({Name = "エラー", Content = "家の外で実行してください", Time = 3})
            return false
        end
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return false end
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        local origSpeed = hum.WalkSpeed
        local origPos = player.Character.HumanoidRootPart.CFrame
        hum.WalkSpeed = 0
        if not ReplicatedStorage:FindFirstChild("MenuToys") then hum.WalkSpeed = origSpeed; return false end
        ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("InstrumentWoodwindOcarina", CFrame.new(184.148834, -5.54824972, 498.136749), Vector3.new(0,34,0))
        task.wait(0.4)
        local folder = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
        local ocarina = folder and folder:FindFirstChild("InstrumentWoodwindOcarina")
        if not ocarina or not ocarina:FindFirstChild("HoldPart") then hum.WalkSpeed = origSpeed; return false end
        ocarina.HoldPart.HoldItemRemoteFunction:InvokeServer(ocarina, Workspace[player.Name])
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = CFrame.new(304.06, 25.77, 488.54)
        end
        task.wait(0.21)
        if folder and folder:FindFirstChild("InstrumentWoodwindOcarina") then
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(folder.InstrumentWoodwindOcarina)
        end
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = origPos
        end
        task.wait(0.7)
        ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("Campfire", CFrame.new(257.638672, -5.57392979, 450.103638), Vector3.new(0,161.972,0))
        task.wait(0.7)
        local folder2 = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
        if folder2 and folder2:FindFirstChild("Campfire") then
            hum.WalkSpeed = origSpeed
            OrionLib:MakeNotification({Name = "成功", Content = "Barrier破壊に成功！", Time = 5})
            return true
        end
        hum.WalkSpeed = origSpeed
        return false
    end)
    if not success then
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
        OrionLib:MakeNotification({Name = "エラー", Content = tostring(err), Time = 3})
    end
    barrierRunning = false
    return success
end

BarrierTab:AddButton({ Name = "Break Barrier (1回実行)", Callback = function() executeBarrierBreak() end })
