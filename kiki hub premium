local function spinKickLoop()
    if not kickTarget then return end
    isSpinning = true
    local savedPos = player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.CFrame or CFrame.identity
    local speed = _G.SpinSpeed or 15
    while isSpinning do
        if not blobman or not blobman.Parent then
            blobman = spawnBlobman()
            rideBlobman()
            if not blobman then break end
        end
        if not kickTarget or not kickTarget.Character then break end
        local tRoot = kickTarget.Character:FindFirstChild("HumanoidRootPart")
        if not tRoot then break end
        spinAngle = spinAngle + math.rad(speed * 2)
        if spinAngle > math.pi * 2 then spinAngle = spinAngle - math.pi * 2 end
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = player.Character.HumanoidRootPart
            myRoot.CFrame = CFrame.new(savedPos.Position) * CFrame.Angles(0, spinAngle, 0)
        end
        local distance = 8
        local targetPos = savedPos.Position + Vector3.new(math.sin(spinAngle)*distance, 0, math.cos(spinAngle)*distance)
        tRoot.CFrame = CFrame.new(targetPos)
        tRoot.AssemblyLinearVelocity = Vector3.zero
        tRoot.AssemblyAngularVelocity = Vector3.zero
        physicalKick(tRoot, 100, 50)
        local grabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
        if grabEvents and grabEvents:FindFirstChild("SetNetworkOwner") then
            pcall(function() grabEvents.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame) end)
        end
        RunService.Heartbeat:Wait()
    end
end

