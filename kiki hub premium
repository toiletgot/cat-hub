-- ========================================================================
--  メイン物理ループ（コンボ対応＋上限超過防止）
-- ========================================================================
RunService.Heartbeat:Connect(function()
    if mode == "None" and not presentEnabled and not monoAllEnabled then return end
    
    -- 現在の対象プレイヤー
    local targetPlayer = Players:FindFirstChild(targetPlayerName) or player
    local hrp = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- タイムカウンター更新
    timeNormal = timeNormal + settings.speed
    for i = 1, 8 do
        timeCounters[i] = timeCounters[i] + settings["comboSpeed" .. i]
    end

    -- スキャン＆吸い込み
    scanCooldown = scanCooldown + 0.05
    if scanCooldown >= 0.1 then
        scanCooldown = 0
        if not isSuikomiStopped then
            local foundParts = workspace:GetPartBoundsInRadius(hrp.Position, settings.wingRange)
            for _, p in ipairs(foundParts) do
                if isSelectableObject(p, targetPlayer.Character) then
                    local target = p.Parent:IsA("Model") and p.Parent or p
                    if target:IsA("Model") and target:IsA("Workspace") then target = p end
                    if not hoveringObjects[target] then 
                        registerPart(p) 
                    end
                end
            end
        end
    end

    -- 現在のオブジェクトリスト作成
    local currentObjects = {}
    for o in pairs(hoveringObjects) do
        local root = o:IsA("Model") and o.PrimaryPart or o
        if o and o.Parent and root and root:FindFirstChild("SyncForce") then
            table.insert(currentObjects, o)
        else
            hoveringObjects[o] = nil
            objectData[o] = nil
        end
    end

    -- 上限を超えたら解除
    if #currentObjects > maxObjects then
        for i = maxObjects + 1, #currentObjects do
            unregisterObject(currentObjects[i])
        end
        local newTable = {}
        for i = 1, maxObjects do table.insert(newTable, currentObjects[i]) end
        currentObjects = newTable
    end

    local total = #currentObjects
    if total == 0 then return end

    local lookCFrame = hrp.CFrame
    local flapWave = math.sin(tick() * settings.flapSpeed) * settings.flapStrength
    local invertMult = settings.invertDirection and -1.0 or 1.0

    -- 各コンボのアクティブ状態取得
    local comboModes = {}
    local comboCounts = {}
    for i = 1, 8 do
        comboModes[i] = settings["comboActive" .. i] and 
            ({comboMode1, comboMode2, comboMode3, comboMode4, comboMode5, comboMode6, comboMode7, comboMode8})[i] or "None"
        comboCounts[i] = settings["comboActive" .. i] and settings["comboCount" .. i] or 0
    end

    for i, obj in ipairs(currentObjects) do
        local root = obj:IsA("Model") and obj.PrimaryPart or obj
        if root and root:FindFirstChild("SyncForce") then
            local data = objectData[obj]
            local currentPos = root.Position
            local targetPos, rotCFrame

            if mode == "Combined" then
                local placed = false
                local runningSum = 0
                for cId = 1, 8 do
                    local prevSum = runningSum
                    runningSum = runningSum + comboCounts[cId]
                    if i <= runningSum and comboModes[cId] ~= "None" then
                        local idx = i - prevSum
                        targetPos, rotCFrame = calculatePosition(
                            comboModes[cId], idx, comboCounts[cId], hrp, data, timeCounters[cId],
                            lookCFrame, flapWave, invertMult,
                            settings["comboWidth" .. cId],
                            settings["comboHeight" .. cId],
                            settings["comboDensity" .. cId]
                        )
                        placed = true
                        break
                    end
                end
                if not placed then
                    unregisterObject(obj)
                    targetPos, rotCFrame = nil, nil
                end
            elseif presentEnabled then
                local target = Players:FindFirstChild(selectedGiftTarget)
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    local tHRP = target.Character.HumanoidRootPart
                    local pAngle = (timeNormal * (presentSpeed/10)) + (i / total * math.pi * 2)
                    targetPos = tHRP.Position + Vector3.new(math.cos(pAngle)*4, math.sin(timeNormal*2+i)*2, math.sin(pAngle)*4)
                    root.SyncForce.Velocity = (targetPos - currentPos) * presentFollowSpeed
                end
            elseif monoAllEnabled then
                local others = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        table.insert(others, p.Character.HumanoidRootPart)
                    end
                end
                if #others > 0 then
                    local tHRP = others[(i % #others) + 1]
                    local pAngle = (timeNormal * monoAllSpeed) + (i * 0.5)
                    targetPos = tHRP.Position + Vector3.new(math.cos(pAngle)*5, math.sin(timeNormal*3+i)*2, math.sin(pAngle)*5)
                    root.SyncForce.Velocity = (targetPos - currentPos) * 35
                end
            else
                targetPos, rotCFrame = calculatePosition(
                    mode, i, total, hrp, data, timeNormal,
                    lookCFrame, flapWave, invertMult,
                    settings.width, settings.height, settings.density
                )
            end

            if targetPos then
                root.SyncForce.Velocity = (targetPos - currentPos) * 25
            end
            if rotCFrame then
                root.SyncGyro.CFrame = rotCFrame
            end
            if math.random() > 0.85 then
                pcall(function() root:SetNetworkOwner(player) end)
            end
        end
    end
end)

-- キャラクター接触判定
local function connectCharacter(char)
    char:WaitForChild("HumanoidRootPart")
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("BasePart") then
            v.Touched:Connect(function(hit) 
                if mode ~= "None" or presentEnabled or monoAllEnabled then 
                    registerPart(hit) 
                end 
            end)
        end
    end
end
