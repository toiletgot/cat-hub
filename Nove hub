-- ──────────────────────────────────────────────
-- 攻撃関数テーブル (Aura / Loop から共通で使用)
-- ──────────────────────────────────────────────
local AttackFn = {
    kill = function(p)
        if not (p and p.Character) then return end
        local hrp   = p.Character:FindFirstChild("HumanoidRootPart")
        local torso = p.Character:FindFirstChild("Torso")
        pcall(function()
            if hrp then SNO(hrp) end
            if torso then
                SNO(torso)
                for _, m in pairs(torso:GetChildren()) do
                    if m:IsA("Motor6D") then m:Destroy() end
                end
                p.Character:BreakJoints()
            end
        end)
    end,

    sky = function(p, power)
        if not (p and p.Character) then return end
        local t = p.Character:FindFirstChild("Torso")
               or p.Character:FindFirstChild("HumanoidRootPart")
        if t then
            SNO(t)
            local bv = Instance.new("BodyVelocity", t)
            bv.Velocity = Vector3.new(0, power or 100, 0)
            bv.MaxForce = Vector3.one * math.huge
            Services.Debris:AddItem(bv, 3)
        end
    end,

    fling = function(p)
        if not (p and p.Character) then return end
        local t = p.Character:FindFirstChild("Torso")
        if t then
            SNO(t)
            local bv = Instance.new("BodyVelocity", t)
            bv.Velocity = Vector3.new(
                math.random(-1,1)*5e10, 5e15, math.random(-1,1)*5e10)
            bv.MaxForce = Vector3.one * math.huge
            Services.Debris:AddItem(bv, 2)
        end
    end,

    void = function(p)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            SNO(hrp)
            for _, part in ipairs(p.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
            Velocity(hrp, Vector3.new(0, -1000, 0))
        end
    end,

    spin = function(p, speed)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            SNO(hrp)
            local bav = Instance.new("BodyAngularVelocity", hrp)
            bav.AngularVelocity = Vector3.new(0, speed or 150, 0)
            bav.MaxTorque = Vector3.one * math.huge
            Services.Debris:AddItem(bav, 3)
        end
    end,

    freeze = function(p)
        if not (p and p.Character) then return end
        local t = p.Character:FindFirstChild("Torso")
               or p.Character:FindFirstChild("HumanoidRootPart")
        if t then
            SNO(t)
            local bp = Instance.new("BodyPosition", t)
            bp.Position  = t.Position
            bp.MaxForce  = Vector3.one * math.huge
            bp.P         = 1e6
            Services.Debris:AddItem(bp, 5)
        end
    end,

    poison = function(p)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp and #poisonHurtParts > 0 then
            SNO(hrp)
            for _, part in pairs(poisonHurtParts) do
                part.Size = Vector3.new(2, 2, 2)
                part.Transparency = 1
                part.Position = hrp.Position
            end
            task.wait()
            for _, part in pairs(poisonHurtParts) do
                part.Position = Vector3.new(0, -200, 0)
            end
        end
    end,

    ragdoll = function(p)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp and RagdollRemote then
            pcall(function() RagdollRemote:FireServer(hrp, 999999) end)
        end
    end,

    bring = function(p)
        if not (p and p.Character) then return end
        local hrp   = p.Character:FindFirstChild("HumanoidRootPart")
        local myR   = getRoot()
        if hrp and myR then
            SNO(hrp)
            hrp.CFrame = myR.CFrame + myR.CFrame.LookVector * 5
        end
    end,

    repel = function(p, force)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        local myR = getRoot()
        if hrp and myR then
            SNO(hrp)
            local dir = (hrp.Position - myR.Position).Unit
            local bv = Instance.new("BodyVelocity", hrp)
            bv.Velocity  = dir * (force or 100)
            bv.MaxForce  = Vector3.one * math.huge
            Services.Debris:AddItem(bv, 0.2)
        end
    end,

    magnet = function(p)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        local myR = getRoot()
        if hrp and myR then
            SNO(hrp)
            local dir = (myR.Position - hrp.Position).Unit
            local bv = Instance.new("BodyVelocity", hrp)
            bv.Velocity  = dir * 50
            bv.MaxForce  = Vector3.one * math.huge
            Services.Debris:AddItem(bv, 0.2)
        end
    end,
}

