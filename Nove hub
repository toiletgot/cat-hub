-- Gucci Anti (AntiGUCCI高速 移植)
-- ──────────────────────────────────────────────
local gucciAutoT        = false
local gucci_blobman     = nil
local gucci_lastSeat    = nil
local gucci_allowSeat   = false
local GUCCI_ANTI_DURATION = 3.2

local function gucci_getChar()
    return LP.Character or LP.CharacterAdded:Wait()
end
local function gucci_getBlobman()
    local f = Services.Workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
    return f and f:FindFirstChild("CreatureBlobman")
end
local function gucci_spawnBlobman()
    local char = gucci_getChar()
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    RS.MenuToys.SpawnToyRemoteFunction:InvokeServer(
        "CreatureBlobman",
        hrp.CFrame * CFrame.new(0, 0, -2),
        Vector3.new(0, -15.716, 0)
    )
    task.wait(0.25)
    gucci_blobman = gucci_getBlobman()
end
local function gucci_ensureBlobman()
    if not (gucci_blobman and gucci_blobman.Parent) then
        gucci_spawnBlobman()
    end
    return gucci_blobman
end
local function gucci_getPrimary()
    if not gucci_blobman then return end
    local p = gucci_blobman.PrimaryPart or gucci_blobman:FindFirstChildWhichIsA("BasePart")
    if p and not gucci_blobman.PrimaryPart then gucci_blobman.PrimaryPart = p end
    return p
end
local function gucci_seat_jump_ragdoll()
    local char = gucci_getChar()
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp and gucci_blobman) then return end
    local seat = gucci_blobman:FindFirstChildWhichIsA("VehicleSeat")
    if not seat then return end
    gucci_lastSeat = seat
    local rag = RS.CharacterEvents.RagdollRemote
    gucci_allowSeat = true
    for i = 1, 400 do
        pcall(function()
            if gucci_allowSeat and seat.Occupant ~= hum then
                seat:Sit(hum)
            end
            rag:FireServer(hrp, 0)
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    end
    gucci_allowSeat = false
end
local function gucci_runAnti(duration)
    local hrp   = gucci_getChar():FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local rag   = RS.CharacterEvents.RagdollRemote
    local start = tick()
    while gucciAutoT and tick() - start < duration do
        if not (gucci_blobman and gucci_blobman.Parent) then break end
        rag:FireServer(hrp, 0)
        task.wait(0.01)
    end
end
local function gucci_yeetUp()
    local p = gucci_getPrimary()
    if not p then return end
    pcall(function()
        RS.GrabEvents.SetNetworkOwner:FireServer(
            p, gucci_getChar().HumanoidRootPart.CFrame)
    end)
    if sethiddenproperty then
        sethiddenproperty(p, "NetworkIsSleeping", false)
    end
    for _, v in ipairs(gucci_blobman:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
    local pos = p.Position
    p.CFrame = CFrame.new(pos.X, pos.Y + 1e8, pos.Z)
end
local function gucci_clearAll()
    gucci_allowSeat = false
    if gucci_blobman then
        RS.MenuToys.DestroyToy:FireServer(gucci_blobman)
    end
    gucci_blobman  = nil
    gucci_lastSeat = nil
end
local function gucci_runOnce()
    gucciAutoT = true
    gucci_ensureBlobman()
    if not gucci_blobman then return end
    gucci_seat_jump_ragdoll()
    gucci_runAnti(GUCCI_ANTI_DURATION)
    gucci_yeetUp()
    task.delay(0.5, function()
        if gucci_lastSeat and gucci_lastSeat.Parent then
            gucci_lastSeat:Destroy()
        end
    end)
end

