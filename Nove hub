                                <= Vars.auraRadius then
                            local fpp = p.Character.HumanoidRootPart
                                    and p.Character.HumanoidRootPart:FindFirstChild("FirePlayerPart")
                            if fpp then
                                SNO(fpp)
                                if Vars.auraToggle == 1 then
                                    -- Silent mode: invisible platform
                                    if not Vars.platforms[p] then
                                        local platform = Instance.new("Part")
                                        platform.Name = "FloatingPlatform"
                                        platform.Size = Vector3.new(5, 2, 5)
                                        platform.Anchored = true
                                        platform.Transparency = 1
                                        platform.CanCollide = true
                                        platform.Parent = p.Character
                                        Vars.platforms[p] = platform
                                    end
                                else
                                    -- Sky mode: BodyVelocity
                                    if not fpp:FindFirstChild("KickAuraVel") then
                                        local bv = Instance.new("BodyVelocity")
                                        bv.Name = "KickAuraVel"
                                        bv.Velocity = Vector3.new(0, 20, 0)
                                        bv.MaxForce = Vector3.one * math.huge
                                        bv.Parent = fpp
                                    end
                                end
                            end
                        end
                    end
                end
                -- Update platform positions (Silent mode)
                if Vars.auraToggle == 1 then
                    for player, platform in pairs(Vars.platforms) do
                        if player.Character and player.Character:FindFirstChild("Humanoid")
                        and player.Character.Humanoid.Health > 1 then
                            local phrp = player.Character.HumanoidRootPart
                            platform.Position = phrp.Position - Vector3.new(0, 3.994, 0)
                        else
                            pcall(function() platform:Destroy() end)
                            Vars.platforms[player] = nil
                        end
                    end
                end
            end)
            task.wait(0.02)
        end
        -- Cleanup
        for _, plat in pairs(Vars.platforms) do pcall(function() plat:Destroy() end) end
        Vars.platforms = {}
    end)
end

