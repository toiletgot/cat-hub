local function blobMoveTo(part, x)
    for _, v in ipairs(part.Parent:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
    local pos = typeof(x) == "CFrame" and x.Position or x
    local b = Instance.new("BodyPosition")
    b.MaxForce = Vector3.one * math.huge
    b.Position = pos
    b.P = 2e4
    b.D = 5e3
    b.Parent = part
    task.spawn(function()
        b.ReachedTarget:Wait()
        pcall(game.Destroy, b)
        for _, v in ipairs(part.Parent:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = true end
        end
    end)
end

local function getBlobman()
    local inv = Services.Workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
    local v = inv and inv:FindFirstChild("CreatureBlobman")
    if v then
        if v.ClassName ~= "Model" then return false end
        if not v:FindFirstChild("VehicleSeat") then return false end
        return v
    end
    local result = nil
    pcall(function()
        for _, p in ipairs(Services.Workspace.PlotItems:GetChildren()) do
            local m = p:FindFirstChild("CreatureBlobman")
            if m and m:FindFirstChild("PlayerValue") and m.PlayerValue.Value == LP.Name then
                if m.ClassName == "Model" and m:FindFirstChild("VehicleSeat") then
                    result = m
                end
            end
        end
    end)
    return result
end

local function spawnBlobman()
    local r = getRoot()
    if r then
        pcall(function()
            Services.ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(
                "CreatureBlobman", r.CFrame, Vector3.zero)
        end)
    end
    task.wait(0.3)
    return getBlobman()
end

local function blobGrab(blob, target, side)
    pcall(function()
        local det  = blob:FindFirstChild(side .. "Detector")
        local weld = det and det:FindFirstChild(side .. "Weld")
        blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(det, target, weld)
    end)
end

local function blobDrop(blob, target, side)
    pcall(function()
        local det = blob:FindFirstChild(side .. "Detector")
        blob.BlobmanSeatAndOwnerScript.CreatureDrop:FireServer(det, target)
    end)
end

local function blobBring(blob, target, side)
    local r = getRoot()
    if not r then return end
    local pos = r.CFrame
    r.CFrame = target.CFrame
    task.wait(0.25)
    blobGrab(blob, target, side)
    task.wait(0.25)
    r.CFrame = pos
end

local function blobKick(blob, target, side)
    local r = getRoot()
    if not r then return end
    blobGrab(blob, r, side)
    task.wait(0.1)
    SetNetworkOwner:FireServer(target, r.CFrame)
    task.wait()
    target.CFrame = target.CFrame + Vector3.new(0, 16, 0)
    task.wait(0.1)
    pcall(function() DestroyLine:FireServer(target) end)
    blobGrab(blob, target, side)
end

local function blobIsFriend(p)
    if not p or not p.UserId then return false end
    return pcall(function() return LP:IsFriendsWith(p.UserId) end)
        and LP:IsFriendsWith(p.UserId)
end

local function blobIsInPlot(p)
    local v = p:FindFirstChild("InPlot")
    return v and v.Value
end

local function getPlayerFromName(name)
    local tplayer = nil
    local sname = name:lower()
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player.DisplayName:lower():sub(1, #sname) == sname then
            tplayer = player; break
        elseif player.Name:lower():sub(1, #sname) == sname then
            if not tplayer then tplayer = player end
        end
    end
    return tplayer
end

-- config テーブル
local blobCfg = {
    Target        = "",
    ArmSide       = "Left",
    Noclip        = false,
    GrabAura      = false,
    KickAura      = false,
    LoopKick      = false,
    LoopKickAll   = false,
    IgnoreFriend  = false,
    IgnoreIsInPlot = false,
    AuraRadius    = 28,
}

-- ──────────────────────────────────────────────
-- Blobman メインループ (Suisei Hub移植)
-- ──────────────────────────────────────────────
local blobLoopKickTimer = 0
local blobMainConn = nil

local function startBlobMainLoop()
    if blobMainConn then return end
    blobMainConn = Services.RunService.Heartbeat:Connect(function(dt)
        blobLoopKickTimer = blobLoopKickTimer + dt

        -- Noclip
        if blobCfg.Noclip then
            local blob = getBlobman()
            if blob then
                for _, v in ipairs(blob:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end

        -- Aura
        local r = getRoot()
        if r and getChar() then
            for _, v in ipairs(Services.Workspace:GetPartBoundsInRadius(r.Position, blobCfg.AuraRadius)) do
                if not v.Anchored and not v:IsDescendantOf(getChar()) then
                    local p = Services.Players:GetPlayerFromCharacter(v.Parent)
                    if blobIsFriend(p) and blobCfg.IgnoreFriend then continue end

                    -- Grab Aura
                    if blobCfg.GrabAura then
                        if v.Name ~= "HumanoidRootPart" or not getBlobman() then continue end
                        if p and blobCfg.IgnoreFriend and blobIsFriend(p) then continue end
                        if p and p == LP then continue end
                        local blob = getBlobman()
                        local side = (math.random() >= 0.5) and "Left" or "Right"
                        blobGrab(blob, v, side)
                    end

                    -- Kick Aura
                    if blobCfg.KickAura then
                        if not p then continue end
                        local hum = getHum()
                        if hum and hum.Sit then
                            if v.Name ~= "HumanoidRootPart" or not getBlobman() then continue end
                            local blob = getBlobman()
                            local side = (math.random() >= 0.5) and "Left" or "Right"
                            task.spawn(function() blobKick(blob, v, side) end)
                        end
                    end
                end
            end
        end

        -- LoopKick / LoopKickAll (1.5秒ごと)
        if blobLoopKickTimer >= 1.5 then
            if blobCfg.LoopKick then
                local target = getPlayerFromName(blobCfg.Target)
                local blob = getBlobman() or spawnBlobman()
                if target and blob then
                    local char = target.Character
                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local side = (math.random() >= 0.5) and "Left" or "Right"
                            local pos = getRoot() and getRoot().CFrame
                            task.wait(0.5)
                            if getRoot() then getRoot().CFrame = root.CFrame end
                            task.wait()
                            blobKick(blob, root, side)
                            task.wait(0.5)
                            if getRoot() then getRoot().CFrame = pos end
                        end
                    end
                end
            end

            if blobCfg.LoopKickAll then
                local blob = getBlobman() or spawnBlobman()
                if blob then
                    for _, p in ipairs(Services.Players:GetPlayers()) do
                        if p == LP then continue end
                        if not blobCfg.IgnoreIsInPlot and blobIsInPlot(p) then continue end
                        if blobCfg.IgnoreFriend and blobIsFriend(p) then continue end
                        if not p.Character then continue end
                        local root = p.Character:FindFirstChild("HumanoidRootPart")
                        if not root then continue end
                        local side = (math.random() >= 0.5) and "Left" or "Right"
                        local pos = getRoot() and getRoot().CFrame
                        task.wait(0.25)
                        if getRoot() then getRoot().CFrame = root.CFrame end
                        task.wait()
                        blobKick(blob, root, side)
                        task.wait(0.25)
                        if getRoot() then getRoot().CFrame = pos end
                    end
                end
            end

            blobLoopKickTimer = 0
        end
    end)
end

local function updateBlobLoop()
    if blobCfg.Noclip or blobCfg.GrabAura or blobCfg.KickAura
    or blobCfg.LoopKick or blobCfg.LoopKickAll then
        startBlobMainLoop()
    else
        if blobMainConn then blobMainConn:Disconnect(); blobMainConn = nil end
    end
end

