local function noclipGrabLoop()
    while true do
        pcall(function()
            local gp = Services.Workspace:FindFirstChild("GrabParts")
            if gp then
                local grabPart = gp:FindFirstChild("GrabPart")
                if grabPart and grabPart:FindFirstChild("WeldConstraint") then
                    local char = grabPart.WeldConstraint.Part1
                               and grabPart.WeldConstraint.Part1.Parent
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        while Services.Workspace:FindFirstChild("GrabParts") do
                            for _, p in pairs(char:GetChildren()) do
                                if p:IsA("BasePart") then p.CanCollide = false end
                            end
                            task.wait()
                        end
                        for _, p in pairs(char:GetChildren()) do
                            if p:IsA("BasePart") then p.CanCollide = true end
                        end
                    end
                end
            end
        end)
        task.wait()
    end
end

