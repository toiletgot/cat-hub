            OrionLib:MakeNotification({Name="❌ エラー", Content="Blobmanへの着席に失敗しました", Time=4})
            return false
        end
    end
    kickAuraV1_active = true
    kickAuraV1_ftapConn = Services.RunService.Heartbeat:Connect(function()
        if not kickAuraV1_active then return end
        bv1_executeFtap()
        bv1_stealNetworkOwnership()
    end)
    kickAuraV1_velConn = Services.RunService.Heartbeat:Connect(function()
        if not kickAuraV1_active then return end
        bv1_pullPlayers()
    end)
    OrionLib:MakeNotification({Name="▶ キックオーラ v1 オン", Content="FTAP 約60/秒 | NetworkSteal | 引き寄せ Y=2", Time=3})
    return true
end

local function kickAuraV1_stop()
    kickAuraV1_active = false
    if kickAuraV1_ftapConn then kickAuraV1_ftapConn:Disconnect(); kickAuraV1_ftapConn = nil end
    if kickAuraV1_velConn  then kickAuraV1_velConn:Disconnect();  kickAuraV1_velConn  = nil end
    bv1_clearAll()
    BlobmanBeta.destroyBlobman()
    OrionLib:MakeNotification({Name="⏹ キックオーラ v1 オフ", Content="FTAP停止", Time=2})
end


