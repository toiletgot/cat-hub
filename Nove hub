local function auraLoop(flagFn, action)
    task.spawn(function()
        while flagFn() do
            local root = getRoot()
            if root then
                for _, p in pairs(Services.Players:GetPlayers()) do
                    if p ~= LP and not isFriend(p) and p.Character then
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                            or p.Character:FindFirstChild("Torso")
                        if hrp and (hrp.Position - root.Position).Magnitude
                                <= Vars.auraRadius then
                            pcall(action, p)
                        end
                    end
                end
            end
            task.wait(Vars.auraSpeed)
        end
    end)
end

