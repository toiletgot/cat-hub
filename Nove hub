-- Anti Fire (Cosmic移植)
local antiFireConn = nil
local function setupAntiFire()
    local ep = pcall(function() return Services.Workspace.Map.Hole.PoisonBigHole.ExtinguishPart end)
        and Services.Workspace.Map.Hole.PoisonBigHole.ExtinguishPart
    if not ep then return end
    local origPos = ep.Position
    antiFireConn = Services.RunService.Heartbeat:Connect(function()
        if not Vars.antiFire then
            ep.CFrame = CFrame.new(origPos)
            antiFireConn:Disconnect(); antiFireConn = nil
            return
        end
        pcall(function()
            local root = getRoot()
            if root then
                local fl = root:FindFirstChild("FireLight")
                local fe = root:FindFirstChild("FireParticleEmitter")
                if fl or fe then
                    ep.CFrame = CFrame.new(root.Position)
                else
                    ep.CFrame = CFrame.new(origPos)
                end
            end
        end)
    end)
end

