-- BlobmanBeta: Ultra FTAP用関数群
local BlobmanBeta = {}
function BlobmanBeta.getLocalRoot() return getRoot() end
function BlobmanBeta.getLocalHum()  return getHum() end
function BlobmanBeta.getInv()
    return Services.Workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
end
function BlobmanBeta.SetNetworkOwner(part)
    pcall(function()
        SetNetworkOwner:FireServer(part, getRoot().CFrame)
    end)
end
function BlobmanBeta.ungrab(part)
    pcall(function() DestroyLine:FireServer(part) end)
end
function BlobmanBeta.getBlobman()
    local inv = BlobmanBeta.getInv()
    if inv then
        local v = inv:FindFirstChild("CreatureBlobman")
        if v and v:FindFirstChild("VehicleSeat") then return v end
    end
    for _, p in Services.Workspace.PlotItems:GetChildren() do
        local m = p:FindFirstChild("CreatureBlobman")
        if m and m:FindFirstChild("PlayerValue")
        and m.PlayerValue.Value == LP.Name then return m end
    end
    return nil
end
function BlobmanBeta.spawnBlobman()
    pcall(function()
        RS.MenuToys.SpawnToyRemoteFunction:InvokeServer(
            "CreatureBlobman", getRoot().CFrame, Vector3.zero)
    end)
    task.wait(0.5)
    return BlobmanBeta.getBlobman()
end
function BlobmanBeta.destroyBlobman()
    local blob = BlobmanBeta.getBlobman()
    if blob then pcall(function() DestroyToy:FireServer(blob) end) end
end
function BlobmanBeta.isSittingOnBlobman()
    local hum  = getHum()
    local blob = BlobmanBeta.getBlobman()
    if not hum or not blob or not blob:FindFirstChild("VehicleSeat") then return false end
    return hum.Sit and hum.SeatPart == blob.VehicleSeat
end
function BlobmanBeta.ensureSitBlobman()
    local blob = BlobmanBeta.getBlobman()
    if not blob or not blob:FindFirstChild("VehicleSeat") then return false end
    local hum = getHum()
    if hum and not hum.Sit then
        blob.VehicleSeat:Sit(hum)
        task.wait(0.3)
    end
    return BlobmanBeta.isSittingOnBlobman()
end
function BlobmanBeta.blobGrabFast(blob, target, side)
    if not blob then return false end
    local detector = blob:FindFirstChild(side .. "Detector")
    if not detector then return false end
    local weld = detector:FindFirstChild(side .. "Weld")
    if not weld then return false end
    local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript", true)
    if not script then return false end
    local remote = script:FindFirstChild("CreatureGrab")
    if remote then pcall(function() remote:FireServer(detector, target, weld) end); return true end
    return false
end
function BlobmanBeta.blobDropFast(blob, target, side)
    if not blob then return end
    local detector = blob:FindFirstChild(side .. "Detector")
    if not detector then return end
    local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript", true)
    if not script then return end
    local remote = script:FindFirstChild("CreatureDrop")
    if remote then pcall(function() remote:FireServer(detector, target) end) end
end
function BlobmanBeta.blobKickFast(blob, targetRoot, side)
    BlobmanBeta.blobGrabFast(blob, getRoot(), side)
    task.wait()
    BlobmanBeta.SetNetworkOwner(targetRoot)
    task.wait()
    targetRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 16, 0)
    task.wait()
    BlobmanBeta.ungrab(targetRoot)
    task.wait()
    BlobmanBeta.blobGrabFast(blob, targetRoot, side)
    task.wait()
    BlobmanBeta.blobDropFast(blob, targetRoot, side)
    task.wait()
    BlobmanBeta.ungrab(targetRoot)
end

-- BodyVelocity管理
local bv1_bodyVelocities = {}
local function bv1_addBodyVelocity(player, targetPos)
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    local existing = rootPart:FindFirstChild("FTAP_Velocity")
    if existing then existing:Destroy() end
    local bv = Instance.new("BodyVelocity")
    bv.Name = "FTAP_Velocity"
    bv.MaxForce = Vector3.new(100000, 100000, 100000)
    bv.Velocity = (targetPos - rootPart.Position).Unit * 150
    bv.Parent = rootPart
    bv1_bodyVelocities[player] = bv
    task.delay(3, function()
        if bv and bv.Parent then bv:Destroy(); bv1_bodyVelocities[player] = nil end
    end)
end
local function bv1_pullPlayers()
    local myRoot = getRoot()
    if not myRoot then return end
    local targetPos = Vector3.new(myRoot.Position.X, 2, myRoot.Position.Z)
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LP then
            local char = player.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            if rootPart and (rootPart.Position - targetPos).Magnitude <= 50 then
                bv1_addBodyVelocity(player, targetPos)
            end
        end
    end
end
local function bv1_clearAll()
    for _, bv in pairs(bv1_bodyVelocities) do
        pcall(function() if bv and bv.Parent then bv:Destroy() end end)
    end
    bv1_bodyVelocities = {}
end

-- NetworkOwner奪取
local function bv1_stealNetworkOwnership()
    local myRoot = getRoot()
    if not myRoot then return end
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LP then
            local char = player.Character
            local targetRoot = char and char:FindFirstChild("HumanoidRootPart")
            if targetRoot and (myRoot.Position - targetRoot.Position).Magnitude <= 30 then
                pcall(function() BlobmanBeta.SetNetworkOwner(targetRoot) end)
            end
        end
    end
end

-- FTAP実行
local function bv1_executeFtap()
    local myRoot = getRoot()
    if not myRoot then return end
    local blob = BlobmanBeta.getBlobman()
    if not blob then return end
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LP then
            local char = player.Character
            local targetRoot = char and char:FindFirstChild("HumanoidRootPart")
            if targetRoot and (myRoot.Position - targetRoot.Position).Magnitude <= 30 then
                pcall(function() BlobmanBeta.blobKickFast(blob, targetRoot, "Left") end)
            end
        end
    end
end

-- ループ管理
local kickAuraV1_active = false
local kickAuraV1_ftapConn = nil
local kickAuraV1_velConn  = nil

local function kickAuraV1_start()
    local blob = BlobmanBeta.getBlobman()
    if not blob then blob = BlobmanBeta.spawnBlobman() end
    if not blob then
        OrionLib:MakeNotification({Name="❌ エラー", Content="Blobmanの生成に失敗しました", Time=4})
        return false
    end
    if not BlobmanBeta.isSittingOnBlobman() then
        BlobmanBeta.ensureSitBlobman()
