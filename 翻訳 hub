-- 逆引き用
local CodeToName = {}
for name, code in pairs(FullLangTable) do
    CodeToName[code:lower()] = name
end

local LList = {}; for n,_ in pairs(FullLangTable) do table.insert(LList, n) end; table.sort(LList)

-- ===== クリップボードコピー関数 =====
local function copyToClipboard(text)
    if setclipboard then
        setclipboard(text)
        OrionLib:MakeNotification({
            Name = "コピー完了",
            Content = "クリップボードにコピーしました",
            Time = 2
        })
    end
end

-- ===== 万能翻訳関数 =====
local function translateExtended(text, from, to)
    if text == "" or not text then return nil, nil end
    local url = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=" 
                .. from .. "&tl=" .. to .. "&dt=t&q=" .. HttpService:UrlEncode(text)
    
    local response
    local success = pcall(function() response = game:HttpGet(url) end)
    
    if success and response then
        local data = HttpService:JSONDecode(response)
        if data and data[1] and data[1][1] then
            local translatedText = data[1][1][1]
            local det = data[3] or data[2] or "不明"
            
            if type(det) == "string" then
                det = det:lower():split("-")[1]
            else
                det = "unknown"
            end
            
            local detectedName = CodeToName[det] or det
            return translatedText, detectedName
        end
    end
    return nil, nil
end

-- ===== チャット送信 =====
local function sendChat(msg)
    pcall(function()
        local legacy = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
        if legacy and legacy:FindFirstChild("SayMessageRequest") then
            legacy.SayMessageRequest:FireServer(msg, "All")
        end
        local tcs = game:GetService("TextChatService")
        if tcs.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = tcs:FindFirstChild("RBXGeneral", true)
            if channel then channel:SendAsync(msg) end
        end
    end)
end

