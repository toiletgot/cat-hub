        if p ~= LocalPlayer and not Config.SelectedPlayers[p.Name] then
            Config.SelectedPlayers[p.Name] = false
            TargetTab:AddToggle({
                Name = p.Name,
                Default = false,
                Callback = function(v) Config.SelectedPlayers[p.Name] = v end
            })
        end
    end
end
Players.PlayerAdded:Connect(refreshTargets)
