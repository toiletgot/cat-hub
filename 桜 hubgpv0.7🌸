                local fixedCFrame = SH.FerrisWheelConfig.FixedDirection and CFrame.Angles(math.rad(SH.FerrisWheelConfig.FixedPitch), math.rad(SH.FerrisWheelConfig.FixedYaw), math.rad(SH.FerrisWheelConfig.FixedRoll)) or nil
