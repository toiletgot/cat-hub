    local SelectKickTab = Window:MakeTab({ Name = "セレクトKick", Icon = "rbxassetid://4483345998", PremiumOnly = false })
    local kickLoopEnabled = false
    local selectedKickPlayer = nil

    local function getPlayerTable()
