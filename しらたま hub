   Title.Font = Enum.Font.SourceSansBold
   Title.Parent = MainFrame

   local TitleCorner = Instance.new("UICorner")
   TitleCorner.CornerRadius = UDim.new(0, 12)
   TitleCorner.Parent = Title

   -- コンテンツエリア
   local ContentFrame = Instance.new("Frame")
   ContentFrame.Size = UDim2.new(1, -130, 1, -50)
   ContentFrame.Position = UDim2.new(0, 125, 0, 45)
   ContentFrame.BackgroundTransparency = 1
   ContentFrame.Parent = MainFrame

   -- Mainページ
   local MainPage = Instance.new("Frame")
   MainPage.Size = UDim2.new(1, 0, 1, 0)
   MainPage.BackgroundTransparency = 1
   MainPage.Visible = true
   MainPage.Parent = ContentFrame

   -- Combatページ
   local CombatPage = Instance.new("Frame")
   CombatPage.Size = UDim2.new(1, 0, 1, 0)
   CombatPage.BackgroundTransparency = 1
   CombatPage.Visible = false
   CombatPage.Parent = ContentFrame

   -- タブボタン
   local TabMainBtn = Instance.new("TextButton")
   TabMainBtn.Size = UDim2.new(1, -10, 0, 35)
   TabMainBtn.Position = UDim2.new(0, 5, 0, 10)
   TabMainBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
   TabMainBtn.Text = "🏠 Main"
   TabMainBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
   TabMainBtn.Font = Enum.Font.SourceSansBold
   TabMainBtn.TextSize = 14
   TabMainBtn.Parent = SideBar
   Instance.new("UICorner", TabMainBtn).CornerRadius = UDim.new(0, 6)

   local TabCombatBtn = Instance.new("TextButton")
   TabCombatBtn.Size = UDim2.new(1, -10, 0, 35)
   TabCombatBtn.Position = UDim2.new(0, 5, 0, 50)
   TabCombatBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
   TabCombatBtn.Text = "⚔️ Combat"
   TabCombatBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
   TabCombatBtn.Font = Enum.Font.SourceSansBold
   TabCombatBtn.TextSize = 14
   TabCombatBtn.Parent = SideBar
   Instance.new("UICorner", TabCombatBtn).CornerRadius = UDim.new(0, 6)

   TabMainBtn.MouseButton1Click:Connect(function()
      MainPage.Visible = true
      CombatPage.Visible = false
      TabMainBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
      TabMainBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
      TabCombatBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
      TabCombatBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
   end)

   TabCombatBtn.MouseButton1Click:Connect(function()
      MainPage.Visible = false
      CombatPage.Visible = true
      TabMainBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
      TabMainBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
      TabCombatBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
      TabCombatBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
   end)

   -- Mainページ: Infinite Jump
   local ToggleJump = Instance.new("TextButton")
   ToggleJump.Size = UDim2.new(1, 0, 0, 45)
   ToggleJump.Position = UDim2.new(0, 0, 0, 10)
   ToggleJump.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
   ToggleJump.Text = "Infinite Jump: OFF"
   ToggleJump.TextColor3 = Color3.fromRGB(255, 255, 255)
   ToggleJump.TextSize = 15
   ToggleJump.Font = Enum.Font.SourceSans
   ToggleJump.Parent = MainPage
   Instance.new("UICorner", ToggleJump).CornerRadius = UDim.new(0, 8)

   -- Combatページ: Aimbot ON/OFF
   local ToggleAimbot = Instance.new("TextButton")
   ToggleAimbot.Size = UDim2.new(1, 0, 0, 45)
   ToggleAimbot.Position = UDim2.new(0, 0, 0, 10)
   ToggleAimbot.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
   ToggleAimbot.Text = "Player Aimbot: OFF"
   ToggleAimbot.TextColor3 = Color3.fromRGB(255, 255, 255)
   ToggleAimbot.TextSize = 15
   ToggleAimbot.Font = Enum.Font.SourceSans
   ToggleAimbot.Parent = CombatPage
   Instance.new("UICorner", ToggleAimbot).CornerRadius = UDim.new(0, 8)

   -- Combatページ: 狙う部位の選択ボタン
   local ChangePartBtn = Instance.new("TextButton")
   ChangePartBtn.Size = UDim2.new(1, 0, 0, 45)
   ChangePartBtn.Position = UDim2.new(0, 0, 0, 65)
   ChangePartBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
   ChangePartBtn.Text = "Target Part: 体 (Torso)"
   ChangePartBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
   ChangePartBtn.TextSize = 15
   ChangePartBtn.Font = Enum.Font.SourceSans
   ChangePartBtn.Parent = CombatPage
   Instance.new("UICorner", ChangePartBtn).CornerRadius = UDim.new(0, 8)

   -- トグルイベント
   ToggleJump.MouseButton1Click:Connect(function()
      isInfiniteJumpEnabled = not isInfiniteJumpEnabled
      if isInfiniteJumpEnabled then
         ToggleJump.Text = "Infinite Jump: ON"
         ToggleJump.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
      else
         ToggleJump.Text = "Infinite Jump: OFF"
         ToggleJump.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
      end
   end)

   ToggleAimbot.MouseButton1Click:Connect(function()
      isAimbotEnabled = not isAimbotEnabled
      if isAimbotEnabled then
         ToggleAimbot.Text = "Player Aimbot: ON"
         ToggleAimbot.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
      else
         ToggleAimbot.Text = "Player Aimbot: OFF"
         ToggleAimbot.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
      end
   end)

   -- 部位切り替えロジック
   ChangePartBtn.MouseButton1Click:Connect(function()
      if aimPart == "HumanoidRootPart" then
         aimPart = "Head"
         ChangePartBtn.Text = "Target Part: 頭 (Head)"
         ChangePartBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50) -- 頭の時は赤っぽく
      else
         aimPart = "HumanoidRootPart"
         ChangePartBtn.Text = "Target Part: 体 (Torso)"
         ChangePartBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
      end
   end)

   -- 最小化キー機能 (左Controlキー)
   UserInputService.InputBegan:Connect(function(input, gameProcessed)
      if gameProcessed then return end
      if input.KeyCode == Enum.KeyCode.LeftControl then
         MainFrame.Visible = not MainFrame.Visible
      end
   end)

   -- 最寄りのプレイヤーを取得
   local function getClosestPlayer()
      local closestPlayer = nil
      local shortestDistance = math.huge
      
      for _, v in pairs(Players:GetPlayers()) do
         if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local distance = (player.Character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
            if distance < shortestDistance then
               closestPlayer = v
               shortestDistance = distance
            end
         end
      end
      return closestPlayer
   end

   -- 無限ジャンプ
   UserInputService.JumpRequest:Connect(function()
      if isInfiniteJumpEnabled then
         local character = player.Character
         local humanoid = character and character:FindFirstChildOfClass("Humanoid")
         if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
         end
      end
   end)

   -- エイムボット（選択されたターゲットの部位を追従）
   RunService.RenderStepped:Connect(function()
      if isAimbotEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
         local target = getClosestPlayer()
         if target and target.Character and target.Character:FindFirstChild(aimPart) then
            camera.CFrame = CFrame.new(camera.CFrame.Position, target.Character[aimPart].Position)
         end
      end
   end)
end

