-- 1. 状態管理
----------------------------------------------------------------

local controlling = false
local controlledMissiles = {} -- { {root=, mover=, alignMover=, attachment=}, ... }
local MAX_MISSILES = 10

local GRAB_RADIUS = 80          -- ★ 近く判定の半径（スタッド）
local CURRENT_SPEED = 20

local CAMERA_DISTANCE = 20
local cameraYaw = 0
local cameraPitch = -20
local currentYaw = 0
local currentPitch = -20
local CAMERA_SMOOTHNESS = 30
local CAMERA_SENSITIVITY = 1.0

local PLAYER_FIXED_POSITION = Vector3.new(460.4, 131.4, 202.7)
local savedPlayerCFrame = nil

----------------------------------------------------------------
-- ★ ミサイルの「機首の向き」補正
----------------------------------------------------------------
local NOSE_CORRECTION = CFrame.Angles(0, math.rad(-90), 0) * CFrame.Angles(math.rad(90), 0, 0)

----------------------------------------------------------------
-- ホワイトリスト
----------------------------------------------------------------

local GRABBABLE_NAMES = { BombMissile = true }

local function isGrabbable(part)
	if not part or not part:IsA("BasePart") then return false end
	if part.Anchored then return false end
	if GRABBABLE_NAMES[part.Name] then return true end
	local model = part:FindFirstAncestorOfClass("Model")
	if model and GRABBABLE_NAMES[model.Name] then return true end
	return false
end

----------------------------------------------------------------
-- 2. 近くのミサイル取得
----------------------------------------------------------------

local function isAlreadyControlled(root)
	for _, entry in ipairs(controlledMissiles) do
		if entry.root == root then return true end
	end
	return false
end

local function findNearbyMissiles()
	local char = player.Character
	if not char then return {} end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return {} end
	local origin = hrp.Position

	local results = {}
	local seen = {}

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and isGrabbable(obj) then
			local root = obj.AssemblyRootPart or obj
			if not seen[root] then
				seen[root] = true
				local dist = (root.Position - origin).Magnitude
				if dist <= GRAB_RADIUS and not isAlreadyControlled(root) then
					table.insert(results, { root = root, dist = dist })
				end
			end
		end
	end

	table.sort(results, function(a, b) return a.dist < b.dist end)

	local roots = {}
	for _, r in ipairs(results) do
		table.insert(roots, r.root)
	end
	return roots
end

----------------------------------------------------------------
-- 3. 三人称カメラ
----------------------------------------------------------------

local function updateThirdPersonCamera(dt)
	if #controlledMissiles == 0 then return end
	currentYaw = currentYaw + (cameraYaw - currentYaw) * math.clamp(dt * CAMERA_SMOOTHNESS, 0, 1)
	currentPitch = currentPitch + (cameraPitch - currentPitch) * math.clamp(dt * CAMERA_SMOOTHNESS, 0, 1)
	local yawRad = math.rad(currentYaw)
	local pitchRad = math.rad(currentPitch)
	local offset = Vector3.new(
		math.cos(pitchRad) * math.sin(yawRad),
		math.sin(pitchRad),
		math.cos(pitchRad) * math.cos(yawRad)
	) * CAMERA_DISTANCE
	local avgPos = Vector3.zero
	local count = 0
	for _, entry in ipairs(controlledMissiles) do
		if entry.root and entry.root.Parent then
			avgPos = avgPos + entry.root.Position
			count = count + 1
		end
	end
	if count == 0 then return end
	avgPos = avgPos / count
	camera.CFrame = CFrame.lookAt(avgPos + offset, avgPos)
end

----------------------------------------------------------------
-- 4. 開始/終了
----------------------------------------------------------------

local MAX_FORCE = 100000

local function destroyMissileEntry(entry)
	if entry.mover then entry.mover:Destroy() end
	if entry.alignMover then entry.alignMover:Destroy() end
	if entry.attachment then entry.attachment:Destroy() end
end

local function destroyAllMovers()
	for _, entry in ipairs(controlledMissiles) do
		destroyMissileEntry(entry)
	end
	controlledMissiles = {}
end

local function setRobloxJumpButtonVisible(visible)
	pcall(function()
		local touchGui = playerGui:FindFirstChild("TouchGui")
		if touchGui then
			local f = touchGui:FindFirstChild("TouchControlFrame")
			if f then
				local jb = f:FindFirstChild("JumpButton")
				if jb then jb.Visible = visible end
			end
		end
	end)
end

local function attachMoverToPart(root)
	local mover = Instance.new("BodyVelocity")
	mover.Name = "GrabMoveVelocity"
	mover.MaxForce = Vector3.new(MAX_FORCE, MAX_FORCE, MAX_FORCE)
	mover.P = 12500
	mover.Velocity = Vector3.zero
	mover.Parent = root

	local attachment = Instance.new("Attachment")
	attachment.Name = "GrabMoveAttachment"
	attachment.Parent = root

	local alignMover = Instance.new("AlignOrientation")
	alignMover.Name = "GrabMoveOrientation"
	alignMover.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignMover.Attachment0 = attachment
	alignMover.MaxTorque = 1000000
	alignMover.Responsiveness = 20
	alignMover.Parent = root

	return { root = root, mover = mover, alignMover = alignMover, attachment = attachment }
end

-- 近くのミサイルを上限まで全部掴む
local function grabNearbyMissiles()
	if #controlledMissiles >= MAX_MISSILES then
		return 0, "MAX"
	end

	local nearby = findNearbyMissiles()
	if #nearby == 0 then
		return 0, "NONE"
	end

	if #controlledMissiles == 0 then
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				savedPlayerCFrame = hrp.CFrame
				hrp.CFrame = CFrame.new(PLAYER_FIXED_POSITION)
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
		end

		cameraYaw = 0
		cameraPitch = -20
		currentYaw = 0
		currentPitch = -20
		camera.CameraType = Enum.CameraType.Scriptable
		controlling = true
		setRobloxJumpButtonVisible(false)
	end

	local added = 0
	for _, root in ipairs(nearby) do
		if #controlledMissiles >= MAX_MISSILES then break end
		table.insert(controlledMissiles, attachMoverToPart(root))
		added = added + 1
	end

	updateThirdPersonCamera(0)
	return added
end

local function stopControl()
	destroyAllMovers()
	if savedPlayerCFrame then
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.CFrame = savedPlayerCFrame
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
		end
		savedPlayerCFrame = nil
	end
	controlling = false
	camera.CameraType = Enum.CameraType.Custom
	setRobloxJumpButtonVisible(true)
end

