----------------------------------------------------------------
-- 8. トグル・追加・クリア
----------------------------------------------------------------

toggleButton.MouseButton1Click:Connect(function()
	if not controlling then
		local added, reason = grabNearbyMissiles()
		if added > 0 then
			toggleButton.Text = "操作: ON (" .. added .. ")"
			showControlUI(true)
			updateCountLabel()
			task.wait(1)
			toggleButton.Text = "操作: ON"
		else
			if reason == "MAX" then
				toggleButton.Text = "上限です"
			else
				toggleButton.Text = "近くに無し"
			end
			task.wait(1)
			toggleButton.Text = "操作: OFF"
		end
	else
		stopControl()
		toggleButton.Text = "操作: OFF"
		showControlUI(false)
		resetKnob()
	end
end)

addButton.MouseButton1Click:Connect(function()
	if not controlling then return end
	local added, reason = grabNearbyMissiles()
	updateCountLabel()
	if added > 0 then
		addButton.Text = added .. "個追加"
	else
		addButton.Text = (reason == "MAX") and "上限(10)" or "近くに無し"
	end
	task.wait(0.8)
	updateCountLabel()
end)

clearButton.MouseButton1Click:Connect(function()
	if not controlling then return end
	stopControl()
	toggleButton.Text = "操作: OFF"
	showControlUI(false)
	resetKnob()
end)

----------------------------------------------------------------
-- 9. 毎フレーム更新
----------------------------------------------------------------

RunService.Heartbeat:Connect(function(dt)
	if not controlling or #controlledMissiles == 0 then
		return
	end

	-- 消滅したミサイルを除去
	for i = #controlledMissiles, 1, -1 do
		local entry = controlledMissiles[i]
		if not entry.root or not entry.root.Parent then
			destroyMissileEntry(entry)
			table.remove(controlledMissiles, i)
		end
	end

	if #controlledMissiles == 0 then
		stopControl()
		toggleButton.Text = "操作: OFF"
		showControlUI(false)
		resetKnob()
		return
	end

	updateThirdPersonCamera(dt)
	local camCF = camera.CFrame

	local forwardVel = camCF.LookVector * CURRENT_SPEED
	local rightVel = camCF.RightVector * (stickInput.X * CURRENT_SPEED)
	local upVel = Vector3.new(0, 1, 0) * (-stickInput.Y * CURRENT_SPEED)
	local targetVel = forwardVel + rightVel + upVel

	local lookCFrame = nil
	if targetVel.Magnitude > 0.5 then
		lookCFrame = CFrame.lookAt(Vector3.zero, targetVel.Unit) * NOSE_CORRECTION
	end

	for _, entry in ipairs(controlledMissiles) do
		if entry.mover and entry.mover.Parent then
			entry.mover.MaxForce = Vector3.new(MAX_FORCE, MAX_FORCE, MAX_FORCE)
			entry.mover.Velocity = targetVel
		end
		if lookCFrame and entry.alignMover and entry.alignMover.Parent then
			entry.alignMover.CFrame = lookCFrame
		end
	end
end)
