-- ★すべての設定値を100%安全に適用する絶対座標エンジン
local function getUltimateGrid(s, pose, t)
    local w1 = math.sin(t * Config.MotionSpeed) * 0.18 * Config.MotionIntensity
    local w2 = math.sin(t * Config.MotionSpeed + Config.WavePhase) * 0.22 * Config.MotionIntensity
    local w3 = math.sin(t * Config.MotionSpeed + (Config.WavePhase * 2)) * 0.15 * Config.MotionIntensity

    -- 新設定2（上下ウネウネ）をY軸の揺れ（w1, w2, w3）にのみ乗算
    local vM = Config.VerticalMotion
    local yw1 = w1 * vM
    local yw2 = w2 * vM
    local yw3 = w3 * vM

    local b = Config.FingerBend
    local ps = Config.PoseStrength
    local len = Config.FingerLength
    
    local rotFold = CFrame.Angles(math.rad(105 * ps * b), 0, 0)
    local rotStraight = CFrame.Angles(math.rad(10 * b) + w1, 0, 0)
    local rotTip = CFrame.Angles(math.rad(25 * b) + w2, 0, 0)

    local thumb = rotStraight
    local index = rotStraight
    local middle = rotStraight
    local ring = rotStraight
    local pinky = rotStraight

    if tostring(pose) == "グー" then
        thumb = rotFold index = rotFold middle = rotFold ring = rotFold pinky = rotFold
    elseif tostring(pose) == "チョキ" then
        thumb = rotFold ring = rotFold pinky = rotFold
        index = rotStraight middle = rotStraight
    elseif tostring(pose) == "中指" then
        thumb = rotFold index = rotFold ring = rotFold pinky = rotFold
        middle = rotStraight
    elseif tostring(pose) == "人差し指で指す" then
        thumb = rotFold middle = rotFold ring = rotFold pinky = rotFold
        index = rotStraight
    end

    local sp = Config.FingerSpread
    local bw = Config.HandBackWidth
    local den = Config.HandDensity 
    local bW = Config.FingerBaseWidth -- 新設定1（根本の横幅）

    return {
        -- ■ 手の甲（ベース5ブロック）
        [1] = CFrame.new(0, Config.HandBackHeight, s * 1.5 * Config.HandBackZ * den),
        [2] = CFrame.new(-s * 1.0 * sp * bw * den, Config.HandBackHeight, s * 0.5 * Config.HandBackZ * den),
        [3] = CFrame.new(0, Config.HandBackHeight, s * 0.5 * Config.HandBackZ * den),
        [4] = CFrame.new(s * 1.0 * sp * bw * den, Config.HandBackHeight, s * 0.5 * Config.HandBackZ * den),
        [5] = CFrame.new(0, Config.HandBackHeight, -s * 0.5 * Config.HandBackZ * den),

        -- ■ 親指（3ブロック）
        [6] = CFrame.new(-s * 1.8 * sp * bW, 0, s * 0.2) * CFrame.Angles(0, math.rad(-35), 0),
        [7] = CFrame.new(-s * 2.5 * sp, -s * 0.2 + yw3, -s * 0.3 * len) * thumb,
        [8] = CFrame.new(-s * 3.1 * sp, -s * 0.5 + yw2, -s * 0.9 * len) * thumb * rotTip,

        -- ■ 人差し指（3ブロック）
        [9] = CFrame.new(-s * 1.2 * sp * bW, 0, -s * 1.2),
        [10] = CFrame.new(-s * 1.2 * sp, -s * 0.3, -s * 2.3 * len) * index,
        [11] = CFrame.new(-s * 1.2 * sp, -s * 0.8, -s * 3.3 * len) * index * rotTip,

        -- ■ 中指（3ブロック）
        [12] = CFrame.new(0, 0, -s * 1.5),
        [13] = CFrame.new(0, -s * 0.3, -s * 2.7 * len) * middle,
        [14] = CFrame.new(0, -s * 0.8, -s * 3.8 * len) * middle * rotTip,

        -- ■ 薬指（3ブロック）
        [15] = CFrame.new(s * 1.2 * sp * bW, 0, -s * 1.2),
        [16] = CFrame.new(s * 1.2 * sp, -s * 0.3, -s * 2.3 * len) * ring,
        [17] = CFrame.new(s * 1.2 * sp, -s * 0.8, -s * 3.3 * len) * ring * rotTip,

        -- ■ 小指（3ブロック）
        [18] = CFrame.new(s * 2.1 * sp * bW, 0, -s * 0.8) * CFrame.Angles(0, 0, math.rad(12)),
        [19] = CFrame.new(s * 2.4 * sp, -s * 0.3 + yw3, -s * 1.8 * len) * pinky,
        [20] = CFrame.new(s * 2.7 * sp, -s * 0.8 + yw1, -s * 2.7 * len) * pinky * rotTip
    }
end

-- 自作判定フィルター
local function isStrictlyMyPart(part)
    if not part:IsA("BasePart") then return false end
    if player.Character and part:IsDescendantOf(player.Character) then return false end
    
    if part:FindFirstChild("Owner") or part:FindFirstChild("Creator") then
        local ownerObj = part:FindFirstChild("Owner") or part:FindFirstChild("Creator")
        if ownerObj.Value == player or ownerObj.Value == player.Name or ownerObj.Value == tostring(player.UserId) then
            return true
        end
    end
    
    local current = part.Parent
    while current and current ~= workspace do
        local lowerName = current.Name:lower()
        if lowerName:find(player.Name:lower()) or lowerName:find(tostring(player.UserId)) then return true end
        current = current.Parent
    end
    return false
end

-- ポーズ変更強制関数
local function forcePoseChange(poseName)
    Config.CurrentPose = poseName
    for _, p in pairs(lockedParts) do
        if p and p.Parent then
            p.Anchored = false
        end
    end
end

-- メインループ
local function startPerfectHand()
    if heartbeatConnection then heartbeatConnection:Disconnect() end
    lockedParts = {}

    heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
        timeCounter = timeCounter + deltaTime
        
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local handCenterCFrame = hrp.CFrame * CFrame.new(Config.OffsetX, Config.Height, -Config.Distance)
        local gridOffsets = getUltimateGrid(Config.Scale, Config.CurrentPose, timeCounter)

        local parts = workspace:GetPartBoundsInRadius(hrp.Position, 250)
        local availableParts = {}
        
        for _, p in ipairs(parts) do
            if isStrictlyMyPart(p) then table.insert(availableParts, p) end
        end

        for i = 1, 20 do
            local targetPart = availableParts[i]
            local offsetCF = gridOffsets[i]
            
            if targetPart and targetPart.Parent and offsetCF then
                lockedParts[i] = targetPart
                targetPart.Anchored = true
                targetPart.CanCollide = false
                targetPart.CFrame = handCenterCFrame * offsetCF
            end
        end
    end)
end

local function stopPerfectHand()
    if heartbeatConnection then heartbeatConnection:Disconnect() heartbeatConnection = nil end
    for _, p in pairs(lockedParts) do
        if p and p.Parent then
            p.Anchored = false p.CanCollide = true
            p.AssemblyLinearVelocity = Vector3.new(0,0,0)
        end
    end
    lockedParts = {}
end

