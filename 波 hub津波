if not getgenv().Network then
    getgenv().Network = {
        BaseParts = {},
        Velocity = Vector3.new(14.46262424, 14.46262424, 14.46262424)
    }

    local function initNetwork()
        LocalPlayer.ReplicationFocus = Workspace
        RunService.Heartbeat:Connect(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
            for _, part in pairs(getgenv().Network.BaseParts) do
                if part:IsDescendantOf(Workspace) then
                    part.Velocity = getgenv().Network.Velocity
                end
            end
        end)
    end
    initNetwork()
end

local function AddPart(part)
    if part:IsA("BasePart") and not part.Anchored and part:IsDescendantOf(Workspace) then
        if part.Parent == LocalPlayer.Character or part:IsDescendantOf(LocalPlayer.Character) then
            return false
        end
        part.CanCollide = false
        part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
        if not table.find(trackedParts, part) then
            table.insert(trackedParts, part)
        end
        return true
    end
    return false
end

local function RemovePart(part)
    local index = table.find(trackedParts, part)
    if index then
        table.remove(trackedParts, index)
    end
end

for _, part in pairs(Workspace:GetDescendants()) do
    AddPart(part)
end

Workspace.DescendantAdded:Connect(AddPart)
Workspace.DescendantRemoving:Connect(RemovePart)

RunService.Heartbeat:Connect(function()
    if not isEnabled then return end

    local character = LocalPlayer.Character
    local head = character and character:FindFirstChild("Head")
    if not head then return end

    local headPos = head.Position

    for _, part in pairs(trackedParts) do
        if part.Parent and not part.Anchored then
            local partPos = part.Position
            local distance = (Vector3.new(partPos.X, headPos.Y, partPos.Z) - headPos).Magnitude
            local angle = math.atan2(partPos.Z - headPos.Z, partPos.X - headPos.X)
            local newAngle = angle + math.rad(Settings.rotationSpeed)

            local targetPos = Vector3.new(
                headPos.X + (math.cos(newAngle) * math.min(Settings.radius, distance)),
                headPos.Y + (Settings.height * math.abs(math.sin((partPos.Y - headPos.Y) / Settings.height))),
                headPos.Z + (math.sin(newAngle) * math.min(Settings.radius, distance))
            )

            local direction = (targetPos - partPos).Unit
            part.Velocity = direction * Settings.attractionStrength
        end
    end
end)

