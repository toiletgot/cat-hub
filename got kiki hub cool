-- 物理エフェクト計算
local timeCounter = 0
RunService.Heartbeat:Connect(function()
    timeCounter = timeCounter + settings.speed
    frameCounter = frameCounter + 1

    if grabEnabled or chaosEnabled or slowUpEnabled or slowDownEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - player.Character.HumanoidRootPart.Position).Magnitude <= grabRange then
                    for _, part in ipairs(p.Character:GetDescendants()) do
                        if part:IsA("BasePart") then registerPart(part) end
                    end
                end
            end
        end
    end

    if not (grabEnabled or chaosEnabled or slowUpEnabled or slowDownEnabled) and frameCounter % 5 == 0 then
        local targetUser = presentEnabled and Players:FindFirstChild(selectedGiftTarget) or (monoAllEnabled and nil or Players:FindFirstChild(selectedTargetName))
        if targetUser and targetUser.Character then
            for _, part in ipairs(targetUser.Character:GetDescendants()) do
                if part:IsA("BasePart") then registerPart(part) end
            end
        end
        if monoAllEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character then
                    for _, part in ipairs(p.Character:GetDescendants()) do
                        if part:IsA("BasePart") then registerPart(part) end
                    end
                end
            end
        end
    end

    local currentObjects = {}
    for obj in pairs(objectData) do 
        if (grabEnabled or chaosEnabled or slowUpEnabled or slowDownEnabled) then
            if isPlayerPart(obj) or (obj:IsA("Model") and isPlayerPart(obj.PrimaryPart)) then
                table.insert(currentObjects, obj)
            end
        else
            table.insert(currentObjects, obj)
        end
    end

    if #currentObjects > maxObjects and not (grabEnabled or chaosEnabled or slowUpEnabled or slowDownEnabled) then
        for i = maxObjects + 1, #currentObjects do
            local obj = currentObjects[i]
            if obj and obj.Parent then
                pcall(function()
                    local parts = obj:IsA("Model") and obj:GetDescendants() or {obj}
                    for _, p in ipairs(parts) do if p:IsA("BasePart") then p.CanCollide = true end end
                    local root = obj:IsA("Model") and obj.PrimaryPart or obj
                    if root then
                        if root:FindFirstChild("SyncForce") then root.SyncForce:Destroy() end
                        if root:FindFirstChild("SyncGyro") then root.SyncGyro:Destroy() end
                    end
                end)
                hoveringObjects[obj] = nil
                objectData[obj] = nil
            end
        end
        local newList = {}
        for i = 1, math.min(maxObjects, #currentObjects) do newList[i] = currentObjects[i] end
        currentObjects = newList
    end

    if #currentObjects == 0 then return end

    local targetUser = presentEnabled and Players:FindFirstChild(selectedGiftTarget) or (monoAllEnabled and nil or Players:FindFirstChild(selectedTargetName))
    
    if grabEnabled or chaosEnabled or slowUpEnabled or slowDownEnabled then
        for i, obj in ipairs(currentObjects) do
            local rootPart = obj:IsA("Model") and obj.PrimaryPart or obj
            if rootPart and rootPart.Parent and rootPart:FindFirstChild("SyncForce") then
                local currentPos = rootPart.Position
                local targetVel = Vector3.new(0, 0, 0)
                if grabEnabled then
                    targetVel = (Vector3.new(posX, posY, posZ) - currentPos) * 30
                end
                if slowUpEnabled then targetVel = targetVel + Vector3.new(0, 8, 0)
                elseif slowDownEnabled then targetVel = targetVel + Vector3.new(0, -8, 0) end
                
                if chaosEnabled then
                    targetVel = targetVel + Vector3.new(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100))
                    rootPart.SyncGyro.CFrame = CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)))
                else
                    rootPart.SyncGyro.CFrame = CFrame.new(currentPos, currentPos + Vector3.new(0, 0, 1))
                end
                rootPart.SyncForce.Velocity = targetVel
                if math.random() > 0.98 then pcall(function() rootPart:SetNetworkOwner(player) end) end
            end
        end
        return
    end

    for i, obj in ipairs(currentObjects) do
        local rootPart = obj:IsA("Model") and obj.PrimaryPart or obj
        if rootPart and rootPart.Parent and rootPart:FindFirstChild("SyncForce") then
            local currentPos = rootPart.Position
            local targetPos = nil
            local rotCFrame = nil
            local hrp = nil

            local useCombined = (mode == "Combined")
            local usePresent = presentEnabled
            local useMono = monoAllEnabled

            if useMono then
                local others = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then table.insert(others, p.Character.HumanoidRootPart) end
                end
                if #others > 0 then
                    local targetHRP = others[(i % #others) + 1]
                    local pAngle = (timeCounter * monoAllSpeed) + (i * 0.5)
                    targetPos = targetHRP.Position + Vector3.new(math.cos(pAngle) * 5, math.sin(timeCounter * 3 + i) * 2, math.sin(pAngle) * 5)
                    rotCFrame = CFrame.new(currentPos, targetHRP.Position)
                    rootPart.SyncForce.Velocity = (targetPos - currentPos) * 35
                end
            elseif usePresent then
                local target = Players:FindFirstChild(selectedGiftTarget)
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    hrp = target.Character.HumanoidRootPart
                    local pAngle = (timeCounter * (presentSpeed/10)) + (i / #currentObjects * math.pi * 2)
                    targetPos = hrp.Position + Vector3.new(math.cos(pAngle) * 4, math.sin(timeCounter * 2 + i) * 2, math.sin(pAngle) * 4)
                    rootPart.SyncForce.Velocity = (targetPos - currentPos) * presentFollowSpeed
                    rotCFrame = CFrame.new(currentPos, hrp.Position)
                end
            elseif useCombined then
                local targetPlayer = Players:FindFirstChild(selectedTargetName) or player
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    hrp = targetPlayer.Character.HumanoidRootPart
                    local lookCFrame = hrp.CFrame
                    local flapWave = math.sin(tick() * settings.flapSpeed) * settings.flapStrength
                    local invertMult = settings.invertDirection and -1.0 or 1.0
                    local placed = false
                    local runningSum = 0
                    for cId = 1, 8 do
                        local prevSum = runningSum
                        runningSum = runningSum + comboCount[cId]
                        if i <= runningSum and comboMode[cId] ~= "None" and comboActive[cId] then
                            local idx = i - prevSum
                            targetPos, rotCFrame = calculatePosition(comboMode[cId], idx, comboCount[cId], hrp, objectData[obj], timeCounters[cId], lookCFrame, flapWave, invertMult, comboWidth[cId], comboHeight[cId], comboDensity[cId])
                            placed = true
                            break
                        end
                    end
                    if not placed then
                        if obj and obj.Parent then
                            local parts = obj:IsA("Model") and obj:GetDescendants() or {obj}
                            for _, p in ipairs(parts) do if p:IsA("BasePart") then p.CanCollide = true end end
                            if rootPart then
                                if rootPart:FindFirstChild("SyncForce") then rootPart.SyncForce:Destroy() end
                                if rootPart:FindFirstChild("SyncGyro") then rootPart.SyncGyro:Destroy() end
                            end
                        end
                        hoveringObjects[obj] = nil; objectData[obj] = nil
                        targetPos = nil
                    end
                end
            else
                local targetPlayer = Players:FindFirstChild(selectedTargetName) or player
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    hrp = targetPlayer.Character.HumanoidRootPart
                    local lookCFrame = hrp.CFrame
                    local flapWave = math.sin(tick() * settings.flapSpeed) * settings.flapStrength
                    local invertMult = settings.invertDirection and -1.0 or 1.0
                    targetPos, rotCFrame = calculatePosition(mode, i, #currentObjects, hrp, objectData[obj], timeCounter, lookCFrame, flapWave, invertMult, settings.width, settings.height, settings.density)
                end
            end

            if targetPos then
                rootPart.SyncForce.Velocity = rootPart.SyncForce.Velocity:Lerp((targetPos - currentPos) * 30, 0.15)
            end
            if rotCFrame then
                rootPart.SyncGyro.CFrame = rotCFrame
            end
            if math.random() > 0.98 then pcall(function() rootPart:SetNetworkOwner(player) end) end
        end
    end

    for i = 1, 8 do
        timeCounters[i] = timeCounters[i] + comboSpeed[i]
    end
end)

local function setupCharacter(char)
    char:WaitForChild("HumanoidRootPart")
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Touched:Connect(function(hit) 
                local anyEnabled = (mode ~= "None" or presentEnabled or monoAllEnabled or grabEnabled or chaosEnabled or slowUpEnabled or slowDownEnabled)
                if not anyEnabled then return end
                if (grabEnabled or chaosEnabled or slowUpEnabled or slowDownEnabled) then
                    if isPlayerPart(hit) then registerPart(hit) end
                else
                    registerPart(hit)
                end
            end)
        end
    end
end
for _, p in ipairs(Players:GetPlayers()) do if p.Character then setupCharacter(p.Character) end p.CharacterAdded:Connect(setupCharacter) end

