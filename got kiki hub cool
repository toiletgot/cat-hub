-- --- 座標計算関数（省略：前回と同じ） ---
local function calculatePosition(currentMode, idx, count, hrp, data, timeCounter, lookCFrame, flapWave, invertMult, useWidth, useHeight, useDensity)
    if currentMode == "None" then return nil, nil end
    local targetPos
    local rotCFrame = nil
    
    local baseCenter = hrp.Position + (lookCFrame.LookVector * settings.depth)
    local directionAngle = settings.invertDirection and CFrame.Angles(0, math.pi, 0) or CFrame.identity

    if currentMode == "VerticalOrbit" then
        local angle = timeCounter + (idx * (math.pi * 2 / count) * useDensity)
        targetPos = baseCenter + Vector3.new(0, math.sin(angle) * useWidth + useHeight, math.cos(angle) * useWidth)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, useHeight, 0)) * directionAngle
    elseif currentMode == "Square" then
        local angle = timeCounter + (idx * (math.pi * 2 / count) * useDensity)
        local rawX, rawZ = math.cos(angle), math.sin(angle)
        local maxVal = math.max(math.abs(rawX), math.abs(rawZ))
        local radius = useWidth / maxVal
        targetPos = baseCenter + Vector3.new(rawX * radius, useHeight, rawZ * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter) * directionAngle
    elseif currentMode == "Triangle" then
        local angle = timeCounter + (idx * (math.pi * 2 / count) * useDensity)
        local deg = (angle % (math.pi * 2)) / (math.pi * 2) * 3
        local side = math.floor(deg)
        local f = deg - side
        local p1, p2
        if side == 0 then p1 = Vector3.new(0,0,1) p2 = Vector3.new(math.sqrt(3)/2,0,-0.5)
        elseif side == 1 then p1 = Vector3.new(math.sqrt(3)/2,0,-0.5) p2 = Vector3.new(-math.sqrt(3)/2,0,-0.5)
        else p1 = Vector3.new(-math.sqrt(3)/2,0,-0.5) p2 = Vector3.new(0,0,1) end
        local p = p1:Lerp(p2, f) * useWidth
        targetPos = baseCenter + Vector3.new(p.X, useHeight, p.Z)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter) * directionAngle
    elseif currentMode == "Hexagon" then
        local angle = timeCounter + (idx * (math.pi * 2 / count) * useDensity)
        local deg = (angle % (math.pi * 2)) / (math.pi * 2) * 6
        local side = math.floor(deg)
        local f = deg - side
        local r = useWidth
        local p1Angle = side * (math.pi / 3)
        local p2Angle = (side + 1) * (math.pi / 3)
        local p1 = Vector3.new(math.cos(p1Angle),0,math.sin(p1Angle)) * r
        local p2 = Vector3.new(math.cos(p2Angle),0,math.sin(p2Angle)) * r
        local p = p1:Lerp(p2, f)
        targetPos = baseCenter + Vector3.new(p.X, useHeight, p.Z)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter) * directionAngle
    elseif currentMode == "Water" then
        local angle = (idx / count) * math.pi * 2 + timeCounter
        local waveY = math.sin(timeCounter * 3 + idx * 0.5) * 1.5 + math.cos(timeCounter * 2 + idx) * 0.5
        local radius = useWidth * 0.7 + math.sin(timeCounter + idx) * 1.0
        targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, useHeight + waveY, math.sin(angle) * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, waveY, 0)) * directionAngle
    elseif currentMode == "Gourd" then
        local ratio = idx / count
        local angle = ratio * math.pi * 2 * 3 + timeCounter
        local heightLocal = (ratio - 0.5) * (useHeight * 2.5) * useDensity
        local gourdRadius = math.abs(math.sin(ratio * math.pi)) * (useWidth * 0.4) * useDensity
        if ratio > 0.5 then gourdRadius = gourdRadius * 0.7 end
        targetPos = baseCenter + Vector3.new(math.cos(angle) * gourdRadius, useHeight + heightLocal, math.sin(angle) * gourdRadius)
        rotCFrame = CFrame.Angles(0, angle, 0) * directionAngle
    elseif currentMode == "Stickman" then
        local headCut = math.floor(count * 0.2); local bodyCut = math.floor(count * 0.5); local armCut = math.floor(count * 0.75)
        local localVec = Vector3.zero
        local ds = useDensity 
        if idx <= headCut then
            local angle = (idx / headCut) * math.pi * 2 + timeCounter
            localVec = Vector3.new(math.cos(angle) * 2 * ds, (6 + math.sin(angle) * 2) * ds, 0)
        elseif idx <= bodyCut then
            local progress = (idx - headCut) / (bodyCut - headCut)
            localVec = Vector3.new(0, (4 - (progress * 5)) * ds, 0)
        elseif idx <= armCut then
            local progress = (idx - bodyCut) / (armCut - bodyCut)
            localVec = Vector3.new((progress - 0.5) * 6 * ds, (2.5 + math.sin(timeCounter)*0.5) * ds, 0)
        else
            local progress = (idx - armCut) / (count - armCut)
            local side = (idx % 2 == 0) and 1 or -1
            localVec = Vector3.new(side * (progress * 3) * ds, (-1 - (progress * 4)) * ds, 0)
        end
        targetPos = (lookCFrame + (lookCFrame.LookVector * settings.depth)):PointToWorldSpace(localVec + Vector3.new(0, useHeight, -5))
        rotCFrame = lookCFrame * directionAngle
    elseif currentMode == "ReverseOrbit" then
        local angle = -timeCounter - (idx * (math.pi * 2 / count) * useDensity)
        local radius = useWidth * (settings.invertDirection and -1.0 or 1.0)
        targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, useHeight, math.sin(angle) * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter) * directionAngle
    elseif currentMode == "Island" then
        local goldenRatio = (1 + 5^0.5) / 2
        local theta = idx * math.pi * 2 * goldenRatio * useDensity + timeCounter
        local r = math.sqrt(idx / count) * (useWidth * 0.45)
        local floatY = math.sin(timeCounter * 1.5 + idx * 0.1) * 0.2
        targetPos = baseCenter + Vector3.new(math.cos(theta) * r, -3.2 + floatY, math.sin(theta) * r)
        rotCFrame = lookCFrame * CFrame.Angles(0, theta, 0) * directionAngle
    elseif currentMode == "Star2" then
        local angle = (idx / count) * math.pi * 2 + (timeCounter * 1.5)
        local starAngle = (angle * 5) % (math.pi * 2)
        local r = useWidth * 0.6 * (1 / (2 - math.cos(starAngle)))
        targetPos = baseCenter + Vector3.new(math.cos(angle) * r, useHeight + math.sin(timeCounter * 2 + idx) * 0.4, math.sin(angle) * r)
        rotCFrame = CFrame.Angles(0, angle, 0) * directionAngle
    elseif currentMode == "Heart2" then
        local angle = (idx / count) * math.pi * 2
        local pulse = 1 + math.sin(timeCounter * 4) * 0.1
        local size = useWidth * 0.5 * pulse
        local x = 16 * math.pow(math.sin(angle), 3)
        local y = 13 * math.cos(angle) - 5 * math.cos(2*angle) - 2 * math.cos(3*angle) - math.cos(4*angle)
        x = (x / 16) * size; y = (y / 16) * size
        local zDist = -5 - (math.sin(idx + timeCounter) * 0.5)
        targetPos = (lookCFrame + (lookCFrame.LookVector * settings.depth)):PointToWorldSpace(Vector3.new(x, y + useHeight, zDist))
        rotCFrame = lookCFrame * directionAngle
    elseif currentMode == "Number" then
        local digitSegments = {[0]={1,1,1,0,1,1,1},[1]={0,0,1,0,0,1,0},[2]={1,0,1,1,1,0,1},[3]={1,0,1,1,0,1,1},[4]={0,1,1,1,0,1,0},[5]={1,1,0,1,0,1,1},[6]={1,1,0,1,1,1,1},[7]={1,1,1,0,0,1,0},[8]={1,1,1,1,1,1,1},[9]={1,1,1,1,0,1,1}}
        local segmentLines = {{Vector3.new(-1,2,0),Vector3.new(1,2,0)},{Vector3.new(-1,2,0),Vector3.new(-1,0,0)},{Vector3.new(1,2,0),Vector3.new(1,0,0)},{Vector3.new(-1,0,0),Vector3.new(1,0,0)},{Vector3.new(-1,0,0),Vector3.new(-1,-2,0)},{Vector3.new(1,0,0),Vector3.new(1,-2,0)},{Vector3.new(-1,-2,0),Vector3.new(1,-2,0)}}
        local currentDigit = math.floor(tick()) % 10
        local activeSegments = digitSegments[currentDigit]
        local validLines = {}
        for sId, active in ipairs(activeSegments) do if active == 1 then table.insert(validLines, segmentLines[sId]) end end
        local lineCount = #validLines
        if lineCount > 0 then
            local pPerLine = math.ceil(count / lineCount)
            local lineIdx = math.floor((idx - 1) / pPerLine) + 1
            if lineIdx > lineCount then lineIdx = lineCount end
            local localIdx = (idx - 1) % pPerLine
            local ratio = pPerLine > 1 and (localIdx / (pPerLine - 1)) or 0.5
            local line = validLines[lineIdx]
            local localVec = line[1]:Lerp(line[2], ratio) * (useWidth * 0.25)
            localVec = Vector3.new(localVec.X, localVec.Y + useHeight + 3, -6)
            targetPos = (lookCFrame + (lookCFrame.LookVector * settings.depth)):PointToWorldSpace(localVec)
            rotCFrame = lookCFrame * directionAngle
        else targetPos = baseCenter + Vector3.new(0, useHeight, 0) end
    elseif currentMode == "Cursor" then
        local progress = (idx / count)
        local arrowLength = useWidth * 0.5
        local yOffset = useHeight + 8
        if progress < 0.4 then
            local segt = progress / 0.4
            local fwd = -arrowLength * 0.3 + (segt * arrowLength * 0.6)
            targetPos = baseCenter + Vector3.new(0, yOffset, 0) + (lookCFrame.LookVector * fwd)
        else
            local segt = (progress - 0.4) / 0.6
            local side = (idx % 2 == 0) and 1 or -1
            local fwd = arrowLength * 0.3 - (segt * arrowLength * 0.5)
            local right = side * (segt * arrowLength * 0.4)
            targetPos = baseCenter + Vector3.new(0, yOffset, 0) + (lookCFrame.LookVector * fwd) + (lookCFrame.RightVector * right)
        end
        rotCFrame = lookCFrame * CFrame.Angles(0, math.pi, 0) * directionAngle
    elseif currentMode == "Poop" then
        local angle = (idx * 0.5 * useDensity) + (timeCounter * 2)
        local heightProgress = (idx / count) 
        local radius = useWidth * 0.4 * (1 - heightProgress * 0.9)
        local yOffset = (useHeight - 3) + (heightProgress * 6)
        targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, yOffset, math.sin(angle) * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, yOffset, 0)) * directionAngle
    elseif currentMode == "Flower" then
        local petalCount = 5
        if idx <= math.floor(count * 0.15) then
            local angle = (idx / count) * math.pi * 2 + timeCounter
            targetPos = baseCenter + Vector3.new(math.cos(angle) * 1.5, useHeight + math.sin(timeCounter * 3 + idx) * 0.5, math.sin(angle) * 1.5)
        else
            local angle = (idx / count) * math.pi * 2 + (timeCounter * 0.5)
            local r = useWidth * 0.5 * math.abs(math.cos(petalCount * angle * 0.5))
            targetPos = baseCenter + Vector3.new(math.cos(angle) * r, useHeight, math.sin(angle) * r)
        end
        rotCFrame = CFrame.Angles(0, timeCounter, 0) * directionAngle
    elseif currentMode == "Magic3" then
        local layer = idx % 3
        local perLayer = math.ceil(count / 3)
        local layerIdx = math.floor((idx - 1) / perLayer)
        local layerSpeed = (layerIdx == 0) and 1.5 or ((layerIdx == 1) and -2.2 or 0.8)
        local angle = (idx / perLayer) * math.pi * 2 + (timeCounter * layerSpeed)
        local pulse = math.sin(timeCounter * 4 + layerIdx * 2) * 1.2
        local radius = (useWidth * (0.3 + (layerIdx * 0.3))) + pulse
        local floatY = math.cos(timeCounter * 2 + layerIdx) * 0.8
        local yOffset = useHeight + (layerIdx * 4) - 4 + floatY
        targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, yOffset, math.sin(angle) * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, yOffset, 0)) * CFrame.Angles(math.rad(10), angle, 0) * directionAngle
    elseif currentMode == "CubeArea" then
        local size = (useWidth * 0.4)
        local sides = 6
        local perSide = math.ceil(count / sides)
        local sideIdx = math.floor((idx - 1) / perSide) + 1
        local localIdx = (idx - 1) % perSide
        local t = perSide > 1 and (localIdx / (perSide - 1) * 2 - 1) or 0
        local u = math.sin(localIdx * 1.5) 
        local x, y, z = 0, useHeight, 0
        if sideIdx == 1 then x = size; y = y + t * size; z = u * size
        elseif sideIdx == 2 then x = -size; y = y + t * size; z = u * size
        elseif sideIdx == 3 then x = t * size; y = y + size; z = u * size
        elseif sideIdx == 4 then x = t * size; y = y - size; z = u * size
        elseif sideIdx == 5 then x = t * size; y = y + u * size; z = size
        else x = t * size; y = y + u * size; z = -size end
        targetPos = baseCenter + Vector3.new(x, y - useHeight, z)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, y - useHeight, 0)) * directionAngle
    elseif currentMode == "SphereArea" then
        local radius = (useWidth * 0.5)
        local phi = math.acos(1 - 2 * (idx / count))
        local theta = math.pi * (1 + 5^0.5) * idx + (timeCounter * 0.5)
        local x = math.cos(theta) * math.sin(phi) * radius
        local y = math.sin(phi) * math.sin(theta) * radius + useHeight
        local z = math.cos(phi) * radius
        targetPos = baseCenter + Vector3.new(x, y - useHeight, z)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, y - useHeight, 0)) * directionAngle
    elseif currentMode == "Shield" then
        local size = useWidth * 0.4
        local columns = math.ceil(math.sqrt(count))
        local row = math.floor((idx - 1) / columns)
        local col = (idx - 1) % columns
        local x = (col - (columns / 2)) * (size / columns) * 2
        local y = (row - (columns / 2)) * (size / columns) * 2 + useHeight
        local localOffset = Vector3.new(x, y, -4)
        targetPos = (lookCFrame + (lookCFrame.LookVector * settings.depth)):PointToWorldSpace(localOffset)
        rotCFrame = lookCFrame * directionAngle
    elseif currentMode == "Matsuri" then
        local layer = idx % 3
        local perLayer = math.ceil(count / 3)
        local angle = (idx / perLayer) * math.pi * 2 + (timeCounter * 2)
        local radius = (useWidth * 0.6) + (layer * 3)
        local yOffset = useHeight + (layer * 2.5) + math.sin(timeCounter * 3 + idx) * 0.5
        targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, yOffset, math.sin(angle) * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, yOffset, 0)) * directionAngle
    elseif currentMode == "Clock" then
        local radius = useWidth * 0.5
        if idx % 3 == 0 then 
            local t = (idx / count) * (useWidth * 0.4)
            local angle = timeCounter * 0.5
            targetPos = baseCenter + Vector3.new(math.cos(angle) * t, useHeight, math.sin(angle) * t)
        elseif idx % 3 == 1 then 
            local t = (idx / count) * (useWidth * 0.25)
            local angle = timeCounter * 0.05
            targetPos = baseCenter + Vector3.new(math.cos(angle) * t, useHeight, math.sin(angle) * t)
        else 
            local angle = (idx / count) * math.pi * 2
            targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, useHeight, math.sin(angle) * radius)
        end
        rotCFrame = CFrame.Angles(math.rad(90), 0, 0) * directionAngle
    elseif currentMode == "Sun" then
        local radius = useWidth * 0.4
        if idx <= math.floor(count * 0.4) then 
            local phi = math.acos(1 - 2 * (idx / count))
            local theta = math.pi * (1 + 5^0.5) * idx + timeCounter
            targetPos = baseCenter + Vector3.new(math.cos(theta)*math.sin(phi)*radius, useHeight + math.sin(phi)*math.cos(theta)*radius, math.cos(phi)*radius)
        else 
            local angle = (idx / count) * math.pi * 2 + timeCounter
            local heatWave = radius + math.sin(timeCounter * 10 + idx) * 3.5
            local yHeat = useHeight + math.cos(timeCounter * 8 + idx) * 2
            targetPos = baseCenter + Vector3.new(math.cos(angle) * heatWave, yHeat, math.sin(angle) * heatWave)
        end
        rotCFrame = CFrame.Angles(math.random(), math.random(), math.random()) * directionAngle
    elseif currentMode == "Tree" then
        local progress = (idx / count)
        local yOffset = useHeight - 2 + (progress * useHeight * 2.5)
        local radius = useWidth * 0.5 * (1 - (progress * 0.8)) 
        local angle = (idx * 1.2 * useDensity) + timeCounter
        if progress < 0.15 then radius = 1 end 
        targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, yOffset, math.sin(angle) * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, yOffset, 0)) * directionAngle
    elseif currentMode == "Crown" then
        local angle = (idx / count) * math.pi * 2 + timeCounter
        local radius = useWidth * 0.2
        local yBase = useHeight + 1.0
        local peak = math.abs(math.sin((idx / count) * math.pi * 5)) * (useHeight * 0.4)
        targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, yBase + peak, math.sin(angle) * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, yBase, 0)) * CFrame.Angles(math.rad(15), 0, 0) * directionAngle
    elseif currentMode == "Rain" then
        local topY = useHeight + 18
        local bottomY = useHeight - 8
        local rx = data and data.randX or 0
        local rz = data and data.randZ or 0
        local fallSpd = data and data.fallSpeed or 20
        local currentY = topY - (((timeCounter * fallSpd + (idx * 1.5)) % (topY - bottomY)))
        targetPos = baseCenter + Vector3.new(rx, currentY, rz)
        rotCFrame = CFrame.Angles(math.rad(180), 0, 0) * directionAngle
    elseif currentMode == "Wing" then
        local side = (idx % 2 == 0) and 1 or -1
        local wingIndex = math.ceil(idx / 2)
        local maxWingObjects = math.ceil(count / 2)
        local t = wingIndex / maxWingObjects
        local spacingFactor = math.clamp(1 / math.log10(maxWingObjects + 3), 0.4, 1.0)
        local xOffset = (1.8 + (t * settings.wingSize * settings.wingSpread)) * side
        local yOffset = 1.0 + (t * (settings.wingSize * 0.4) * spacingFactor) + (flapWave * t * spacingFactor)
        local zOffset = 1.0 + (t * 0.6)
        targetPos = (lookCFrame + (lookCFrame.LookVector * settings.depth)):PointToWorldSpace(Vector3.new(xOffset, yOffset, zOffset))
        rotCFrame = CFrame.lookAt(targetPos, targetPos + (lookCFrame.RightVector * side * 5 + lookCFrame.UpVector * flapWave), lookCFrame.UpVector) * directionAngle
    elseif currentMode == "Heart" then
        local angle = (idx / count) * math.pi * 2 + (timeCounter * 0.5)
        local size = useWidth * 0.6
        local x = 16 * math.pow(math.sin(angle), 3)
        local y = 13 * math.cos(angle) - 5 * math.cos(2*angle) - 2 * math.cos(3*angle) - math.cos(4*angle)
        x = (x / 16) * size; y = (y / 16) * size
        targetPos = (lookCFrame + (lookCFrame.LookVector * settings.depth)):PointToWorldSpace(Vector3.new(x, y + useHeight, 3))
        rotCFrame = lookCFrame * directionAngle
    elseif currentMode == "Tornado" then
        local angle = (timeCounter * 3) + (idx * (math.pi * 2 / math.min(count, 8)) * useDensity)
        local heightPercent = (idx / count)
        local radius = (3 + (heightPercent * useWidth))
        local yOffset = (heightPercent * useHeight * 4) - (useHeight * 1.5)
        targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, yOffset, math.sin(angle) * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, yOffset, 0)) * directionAngle
    elseif currentMode == "Star" then
        local angle = (timeCounter * 2) + (idx / count * math.pi * 2 * useDensity)
        local r = useWidth * (2 / (3 - math.cos(5 * angle)))
        targetPos = baseCenter + Vector3.new(math.cos(angle) * r, useHeight, math.sin(angle) * r)
        rotCFrame = CFrame.Angles(0, angle, 0) * directionAngle
    elseif currentMode == "Lightning" then
        local angle = (timeCounter * 5) + (idx / count * math.pi * 2)
        local zig = math.sin(idx * 50) * 3
        local radius = (useWidth + zig)
        targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, useHeight + (math.cos(idx*20)*2), math.sin(angle) * radius)
        rotCFrame = CFrame.Angles(math.random(), math.random(), math.random()) * directionAngle
    elseif currentMode == "Beam" then
        local beamIndex = (idx % 6)
        local step = math.floor(idx / 6)
        local angle = (beamIndex * (math.pi * 2 / 6)) + (timeCounter * 0.2)
        local distance = 4 + (step * 3.5)
        targetPos = baseCenter + Vector3.new(math.cos(angle) * distance, useHeight, math.sin(angle) * distance)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, useHeight, 0)) * directionAngle
    elseif currentMode == "Saturn" then
        local size = useWidth
        if idx % 3 == 0 then
            local t = idx / count * math.pi * 2
            targetPos = baseCenter + Vector3.new(math.cos(t)*3, useHeight + math.sin(timeCounter+idx)*2, math.sin(t)*3)
        else
            local angle = timeCounter + (idx * (math.pi * 2 / count) * useDensity)
            local ringCFrame = hrp.CFrame * CFrame.Angles(math.rad(15), 0, math.rad(15))
            targetPos = baseCenter + ringCFrame:VectorToWorldSpace(Vector3.new(math.cos(angle)*size, 0, math.sin(angle)*size))
        end
        rotCFrame = CFrame.lookAt(targetPos, baseCenter) * directionAngle
    elseif currentMode == "Magic2" then
        local angle = (timeCounter * 2) + (idx / count * math.pi * 2 * useDensity)
        local radius = (idx % 2 == 0 and useWidth or useWidth * 0.6)
        targetPos = baseCenter + Vector3.new(math.cos(angle)*radius, useHeight, math.sin(angle)*radius)
        rotCFrame = hrp.CFrame * CFrame.Angles(0, angle * (idx % 2 == 0 and 1 or -1), 0) * directionAngle
    elseif currentMode == "MagicCircle" then
        local angle = (timeCounter * 2) + (idx / count * math.pi * 2 * useDensity)
        local s = (useWidth / 2)
        local x = math.sign(math.cos(angle)) * math.pow(math.abs(math.cos(angle)), 0.2) * s
        local z = math.sign(math.sin(angle)) * math.pow(math.abs(math.sin(angle)), 0.2) * s
        targetPos = baseCenter + Vector3.new(0, useHeight, 0) + (CFrame.Angles(math.rad(11.5), 0, math.rad(11.5)) * Vector3.new(x, 0, z))
        rotCFrame = hrp.CFrame * CFrame.Angles(math.rad(11.5), angle, math.rad(11.5)) * directionAngle
    elseif currentMode == "Orbit" then
        local angle = timeCounter + (idx * (math.pi * 2 / count) * useDensity)
        local radius = useWidth
        targetPos = baseCenter + Vector3.new(math.cos(angle) * radius, useHeight, math.sin(angle) * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter) * directionAngle
    elseif currentMode == "Ghost" then
        local t = timeCounter + (data and data.seed or 0)
        local radius = useWidth
        targetPos = baseCenter + Vector3.new(math.sin(t * 0.7) * radius * useDensity, math.cos(t * 0.5) * (radius * 0.5) + useHeight, math.sin(t * 0.3) * radius * useDensity)
        rotCFrame = targetPos and CFrame.Angles(0.05, 0.05, 0.05) * directionAngle or CFrame.identity
    elseif currentMode == "Manji" then
        local b = (idx - 1) % 4
        local a = (b * math.pi / 2) + (timeCounter * 1.5)
        local sIdx = math.floor((idx - 1) / 4)
        local r = math.min(1, sIdx / (math.max(1, count/4) * 0.6 + 0.1))
        local radius = (r * useWidth) * useDensity
        targetPos = baseCenter + Vector3.new(math.cos(a) * radius, useHeight, math.sin(a) * radius)
        rotCFrame = CFrame.lookAt(Vector3.zero, Vector3.new(math.cos(a), 0, math.sin(a))) * directionAngle
    elseif currentMode == "Divine" then
        local a = (idx / count) * math.pi * 2 * useDensity + (timeCounter * 0.5)
        local radius = useWidth
        targetPos = baseCenter + Vector3.new(math.cos(a) * radius, useHeight + math.sin(timeCounter + idx) * 0.5, math.sin(a) * radius)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter + Vector3.new(0, 10, 0)) * directionAngle
    elseif currentMode == "Geometry" then
        local n = 12 
        local sA = timeCounter * 1.5 + (data and data.phase or 0)
        local lA = ((idx - 1) % n / n) * math.pi * 2 * useDensity + (timeCounter * 0.2)
        local radius = useWidth
        targetPos = baseCenter + Vector3.new(math.cos(lA) * radius + math.cos(sA) * 5, useHeight, math.sin(lA) * radius + math.sin(sA) * 5)
        rotCFrame = CFrame.lookAt(targetPos, targetPos + Vector3.new(math.cos(lA), 0, math.sin(lA))) * directionAngle
    elseif currentMode == "Spin" then
        local sAngle = (timeCounter * 2) + (idx / count * math.pi * 2)
        targetPos = baseCenter + Vector3.new(math.cos(sAngle) * useWidth, math.sin(timeCounter * 5 + idx) * (useWidth/2), math.sin(sAngle) * useWidth)
        rotCFrame = CFrame.lookAt(targetPos, baseCenter) * directionAngle
    end
    return targetPos, rotCFrame
end

