-- 1. Anti Explode
local antiExplodeEnabled = false
local antiExplodeConn = nil
local function SetAntiExplode(enabled)
    antiExplodeEnabled = enabled
    if antiExplodeConn then antiExplodeConn:Disconnect(); antiExplodeConn = nil end
    if not enabled then return end
    local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if not (HRP and hum and hum:FindFirstChild("Ragdolled")) then return end
    antiExplodeConn = Workspace.ChildAdded:Connect(function(c)
        if not antiExplodeEnabled then return end
        if c.Name == "Part" then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local h = char and char:FindFirstChild("Humanoid")
            if hrp and h and h:FindFirstChild("Ragdolled")
                and (c.Position - hrp.Position).Magnitude < 40
                and h.Ragdolled.Value == true then
                hrp.Anchored = true
                task.wait(0.01)
                hrp.Anchored = false
                stvel(hrp)
                h:ChangeState(Enum.HumanoidStateType.Running)
            end
        end
    end)
end

-- 2. Anti Burn
local antiBurnEnabled = false
local antiburn, antiburn1 = nil, nil
local HRP_Burn, hum_Burn = nil, nil
local function SetAntiBurn(v)
    antiBurnEnabled = v
    if antiburn then antiburn:Disconnect(); antiburn = nil end
    if antiburn1 then antiburn1:Disconnect(); antiburn1 = nil end
    if not v then return end
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    HRP_Burn = char:WaitForChild("HumanoidRootPart", 0.5)
    hum_Burn = char:WaitForChild("Humanoid", 0.5)
    local function burnHandler()
        if not hum_Burn or not hum_Burn:FindFirstChild("FireDebounce") then return end
        if hum_Burn.FireDebounce.Value == true then
            local bar = Workspace.Plots.Plot1.Barrier.PlotBarrier
            local pos = bar.CFrame
            task.spawn(function()
                repeat task.wait() bar.CFrame = HRP_Burn.CFrame until not hum_Burn.FireDebounce.Value
            end)
            task.wait(1)
            hum_Burn.FireDebounce.Value = false
            task.wait()
            bar.CFrame = pos
        end
    end
    antiburn1 = plr.CharacterAdded:Connect(function(ch)
        if antiburn then antiburn:Disconnect() end
        local h = ch:WaitForChild("Humanoid", 0.5)
        local fd = h and h:FindFirstChild("FireDebounce")
        if fd then
            antiburn = fd.Changed:Connect(function()
                HRP_Burn = ch:FindFirstChild("HumanoidRootPart")
                hum_Burn = h
                burnHandler()
            end)
        end
    end)
    if plr.Character and plr.Character:FindFirstChild("Humanoid") then
        local h = plr.Character.Humanoid
        if h:FindFirstChild("FireDebounce") then
            antiburn = h.FireDebounce.Changed:Connect(burnHandler)
        end
    end
end

-- 3. Anti Void
local antiVoidActive = false
local antiVoidConnection = nil
local function HandleAntiVoid(Value)
    antiVoidActive = Value
    if antiVoidConnection then antiVoidConnection:Disconnect(); antiVoidConnection = nil end
    if not Value then return end
    local VOID_THRESHOLD = -50
    local SAFE_HEIGHT = 100
    antiVoidConnection = RunService.Heartbeat:Connect(function()
        if not antiVoidActive then return end
        local char = LocalPlayer.Character
        local primary = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
        if primary then
            local pos = primary.Position
            if pos.Y < VOID_THRESHOLD then
                local safePos = Vector3.new(pos.X, pos.Y + SAFE_HEIGHT, pos.Z)
                primary.CFrame = CFrame.new(safePos)
                primary.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end)
end

