        hum.SeatPart = seat
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = seat.CFrame * CFrame.new(0, 0, 0) end
    end)
    task.wait(0.5)
    if hum.SeatPart == seat then return true end
    pcall(function() hum.Sit = true; hum.SeatPart = seat end)
    task.wait(0.3)
