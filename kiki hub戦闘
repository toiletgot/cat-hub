local function destroyServer()
    task.spawn(function()
        startLineLag()
        task.wait(1)
        local players = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then table.insert(players, {plr=p, hrp=hrp}) end
            end
        end
        local height = 35
        local radius = 40
        for idx, data in ipairs(players) do
            local angle = ((idx-1) / math.max(#players,1)) * math.pi * 2
            local x, z = math.cos(angle)*radius, math.sin(angle)*radius
            data.hrp.CFrame = CFrame.new(x, height, z)
            data.hrp.AssemblyLinearVelocity = Vector3.zero
            local bp = Instance.new("BodyPosition")
            bp.MaxForce = Vector3.new(1e9,1e9,1e9); bp.P = 40000000; bp.Position = Vector3.new(x,height,z)
            bp.Parent = data.hrp
            task.delay(2, function() pcall(function() bp:Destroy() end) end)
        end
        task.wait(2)
    end)
end

