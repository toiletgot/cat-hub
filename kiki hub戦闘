local blobman = nil
local kickTarget = nil
local spinAngle = 0
local isSpinning = false

local function findBlobman()
    for _, v in ipairs(Workspace:GetChildren()) do
        if v:IsA("Model") and (v.Name:lower():find("blobman") or v.Name:lower():find("creatureblobman")) then
            blobman = v
            return v
        end
    end
    local folder = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
    if folder then
        for _, v in ipairs(folder:GetChildren()) do
            if v:IsA("Model") and v.Name:lower():find("blobman") then
                blobman = v
                return v
            end
        end
    end
    return nil
end

local function spawnBlobman()
    local existing = findBlobman()
    if existing then return existing end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local success, result = pcall(function()
        return ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", root.CFrame * CFrame.new(0,0,-5), Vector3.zero)
    end)
    if success then
        task.wait(1.0)
        local blob = findBlobman()
        if blob then return blob end
    end
    local blobEvents = ReplicatedStorage:FindFirstChild("BlobEvents")
    if blobEvents and blobEvents:FindFirstChild("CreateBlob") then
        pcall(function() blobEvents.CreateBlob:FireServer() end)
        task.wait(1.5)
        local blob = findBlobman()
        if blob then return blob end
    end
    return nil
end

local function rideBlobman()
    if not blobman then
        blobman = spawnBlobman()
        if not blobman then return false end
    end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local seat = blobman:FindFirstChild("VehicleSeat")
    if seat and seat:IsA("VehicleSeat") then
        hum.Sit = true
        hum.SeatPart = seat
        seat:Sit(hum)
        task.wait(0.2)
        return true
    end
    return false
end

local function physicalKick(targetRoot, power, upForce)
    if not targetRoot or not targetRoot.Parent then return false end
    pcall(function()
        targetRoot.AssemblyLinearVelocity = Vector3.zero
        targetRoot.AssemblyAngularVelocity = Vector3.zero
        targetRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 25, 0)
        task.wait(0.02)
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e7, 1e7, 1e7)
        local dir = Vector3.new(math.random(-1,1), 1, math.random(-1,1)).Unit
        bv.Velocity = dir * (power or 200) + Vector3.new(0, upForce or 150, 0)
        bv.Parent = targetRoot
        task.delay(0.3, function() if bv then bv:Destroy() end end)
        targetRoot.AssemblyLinearVelocity = Vector3.new(math.random(-50,50), upForce or 200, math.random(-50,50))
    end)
    return true
end

local function performKick(target)
    if not target or not target.Character then return false end
    local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not tRoot then return false end
    if not blobman or not blobman.Parent then
        blobman = spawnBlobman()
        task.wait(0.5)
        rideBlobman()
    end
    local grabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
    if grabEvents then
        local setOwner = grabEvents:FindFirstChild("SetNetworkOwner")
        local createLine = grabEvents:FindFirstChild("CreateGrabLine")
        local destroyLine = grabEvents:FindFirstChild("DestroyGrabLine")
        if setOwner and createLine and destroyLine then
            pcall(function()
                setOwner:FireServer(tRoot, tRoot.CFrame)
                createLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                task.wait(0.05)
                destroyLine:FireServer(tRoot)
                if blobman then
                    local script = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
                    if script then
                        local grab = script:FindFirstChild("CreatureGrab")
                        local drop = script:FindFirstChild("CreatureDrop")
                        local detector = blobman:FindFirstChild("RightDetector")
                        local weld = detector and detector:FindFirstChild("RightWeld")
                        if grab and detector then grab:FireServer(detector, tRoot, weld) end
                        task.wait(0.05)
                        if drop then drop:FireServer() end
                    end
                end
            end)
        end
    end
    physicalKick(tRoot, 250, 180)
    return true
end

local function spinKickLoop()
    if not kickTarget then return end
    isSpinning = true
    local savedPos = player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.CFrame or CFrame.identity
    local speed = _G.SpinSpeed or 15
    while isSpinning do
        if not blobman or not blobman.Parent then
            blobman = spawnBlobman()
            rideBlobman()
            if not blobman then break end
        end
        if not kickTarget or not kickTarget.Character then break end
        local tRoot = kickTarget.Character:FindFirstChild("HumanoidRootPart")
        if not tRoot then break end
        spinAngle = spinAngle + math.rad(speed * 2)
        if spinAngle > math.pi * 2 then spinAngle = spinAngle - math.pi * 2 end
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = player.Character.HumanoidRootPart
            myRoot.CFrame = CFrame.new(savedPos.Position) * CFrame.Angles(0, spinAngle, 0)
        end
        local distance = 8
        local targetPos = savedPos.Position + Vector3.new(math.sin(spinAngle)*distance, 0, math.cos(spinAngle)*distance)
        tRoot.CFrame = CFrame.new(targetPos)
        tRoot.AssemblyLinearVelocity = Vector3.zero
        tRoot.AssemblyAngularVelocity = Vector3.zero
        physicalKick(tRoot, 100, 50)
        local grabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
        if grabEvents and grabEvents:FindFirstChild("SetNetworkOwner") then
            pcall(function() grabEvents.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame) end)
        end
        RunService.Heartbeat:Wait()
    end
end

