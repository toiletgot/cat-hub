local function findTrainItem(name)
    local items = getAllItems()
    for _, item in ipairs(items) do
        if item.Name == name then return item end
    end
    return nil
end

local function performTrainAutoAction(isFirstTime)
    if isFirstTime then
        local target = findTrainItem(trainTargetItemName)
        if not target then spawnTrainItem(trainTargetItemName) end
        local second = findTrainItem(trainSecondItemName)
        if not second then spawnTrainItem(trainSecondItemName) end
        task.wait(1.0)
        target = findTrainItem(trainTargetItemName)
        second = findTrainItem(trainSecondItemName)
        if target then holdItem(target); task.wait(0.1) end
        if second then holdItem(second); task.wait(0.1) end
        if target then useItem(target); task.wait(0.1); dropItemAtPlayer(target); task.wait(0.1) end
        if second then dropItemAtPlayer(second) end
    else
        local target = findTrainItem(trainTargetItemName)
        if not target then spawnTrainItem(trainTargetItemName); task.wait(1.0); target = findTrainItem(trainTargetItemName) end
        if target then
            if holdItem(target) then task.wait(0.3); dropItemAtPlayer(target) end
        end
    end
end

local function setupSeat(seat)
    local conn = seat:GetPropertyChangedSignal("Occupant"):Connect(function()
        local hum = seat.Occupant
        if hum then
            local char = hum.Parent
            local plr = Players:GetPlayerFromCharacter(char)
            if plr then
                trainOccupiedSeats[seat] = plr
                local isFirst = not trainFirstTimeRiders[plr.UserId]
                if isFirst then trainFirstTimeRiders[plr.UserId] = true end
                if trainAutomationEnabled then performTrainAutoAction(isFirst) end
            end
            local sitConn
            sitConn = hum:GetPropertyChangedSignal("Sit"):Connect(function()
                if not hum.Sit and plr then
                    trainOccupiedSeats[seat] = nil
                    if sitConn then sitConn:Disconnect() end
                    if trainAutomationEnabled then performTrainAutoAction(false) end
                end
            end)
        end
    end)
    trainAllSeats[seat] = conn
end

local function startSeatDetection()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Seat") and obj.Name == "Seat" then setupSeat(obj) end
    end
    Workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("Seat") and obj.Name == "Seat" then setupSeat(obj) end
    end)
end

local function sitOnRandomSeat()
    local empty = {}
    for seat, _ in pairs(trainAllSeats) do
        if seat and seat.Parent and not seat.Occupant then table.insert(empty, seat) end
    end
    if #empty == 0 then return end
    local seat = empty[math.random(1, #empty)]
    local char = getPlayerCharacter()
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if hum and root then
        hum.Sit = false; task.wait(0.2)
        root.CFrame = seat.CFrame + Vector3.new(0,3,0); task.wait(0.2)
        seat:Sit(hum)
    end
end

local function startTrainAutomation()
    if trainAutomationConnection then trainAutomationConnection:Disconnect() end
    local char = getPlayerCharacter()
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        trainAutomationConnection = hum.Seated:Connect(function(active, seat)
            if trainAutomationEnabled then
                if active then task.wait(0.1); performTrainAutoAction(true)
                else task.wait(0.1); performTrainAutoAction(false) end
            end
        end)
        if hum.SeatPart then performTrainAutoAction(true) end
    end
end

