local lineLagThread = nil
local lineLagRunning = false

local function startLineLag()
    if lineLagRunning then return end
    lineLagRunning = true
    lineLagThread = coroutine.create(function()
        local grabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
        if not grabEvents then return end
        local createLine = grabEvents:FindFirstChild("CreateGrabLine")
        if not createLine then return end
        while lineLagRunning do
            local spawnLoc = Workspace:FindFirstChild("SpawnLocation") or Workspace:FindFirstChild("Spawn") or (player.Character and player.Character:FindFirstChild("HumanoidRootPart"))
            if spawnLoc then
                local rx, rz = math.random(-1e9, 1e9), math.random(-1e9, 1e9)
                local dirs = {CFrame.new(rx,0,rz), CFrame.new(-rx,0,-rz), CFrame.new(rx,0,-rz), CFrame.new(-rx,0,rz)}
                for _, pos in ipairs(dirs) do pcall(function() createLine:FireServer(spawnLoc, pos) end) end
            end
            task.wait()
        end
    end)
    coroutine.resume(lineLagThread)
end

local function stopLineLag()
    lineLagRunning = false
    if lineLagThread then coroutine.close(lineLagThread); lineLagThread = nil end
end

local netSpamRunning = false
local netSpamTask = nil

local function startNetSpam()
    if netSpamRunning then return end
    netSpamRunning = true
    netSpamTask = task.spawn(function()
        while netSpamRunning do
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    pcall(function()
                        local ge = ReplicatedStorage:FindFirstChild("GrabEvents")
                        if ge and ge:FindFirstChild("SetNetworkOwner") then ge.SetNetworkOwner:FireServer(hrp, hrp.CFrame) end
                    end)
                end
            end
            task.wait(0.05)
        end
    end)
end

local function stopNetSpam()
    netSpamRunning = false
    if netSpamTask then task.cancel(netSpamTask); netSpamTask = nil end
end

local function destroyServer()
    task.spawn(function()
        startLineLag()
        task.wait(1)
        local players = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then table.insert(players, {plr=p, hrp=hrp}) end
            end
        end
        local height = 35
        local radius = 40
        for idx, data in ipairs(players) do
            local angle = ((idx-1) / math.max(#players,1)) * math.pi * 2
            local x, z = math.cos(angle)*radius, math.sin(angle)*radius
            data.hrp.CFrame = CFrame.new(x, height, z)
            data.hrp.AssemblyLinearVelocity = Vector3.zero
            local bp = Instance.new("BodyPosition")
            bp.MaxForce = Vector3.new(1e9,1e9,1e9); bp.P = 40000000; bp.Position = Vector3.new(x,height,z)
            bp.Parent = data.hrp
            task.delay(2, function() pcall(function() bp:Destroy() end) end)
        end
        task.wait(2)
    end)
end

