    return espEntry
end

-- ESP有効化
local function EnableESP(espType)
    ESPEnabled = true
    SelectedESPType = espType or "Box"
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then CreateESP(p, SelectedESPType) end
    end
    local conn = Players.PlayerAdded:Connect(function(p)
        if p ~= player then
            p.CharacterAdded:Connect(function()
                if ESPEnabled then CreateESP(p, SelectedESPType) end
            end)
        end
    end)
    table.insert(ESPConnections, conn)
end

-- ESP無効化
local function DisableESP()
    ESPEnabled = false
    for _, esp in pairs(ESPObjects) do
        if esp.Data then
            for _, obj in pairs(esp.Data) do
                if obj and obj.Parent then obj:Destroy() end
            end
        end
    end
    ESPObjects = {}
    for _, conn in pairs(ESPConnections) do conn:Disconnect() end
    ESPConnections = {}
end

