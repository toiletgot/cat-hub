local function UndoLastESP()
    if #ESPObjects == 0 then
        OrionLib:MakeNotification({Name = "エラー", Content = "取り消せるESPがありません", Time = 3})
        return false
    end
    local last = ESPObjects[#ESPObjects]
    if last and last.Data then
        for _, obj in pairs(last.Data) do
            if obj and obj.Parent then obj:Destroy() end
        end
    end
    table.remove(ESPObjects)
    AddHistory("取り消し", "最後のESPを削除")
    OrionLib:MakeNotification({Name = "取り消し完了", Content = "最後のESPが削除されました", Time = 2})
    return true
end

-- 全てのESPを削除
local function RemoveAllESP()
    if #ESPObjects == 0 then
        OrionLib:MakeNotification({Name = "エラー", Content = "削除するESPがありません", Time = 3})
        return
    end
    local count = #ESPObjects
    for _, esp in pairs(ESPObjects) do
        if esp and esp.Data then
            for _, obj in pairs(esp.Data) do
                if obj and obj.Parent then obj:Destroy() end
            end
        end
    end
    ESPObjects = {}
    AddHistory("一括削除", count .. "件削除")
    OrionLib:MakeNotification({Name = "一括削除完了", Content = count .. "件のESPが削除されました", Time = 3})
end

-- 特定プレイヤーのESPを削除
local function RemoveESPFromPlayer(targetPlayer)
    local toRemove = {}
    for i, esp in pairs(ESPObjects) do
        if esp.Player == targetPlayer then table.insert(toRemove, i) end
    end
    for _, idx in pairs(toRemove) do
        local esp = ESPObjects[idx]
        if esp and esp.Data then
            for _, obj in pairs(esp.Data) do
                if obj and obj.Parent then obj:Destroy() end
            end
        end
        table.remove(ESPObjects, idx)
    end
    AddHistory("プレイヤー削除", targetPlayer.Name)
end

