    local playerColor = targetPlayer.TeamColor and targetPlayer.TeamColor.Color or Color3.new(1,0,0)
    local espData = {}
    
    if espType == "Box" then
        local box = Instance.new("BoxHandleAdornment")
        box.Parent = character
        box.Size = Vector3.new(4, 6, 2)
        box.Adornee = character
        box.AlwaysOnTop = true
        box.ZIndex = 5
        box.Color3 = playerColor
        box.Transparency = 0.5
        espData.Box = box
        
    elseif espType == "Highlight" then
        local highlight = Instance.new("Highlight")
        highlight.Parent = character
        highlight.FillColor = playerColor
        highlight.FillTransparency = 0.3
        highlight.OutlineColor = Color3.new(1,1,1)
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        espData.Highlight = highlight
        
    elseif espType == "NameOnly" then
        local nameTag = Instance.new("BillboardGui")
        nameTag.Parent = character
        nameTag.Size = UDim2.new(0, 200, 0, 50)
        nameTag.Adornee = character:FindFirstChild("Head") or character
        nameTag.AlwaysOnTop = true
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Parent = nameTag
        nameLabel.Size = UDim2.new(1,0,1,0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = targetPlayer.Name
        nameLabel.TextColor3 = playerColor
        nameLabel.TextScaled = true
        nameLabel.Font = Enum.Font.GothamBold
        espData.NameTag = nameTag
        
    elseif espType == "AllInOne" then
        local highlight = Instance.new("Highlight")
        highlight.Parent = character
        highlight.FillColor = playerColor
        highlight.FillTransparency = 0.2
        highlight.OutlineColor = Color3.new(1,1,1)
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        espData.Highlight = highlight
        
        local box = Instance.new("BoxHandleAdornment")
        box.Parent = character
        box.Size = Vector3.new(4,6,2)
        box.Adornee = character
        box.AlwaysOnTop = true
        box.ZIndex = 5
        box.Color3 = playerColor
        box.Transparency = 0.3
        espData.Box = box
        
        local nameTag = Instance.new("BillboardGui")
        nameTag.Parent = character
        nameTag.Size = UDim2.new(0,200,0,50)
        nameTag.Adornee = character:FindFirstChild("Head") or character
