local antiGucciActive = false
local antiGucciConnection = nil
local safePosition = Vector3.zero
local restoreFrames = 0

local function startAntiGucci()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    safePosition = root.Position

    local map = workspace:FindFirstChild("Map")
    local folder = map and map:FindFirstChild("AlwaysHereTweenedObjects")
    local train = folder and folder:FindFirstChild("Train")
    if train then
        for _, d in ipairs(train:GetDescendants()) do
            if d:IsA("Seat") then
                root.CFrame = d.CFrame + Vector3.new(0, 2, 0)
                d:Sit(hum)
                break
            end
        end
    end

    hum:GetPropertyChangedSignal("Jump"):Connect(function()
        if hum.Jump and hum.Sit then
            restoreFrames = 15
            safePosition = root.Position
        end
    end)

    if antiGucciConnection then antiGucciConnection:Disconnect() end
    antiGucciConnection = RunService.Heartbeat:Connect(function()
        if not root or not hum then return end
        local charEvents = ReplicatedStorage:FindFirstChild("CharacterEvents")
        local ragdoll = charEvents and charEvents:FindFirstChild("RagdollRemote")
        if ragdoll then ragdoll:FireServer(root, 0) end
        if restoreFrames > 0 then
            root.CFrame = CFrame.new(safePosition)
            restoreFrames = restoreFrames - 1
        end
    end)

    task.spawn(function()
        while hum.Sit do task.wait(1) end
        task.wait(0.5)
        root.CFrame = CFrame.new(safePosition)
    end)
end

local function stopAntiGucci()
    if antiGucciConnection then
        antiGucciConnection:Disconnect()
        antiGucciConnection = nil
    end
end

