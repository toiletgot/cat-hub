ActionSection:AddButton({
    Name = "キック（浮遊シークエンス）",
    Callback = function()
        if running then running = false return end
        running = true

        local targets = {}
        if selectedPlayerName == "全員 (All)" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then table.insert(targets, p) end
            end
        else
            local p = Players:FindFirstChild(selectedPlayerName)
            if p and p.Character then table.insert(targets, p) end
        end

        if #targets == 0 then
            running = false
            OrionLib:MakeNotification({Name = "エラー", Content = "対象が見つかりません", Time = 3})
            return
        end

        task.spawn(function()
            local blob = getBlob()
            if not blob then 
                running = false 
                OrionLib:MakeNotification({Name = "エラー", Content = "Blobmanが存在しないか乗っていません！", Time = 4})
                return 
            end

            local bScript = blob:WaitForChild("BlobmanSeatAndOwnerScript")
            local grabRemote = bScript:WaitForChild("CreatureGrab")
            local releaseRemote = bScript:WaitForChild("CreatureRelease")
            local dropRemote = bScript:WaitForChild("CreatureDrop")
            local rDet = blob:WaitForChild("RightDetector")
            local rw = rDet:WaitForChild("RightWeld")
            local mainPart = blob:FindFirstChild("HumanoidRootPart") or blob:FindFirstChild("Body")

            for _, target in ipairs(targets) do
                if not running then break end
                if not target.Character then continue end
                local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
                if not tHrp then continue end

                pcall(function()
                    for _, child in ipairs(rDet:GetChildren()) do
                        if child:IsA("Weld") or child:IsA("ManualWeld") then child:Destroy() end
                    end
                    if mainPart then setFloating(mainPart, true) end

                    for i = 1, 10 do
                        local currentPivot = blob:GetPivot()
                        local armOffset = currentPivot:Inverse() * rDet.CFrame
                        blob:PivotTo(tHrp.CFrame * armOffset:Inverse())
                        grabRemote:FireServer(rDet, tHrp, rw)
                        if rDet:FindFirstChildOfClass("Weld") or rDet:FindFirstChildOfClass("ManualWeld") then break end
                        RunService.Heartbeat:Wait()
                    end
                    task.wait(0.1)
                end)
            end

            if running then
                local upPos = blob:GetPivot() * CFrame.new(0, FloatConfig.LiftHeight, 0)
                blob:PivotTo(upPos)
                task.wait(1.2)

                for _, target in ipairs(targets) do
                    if target.Character then
                        pcall(function()
                            releaseRemote:FireServer()
                            dropRemote:FireServer()
                            for _, child in ipairs(rDet:GetChildren()) do
                                if child:IsA("Weld") or child:IsA("ManualWeld") then child:Destroy() end
                            end
                            floatPlayer(target.Character)
                        end)
                    end
                end

                if FloatConfig.ReturnToGround then
                    task.wait(0.5)
                    blob:PivotTo(CFrame.new(blob:GetPivot().Position.X, 35, blob:GetPivot().Position.Z))
                end
            end

            if mainPart then setFloating(mainPart, false) end
            running = false
            OrionLib:MakeNotification({Name = "完了", Content = "シークエンスが終了しました", Time = 3})
        end)
    end
})

