-- マップパーツキャッシュ
local function getDescendantParts(descendantName)
    local parts = {}
    local map = Workspace:FindFirstChild("Map")
    if map then
        for _, descendant in ipairs(map:GetDescendants()) do
            if descendant:IsA("Part") and descendant.Name == descendantName then
                table.insert(parts, descendant)
            end
        end
    end
    return parts
end
local poisonHurtParts = getDescendantParts("PoisonHurtPart")
local paintPlayerParts = getDescendantParts("PaintPlayerPart")

-- === 5. 便利関数・コアロジック ===

local function getBlob()
    if not Character then return nil end
    for _, desc in pairs(Workspace:GetDescendants()) do
        if desc.Name == "CreatureBlobman" then
            local vs = desc:FindFirstChild("VehicleSeat")
            if vs and vs:FindFirstChild("SeatWeld") and vs.SeatWeld.Part1 and vs.SeatWeld.Part1:IsDescendantOf(Character) then
                return desc
            end
        end
    end
    return spawnedToysFolder:FindFirstChild("CreatureBlobman")
end

local function setFloating(part, enable)
    local bv = part:FindFirstChild("AntiSink")
    if enable then
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "AntiSink"
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(400000, 400000, 400000)
            bv.Parent = part
        end
    else
        if bv then bv:Destroy() end
    end
end

-- 浮遊＆高度制限付き上下運動ロジック
local function floatPlayer(targetCharacter)
    local hrp = targetCharacter:FindFirstChild("HumanoidRootPart")
    local tHum = targetCharacter:FindFirstChildWhichIsA("Humanoid")
    if not hrp then return end

    if hrp:FindFirstChild("FloatForce") then hrp.FloatForce:Destroy() end
    if hrp:FindFirstChild("FloatRotator") then hrp.FloatRotator:Destroy() end
    if hrp:FindFirstChild("FloatEffect") then hrp.FloatEffect:Destroy() end

    -- 物理フォース生成
    local bv = Instance.new("BodyVelocity")
    bv.Name = "FloatForce"
    bv.MaxForce = Vector3.new(400000, math.huge, 400000)
    bv.Velocity = Vector3.new(0, FloatConfig.UpSpeed, 0)
    bv.Parent = hrp
    Debris:AddItem(bv, FloatConfig.FloatDuration)

    if FloatConfig.RotateSpeed > 0 then
        local bav = Instance.new("BodyAngularVelocity")
        bav.Name = "FloatRotator"
        bav.AngularVelocity = Vector3.new(0, FloatConfig.RotateSpeed, 0)
        bav.MaxTorque = Vector3.new(400000, 400000, 400000)
        bav.Parent = hrp
        Debris:AddItem(bav, FloatConfig.FloatDuration)
    end

    if FloatConfig.GiveSparkles then
        local sparkles = Instance.new("Sparkles")
        sparkles.Name = "FloatEffect"
        sparkles.SparkleColor = Color3.fromRGB(0, 255, 255)
        sparkles.Parent = hrp
        Debris:AddItem(sparkles, FloatConfig.FloatDuration)
    end

    -- 上下運動および詰め込み物理制御ループ
    task.spawn(function()
        local startTime = tick()
        local seed = math.random(1, 100)
        
        if FloatConfig.GravityDefiance and tHum then
            tHum.PlatformStand = true -- 自由落下や起き上がり判定を無効化
        end

        while tick() - startTime < FloatConfig.FloatDuration and hrp and bv.Parent do
            local elapsed = tick() - startTime
            local currentPos = hrp.Position
            
            -- 横風乱気流ノイズ計算
            local windX = math.sin(elapsed * 5 + seed) * FloatConfig.WindTurbulence
            local windZ = math.cos(elapsed * 5 + seed) * FloatConfig.WindTurbulence

            -- 高度判定による上下運動（ピストン運動）への切り替え
            if currentPos.Y >= FloatConfig.TriggerHeight then
                -- サイン波を使用した滑らかな上下バウンド速度を計算
                local bounceY = math.cos(elapsed * FloatConfig.BounceSpeed) * FloatConfig.BounceAmplitude
                bv.Velocity = Vector3.new(windX, bounceY, windZ)
            else
                -- 基準高度に達するまでは指定された上昇速度を維持
                bv.Velocity = Vector3.new(windX, FloatConfig.UpSpeed, windZ)
            end
            
            RunService.Heartbeat:Wait()
        end
        
        if tHum then tHum.PlatformStand = false end
    end)
end

local function getPlayerList()
    local list = {"全員 (All)"}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(list, p.Name) end
    end
    return list
end

local function grabHandler(grabType)
    while task.wait() do
        pcall(function()
            local grabPartsFolder = Workspace:FindFirstChild("GrabParts")
            if grabPartsFolder then
                local grabPart = grabPartsFolder:FindFirstChild("GrabPart")
                local weld = grabPart and grabPart:FindFirstChildOfClass("WeldConstraint")
                local grabbedPart = weld and weld.Part1
                local enemyHead = grabbedPart and grabbedPart.Parent:FindFirstChild("Head")
                
                if enemyHead then
                    local partsTable = (grabType == "poison") and poisonHurtParts or paintPlayerParts
                    for _, part in ipairs(partsTable) do
                        part.Size = Vector3.new(2, 2, 2)
                        part.Transparency = 1
                        part.Position = enemyHead.Position
                    end
                end
            end
        end)
    end
end

local function fireGrab()
    while task.wait() do
        pcall(function()
            local grabParts = Workspace:FindFirstChild("GrabParts")
            local grabPart = grabParts and grabParts:FindFirstChild("GrabPart")
            local weld = grabPart and grabPart:FindFirstChildOfClass("WeldConstraint")
            local grabbedPart = weld and weld.Part1
            if grabbedPart and grabbedPart.Parent:FindFirstChild("HumanoidRootPart") then
                local targetHrp = grabbedPart.Parent.HumanoidRootPart
                if not spawnedToysFolder:FindFirstChild("Campfire") then
                    SpawnToyRemote:InvokeServer("Campfire", CFrame.new(Vector3.new(-72.93, -5.96, -265.54)), Vector3.new(0, 90, 0))
                    task.wait(0.2)
                end
                local campfire = spawnedToysFolder:FindFirstChild("Campfire")
                local burnPart = campfire and (campfire:FindFirstChild("FirePlayerPart") or campfire:FindFirstChild("BurnPart"))
                if burnPart then
                    burnPart.Size = Vector3.new(7, 7, 7)
                    burnPart.Position = targetHrp.Position
                    task.wait(0.3)
                    burnPart.Position = Vector3.new(0, -50, 0)
                end
            end
        end)
    end
end

local function noclipGrab()
    while task.wait() do
        pcall(function()
            local grabParts = Workspace:FindFirstChild("GrabParts")
            local grabPart = grabParts and grabParts:FindFirstChild("GrabPart")
            local weld = grabPart and grabPart:FindFirstChildOfClass("WeldConstraint")
            local grabbedPart = weld and weld.Part1
            if grabbedPart and grabbedPart:IsA("BasePart") then
                grabbedPart.CanCollide = false
                SetNetworkOwner:FireServer(grabbedPart, grabbedPart.CFrame)
            end
        end)
    end
end

local function spinGrabLoop()
    while task.wait() do
        pcall(function()
            local grabParts = Workspace:FindFirstChild("GrabParts")
            local grabPart = grabParts and grabParts:FindFirstChild("GrabPart")
            local weld = grabPart and grabPart:FindFirstChildOfClass("WeldConstraint")
            local grabbedPart = weld and weld.Part1
            if grabbedPart and grabbedPart.Parent:FindFirstChild("HumanoidRootPart") then
                local targetHrp = grabbedPart.Parent.HumanoidRootPart
                if not targetHrp:FindFirstChild("GrabSpinForce") then
                    local bav = Instance.new("BodyAngularVelocity")
                    bav.Name = "GrabSpinForce"
                    bav.AngularVelocity = Vector3.new(0, 50, 0) 
                    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    bav.Parent = targetHrp
                    Debris:AddItem(bav, 3) 
                end
            end
        end)
    end
end

local function sitJumpF()
    while sitJumpT do
        local bman = getBlob()
        if bman and Humanoid then
            local seat = bman:FindFirstChildWhichIsA("VehicleSeat")
            if seat and seat.Occupant ~= Humanoid then seat:Sit(Humanoid) end
        end
        task.wait(0.1)
        if Humanoid then Humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
        task.wait(0.1)
    end
end

local function ragdollLoopF()
    while autoGucciT do
        if HumanoidRootPart then RagdollRemote:FireServer(HumanoidRootPart, 0) end
        task.wait()
    end
end


