-- Orion X (BlizTBr版) 読み込み
local OrionLib = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/BlizTBr/scripts/main/Orion%20X"
))()

-- ウィンドウ作成
local Window = OrionLib:MakeWindow({
    Name = "Orion X",
    HidePremium = false,
    SaveConfig = false,
    IntroEnabled = false
})

-- ===== 「スプリクト」タブ =====
local ScriptTab = Window:MakeTab({
    Name = "スプリクト",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- ===== ボタンをセクションで囲んで隙間を作る関数 =====
local function AddButtonWithFix(name, url)
    -- 新しいセクションを作ってその中にボタンを配置（これで上下に大きな余白ができる）
    local NewSection = ScriptTab:AddSection({
        Name = "ーー " .. name .. " ーー"
    })
    NewSection:AddButton({
        Name = "実行：" .. name,
        Callback = function() loadstring(game:HttpGet(url))() end
    })
end

