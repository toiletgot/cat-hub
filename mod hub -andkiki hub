local function connectCharacter(char)
    char:WaitForChild("HumanoidRootPart")
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("BasePart") then
            v.Touched:Connect(function(hit) if mode ~= "None" then registerPart(hit) end end)
        end
    end
end
player.CharacterAdded:Connect(connectCharacter)
if player.Character then connectCharacter(player.Character) end

local timeCounter = 0
RunService.Heartbeat:Connect(function()
    if mode == "None" then return end
    
    local hrp = getTargetHRP()
    if not hrp then return end
    
    -- 基準座標計算
    local baseCenterPos = hrp.Position + (hrp.CFrame.RightVector * settings.offsetX) + (hrp.CFrame.LookVector * settings.offsetY)
    
    timeCounter = timeCounter + settings.speed
    local currentParts = {}
    for o in pairs(objectData) do table.insert(currentParts, o) end
    local total = #currentParts

    for i, o in ipairs(currentParts) do
        if o and o.Parent and o:FindFirstChild("SyncForce") then
            local data = objectData[o]
            local targetPos
            
            -- ================= モード判定ロジック =================
            if mode == "MagicCircle" then
                local angle = (timeCounter * 2) + (i / max(1, total) * pi * 2)
                local s = settings.width / 2; local res = 0.2
                local x = sign(cos(angle)) * pow(abs(cos(angle)), res) * s
                local z = sign(sin(angle)) * pow(abs(sin(angle)), res) * s
                local tilt = CFrame.Angles(rad(11.5), 0, rad(11.5))
                targetPos = baseCenterPos + Vector3.new(0, settings.height, 0) + (tilt * Vector3.new(x, 0, z))
                o.SyncGyro.CFrame = hrp.CFrame * tilt * CFrame.Angles(0, angle, 0)
            elseif mode == "Orbit" then
                local angle = timeCounter + (i * (pi * 2 / max(1, total)))
                targetPos = baseCenterPos + Vector3.new(cos(angle) * settings.width, settings.height, sin(angle) * settings.width)
                o.SyncGyro.CFrame = CFrame.new(o.Position, baseCenterPos)
            elseif mode == "Ghost" then
                local t = timeCounter + data.seed
                targetPos = baseCenterPos + Vector3.new(sin(t * 0.7) * settings.width, cos(t * 0.5) * (settings.width * 0.5) + settings.height, sin(t * 0.3) * settings.width)
                o.SyncGyro.CFrame = o.SyncGyro.CFrame * CFrame.Angles(0.05, 0.05, 0.05)
            elseif mode == "Manji" then
                local b = (i - 1) % 4
                local a = (b * pi / 2) + (timeCounter * 1.5)
                local sIdx = math.floor((i - 1) / 4)
                local r = min(1, sIdx / (max(1, total/4) * 0.6 + 0.1))
                targetPos = baseCenterPos + Vector3.new(cos(a) * (r * settings.width), settings.height, sin(a) * (r * settings.width))
                o.SyncGyro.CFrame = CFrame.new(Vector3.zero, Vector3.new(cos(a), 0, sin(a)))
            elseif mode == "Divine" then
                local a = (i / max(1, total)) * pi * 2 + (timeCounter * 0.5)
                targetPos = baseCenterPos + Vector3.new(cos(a) * settings.width, settings.height + sin(timeCounter + i) * 0.5, sin(a) * settings.width)
                o.SyncGyro.CFrame = CFrame.new(o.Position, baseCenterPos + Vector3.new(0, 10, 0))
            elseif mode == "Geometry" then
                local n = 12 
                local sA = timeCounter * 1.5 + data.phase
                local lA = ((i - 1) % n / n) * pi * 2 + (timeCounter * 0.2)
                targetPos = baseCenterPos + Vector3.new(cos(lA) * settings.width + cos(sA) * 5, settings.height, sin(lA) * settings.width + sin(sA) * 5)
                o.SyncGyro.CFrame = CFrame.new(o.Position, targetPos + Vector3.new(cos(lA), 0, sin(lA)))
            elseif mode == "Diagonal" then
                local progress = (i / max(1, total)) * 2 - 1
                local angle = timeCounter * 2
                local offsetDirection
                if i % 2 == 0 then offsetDirection = Vector3.new(progress, progress, 0)
                else offsetDirection = Vector3.new(-progress, progress, 0) end
                local rotatedOffset = CFrame.Angles(0, angle, 0) * (offsetDirection * settings.width)
                targetPos = baseCenterPos + Vector3.new(0, settings.height, 0) + rotatedOffset
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(timeCounter, timeCounter, 0)
            elseif mode == "Square" then
                local side = (i - 1) % 4
                local countPerSide = max(1, total / 4)
                local inSideIndex = math.floor((i - 1) / 4)
                local progress = (inSideIndex / countPerSide) * 2 - 1
                local halfW = settings.width
                local offsetDirection
                if side == 0 then offsetDirection = Vector3.new(progress * halfW, 0, -halfW)
                elseif side == 1 then offsetDirection = Vector3.new(progress * halfW, 0, halfW)
                elseif side == 2 then offsetDirection = Vector3.new(-halfW, 0, progress * halfW)
                else offsetDirection = Vector3.new(halfW, 0, progress * halfW) end
                local angle = timeCounter
                local rotatedOffset = CFrame.Angles(0, angle, 0) * offsetDirection
                targetPos = baseCenterPos + Vector3.new(0, settings.height, 0) + rotatedOffset
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0)
            elseif mode == "Spin" then
                local orbitAngle = (timeCounter * 3) + (i / max(1, total) * pi * 2)
                local radius = settings.width * (0.6 + (i % 3) * 0.2)
                local yOffset = settings.height + sin(timeCounter * 2 + i) * 2
                targetPos = baseCenterPos + Vector3.new(cos(orbitAngle) * radius, yOffset, sin(orbitAngle) * radius)
                local spinAngle = timeCounter * 15
                o.SyncGyro.CFrame = CFrame.new(o.Position, targetPos) * CFrame.Angles(spinAngle, spinAngle * 0.5, spinAngle * 0.2)
            elseif mode == "MagicCircle2" then
                local angle, radius
                local halfTotal = max(1, total / 2)
                if i % 2 == 0 then
                    angle = (timeCounter * 1.8) + ((i / 2) / halfTotal * pi * 2)
                    radius = settings.width
                else
                    angle = -(timeCounter * 1.8) + (((i + 1) / 2) / halfTotal * pi * 2)
                    radius = settings.width * 0.55
                end
                local res = 0.25
                local x = sign(cos(angle)) * pow(abs(cos(angle)), res) * radius
                local z = sign(sin(angle)) * pow(abs(sin(angle)), res) * radius
                local wave = sin(timeCounter * 2.5 + i) * 1.5
                local tilt = CFrame.Angles(rad(8), 0, rad(8))
                targetPos = baseCenterPos + Vector3.new(0, settings.height + wave, 0) + (tilt * Vector3.new(x, 0, z))
                o.SyncGyro.CFrame = hrp.CFrame * tilt * CFrame.Angles(0, angle, timeCounter)
            elseif mode == "Barrier" then
                local limb = (i - 1) % 6
                local countPerLimb = max(1, total / 6)
                local inLimbIndex = math.floor((i - 1) / 6)
                local progress = inLimbIndex / countPerLimb
                local scale = settings.width * 0.4
                local localOffset = Vector3.zero
                local behindDist = -scale * 1.2
                local baseHeight = settings.height
                if limb == 0 then
                    local angle = progress * pi * 2 + (timeCounter * 2)
                    localOffset = Vector3.new(cos(angle) * (scale * 0.3), baseHeight + scale * 1.2 + sin(angle) * (scale * 0.1), behindDist)
                elseif limb == 1 then
                    local yPos = baseHeight + (1 - progress * 2) * (scale * 0.5)
                    localOffset = Vector3.new(0, yPos, behindDist)
                elseif limb == 2 then
                    localOffset = Vector3.new(scale * 0.4 + progress * scale * 0.8, baseHeight + scale * 0.3 - progress * scale * 0.4, behindDist)
                elseif limb == 3 then
                    localOffset = Vector3.new(-(scale * 0.4 + progress * scale * 0.8), baseHeight + scale * 0.3 - progress * scale * 0.4, behindDist)
                elseif limb == 4 then
                    localOffset = Vector3.new(scale * 0.2 + progress * scale * 0.6, baseHeight - scale * 0.5 - progress * scale * 1.0, behindDist)
                    localOffset = localOffset + Vector3.new(0, 0, sin(timeCounter * 3 + progress) * 0.5)
                else
                    localOffset = Vector3.new(-(scale * 0.2 + progress * scale * 0.6), baseHeight - scale * 0.5 - progress * scale * 1.0, behindDist)
                    localOffset = localOffset + Vector3.new(0, 0, -sin(timeCounter * 3 + progress) * 0.5)
                end
                targetPos = (hrp.CFrame * CFrame.new(localOffset)).Position
                o.SyncGyro.CFrame = hrp.CFrame
            elseif mode == "Pillar" then
                local pillarIndex = (i - 1) % 6
                local inPillarIndex = math.floor((i - 1) / 6)
                local angle = (pillarIndex * (pi * 2 / 6)) + (timeCounter * 0.5)
                local radius = settings.width
                local baseX = cos(angle) * radius
                local baseZ = sin(angle) * radius
                local heightSpacing = 2.2
                local yPos = settings.height + (inPillarIndex * heightSpacing)
                targetPos = baseCenterPos + Vector3.new(baseX, yPos, baseZ)
                o.SyncGyro.CFrame = CFrame.new(targetPos, baseCenterPos + Vector3.new(0, yPos - settings.height, 0))
            elseif mode == "MagicCircle3" then
                local ring = (i - 1) % 3
                local countPerRing = max(1, total / 3)
                local inRingIdx = math.floor((i - 1) / 3)
                local angle, radius
                if ring == 0 then
                    angle = (timeCounter * 1.5) + (inRingIdx / countPerRing * pi * 2)
                    radius = settings.width
                elseif ring == 1 then
                    angle = -(timeCounter * 2.2) + (inRingIdx / countPerRing * pi * 2)
                    radius = settings.width * 0.65
                else
                    angle = (timeCounter * 3.0) + (inRingIdx / countPerRing * pi * 2)
                    radius = settings.width * 0.35
                end
                local wave = sin(timeCounter * 4 - radius * 0.2) * 2
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, settings.height + wave, sin(angle) * radius)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0)
            elseif mode == "MagicCircle4" then
                local angle = (i % 2 == 0) and (timeCounter * 2.5) or -(timeCounter * 1.5)
                local radius = (i % 2 == 0) and settings.width or settings.width * 0.5
                angle = angle + (i / max(1, total) * pi * 2)
                local waveY = sin(timeCounter + i) * 1.2
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, settings.height + waveY, sin(angle) * radius)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0)
            elseif mode == "MagicCircle5" then
                local arm = (i - 1) % 3
                local inArm = math.floor((i - 1) / 3)
                local progress = inArm / max(1, total / 3)
                local angle = (arm * (pi * 2 / 3)) + timeCounter + (progress * 2)
                local radius = progress * settings.width
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, settings.height, sin(angle) * radius)
                o.SyncGyro.CFrame = CFrame.new(o.Position, baseCenterPos)
            elseif mode == "MagicCircle6" then
                local angle = timeCounter * 1.8 + (i / max(1, total) * pi * 2)
                local radius = settings.width * 0.7
                local localOffset = Vector3.new(cos(angle) * radius, sin(angle) * radius, -4)
                targetPos = (hrp.CFrame * CFrame.new(localOffset + Vector3.new(0, settings.height - 5, 0))).Position
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, 0, angle)
            elseif mode == "MagicCircle7" then
                local step = (i / max(1, total)) * pi * 2
                local starAngle = timeCounter * 1.2 + step
                local r = settings.width * (0.6 + 0.4 * sin(starAngle * 5))
                targetPos = baseCenterPos + Vector3.new(cos(starAngle) * r, settings.height, sin(starAngle) * r)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, starAngle, 0)
            elseif mode == "MagicCircle8" then
                local progress = (i / max(1, total))
                local angle = (progress * pi * 6) + timeCounter * 3
                local radius = settings.width * 0.6
                local yOffset = (settings.height - 3) + (progress * 6)
                if i % 2 == 0 then angle = angle + pi end
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, yOffset, sin(angle) * radius)
                o.SyncGyro.CFrame = CFrame.Angles(0, angle, 0)
            elseif mode == "Sun" then
                local isFlare = (i % 3 == 0)
                local t = timeCounter + data.seed
                local sunScale = settings.width * 0.3
                if not isFlare then
                    local phi = data.seed * pi
                    local theta = (i / max(1, total)) * pi * 2 + timeCounter
                    local localOffset = Vector3.new(cos(theta) * sin(phi), cos(phi), sin(theta) * sin(phi)) * sunScale
                    targetPos = baseCenterPos + Vector3.new(0, settings.height + 6, 0) + localOffset
                else
                    local angle = (i / max(1, total)) * pi * 2 + (timeCounter * 0.5)
                    local flareDist = settings.width * (0.3 + abs(sin(timeCounter * 3 + data.seed)) * 0.7)
                    targetPos = baseCenterPos + Vector3.new(cos(angle) * flareDist, settings.height + 6 + sin(t)*2, sin(angle) * flareDist)
                end
                o.SyncGyro.CFrame = CFrame.Angles(t, t, t)
            elseif mode == "Tornado" then
                local progress = ((i / max(1, total)) + (timeCounter * 1.2)) % 1
                local yOffset = (settings.height - 4) + (progress * settings.width * 1.5)
                local radius = (progress * settings.width * 0.8) + 1.5
                local angle = (timeCounter * 12) + (progress * pi * 4) + (i * (pi * 2 / 8))
                local swayX = sin(timeCounter * 3 + (yOffset * 0.2)) * 1.5
                local swayZ = cos(timeCounter * 3 + (yOffset * 0.2)) * 1.5
                targetPos = baseCenterPos + Vector3.new((cos(angle) * radius) + swayX, yOffset, (sin(angle) * radius) + swayZ)
                o.SyncGyro.CFrame = CFrame.new(o.Position, baseCenterPos + Vector3.new(swayX, yOffset - settings.height, swayZ)) * CFrame.Angles(0, timeCounter * 4, 0)
            elseif mode == "Star" then
                local pointIdx = (i - 1) % 5
                local countPerLine = max(1, total / 5)
                local inLineIdx = math.floor((i - 1) / 5)
                local progress = inLineIdx / countPerLine
                local starPoints = {0, 2, 4, 1, 3, 0}
                local p1 = starPoints[pointIdx + 1]
                local p2 = starPoints[pointIdx + 2]
                local function getStarVertex(idx)
                    local a = (idx * (pi * 2 / 5)) - (pi / 2) + timeCounter
                    return Vector3.new(cos(a), 0, sin(a)) * settings.width
                end
                targetPos = baseCenterPos + Vector3.new(0, settings.height, 0) + getStarVertex(p1):Lerp(getStarVertex(p2), progress)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, timeCounter, 0)
            elseif mode == "Pinecone" then
                local layer = (i - 1) % 5
                local inLayerIdx = math.floor((i - 1) / 5)
                local countPerLayer = max(1, total / 5)
                local progress = inLayerIdx / countPerLayer
                local yOffset = settings.height + (layer * 2) - 3
                local radius = (settings.width * 0.4) * (1 - (layer / 5) * 0.6)
                local angle = (progress * pi * 2) + (layer * pi / 4) + (timeCounter * 0.3)
                targetPos = (CFrame.new(baseCenterPos) * hrp.CFrame.Rotation * CFrame.new(cos(angle) * radius, yOffset, -settings.width * 0.5 + sin(angle) * radius)).Position
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(rad(15), angle, 0)
            elseif mode == "Meteor" then
                local t = (timeCounter * 2 + data.seed * 5) % 5
                local startOffset = Vector3.new(15, 30, 15)
                local endOffset = Vector3.new(cos(data.phase) * settings.width, settings.height - 2, sin(data.phase) * settings.width)
                local progress = t / 5
                targetPos = baseCenterPos + startOffset:Lerp(endOffset, progress)
                o.SyncGyro.CFrame = CFrame.new(startOffset, endOffset)
            elseif mode == "Stone" then
                local angle = data.phase + (timeCounter * 0.05)
                local radius = (i / max(1, total)) * (settings.width * 0.6)
                local groundY = settings.height - 3.5 + abs(sin(i * 10)) * 0.5
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, groundY, sin(angle) * radius)
                o.SyncGyro.CFrame = CFrame.Angles(data.seed, data.phase, i)
            elseif mode == "Water" then
                local waveT = (timeCounter * 1.5 + (i / max(1, total)) * pi * 2) % (pi * 2)
                local radius = settings.width * 0.4 + sin(waveT) * (settings.width * 0.3)
                local angle = (i / max(1, total)) * pi * 2 + (timeCounter * 0.2)
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, settings.height - 3, sin(angle) * radius)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, angle + pi/2, 0)
            elseif mode == "Fire" then
                local progress = ((i / max(1, total)) + (timeCounter * 0.8)) % 1
                local yPos = (settings.height - 3) + (progress * settings.width * 0.8)
                local radius = (1 - progress) * (settings.width * 0.4)
                local angle = (i * 13) + (timeCounter * 4)
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, yPos, sin(angle) * radius)
                o.SyncGyro.CFrame = CFrame.Angles(timeCounter, i, 0)
            elseif mode == "Ice" then
                local segment = (i - 1) % 6
                local inSegment = math.floor((i - 1) / 6)
                local progress = inSegment / max(1, total / 6)
                local angle = (segment * (pi * 2 / 6)) + timeCounter * 0.2
                local radius = progress * settings.width * 0.8
                local iceY = (settings.height - 3.8) + (progress * settings.height * 1.2)
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, iceY, sin(angle) * radius)
                o.SyncGyro.CFrame = CFrame.new(o.Position, baseCenterPos + Vector3.new(0, settings.height, 0)) * CFrame.Angles(rad(45), 0, 0)
            elseif mode == "Ball" then
                local phi = (i / max(1, total)) * pi
                local theta = (i * 1.618033) * (pi * 2) + timeCounter
                local radius = settings.width * 0.6
                targetPos = baseCenterPos + Vector3.new(cos(theta) * sin(phi), cos(phi), sin(theta) * sin(phi)) * radius + Vector3.new(0, settings.height, 0)
                o.SyncGyro.CFrame = CFrame.new(targetPos, baseCenterPos + Vector3.new(0, settings.height, 0))
            elseif mode == "Thread" then
                local spacing = 1.2
                local trailIndex = i
                local angle = (timeCounter * 4) - (trailIndex * 0.15)
                local waveY = sin(angle) * 2
                targetPos = (CFrame.new(baseCenterPos) * hrp.CFrame.Rotation * CFrame.new(sin(angle * 0.5) * 2, settings.height + waveY, -(trailIndex * spacing))).Position
                o.SyncGyro.CFrame = hrp.CFrame
            elseif mode == "Lightning" then
                local step = math.floor(timeCounter * 8)
                local randX = sin(step + i * 7) * (settings.width * 0.5)
                local randY = cos(step + i * 3) * (settings.width * 0.3) + settings.height
                local randZ = sin(step - i * 5) * (settings.width * 0.5)
                targetPos = baseCenterPos + Vector3.new(randX, randY, randZ)
                o.SyncGyro.CFrame = CFrame.Angles(randX, randY, randZ)
            elseif mode == "Beam" then
                local progress = (i / max(1, total))
                local length = settings.width * 2.5
                targetPos = (CFrame.new(baseCenterPos) * hrp.CFrame.Rotation * CFrame.new(0, settings.height, -(progress * length))).Position
                o.SyncGyro.CFrame = hrp.CFrame
            elseif mode == "Hammer" then
                local isHandle = (i % 3 ~= 0)
                local scale = settings.width * 0.4
                if isHandle then
                    local progress = (i / max(1, total))
                    targetPos = (CFrame.new(baseCenterPos) * hrp.CFrame.Rotation * CFrame.new(scale * 1.5, settings.height - scale + (progress * scale * 2), -scale * 0.5)).Position
                else
                    local progress = ((i % 10) / 10) * 2 - 1
                    targetPos = (CFrame.new(baseCenterPos) * hrp.CFrame.Rotation * CFrame.new(scale * 1.5 + (progress * scale * 0.6), settings.height + scale, -scale * 0.5)).Position
                end
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, 0, rad(-20))
            elseif mode == "Blackhole" then
                local angle = (timeCounter * 5) + (i * (pi * 2 / 8))
                local pullProgress = (data.seed + timeCounter * 0.4) % 1
                local radius = settings.width * 0.8 * (1 - pullProgress)
                local zOffset = sin(timeCounter + i) * 0.5
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, settings.height + 5 + zOffset, sin(angle) * radius)
                o.SyncGyro.CFrame = CFrame.new(targetPos, baseCenterPos + Vector3.new(0, settings.height + 5, 0)) * CFrame.Angles(timeCounter, 0, 0)
            elseif mode == "Rock" then
                local row = (i - 1) % 4
                local col = math.floor((i - 1) / 4) % 4
                local heightLayer = math.floor((i - 1) / 16)
                local scale = settings.width * 0.2
                local localX = (row - 1.5) * scale + sin(i) * 0.3
                local localY = (heightLayer) * scale + settings.height - 2
                local localZ = -settings.width * 0.5 + (col - 1.5) * scale + cos(i) * 0.3
                targetPos = (CFrame.new(baseCenterPos) * hrp.CFrame.Rotation * CFrame.new(localX, localY, localZ)).Position
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(data.seed, data.phase, 0)
            elseif mode == "Bug" then
                local bugStep = math.floor(timeCounter * 6)
                local offsetX = sin(bugStep + i) * settings.width * 0.6
                local offsetY = settings.height + cos(bugStep * 1.5 + i) * (settings.width * 0.3)
                local offsetZ = sin(bugStep * 2 - i) * settings.width * 0.6
                targetPos = baseCenterPos + Vector3.new(offsetX, offsetY, offsetZ)
                o.SyncGyro.CFrame = CFrame.Angles(offsetX, offsetY, offsetZ)
            elseif mode == "Supernova" then
                local cycle = 3.5
                local t = (timeCounter % cycle) / cycle
                local radius
                if t < 0.6 then radius = settings.width * 1.2 * (1 - t/0.6) + 0.1
                elseif t < 0.75 then radius = 0.1 + (((t - 0.6) / 0.15) * settings.width * 1.6)
                else radius = (settings.width * 1.6) + (((t - 0.75) / 0.25) * settings.width * 0.2) end
                local phi = data.seed * pi
                local theta = (i / max(1, total)) * pi * 2 + (timeCounter * 0.5)
                targetPos = baseCenterPos + Vector3.new(cos(theta) * sin(phi), cos(phi), sin(theta) * sin(phi)) * radius + Vector3.new(0, settings.height, 0)
                o.SyncGyro.CFrame = CFrame.Angles(timeCounter * 6, timeCounter * 4, i)
            elseif mode == "Explosion" then
                local cycle = 2.0
                local t = (timeCounter % cycle) / cycle
                local radius, yDrop
                if t < 0.2 then radius = (t / 0.2) * settings.width * (0.8 + sin(i)*0.4); yDrop = 0
                else radius = settings.width * (0.8 + sin(i)*0.4) + ((t - 0.2)/0.8 * 2); yDrop = -((t - 0.2)/0.8) * 4.5 end
                local angle = (i / max(1, total)) * pi * 2 + data.phase
                local heightOffset = settings.height + (cos(i * 7) * settings.width * 0.3) + yDrop
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, heightOffset, sin(angle) * radius)
                o.SyncGyro.CFrame = CFrame.Angles(timeCounter * 12, i, timeCounter * 5)
            elseif mode == "Bomb" then
                local bombScale = settings.width * 0.4
                local phi = data.seed * pi
                local theta = (i / max(1, total)) * pi * 2 + (timeCounter * 0.2)
                targetPos = (CFrame.new(baseCenterPos) * hrp.CFrame.Rotation * CFrame.new(cos(theta) * sin(phi) * bombScale, settings.height + sin(theta) * sin(phi) * bombScale, -bombScale * 1.5)).Position
                o.SyncGyro.CFrame = hrp.CFrame
            elseif mode == "Magma" then
                local angle = (i / max(1, total)) * pi * 2
                local radius = settings.width * 0.5 + sin(timeCounter + i) * 2
                local waveY = settings.height - 3.8 + sin(timeCounter * 2 + (i % 5)) * 0.6
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, waveY, sin(angle) * radius)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(rad(90), 0, angle)
            elseif mode == "Hexagon" then
                local side = (i - 1) % 6
                local countPerSide = max(1, total / 6)
                local inSideIdx = math.floor((i - 1) / 6)
                local progress = inSideIdx / countPerSide
                local function getHexVertex(idx)
                    local a = (idx * (pi * 2 / 6)) + (timeCounter * 0.6)
                    return Vector3.new(cos(a), sin(a), 0) * (settings.width * 0.5)
                end
                local localOffset = getHexVertex(side):Lerp(getHexVertex(side + 1), progress) + Vector3.new(0, settings.height, -settings.width * 0.6)
                targetPos = (hrp.CFrame * CFrame.new(localOffset)).Position
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, 0, timeCounter * 0.6)
            elseif mode == "Rice" then
                local t = timeCounter * 3 + data.seed * 10
                local radius = settings.width * 0.4 + sin(timeCounter * 0.5 + data.phase) * 3
                local angle = data.phase + (timeCounter * 0.3)
                local hoverY = settings.height + sin(t) * 1.2
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, hoverY, sin(angle) * radius)
                o.SyncGyro.CFrame = CFrame.Angles(t, angle, sin(t * 2))
            elseif mode == "Expansion" then
                local cycle = 4.0
                local t = (timeCounter % cycle) / cycle
                local phi = data.seed * pi
                local theta = (i / max(1, total)) * pi * 2 + (timeCounter * 0.2)
                local radius = settings.width * 0.9 * t
                targetPos = baseCenterPos + Vector3.new(cos(theta) * sin(phi), cos(phi), sin(theta) * sin(phi)) * radius + Vector3.new(0, settings.height, 0)
                o.SyncGyro.CFrame = CFrame.new(targetPos, baseCenterPos + Vector3.new(0, settings.height, 0))
            elseif mode == "Dirt" then
                local t = timeCounter * 2 + data.seed * 8
                local radius = (abs(sin(t * 0.5)) * settings.width * 0.7) + 2
                local angle = data.phase + (timeCounter * 0.4)
                local dirtY = settings.height - 3.8 + (abs(cos(t * 3)) * 1.5)
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, dirtY, sin(angle) * radius)
                o.SyncGyro.CFrame = CFrame.Angles(t, i, t * 0.5)
            elseif mode == "Carpet" then
                local sideSize = math.ceil(math.sqrt(max(1, total)))
                local spacing = 2.5
                local offsetX = ((i - 1) % sideSize - (sideSize / 2)) * spacing
                local offsetZ = (math.floor((i - 1) / sideSize) - (sideSize / 2)) * spacing
                targetPos = (hrp.CFrame * CFrame.new(offsetX, settings.height - 3.8, offsetZ)).Position
                o.SyncGyro.CFrame = hrp.CFrame
            elseif mode == "Heart" then
                local angle = (i / max(1, total)) * pi * 2
                local hx = 16 * pow(sin(angle), 3)
                local hz = 13 * cos(angle) - 5 * cos(2 * angle) - 2 * cos(3 * angle) - cos(4 * angle)
                local scale = settings.width * 0.05
                local localOffset = Vector3.new(hx * scale, hz * scale + settings.height, -5)
                targetPos = baseCenterPos + (CFrame.Angles(0, timeCounter, 0) * localOffset)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, timeCounter, 0)
            elseif mode == "Triangle" or mode == "Pentagon" or mode == "HexagonNew" or mode == "Heptagon" then
                local sidesMap = {Triangle = 3, Pentagon = 5, HexagonNew = 6, Heptagon = 7}
                local sides = sidesMap[mode]
                local side = (i - 1) % sides
                local progress = math.floor((i - 1) / sides) / max(1, total / sides)
                local function getVertex(idx)
                    local a = (idx * (pi * 2 / sides)) + timeCounter
                    return Vector3.new(cos(a), 0, sin(a)) * settings.width
                end
                targetPos = baseCenterPos + Vector3.new(0, settings.height, 0) + getVertex(side):Lerp(getVertex(side + 1), progress)
                o.SyncGyro.CFrame = CFrame.new(o.Position, baseCenterPos)
            elseif mode == "SunNew" then
                local t = timeCounter + data.seed * 5
                local radius = settings.width * 0.35
                local flare = sin(timeCounter * 4 + i) * (settings.width * 0.15)
                local phi = (i / max(1, total)) * pi
                local theta = (i * 1.7) * pi * 2 + (timeCounter * 0.5)
                targetPos = baseCenterPos + Vector3.new(cos(theta) * sin(phi), cos(phi), sin(theta) * sin(phi)) * (radius + flare) + Vector3.new(0, settings.height + 5, 0)
                o.SyncGyro.CFrame = CFrame.Angles(t, t, 0)
            elseif mode == "Wings" then
                local isRight = (i % 2 == 0)
                local idx = math.floor((i - 1) / 2)
                local countPerWing = max(1, total / 2)
                local progress = idx / countPerWing
                local flap = sin(timeCounter * 3) * rad(20)
                local wingAngle = isRight and (rad(30) + flap) or (-rad(30) - flap)
                local extX = isRight and (progress * settings.width * 0.6) or (-progress * settings.width * 0.6)
                local extY = progress * settings.height * 0.8 - (progress * progress * 2)
                local localOffset = Vector3.new(extX + (isRight and 1.5 or -1.5), settings.height + extY, -1.2)
                targetPos = (hrp.CFrame * CFrame.new(localOffset)).Position
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, wingAngle, 0)
            elseif mode == "Cosmos" then
                local orbitIdx = (i % 3) + 1
                local radius = settings.width * (0.3 * orbitIdx)
                local angle = (timeCounter * (2 / orbitIdx)) + (i * (pi * 2 / max(1, total)))
                local tilt = CFrame.Angles(rad(15 * (orbitIdx - 2)), 0, rad(10 * (orbitIdx - 2)))
                targetPos = baseCenterPos + Vector3.new(0, settings.height, 0) + (tilt * Vector3.new(cos(angle) * radius, sin(timeCounter + i) * 0.5, sin(angle) * radius))
                o.SyncGyro.CFrame = CFrame.Angles(timeCounter, timeCounter, 0)
            elseif mode == "BigBang" then
                local cycle = 3.0
                local t = (timeCounter % cycle) / cycle
                local radius
                if t < 0.25 then radius = 0.1 + (t / 0.25) * 1.5
                else radius = 1.5 + ((t - 0.25) / 0.75) * settings.width * 1.8 end
                local phi = data.seed * pi
                local theta = (i * 2.3) * pi * 2 + timeCounter
                targetPos = baseCenterPos + Vector3.new(cos(theta) * sin(phi), cos(phi), sin(theta) * sin(phi)) * radius + Vector3.new(0, settings.height, 0)
                o.SyncGyro.CFrame = CFrame.Angles(timeCounter * 8, i, 0)
            elseif mode == "Umbrella" then
                local angle = (i / max(1, total)) * pi * 2 + timeCounter
                local radius = settings.width * 0.6
                local slopeY = (1 - (radius / settings.width)) * 3
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, settings.height + 4 - slopeY, sin(angle) * radius)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, angle, rad(15))
            elseif mode == "ThreeSpheres" then
                local group = i % 3
                local groupAngle = (timeCounter * 1.5) + (group * pi * 2 / 3)
                local groupCenter = baseCenterPos + Vector3.new(cos(groupAngle) * settings.width, settings.height, sin(groupAngle) * settings.width)
                local inGroupIdx = math.floor((i - 1) / 3)
                local phi = (inGroupIdx * 0.1) * pi
                local theta = (inGroupIdx * 1.5) * pi * 2 + (timeCounter * 4)
                local subRadius = 2.5
                targetPos = groupCenter + Vector3.new(cos(theta) * sin(phi), cos(phi), sin(theta) * sin(phi)) * subRadius
                o.SyncGyro.CFrame = CFrame.new(targetPos, groupCenter)
            elseif mode == "Earthquake" then
                local step = math.floor(timeCounter * 10)
                local shakeX = sin(step + i) * 2.5
                local shakeY = cos(step * 1.3 + i) * 1.8
                local shakeZ = cos(step + i * 2) * 2.5
                local radius = settings.width * 0.5
                local angle = data.phase
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius + shakeX, settings.height - 3.8 + shakeY, sin(angle) * radius + shakeZ)
                o.SyncGyro.CFrame = CFrame.Angles(shakeX, shakeZ, 0)
            elseif mode == "Cloud" then
                local t = timeCounter * 0.5 + data.seed
                local cloudW = settings.width * 0.6
                local cx = sin(t * 0.6 + i) * cloudW
                local cy = settings.height + 5 + cos(t * 0.8 + i) * 2.0
                local cz = cos(t * 0.5 - i) * cloudW
                targetPos = baseCenterPos + Vector3.new(cx, cy, cz)
                o.SyncGyro.CFrame = CFrame.Angles(0, t, 0)
            elseif mode == "ShootingStar" then
                local fallT = (timeCounter * 1.8 + data.seed * 10) % 6
                local progress = fallT / 6
                local startPos = Vector3.new(cos(data.phase) * settings.width * 1.5, 25, sin(data.phase) * settings.width * 1.5)
                local endPos = Vector3.new(cos(data.phase) * settings.width * 0.4, settings.height - 3.5, sin(data.phase) * settings.width * 0.4)
                targetPos = baseCenterPos + startPos:Lerp(endPos, progress)
                o.SyncGyro.CFrame = CFrame.new(startPos, endPos)
            elseif mode == "Concept" then
                local warpCycle = math.floor(timeCounter * 1.5)
                if warpCycle % 2 == 0 then
                    local angle = (i / max(1, total)) * pi * 2 + (timeCounter * 5)
                    targetPos = baseCenterPos + Vector3.new(cos(angle) * settings.width, settings.height + sin(timeCounter * 10) * 4, sin(angle) * settings.width)
                else
                    local randX = sin(warpCycle + i * 5) * (settings.width * 1.2)
                    local randY = cos(warpCycle - i * 3) * settings.height
                    local randZ = cos(warpCycle + i * 2) * (settings.width * 1.2)
                    targetPos = baseCenterPos + Vector3.new(randX, randY, randZ)
                end
                o.SyncGyro.CFrame = CFrame.Angles(timeCounter, timeCounter, timeCounter)

            -- ================= 今回の追加モード =================
            elseif mode == "Sand" then
                local t = timeCounter * 2 + data.seed * 5
                local radius = settings.width * 0.5 + sin(t * 0.5) * 2
                local angle = data.phase + (timeCounter * 1.2)
                local sandY = settings.height - 3.8 + (sin(t + i) * 0.8)
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, sandY, sin(angle) * radius)
                o.SyncGyro.CFrame = CFrame.Angles(t, angle, 0)

            elseif mode == "Candle" then
                local angle = (i / max(1, total)) * pi * 2
                local radius = settings.width * 0.6
                local flicker = sin(timeCounter * 4 + i) * 0.6
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, settings.height - 2 + flicker, sin(angle) * radius)
                o.SyncGyro.CFrame = hrp.CFrame

            elseif mode == "Light" then
                local speedMult = 5
                local length = settings.width * 0.8
                local pulse = abs(sin(timeCounter * speedMult + data.seed * pi)) * length
                local phi = data.seed * pi
                local theta = (i / max(1, total)) * pi * 2
                targetPos = baseCenterPos + Vector3.new(cos(theta) * sin(phi), cos(phi), sin(theta) * sin(phi)) * pulse + Vector3.new(0, settings.height, 0)
                o.SyncGyro.CFrame = CFrame.new(baseCenterPos, targetPos)

            elseif mode == "God" then
                local innerI = (i - 1) % 2
                local ringIdx = math.floor((i - 1) / 2)
                local angle = (ringIdx / max(1, total / 2)) * pi * 2 + (timeCounter * 0.5)
                local radius = (innerI == 0) and (settings.width * 0.5) or (settings.width * 0.8)
                local localOffset = Vector3.new(cos(angle) * radius, sin(angle) * radius + settings.height + 2, -2.5)
                targetPos = (hrp.CFrame * CFrame.new(localOffset)).Position
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, 0, angle)

            elseif mode == "MagicCircle9" then
                local isTriangle2 = (i % 2 == 0)
                local idx = math.floor((i - 1) / 2)
                local progress = (idx % 3) + ((math.floor(idx / 3) / max(1, total / 6)) % 1)
                local side = math.floor(progress) % 3
                local p = progress % 1
                local rotAngle = timeCounter * 1.5 + (isTriangle2 and pi or 0)
                local function getVertex(idx)
                    local a = (idx * (pi * 2 / 3)) + rotAngle
                    return Vector3.new(cos(a), 0, sin(a)) * settings.width
                end
                targetPos = baseCenterPos + Vector3.new(0, settings.height, 0) + getVertex(side):Lerp(getVertex(side + 1), p)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, rotAngle, 0)

            elseif mode == "MagicCircle10" then
                local isOuter = (i % 2 == 0)
                local angle = (i / max(1, total)) * pi * 2
                local radius, finalAngle
                if isOuter then
                    finalAngle = angle + timeCounter * 2.0
                    radius = settings.width
                else
                    finalAngle = -angle - timeCounter * 1.5
                    radius = settings.width * 0.6
                end
                local waveY = sin(timeCounter * 3 + (radius * 0.3)) * 1.5
                targetPos = baseCenterPos + Vector3.new(cos(finalAngle) * radius, settings.height + waveY, sin(finalAngle) * radius)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, finalAngle, 0)
            end
            
            if targetPos then o.SyncForce.Velocity = (targetPos - o.Position) * 18 end
            if math.random() > 0.95 then pcall(function() o:SetNetworkOwner(player) end) end
        else
            objectData[o] = nil; hoveringObjects[o] = nil
        end
    end
end)

OrionLib:Init()
