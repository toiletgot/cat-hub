-- --- 物理管理関数 ---
local function clearObjects()
    for o in pairs(hoveringObjects) do
        pcall(function()
            if o and o.Parent then
                o.CanCollide = true
                if o:FindFirstChild("SyncForce") then o.SyncForce:Destroy() end
                if o:FindFirstChild("SyncGyro") then o.SyncGyro:Destroy() end
            end
        end)
    end
    hoveringObjects = {}; objectData = {}
end

local function registerPart(part)
    if not part:IsA("BasePart") or part.Anchored then return end
    if player.Character and part:IsDescendantOf(player.Character) then return end
    if hoveringObjects[part] then return end 

    hoveringObjects[part] = true
    objectData[part] = { seed = math.random() * 100, phase = math.random() * pi * 2 }
    
    local bv = Instance.new("BodyVelocity")
    bv.Name = "SyncForce"; bv.MaxForce = Vector3.new(1,1,1)*1e6; bv.Velocity = Vector3.zero; bv.Parent = part
    local bg = Instance.new("BodyGyro")
    bg.Name = "SyncGyro"; bg.MaxTorque = Vector3.new(1,1,1)*1e6; bg.Parent = part
    
    part.CanCollide = false
    pcall(function() part:SetNetworkOwner(player) end)
end

-- --- ターゲット取得関数 ---
local function getTargetHRP()
    local targetPlr = Players:FindFirstChild(targetPlayerName)
    if targetPlayerName == "自分自身" or not targetPlr then
        return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    end
    return targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart")
end

-- --- プレイヤーリストの更新処理 ---
local function getPlayerList()
    local list = {"自分自身"}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p.Name) end
    end
    return list
end

