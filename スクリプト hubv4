-- 「スクリプト」タブのボタン生成
for _, hub in ipairs(hubs) do
    MainGroup:AddButton({
        Text = hub.name .. " を読み込む",
        Func = function()
            local baseUrl = "https://raw.githubusercontent.com/toiletgot/" .. hub.repo .. "/"
            local path = hub.isMain and "main/" or "refs/heads/main/"
            
            loadstring(game:HttpGet(baseUrl .. path .. hub.url))()
            Library:Notify(hub.name .. " を読み込みました！", 3)
        end,
        DoubleClick = false
    })
end

-- 「他スクリプト」タブのボタン生成
for _, item in ipairs(otherScripts) do
    OtherGroup:AddButton({
        Text = item.name .. " を読み込む",
        Func = function()
            if item.customFunc then
                item.customFunc()
                Library:Notify(item.name .. " を読み込みました！", 3)
            elseif item.url and item.url ~= "" then
                if item.isRaw then
                    loadstring(game:HttpGet(item.url, true))()
                else
                    loadstring(game:HttpGet(item.url))()
                end
                Library:Notify(item.name .. " を読み込みました！", 3)
            else
                Library:Notify(item.name .. " のURLが見つかりません", 3)
            end
        end,
        DoubleClick = false
    })
end

