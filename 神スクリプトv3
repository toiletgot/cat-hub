-- 安全なスクリプト読み込み関数
local function SafeLoadScript(url, scriptName)
    local success, result = pcall(function()
        local content = game:HttpGet(url)
        return loadstring(content)
    end)
    
    if success and result then
        local execSuccess, execResult = pcall(result)
        if execSuccess then
            Library:Notify(scriptName .. " を読み込みました！", 3)
            return true
        else
            Library:Notify(scriptName .. " の実行に失敗しました", 5)
            return false
        end
    else
        Library:Notify(scriptName .. " の読み込みに失敗しました", 5)
        return false
    end
end

