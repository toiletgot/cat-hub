-- スクリプトボタンを生成
local function CreateScriptButton(group, scriptData)
    local baseUrl = "https://raw.githubusercontent.com/toiletgot/" .. scriptData.repo .. "/"
    local path = scriptData.isMain and "main/" or "refs/heads/main/"
    local url = baseUrl .. path .. scriptData.url
    
    group:AddButton({
        Text = scriptData.name .. " を読み込む",
        Func = function()
            SafeLoadScript(url, scriptData.name)
        end,
        DoubleClick = false
    })
end

