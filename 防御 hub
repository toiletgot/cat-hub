                    Config.notifiedNoCoins = true
                end
                return
            end
        end
        local kunai = sv_Workspace:FindFirstChild(sv_Local.Name.."SpawnedInToys"):FindFirstChild("NinjaKunai")
        if kunai then
            local sticky = kunai:WaitForChild("StickyPart", 1)
            if sticky then
                local weld = sticky:FindFirstChild("StickyWeld")
                local attachedPart = weld and weld.Part1
                if not weld or attachedPart ~= leg then
                    sv_RepStorage.MenuToys.DestroyToy:FireServer(kunai)
                    task.wait(0.1)
                end
            else
                sv_RepStorage.MenuToys.DestroyToy:FireServer(kunai)
                task.wait(0.1)
            end
        elseif sv_Local.CanSpawnToy.Value then
            task.spawn(inner_toyspn2, "NinjaKunai")
            local newKunai = sv_Workspace:FindFirstChild(sv_Local.Name.."SpawnedInToys"):WaitForChild("NinjaKunai", 3)
            if newKunai then
                local sticky = newKunai:WaitForChild("StickyPart", 2)
                if sticky then
                    local weld = sticky:WaitForChild("StickyWeld", 2)
                    sv_RepStorage.GrabEvents.SetNetworkOwner:FireServer(sticky, sticky.CFrame)
                    local retry = 0
                    while Config.AntiKickV2 and weld.Part1 == nil and retry < 20 do
                        sv_RepStorage.PlayerEvents.StickyPartEvent:FireServer(sticky, leg,
                            CFrame.new(0.0490287527, 0.5, 0, 0, 0.00739139877, -0.999561906,
                                -0.998452604, -0.0478846952, 0.0282763243, -0.0476547107, 0.99882561,
                                0) * CFrame.Angles(0, 0, 0))
                        task.wait(0.1)
                        retry = retry + 1
                    end
                end
            end
        end
    end
    
    task.spawn(function()
        while Config.AntiKickV2 do
            pcall(f)
            task.wait()
        end
    end)
end

