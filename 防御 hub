-- ---------- アンチラグドール ----------
local antiRagdollConnections = {}
local antiRagdollCharAddedConn = nil

local function EnableAntiRagdoll()
    Config.AntiRagdoll = true
    local function clearConnections()
        for _, conn in ipairs(antiRagdollConnections) do
            if conn then conn:Disconnect() end
        end
        antiRagdollConnections = {}
    end
    local function protectHumanoid(humanoid)
        humanoid.BreakJointsOnDeath = false
        humanoid.AutoRotate = true
        humanoid.PlatformStand = false
        table.insert(antiRagdollConnections, humanoid.HealthChanged:Connect(function(health)
            if Config.AntiRagdoll and health <= 0 then
                humanoid.Health = 1
            end
        end))
        table.insert(antiRagdollConnections, humanoid:GetPropertyChangedSignal("AutoRotate"):Connect(function()
            if Config.AntiRagdoll and not humanoid.AutoRotate then
                humanoid.AutoRotate = true
            end
        end))
        table.insert(antiRagdollConnections, humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
            if Config.AntiRagdoll and humanoid.PlatformStand then
                humanoid.PlatformStand = false
            end
        end))
        table.insert(antiRagdollConnections, sv_Run.RenderStepped:Connect(function()
            if Config.AntiRagdoll and humanoid.Sit and humanoid.SeatPart == nil then
                humanoid.Sit = false
            end
        end))
    end
    local function onCharacter(char)
        local humanoid = char:WaitForChild("Humanoid", 5)
        if humanoid and Config.AntiRagdoll then
            protectHumanoid(humanoid)
        end
    end
    local character = sv_Local.Character
    if character then onCharacter(character) end
    antiRagdollCharAddedConn = sv_Local.CharacterAdded:Connect(onCharacter)
end

local function DisableAntiRagdoll()
    Config.AntiRagdoll = false
    for _, conn in ipairs(antiRagdollConnections) do
        if conn then conn:Disconnect() end
    end
    antiRagdollConnections = {}
    if antiRagdollCharAddedConn then
        antiRagdollCharAddedConn:Disconnect()
        antiRagdollCharAddedConn = nil
    end
end

-- ---------- アンチウォーター ----------
local function EnableAntiWater()
    Config.AntiWater = true
    local oceanPath = sv_Workspace:FindFirstChild("Map")
        and sv_Workspace.Map:FindFirstChild("AlwaysHereTweenedObjects")
        and sv_Workspace.Map.AlwaysHereTweenedObjects:FindFirstChild("Ocean")
        and sv_Workspace.Map.AlwaysHereTweenedObjects.Ocean:FindFirstChild("Object")
        and sv_Workspace.Map.AlwaysHereTweenedObjects.Ocean.Object:FindFirstChild("ObjectModel")
    if oceanPath then
        for _, part in pairs(oceanPath:GetChildren()) do
            if part:IsA("BasePart") and part.Name == "Ocean" then
                part.CanCollide = true
            end
        end
    end
end

local function DisableAntiWater()
    Config.AntiWater = false
    local oceanPath = sv_Workspace:FindFirstChild("Map")
        and sv_Workspace.Map:FindFirstChild("AlwaysHereTweenedObjects")
        and sv_Workspace.Map.AlwaysHereTweenedObjects:FindFirstChild("Ocean")
        and sv_Workspace.Map.AlwaysHereTweenedObjects.Ocean:FindFirstChild("Object")
        and sv_Workspace.Map.AlwaysHereTweenedObjects.Ocean.Object:FindFirstChild("ObjectModel")
    if oceanPath then
        for _, part in pairs(oceanPath:GetChildren()) do
            if part:IsA("BasePart") and part.Name == "Ocean" then
                part.CanCollide = false
            end
        end
    end
end

