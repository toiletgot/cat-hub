-- 8. Anti Lag
local createGrabLineCopy, extendGrabLineCopy
local grabFolder = RS:FindFirstChild("GrabEvents")
if grabFolder then
    local originalCreate = grabFolder:FindFirstChild("CreateGrabLine")
    local originalExtend = grabFolder:FindFirstChild("ExtendGrabLine")
    if originalCreate then createGrabLineCopy = originalCreate:Clone() end
    if originalExtend then extendGrabLineCopy = originalExtend:Clone() end
end

local function toggleAntiLag(state)
    antiLagEnabled = state
    if state then
        local grabFolder = RS:FindFirstChild("GrabEvents")
        if grabFolder then
            local create = grabFolder:FindFirstChild("CreateGrabLine")
            local extend = grabFolder:FindFirstChild("ExtendGrabLine")
            if create and create:IsA("RemoteEvent") then create:Destroy() end
            if extend and extend:IsA("RemoteEvent") then extend:Destroy() end
        end
        for _, v in ipairs(W:GetDescendants()) do
            if v:IsA("Beam") or v.Name:lower():find("line") then
                v:Destroy()
            end
        end
        OrionLib:MakeNotification({Name="アンチラグ", Content="有効になりました", Time=2})
    else
        local grabFolder = RS:FindFirstChild("GrabEvents")
        if grabFolder then
            if createGrabLineCopy and not grabFolder:FindFirstChild("CreateGrabLine") then
                createGrabLineCopy:Clone().Parent = grabFolder
            end
            if extendGrabLineCopy and not grabFolder:FindFirstChild("ExtendGrabLine") then
                extendGrabLineCopy:Clone().Parent = grabFolder
            end
        end
        OrionLib:MakeNotification({Name="アンチラグ", Content="無効になりました", Time=2})
    end
end

-- 9. Auto Anti Lag
local function toggleAutoAntiLag(state)
    autoAntiLagEnabled = state
    if state then
        if autoAntiLagConn then autoAntiLagConn:Disconnect() end
        autoAntiLagConn = R.Heartbeat:Connect(function()
            local fps = math.floor(1 / R.RenderStepped:Wait())
            if fps < 20 and not antiLagActive then
                antiLagActive = true
                toggleAntiLag(true)
                OrionLib:MakeNotification({Name="オートアンチラグ", Content="FPS低下を検出、アンチラグ有効化", Time=3})
            end
        end)
        OrionLib:MakeNotification({Name="オートアンチラグ", Content="有効になりました", Time=2})
    else
        if autoAntiLagConn then autoAntiLagConn:Disconnect(); autoAntiLagConn = nil end
        antiLagActive = false
        OrionLib:MakeNotification({Name="オートアンチラグ", Content="無効になりました", Time=2})
    end
end

-- 10. Anti Paint
local function deleteAllPaintParts()
    for _, obj in ipairs(W:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "PaintPlayerPart" then
            local clone = obj:Clone()
            clone.Archivable = true
            paintPartsBackup[obj:GetDebugId()] = {
                clone = clone,
                parent = obj.Parent
            }
            obj:Destroy()
        end
    end
end

local function restorePaintParts()
    for _, data in pairs(paintPartsBackup) do
        if data.clone and data.parent then
            data.clone.Parent = data.parent
        end
    end
    paintPartsBackup = {}
end

local function watchNewPaintParts()
    table.insert(paintConnections, W.DescendantAdded:Connect(function(obj)
        if obj:IsA("BasePart") and obj.Name == "PaintPlayerPart" then
            task.defer(function()
                if obj and obj.Parent then
                    local clone = obj:Clone()
                    clone.Archivable = true
                    paintPartsBackup[obj:GetDebugId()] = {
                        clone = clone,
                        parent = obj.Parent
                    }
                    obj:Destroy()
                end
            end)
        end
    end))
end

local function disconnectWatchers()
    for _, conn in ipairs(paintConnections) do
        if conn.Connected then conn:Disconnect() end
    end
    paintConnections = {}
end

local function setTouchQuery(state)
    local char = W:FindFirstChild(LocalPlayer.Name)
    if not char then return end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Part") or v:IsA("BasePart") then
            v.CanTouch = state
            v.CanQuery = state
        end
    end
end

local function toggleAntiPaint(state)
    antiPaintEnabled = state
    if state then
        deleteAllPaintParts()
        watchNewPaintParts()
        setTouchQuery(false)
        OrionLib:MakeNotification({Name="アンチペイント", Content="有効になりました", Time=2})
    else
        restorePaintParts()
        disconnectWatchers()
        setTouchQuery(true)
        OrionLib:MakeNotification({Name="アンチペイント", Content="無効になりました", Time=2})
    end
end

-- 11. Anti Input Lag
local function toggleAntiInputLag(state)
    antiInputLagEnabled = state
    _G.AntiInputLag = state
    if not state then return end
    task.spawn(function()
        local char = getChar() or LocalPlayer.CharacterAdded:Wait()
        local hrp = getRoot()
        local SpawnRemote = MT and MT:FindFirstChild("SpawnToyRemoteFunction")
        local selectedToyName = SelectedToy

        while _G.AntiInputLag do
            local toysFolder = getInv()
            if not toysFolder then
                R.Heartbeat:Wait()
                continue
            end

            local toy = toysFolder:FindFirstChild(selectedToyName)
            if not toy then
                pcall(function()
                    if SpawnRemote then
                        SpawnRemote:InvokeServer(selectedToyName, hrp.CFrame * CFrame.new(0, 5, 0), Vector3.zero)
                    end
                end)
                R.Heartbeat:Wait()
            else
                local holdPart = toy:FindFirstChild("HoldPart")
                if holdPart then
                    local holdingPlayer = holdPart:FindFirstChild("HoldingPlayer") and holdPart.HoldingPlayer.Value
                    if holdingPlayer and holdingPlayer ~= LocalPlayer then
                        pcall(function()
                            local dropRemote = holdPart:FindFirstChild("DropItemRemoteFunction")
                            if dropRemote then
                                dropRemote:InvokeServer(toy, hrp.CFrame * CFrame.new(0, 2000, 0), Vector3.zero)
                            end
                        end)
                        toy:Destroy()
                    else
                        while _G.AntiInputLag do
                            pcall(function()
                                local holdRemote = holdPart:FindFirstChild("HoldItemRemoteFunction")
                                local dropRemote = holdPart:FindFirstChild("DropItemRemoteFunction")
                                if holdRemote then holdRemote:InvokeServer(toy, char) end
                                if dropRemote then dropRemote:InvokeServer(toy, hrp.CFrame * CFrame.new(0, 5000, 0), Vector3.zero) end
                            end)
                            if not toy or not toy.Parent or not toysFolder:FindFirstChild(selectedToyName) then
                                break
                            end
                            R.Heartbeat:Wait()
                        end
                    end
                end
            end
        end
    end)
    OrionLib:MakeNotification({Name="アンチインプットラグ", Content=state and "有効" or "無効", Time=2})
end

