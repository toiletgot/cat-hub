local function getBlobman()
    local inv = getInv()
    if inv then
        return inv:FindFirstChild("CreatureBlobman")
    end
    return nil
end

local function spawnBlobman()
    local root = getRoot()
    if not root then return end
    pcall(function()
        MT.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", root.CFrame * CFrame.new(0, 0, 5), Vector3.zero)
    end)
    task.wait(0.5)
end

local function destroyBlobman()
    local blob = getBlobman()
    if blob then
        pcall(function()
            MT.DestroyToy:FireServer(blob)
        end)
    end
end

local function sitOnBlobman()
    local blob = getBlobman()
    if not blob then return false end
    local seat = blob:FindFirstChild("VehicleSeat")
    if not seat then return false end
    local hum = getHum()
    if not hum then return false end
    pcall(function() seat:Sit(hum) end)
    task.wait(0.3)
    return hum.Sit and hum.SeatPart == seat
end

local function toggleKick(on)
    if on then
        if not selectedKickPlayer then
            OrionLib:MakeNotification({Name="⚠️ エラー", Content="先にプレイヤーを選択してください", Time=3})
            return
        end
        
        if not selectedKickPlayer.Parent then
            OrionLib:MakeNotification({Name="⚠️ エラー", Content="選択したプレイヤーが存在しません", Time=3})
            selectedKickPlayer = nil
            return
        end

        if not getChar() then
            OrionLib:MakeNotification({Name="エラー", Content="キャラクターが見つかりません", Time=3})
            return
        end

        local hum = getHum()
        if not hum then
            OrionLib:MakeNotification({Name="エラー", Content="Humanoidが見つかりません", Time=3})
            return
        end

        local seat = hum.SeatPart
        if not seat or not seat.Parent or seat.Parent.Name ~= "CreatureBlobman" then
            spawnBlobman()
            task.wait(0.3)
            local blob = getBlobman()
            if blob then
                local newSeat = blob:FindFirstChild("VehicleSeat")
                if newSeat then
                    pcall(function() newSeat:Sit(hum) end)
                    task.wait(0.3)
                end
            end
            if not hum.Sit or not hum.SeatPart or hum.SeatPart.Parent.Name ~= "CreatureBlobman" then
                OrionLib:MakeNotification({Name="エラー", Content="ブロブマンに座ってください", Time=3})
                return
            end
        end
    end

    kickActive = on

    if on then
        local target = selectedKickPlayer
        OrionLib:MakeNotification({Name="67キック開始", Content="ターゲット: " .. target.Name, Time=2})

        if kickThread then task.cancel(kickThread) end
        kickThread = task.spawn(function()
            local blob = getBlobman()
            if not blob then
                OrionLib:MakeNotification({Name="❌ エラー", Content="ブロブマンが見つかりません", Time=3})
                kickActive = false
                return
            end

            local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
            if not blobRoot then
                OrionLib:MakeNotification({Name="❌ エラー", Content="ブロブマンのルートパーツがない", Time=3})
                kickActive = false
                return
            end

            local SavedPos = blobRoot.CFrame
            
            local R_Det = blob:FindFirstChild("RightDetector")
            if not R_Det then
                for _, child in ipairs(blob:GetChildren()) do
                    if child.Name:lower():find("detector") then
                        R_Det = child
                        break
                    end
                end
                if not R_Det then
                    OrionLib:MakeNotification({Name="❌ エラー", Content="Detectorが見つかりません", Time=3})
                    kickActive = false
                    return
                end
            end

            local L_Det = blob:FindFirstChild("LeftDetector")
            if not L_Det then
                for _, child in ipairs(blob:GetChildren()) do
                    if child.Name:lower():find("detector") and child ~= R_Det then
                        L_Det = child
                        break
                    end
                end
                if not L_Det then
                    L_Det = R_Det
                end
            end

            local R_Weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")
            local L_Weld = L_Det:FindFirstChild("LeftWeld") or L_Det:FindFirstChildWhichIsA("Weld")

            local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
            local CG = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
            local CD = scriptObj and scriptObj:FindFirstChild("CreatureDrop")

            if not CG then
                for _, child in ipairs(blob:GetDescendants()) do
                    if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                        if child.Name:lower():find("grab") then CG = child end
                        if child.Name:lower():find("drop") then CD = child end
                    end
                end
            end

            if not CG then
                OrionLib:MakeNotification({Name="⚠️ 警告", Content="CreatureGrabが見つかりません", Time=3})
            end

            local rightHandPos = R_Det.CFrame * CFrame.new(0, 15, -3) * CFrame.new(5, 3, 0)
            local leftHandPos = L_Det.CFrame * CFrame.new(0, 15, -3) * CFrame.new(-5, 3, 0)

            local tChar = target.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

            if tRoot and blobRoot then
                local bringStart = tick()
                while tick() - bringStart < 0.35 do
                    if not kickActive then break end
                    blobRoot.CFrame = tRoot.CFrame
                    blobRoot.Velocity = Vector3.zero
                    pcall(function()
                        if CG and R_Det then
                            CG:FireServer(R_Det, tRoot, R_Weld)
                        end
                        GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                        GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                    end)
                    R.Heartbeat:Wait()
                end
                blobRoot.CFrame = SavedPos
                blobRoot.Velocity = Vector3.zero
                task.wait(0.05)
            end

            local teleportIndex = 0
            local packetTimer = 0
            
            while kickActive do
                if not target or not target.Parent or not target.Character then break end

                tChar = target.Character
                tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChild("Humanoid")

                if tRoot and tHum and tHum.Health > 0 then
                    blobRoot.CFrame = SavedPos
                    blobRoot.Velocity = Vector3.zero

                    teleportIndex = (teleportIndex + 1) % 2
                    local targetPos
                    local currentDet
                    local currentWeld
                    
                    if teleportIndex == 0 then
                        targetPos = rightHandPos
                        currentDet = R_Det
                        currentWeld = R_Weld
                    else
                        targetPos = leftHandPos
                        currentDet = L_Det
                        currentWeld = L_Weld
                    end
                    
                    tRoot.CFrame = targetPos
                    tRoot.Velocity = Vector3.zero
                    tRoot.RotVelocity = Vector3.zero

                    if tick() - packetTimer > 0.01 then
                        packetTimer = tick()
                        pcall(function()
                            tHum.PlatformStand = true
                            tHum.Sit = true
                            
                            GE.SetNetworkOwner:FireServer(tRoot, targetPos)
                            
                            if R_Det then
                                local weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")
                                if weld and CD then CD:FireServer(weld) end
                            end
                            if L_Det then
                                local weld = L_Det:FindFirstChild("LeftWeld") or L_Det:FindFirstChildWhichIsA("Weld")
                                if weld and CD then CD:FireServer(weld) end
                            end
                            
                            GE.DestroyGrabLine:FireServer(tRoot)
                            
                            if CG and currentDet then
                                CG:FireServer(currentDet, tRoot, currentWeld)
                            end
                            
                            GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                            
                            for i = 1, 3 do
                                if CG and currentDet then
                                    CG:FireServer(currentDet, tRoot, currentWeld)
                                end
                                task.wait(0.002)
                            end
                        end)
                    end
                else
                    if blobRoot and blobRoot.Parent then
                        blobRoot.CFrame = SavedPos
                        blobRoot.Velocity = Vector3.zero
                    end
                    break
                end

                R.Heartbeat:Wait()
            end

            kickActive = false
            if blobRoot and blobRoot.Parent then
                blobRoot.CFrame = SavedPos
                blobRoot.Velocity = Vector3.zero
            end
            OrionLib:MakeNotification({Name="67キック停止", Content="ループを終了しました", Time=2})
        end)
    else
        if kickThread then task.cancel(kickThread); kickThread = nil end
        destroyBlobman()
        OrionLib:MakeNotification({Name="67キック停止", Content="停止しました", Time=2})
    end
end

