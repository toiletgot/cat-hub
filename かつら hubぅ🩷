local function toggleSpinKick(on)
    if on then
        if not selectedSpinPlayer then
            OrionLib:MakeNotification({Name="⚠️ エラー", Content="先にプレイヤーを選択してください", Time=3})
            return
        end
        
        if not selectedSpinPlayer.Parent then
            OrionLib:MakeNotification({Name="⚠️ エラー", Content="選択したプレイヤーが存在しません", Time=3})
            selectedSpinPlayer = nil
            return
        end

        if not getChar() then
            OrionLib:MakeNotification({Name="エラー", Content="キャラクターが見つかりません", Time=3})
            return
        end

        local hum = getHum()
        if not hum then
            OrionLib:MakeNotification({Name="エラー", Content="Humanoidが見つかりません", Time=3})
            return
        end

        local seat = hum.SeatPart
        if not seat or not seat.Parent or seat.Parent.Name ~= "CreatureBlobman" then
            spawnBlobman()
            task.wait(0.3)
            local blob = getBlobman()
            if blob then
                local newSeat = blob:FindFirstChild("VehicleSeat")
                if newSeat then
                    pcall(function() newSeat:Sit(hum) end)
                    task.wait(0.3)
                end
            end
            if not hum.Sit or not hum.SeatPart or hum.SeatPart.Parent.Name ~= "CreatureBlobman" then
                OrionLib:MakeNotification({Name="エラー", Content="ブロブマンに座ってください", Time=3})
                return
            end
        end
    end

    spinActive = on

    if on then
        local target = selectedSpinPlayer
        OrionLib:MakeNotification({Name="竜巻きキック開始", Content="ターゲット: " .. target.Name, Time=2})

        if spinThread then task.cancel(spinThread) end
        spinThread = task.spawn(function()
            local blob = getBlobman()
            if not blob then
                OrionLib:MakeNotification({Name="❌ エラー", Content="ブロブマンが見つかりません", Time=3})
                spinActive = false
                return
            end

            local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
            if not blobRoot then
                OrionLib:MakeNotification({Name="❌ エラー", Content="ブロブマンのルートパーツがない", Time=3})
                spinActive = false
                return
            end

            local SavedPos = blobRoot.CFrame
            
            local R_Det = blob:FindFirstChild("RightDetector")
            if not R_Det then
                for _, child in ipairs(blob:GetChildren()) do
                    if child.Name:lower():find("detector") then
                        R_Det = child
                        break
                    end
                end
                if not R_Det then
                    OrionLib:MakeNotification({Name="❌ エラー", Content="Detectorが見つかりません", Time=3})
                    spinActive = false
                    return
                end
            end

            local R_Weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")

            local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
            local CG = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
            local CD = scriptObj and scriptObj:FindFirstChild("CreatureDrop")

            if not CG then
                for _, child in ipairs(blob:GetDescendants()) do
                    if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                        if child.Name:lower():find("grab") then CG = child end
                        if child.Name:lower():find("drop") then CD = child end
                    end
                end
            end

            if not CG then
                OrionLib:MakeNotification({Name="⚠️ 警告", Content="CreatureGrabが見つかりません", Time=3})
            end

            local tChar = target.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

            if tRoot and blobRoot then
                local bringStart = tick()
                while tick() - bringStart < 0.35 do
                    if not spinActive then break end
                    blobRoot.CFrame = tRoot.CFrame
                    blobRoot.Velocity = Vector3.zero
                    pcall(function()
                        if CG and R_Det then
                            CG:FireServer(R_Det, tRoot, R_Weld)
                        end
                        GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                        GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                    end)
                    R.Heartbeat:Wait()
                end
                blobRoot.CFrame = SavedPos
                blobRoot.Velocity = Vector3.zero
                task.wait(0.05)
            end

            spinAngle = 0
            local packetTimer = 0
            
            while spinActive do
                if not target or not target.Parent or not target.Character then break end
                if not blobRoot or not blobRoot.Parent then break end

                tChar = target.Character
                tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChild("Humanoid")

                if tRoot and tHum and tHum.Health > 0 then
                    spinAngle = spinAngle + (math.rad(spinSpeed) * 2)
                    if spinAngle > math.pi * 2 then
                        spinAngle = spinAngle - math.pi * 2
                    end

                    blobRoot.CFrame = CFrame.new(SavedPos.Position) * CFrame.Angles(0, spinAngle, 0)
                    blobRoot.Velocity = Vector3.zero

                    local distance = 8
                    local targetPos = SavedPos.Position + Vector3.new(
                        math.sin(spinAngle) * distance,
                        0,
                        math.cos(spinAngle) * distance
                    )
                    tRoot.CFrame = CFrame.new(targetPos)
                    tRoot.Velocity = Vector3.zero
                    tRoot.RotVelocity = Vector3.zero

                    if tick() - packetTimer > 0.05 then
                        packetTimer = tick()
                        pcall(function()
                            tHum.PlatformStand = true
                            tHum.Sit = true
                            GE.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                            if R_Det then
                                local weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")
                                if weld and CD then CD:FireServer(weld) end
                            end
                            GE.DestroyGrabLine:FireServer(tRoot)
                            if CG and R_Det then
                                CG:FireServer(R_Det, tRoot, R_Weld)
                            end
                            GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                        end)
                    end
                else
                    if blobRoot and blobRoot.Parent then
                        blobRoot.CFrame = SavedPos
                        blobRoot.Velocity = Vector3.zero
                    end
                    break
                end

                R.Heartbeat:Wait()
            end

            spinActive = false
            spinAngle = 0
            if blobRoot and blobRoot.Parent then
                blobRoot.CFrame = SavedPos
                blobRoot.Velocity = Vector3.zero
            end
            OrionLib:MakeNotification({Name="竜巻きキック停止", Content="ループを終了しました", Time=2})
        end)
    else
        if spinThread then task.cancel(spinThread); spinThread = nil end
        spinAngle = 0
        destroyBlobman()
        OrionLib:MakeNotification({Name="竜巻きキック停止", Content="停止しました", Time=2})
    end
end

