-- 2. Anti Grab
local BeingHeld = LocalPlayer:FindFirstChild("IsHeld") or Instance.new("BoolValue")
BeingHeld.Name = "IsHeld"
BeingHeld.Parent = LocalPlayer
local StruggleEvent = CE and CE:FindFirstChild("Struggle")

local function StopAntiGrab()
    antiGrabEnabled = false
    if antiGrabConn then
        antiGrabConn:Disconnect()
        antiGrabConn = nil
    end
    local Root = getRoot()
    if Root then Root.Anchored = false end
end

local function StartAntiGrab()
    if antiGrabConn then
        antiGrabConn:Disconnect()
        antiGrabConn = nil
    end
    antiGrabConn = BeingHeld:GetPropertyChangedSignal("Value"):Connect(function()
        if not antiGrabEnabled or not BeingHeld.Value then return end
        local Char = getChar()
        if not Char then return end
        local Root = getRoot()
        local Hum = getHum()
        local lastFreePos = Root and Root.CFrame
        local renderConn

        task.spawn(function()
            while antiGrabEnabled and BeingHeld.Value do
                pcall(function()
                    if StruggleEvent then StruggleEvent:FireServer() end
                    local ragdollRemote = CE and CE:FindFirstChild("RagdollRemote")
                    if ragdollRemote then ragdollRemote:FireServer(Root, 0) end
                    local stopAllVelocity = RS:FindFirstChild("GameCorrectionEvents") and RS.GameCorrectionEvents:FindFirstChild("StopAllVelocity")
                    if stopAllVelocity then stopAllVelocity:FireServer() end
                end)
                task.wait()
            end
        end)

        task.spawn(function()
            while antiGrabEnabled and BeingHeld.Value do
                pcall(function()
                    if Hum then
                        Hum.Sit = false
                        Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                        Hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                    end
                    if Root then
                        Root.Anchored = true
                        Root.AssemblyLinearVelocity = Vector3.zero
                        Root.AssemblyAngularVelocity = Vector3.zero
                    end
                end)
                task.wait()
            end
            if Root then Root.Anchored = false end
            if renderConn then renderConn:Disconnect() end
        end)

        renderConn = R.RenderStepped:Connect(function()
            if not antiGrabEnabled or not BeingHeld.Value then
                renderConn:Disconnect()
                return
            end
            if Root and lastFreePos then
                Root.CFrame = lastFreePos
                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end)
end

local function toggleAntiGrab(state)
    antiGrabEnabled = state
    if state then StartAntiGrab() else StopAntiGrab() end
    OrionLib:MakeNotification({Name="アンチグラブ", Content=state and "有効" or "無効", Time=2})
end

