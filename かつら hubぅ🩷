local function executeBarrierBreak()
    local player = LocalPlayer
    local playerName = player.Name
    
    local plotItems = W:FindFirstChild("PlotItems")
    if plotItems then
        local playersInPlots = plotItems:FindFirstChild("PlayersInPlots")
        if playersInPlots and playersInPlots:FindFirstChild(playerName) then
            OrionLib:MakeNotification({Name="⚠️ Error", Content="家の外で実行してください", Time=3})
            return false
        end
    end

    barrierRunning = true
    local success, result = pcall(function()
        if not getChar() or not getRoot() then
            OrionLib:MakeNotification({Name="⚠️ Error", Content="キャラクターが見つかりません", Time=3})
            return false
        end

        local humanoid = getHum()
        if not humanoid then
            OrionLib:MakeNotification({Name="⚠️ Error", Content="Humanoidが見つかりません", Time=3})
            return false
        end

        local originalWalkSpeed = humanoid.WalkSpeed
        local originalPosition = getRoot().CFrame
        humanoid.WalkSpeed = 0

        if not MT then
            humanoid.WalkSpeed = originalWalkSpeed
            OrionLib:MakeNotification({Name="⚠️ Error", Content="MenuToysが見つかりません", Time=3})
            return false
        end

        MT.SpawnToyRemoteFunction:InvokeServer("InstrumentWoodwindOcarina", 
            CFrame.new(184.148834, -5.54824972, 498.136749, 0.829037189, -0.214714944, 0.516328275, 0, 0.923344612, 0.383972496, -0.559193552, -0.318327487, 0.765486956), 
            Vector3.new(0, 34, 0))
        wait(0.4)

        local toyFolder = getInv()
        if not toyFolder or not toyFolder:FindFirstChild("InstrumentWoodwindOcarina") then
            humanoid.WalkSpeed = originalWalkSpeed
            OrionLib:MakeNotification({Name="⚠️ Error", Content="オカリナが見つかりません", Time=3})
            return false
        end

        local ocarina = toyFolder:FindFirstChild("InstrumentWoodwindOcarina")
        if not ocarina or not ocarina:FindFirstChild("HoldPart") then
            humanoid.WalkSpeed = originalWalkSpeed
            OrionLib:MakeNotification({Name="⚠️ Error", Content="オカリナのHoldPartが見つかりません", Time=3})
            return false
        end

        ocarina.HoldPart.HoldItemRemoteFunction:InvokeServer(ocarina, W[playerName])

        if getChar() and getRoot() then
            getRoot().CFrame = CFrame.new(304.06, 25.77, 488.54)
        end

        wait(0.21)

        if toyFolder and toyFolder:FindFirstChild("InstrumentWoodwindOcarina") then
            MT.DestroyToy:FireServer(toyFolder.InstrumentWoodwindOcarina)
        end

        if getChar() and getRoot() then
            getRoot().CFrame = originalPosition
        end

        wait(0.7)

        MT.SpawnToyRemoteFunction:InvokeServer("Campfire", 
            CFrame.new(257.638672, -5.57392979, 450.103638, -0.950906992, -0.171067372, 0.257899135, 0, 0.833338678, 0.552762806, -0.309477001, 0.525626004, -0.79242748), 
            Vector3.new(0, 161.9720001220703, 0))

        wait(0.7)

        humanoid.WalkSpeed = originalWalkSpeed
        OrionLib:MakeNotification({Name="✅ Success", Content="Barrier破壊に成功！", Time=5})
        return true
    end)

    if not success then
        local humanoid = getHum()
        if humanoid then humanoid.WalkSpeed = 16 end
        OrionLib:MakeNotification({Name="❌ Error", Content="実行エラー: " .. tostring(result), Time=3})
        return false
    end

    barrierRunning = false
    return result
end

