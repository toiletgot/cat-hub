local function findTrainSeats()
    local seats = {}
    for _, obj in ipairs(W:GetDescendants()) do
        if obj:IsA("VehicleSeat") or obj:IsA("Seat") then
            local model = obj.Parent
            if model and (model.Name:lower():find("train") or model.Name:lower():find("locomotive") or model.Name:lower():find("carriage") or model.Name:lower():find("cart") or model.Name:lower():find("rail")) then
                table.insert(seats, obj)
            end
        end
    end
    return seats
end

local function sitOnRandomTrainSeat()
    local seats = findTrainSeats()
    if #seats == 0 then
        OrionLib:MakeNotification({Name="列車コントロール", Content="列車の座席が見つかりません", Time=3})
        return
    end
    
    local emptySeats = {}
    for _, seat in ipairs(seats) do
        if not seat.Occupant then
            table.insert(emptySeats, seat)
        end
    end
    
    if #emptySeats == 0 then
        OrionLib:MakeNotification({Name="列車コントロール", Content="空いている座席がありません", Time=3})
        return
    end
    
    local chosenSeat = emptySeats[math.random(1, #emptySeats)]
    local hum = getHum()
    if hum and chosenSeat then
        local hrp = getRoot()
        if hrp then
            hrp.CFrame = chosenSeat.CFrame + Vector3.new(0, 2, 0)
            task.wait(0.1)
        end
        chosenSeat:Sit(hum)
        OrionLib:MakeNotification({Name="列車コントロール", Content="座席に座りました！", Time=2})
    end
end

