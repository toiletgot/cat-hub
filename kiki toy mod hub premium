-- ============ フィルター ============
local IGNORE_NAMES = {
    ["Baseplate"]=true, ["Terrain"]=true, ["SpawnLocation"]=true,
    ["Sky"]=true, ["Map"]=true, ["Wall"]=true, ["Floor"]=true, ["Grid"]=true
}

local function isSelectableObject(part, character)
    if not part:IsA("BasePart") or part.Anchored then return false end
    if character and part:IsDescendantOf(character) then return false end
    local parent = part.Parent
    if parent:FindFirstChild("Humanoid") or (parent.Parent and parent.Parent:FindFirstChild("Humanoid")) then return false end
    if IGNORE_NAMES[part.Name] then return false end
    local isOwner = false
    safeCall(function()
        if part:GetNetworkOwner() == player then isOwner = true end
    end)
    if isOwner or part:FindFirstChild("creator") or part.Name == "Handle" or part:GetAttribute("Creator") == player.UserId then return true end
    local size = part.Size
    if size.X < 30 and size.Y < 30 and size.Z < 30 then return true end
    return false
end

-- ============ モデル管理 ============
local function unregisterObject(obj)
    if not obj or not obj.Parent then return end
    safeCall(function()
        local parts = obj:IsA("Model") and obj:GetDescendants() or {obj}
        for _, p in ipairs(parts) do
            if p:IsA("BasePart") then p.CanCollide = true; p.Anchored = false end
        end
        local root = obj:IsA("Model") and obj.PrimaryPart or obj
        if root then
            for _, c in ipairs(root:GetChildren()) do
                if c:IsA("BodyVelocity") or c:IsA("BodyGyro") then c:Destroy() end
            end
        end
    end)
    hoveringObjects[obj] = nil
    objectData[obj] = nil
end

local function clearObjects()
    for obj in pairs(hoveringObjects) do unregisterObject(obj) end
    hoveringObjects = {}; objectData = {}
end

local function registerPart(part)
    if isSuikomiStopped then return false end
    local targetChar = player.Character
    local targetPlayer = Players:FindFirstChild(targetPlayerName)
    if targetPlayer and targetPlayer.Character then targetChar = targetPlayer.Character end
    if targetChar and not isSelectableObject(part, targetChar) then return false end

    local target = part.Parent:IsA("Model") and part.Parent or part
    if target:IsA("Model") and target.Parent == workspace then target = part end
    if hoveringObjects[target] then return false end

    hoveringObjects[target] = true
    nextRegIndex = nextRegIndex + 1
    objectData[target] = {
        seed = math.random() * 100, phase = math.random() * math.pi * 2,
        offsetZ = math.random(-5, 5), randX = math.random(-15, 15), randZ = math.random(-15, 15),
        fallSpeed = math.random(15, 30), wing2WaveOffset = math.random() * math.pi * 2,
        regIndex = nextRegIndex, comboId = nil
    }

    local rootPart = part
    if target:IsA("Model") then
        if not target.PrimaryPart then target.PrimaryPart = part end
        rootPart = target.PrimaryPart
        for _, p in ipairs(target:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false; p.Anchored = false
                if p ~= rootPart and not p:FindFirstChildOfClass("WeldConstraint") then
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = rootPart; weld.Part1 = p; weld.Parent = p
                end
            end
        end
    else
        part.CanCollide = false
    end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "SyncForce"; bv.MaxForce = Vector3.new(1,1,1) * 1e7
    bv.Velocity = Vector3.zero; bv.Parent = rootPart
    local bg = Instance.new("BodyGyro")
    bg.Name = "SyncGyro"; bg.MaxTorque = Vector3.new(1,1,1) * 1e7; bg.Parent = rootPart

    safeCall(function() rootPart:SetNetworkOwner(player) end)
    return true
end

