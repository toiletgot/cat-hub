local timeCounter = 0
RunService.Heartbeat:Connect(function()
    if mode == "None" then return end
    
    local hrp = getTargetHRP()
    if not hrp then return end
    
    local currentParts = {}
    for o in pairs(objectData) do table.insert(currentParts, o) end
    local total = #currentParts
    
    if total == 0 then return end
    
    local baseCenterPos = hrp.Position + (hrp.CFrame.RightVector * settings.offsetX) + (hrp.CFrame.LookVector * settings.offsetY)
    timeCounter = timeCounter + settings.speed

    for i, o in ipairs(currentParts) do
        if o and o.Parent and o:FindFirstChild("SyncForce") then
            local data = objectData[o]
            local targetPos = nil
            
            -- ================= モード判定ロジック群 =================
            if mode == "MagicCircle" then
                local angle = (timeCounter * 2) + (i / total * pi * 2)
                local s = settings.width / 2; local res = 0.2
                local x = sign(cos(angle)) * pow(abs(cos(angle)), res) * s
                local z = sign(sin(angle)) * pow(abs(sin(angle)), res) * s
                local tilt = CFrame.Angles(rad(11.5), 0, rad(11.5))
                targetPos = baseCenterPos + Vector3.new(0, settings.height, 0) + (tilt * Vector3.new(x, 0, z))
                o.SyncGyro.CFrame = hrp.CFrame * tilt * CFrame.Angles(0, angle, 0)
            elseif mode == "Orbit" then
                local angle = timeCounter + (i * (pi * 2 / total))
                targetPos = baseCenterPos + Vector3.new(cos(angle) * settings.width, settings.height, sin(angle) * settings.width)
                o.SyncGyro.CFrame = cfLookAt(o.Position, baseCenterPos)
            elseif mode == "Ghost" then
                local t = timeCounter + data.seed
                targetPos = baseCenterPos + Vector3.new(sin(t * 0.7) * settings.width, cos(t * 0.5) * (settings.width * 0.5) + settings.height, sin(t * 0.3) * settings.width)
                o.SyncGyro.CFrame = o.SyncGyro.CFrame * CFrame.Angles(0.05, 0.05, 0.05)
            elseif mode == "Manji" then
                local b = (i - 1) % 4
                local a = (b * pi / 2) + (timeCounter * 1.5)
                local sIdx = math.floor((i - 1) / 4)
                local r = min(1, sIdx / (max(1, total/4) * 0.6 + 0.1))
                targetPos = baseCenterPos + Vector3.new(cos(a) * (r * settings.width), settings.height, sin(a) * (r * settings.width))
                o.SyncGyro.CFrame = cfLookAt(Vector3.zero, Vector3.new(cos(a), 0, sin(a)))
            elseif mode == "Divine" then
                local a = (i / total) * pi * 2 + (timeCounter * 0.5)
                targetPos = baseCenterPos + Vector3.new(cos(a) * settings.width, settings.height + sin(timeCounter + i) * 0.5, sin(a) * settings.width)
                o.SyncGyro.CFrame = cfLookAt(o.Position, baseCenterPos + Vector3.new(0, 10, 0))
            elseif mode == "Geometry" then
                local n = 12 
                local sA = timeCounter * 1.5 + data.phase
                local lA = ((i - 1) % n / n) * pi * 2 + (timeCounter * 0.2)
                targetPos = baseCenterPos + Vector3.new(cos(lA) * settings.width + cos(sA) * 5, settings.height, sin(lA) * settings.width + sin(sA) * 5)
                o.SyncGyro.CFrame = cfLookAt(o.Position, targetPos + Vector3.new(cos(lA), 0, sin(lA)))
            elseif mode == "Diagonal" then
                local progress = (i / total) * 2 - 1
                local angle = timeCounter * 2
                local offsetDirection
                if i % 2 == 0 then offsetDirection = Vector3.new(progress, progress, 0)
                else offsetDirection = Vector3.new(-progress, progress, 0) end
                local rotatedOffset = CFrame.Angles(0, angle, 0) * (offsetDirection * settings.width)
                targetPos = baseCenterPos + Vector3.new(0, settings.height, 0) + rotatedOffset
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(timeCounter, timeCounter, 0)
            elseif mode == "Square" then
                local side = (i - 1) % 4
                local countPerSide = max(1, total / 4)
                local inSideIndex = math.floor((i - 1) / 4)
                local progress = (inSideIndex / countPerSide) * 2 - 1
                local halfW = settings.width
                local offsetDirection
                if side == 0 then offsetDirection = Vector3.new(progress * halfW, 0, -halfW)
                elseif side == 1 then offsetDirection = Vector3.new(progress * halfW, 0, halfW)
                elseif side == 2 then offsetDirection = Vector3.new(-halfW, 0, progress * halfW)
                else offsetDirection = Vector3.new(halfW, 0, progress * halfW) end
                local angle = timeCounter
                local rotatedOffset = CFrame.Angles(0, angle, 0) * offsetDirection
                targetPos = baseCenterPos + Vector3.new(0, settings.height, 0) + rotatedOffset
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0)
            elseif mode == "Spin" then
                local orbitAngle = (timeCounter * 3) + (i / total * pi * 2)
                local radius = settings.width * (0.6 + (i % 3) * 0.2)
                local yOffset = settings.height + sin(timeCounter * 2 + i) * 2
                targetPos = baseCenterPos + Vector3.new(cos(orbitAngle) * radius, yOffset, sin(orbitAngle) * radius)
                local spinAngle = timeCounter * 15
                o.SyncGyro.CFrame = cfLookAt(o.Position, targetPos) * CFrame.Angles(spinAngle, spinAngle * 0.5, spinAngle * 0.2)
            elseif mode == "MagicCircle2" then
                local angle, radius
                local halfTotal = max(1, total / 2)
                if i % 2 == 0 then
                    angle = (timeCounter * 1.8) + ((i / 2) / halfTotal * pi * 2)
                    radius = settings.width
                else
                    angle = -(timeCounter * 1.8) + (((i + 1) / 2) / halfTotal * pi * 2)
                    radius = settings.width * 0.55
                end
                local res = 0.25
                local x = sign(cos(angle)) * pow(abs(cos(angle)), res) * radius
                local z = sign(sin(angle)) * pow(abs(sin(angle)), res) * radius
                local wave = sin(timeCounter * 2.5 + i) * 1.5
                local tilt = CFrame.Angles(rad(8), 0, rad(8))
                targetPos = baseCenterPos + Vector3.new(0, settings.height + wave, 0) + (tilt * Vector3.new(x, 0, z))
                o.SyncGyro.CFrame = hrp.CFrame * tilt * CFrame.Angles(0, angle, timeCounter)
            elseif mode == "Barrier" then
                local limb = (i - 1) % 6
                local countPerLimb = max(1, total / 6)
                local inLimbIndex = math.floor((i - 1) / 6)
                local progress = inLimbIndex / countPerLimb
                local scale = settings.width * 0.4
                local localOffset = Vector3.zero
                local behindDist = -scale * 1.2
                local baseHeight = settings.height
                if limb == 0 then
                    local angle = progress * pi * 2 + (timeCounter * 2)
                    localOffset = Vector3.new(cos(angle) * (scale * 0.3), baseHeight + scale * 1.2 + sin(angle) * (scale * 0.1), behindDist)
                elseif limb == 1 then
                    local yPos = baseHeight + (1 - progress * 2) * (scale * 0.5)
                    localOffset = Vector3.new(0, yPos, behindDist)
                elseif limb == 2 then
                    localOffset = Vector3.new(scale * 0.4 + progress * scale * 0.8, baseHeight + scale * 0.3 - progress * scale * 0.4, behindDist)
                elseif limb == 3 then
                    localOffset = Vector3.new(-(scale * 0.4 + progress * scale * 0.8), baseHeight + scale * 0.3 - progress * scale * 0.4, behindDist)
                elseif limb == 4 then
                    localOffset = Vector3.new(scale * 0.2 + progress * scale * 0.6, baseHeight - scale * 0.5 - progress * scale * 1.0, behindDist)
                    localOffset = localOffset + Vector3.new(0, 0, sin(timeCounter * 3 + progress) * 0.5)
                else
                    localOffset = Vector3.new(-(scale * 0.2 + progress * scale * 0.6), baseHeight - scale * 0.5 - progress * scale * 1.0, behindDist)
                    localOffset = localOffset + Vector3.new(0, 0, -sin(timeCounter * 3 + progress) * 0.5)
                end
                targetPos = (hrp.CFrame * CFrame.new(localOffset)).Position
                o.SyncGyro.CFrame = hrp.CFrame
            elseif mode == "Pillar" then
                local pillarIndex = (i - 1) % 6
                local inPillarIndex = math.floor((i - 1) / 6)
                local angle = (pillarIndex * (pi * 2 / 6)) + (timeCounter * 0.5)
                local radius = settings.width
                local baseX = cos(angle) * radius
                local baseZ = sin(angle) * radius
                local heightSpacing = 2.2
                local yPos = settings.height + (inPillarIndex * heightSpacing)
                targetPos = baseCenterPos + Vector3.new(baseX, yPos, baseZ)
                o.SyncGyro.CFrame = cfLookAt(targetPos, baseCenterPos + Vector3.new(0, yPos - settings.height, 0))
            elseif mode == "MagicCircle3" then
                local ring = (i - 1) % 3
                local countPerRing = max(1, total / 3)
                local inRingIdx = math.floor((i - 1) / 3)
                local angle, radius
                if ring == 0 then
                    angle = (timeCounter * 1.5) + (inRingIdx / countPerRing * pi * 2)
                    radius = settings.width
                elseif ring == 1 then
                    angle = -(timeCounter * 2.2) + (inRingIdx / countPerRing * pi * 2)
                    radius = settings.width * 0.65
                else
                    angle = (timeCounter * 3.0) + (inRingIdx / countPerRing * pi * 2)
                    radius = settings.width * 0.35
                end
                local wave = sin(timeCounter * 4 - radius * 0.2) * 2
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, settings.height + wave, sin(angle) * radius)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0)
            elseif mode == "MagicCircle4" then
                local angle = (i % 2 == 0) and (timeCounter * 2.5) or -(timeCounter * 1.5)
                local radius = (i % 2 == 0) and settings.width or settings.width * 0.5
                angle = angle + (i / total * pi * 2)
                local waveY = sin(timeCounter + i) * 1.2
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, settings.height + waveY, sin(angle) * radius)
                o.SyncGyro.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0)
            elseif mode == "MagicCircle5" then
                local arm = (i - 1) % 3
                local inArm = math.floor((i - 1) / 3)
                local progress = inArm / max(1, total / 3)
                local angle = (arm * (pi * 2 / 3)) + timeCounter + (progress * 2)
                local radius = progress * settings.width
                targetPos = baseCenterPos + Vector3.new(cos(angle) * radius, settings.height, sin(angle) * radius)
                o.SyncGyro.CFrame = cfLookAt(o.Position, baseCenterPos)
            elseif mode == "MagicCircle6" then
