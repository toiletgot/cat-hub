    LineThickness = 0.05,
}

local ESPBoxes = {}
local Connections = {}

local function IsPCLD(obj)
    if not obj:IsA("BasePart") then return false end
    local name = string.lower(obj.Name)
    return name == "partesp" or 
           name == "playercharacterlocationdetector" or
           name == "pcld" or
           name == "locationdetector"
end

local function CreateBox(part)
    if not part or not part.Parent then return end
    
    if ESPBoxes[part] then
        pcall(function() ESPBoxes[part]:Destroy() end)
        ESPBoxes[part] = nil
    end
    
    local box = Instance.new("SelectionBox")
    box.Adornee = part
    box.LineThickness = pcldSettings.LineThickness
    box.Color3 = pcldSettings.OutlineColor
    box.Transparency = pcldSettings.OutlineTransparency
    box.SurfaceTransparency = pcldSettings.FillTransparency
    box.SurfaceColor3 = pcldSettings.FillColor
    box.Parent = part
    
    ESPBoxes[part] = box
    return box
end

local function ClearAllBoxes()
    for part, box in pairs(ESPBoxes) do
        if box then
            pcall(function() box:Destroy() end)
        end
    end
    ESPBoxes = {}
end

local function ScanAndApply()
    if not pcldSettings.Enabled then return end
    
    for _, obj in ipairs(ws:GetDescendants()) do
        if IsPCLD(obj) and obj.Parent then
            CreateBox(obj)
        end
    end
end

local function SetupWatchers()
    for _, conn in ipairs(Connections) do
        if conn.Connected then conn:Disconnect() end
    end
    Connections = {}
    
    local addedConn = ws.DescendantAdded:Connect(function(obj)
        if pcldSettings.Enabled and IsPCLD(obj) then
            task.defer(function()
                if obj and obj.Parent then
                    CreateBox(obj)
                end
            end)
        end
    end)
    table.insert(Connections, addedConn)
    
    local removedConn = ws.DescendantRemoving:Connect(function(obj)
        if ESPBoxes[obj] then
            pcall(function() ESPBoxes[obj]:Destroy() end)
            ESPBoxes[obj] = nil
        end
    end)
    table.insert(Connections, removedConn)
end

