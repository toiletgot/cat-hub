    end
})

local function playBlackHoleSound()
    if not blackHoleSoundEnabled then return end
    playSound("rbxassetid://138707899268973")
end

local function applyGlowEffect(character, playerObj)
    if not character then return end
    
    if glowingPlayers[character] then return end
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 1
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.Parent = character
    
    glowingPlayers[character] = {
        highlight = highlight,
        player = playerObj,
        startTime = tick()
    }
    
    task.delay(4, function()
        if glowingPlayers[character] then
            local conn
            conn = run.Heartbeat:Connect(function()
                local elapsed = tick() - glowingPlayers[character].startTime
                local progress = (elapsed - 4) / 1
                
                if progress >= 1 then
                    if highlight and highlight.Parent then
                        highlight:Destroy()
                    end
                    glowingPlayers[character] = nil
                    if conn then conn:Disconnect() end
                    if glowConnections[character] then
                        glowConnections[character]:Disconnect()
                        glowConnections[character] = nil
                    end
                    return
                end
                
                if highlight then
                    highlight.OutlineTransparency = progress
                end
            end)
            glowConnections[character] = conn
        end
    end)
    
    character.AncestryChanged:Connect(function(_, parent)
        if not parent then
            if highlight then highlight:Destroy() end
            glowingPlayers[character] = nil
            if glowConnections[character] then
                glowConnections[character]:Disconnect()
                glowConnections[character] = nil
            end
        end
    end)
    
    if playerObj then
        playerObj.AncestryChanged:Connect(function(_, parent)
            if not parent then
                if highlight and highlight.Parent then
                    highlight:Destroy()
                end
                glowingPlayers[character] = nil
                if glowConnections[character] then
                    glowConnections[character]:Disconnect()
                    glowConnections[character] = nil
                end
            end
        end)
    end
end

local function getClosestPlayerToBlackHole(pos)
    local closest = nil
    local dist = math.huge
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr ~= player then
            local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - pos).Magnitude
                if d < dist then
                    dist = d
                    closest = plr
                end
            end
        end
    end
    return closest
end

local function getBlackHolePosition(obj)
    if obj:IsA("BasePart") then return obj.Position end
    local part = obj:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position end
    return nil
end

ws.ChildAdded:Connect(function(obj)
    if not blackHoleNotifyEnabled then return end
    if obj.Name == "BlackHoleKick" or obj.Name == "BlackHoleDetected" then
        task.wait(0.05)
        
        local pos = getBlackHolePosition(obj)
        if not pos then return end
        
        local victim = getClosestPlayerToBlackHole(pos)
        if not victim then return end
        
        if victim.Character then
            applyGlowEffect(victim.Character, victim)
        end
        
        victim.CharacterAdded:Connect(function(char)
            if blackHoleNotifyEnabled then
                for oldChar, data in pairs(glowingPlayers) do
                    if data.player == victim then
                        if data.highlight then
                            data.highlight:Destroy()
                        end
                        glowingPlayers[oldChar] = nil
                        if glowConnections[oldChar] then
                            glowConnections[oldChar]:Disconnect()
                            glowConnections[oldChar] = nil
                        end
                    end
                end
                applyGlowEffect(char, victim)
            end
        end)
        
        victim.AncestryChanged:Connect(function(_, parent)
            if not parent then
                for char, data in pairs(glowingPlayers) do
                    if data.player == victim then
                        if data.highlight then
                            data.highlight:Destroy()
                        end
                        glowingPlayers[char] = nil
                        if glowConnections[char] then
                            glowConnections[char]:Disconnect()
                            glowConnections[char] = nil
                        end
                    end
                end
            end
        end)
        
        local alreadyNotified = false
        for _, id in pairs(gettingKicked) do
            if id == victim.UserId then
                alreadyNotified = true
                break
            end
        end
        
        if not alreadyNotified then
            table.insert(gettingKicked, victim.UserId)
            
            local description = string.format("%s [@%s] was kicked", victim.DisplayName, victim.Name)
            
            if showCoordinates then
                local posStr = string.format("(%.0f, %.0f, %.0f)", pos.X, pos.Y, pos.Z)
                description = description .. " at " .. posStr
            end
            
            Library:Notify({
                Title = "ブラックホールキック",
                Description = description,
                Time = 6,
                Icon = "circle-slash-2",
            })
            
            playBlackHoleSound()
            
            task.delay(5, function()
                for i, id in pairs(gettingKicked) do
                    if id == victim.UserId then
                        table.remove(gettingKicked, i)
                        break
                    end
                end
            end)
        end
    end
end)

