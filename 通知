local soundVolume = 1

local function playSound(soundId)
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = soundId
        s.Volume = soundVolume
        s.PlayOnRemove = true
        s.Parent = soundService
        s:Destroy()
    end)
end

-- ============================================
-- DECAL TEXTURE CHANGER
-- ============================================
local DECAL_TEXTURE = "rbxassetid://123863415108935"
local changedDecals = {}

local function changeDecalTexture(decal)
    if not decal or not decal:IsA("Decal") then return end
    if changedDecals[decal] then return end
    
    decal.Texture = DECAL_TEXTURE
    changedDecals[decal] = true
    
    decal.AncestryChanged:Connect(function(_, parent)
        if not parent then
            changedDecals[decal] = nil
        end
    end)
end

local function scanAndChangeDecals()
    for _, obj in ipairs(ws:GetDescendants()) do
        if obj:IsA("Decal") and not changedDecals[obj] then
            changeDecalTexture(obj)
        end
    end
    for _, obj in ipairs(lighting:GetDescendants()) do
        if obj:IsA("Decal") and not changedDecals[obj] then
            changeDecalTexture(obj)
        end
    end
end

local function setupDecalWatcher()
    local function onDecalAdded(obj)
        if obj:IsA("Decal") and not changedDecals[obj] then
            changeDecalTexture(obj)
        end
    end
    
    ws.DescendantAdded:Connect(onDecalAdded)
    lighting.DescendantAdded:Connect(onDecalAdded)
end

task.spawn(function()
    task.wait(0.5)
    scanAndChangeDecals()
    setupDecalWatcher()
    print("Decal texture changer initialized")
end)

