-- =====================================================
local function blobGrab(blob, target, side)
    if not blob then return end
    local detector = blob:FindFirstChild(side .. "Detector")
    local weld = detector and detector:FindFirstChild(side .. "Weld")
    local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript", true)
    local remote = script and script:FindFirstChild("CreatureGrab")
    if remote then pcall(function() remote:FireServer(detector, target, weld) end) end
end

local function blobDrop(blob, target, side)
    if not blob then return end
    local detector = blob:FindFirstChild(side .. "Detector")
    local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript", true)
    local remote = script and script:FindFirstChild("CreatureDrop")
    if remote then pcall(function() remote:FireServer(detector, target) end) end
end

local function blobKick(blob, target, side)
    local myRoot = GetRoot()
    if not myRoot then return end
    blobGrab(blob, myRoot, side)
    task.wait(0.1)
    if setNetworkOwnerEvent then setNetworkOwnerEvent:FireServer(target, myRoot.CFrame) end
    task.wait()
    target.CFrame = target.CFrame + Vector3.new(0, 16, 0)
    task.wait(0.1)
    if destroyGrabLineEvent then destroyGrabLineEvent:FireServer(target) end
    blobGrab(blob, target, side)
end

-- Kick All シーケンス
local function RunKickAll()
    if isKickAllActive then return end
    isKickAllActive = true
    
    local targets = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if isTargetable(p, true) then table.insert(targets, p) end
    end
    
    if #targets == 0 then
        Library:Notify("キック対象のプレイヤーがいません", 3)
        isKickAllActive = false
        return
    end

    for _, t in ipairs(targets) do playerStatus[t.UserId] = "Targeting" end
    local blob = BlobmanKill.SpawnBlobman()
    local myRoot = GetRoot()
    if not blob or not myRoot then isKickAllActive = false return end

    for _, p in ipairs(targets) do
        local tRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            myRoot.CFrame = tRoot.CFrame
            task.wait(0.02)
            for i = 1, 5 do
                pcall(function()
                    blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(blob.LeftDetector, tRoot, blob.LeftDetector.LeftWeld)
                    blob.BlobmanSeatAndOwnerScript.CreatureRelease:FireServer(blob.LeftDetector.LeftWeld)
                end)
                if i < 5 then task.wait(0.08) end
            end
        end
    end
    
    myRoot.CFrame = CFrame.new(0, 100, 0)
    task.wait(0.1)
    for _, part in ipairs(blob:GetDescendants()) do
        if part:IsA("BasePart") then pcall(function() part.Anchored = true end) end
    end
    
    local radius = 15
    for i, p in ipairs(targets) do
        local tRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            local angle = math.rad((i - 1) * (360 / #targets))
            tRoot.CFrame = CFrame.new(radius * math.cos(angle), 110, radius * math.sin(angle))
        end
    end
    task.wait(0.1)
    
    for _ = 1, 2 do
        for _, p in ipairs(targets) do
            local tRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then
                pcall(function()
                    if setNetworkOwnerEvent then setNetworkOwnerEvent:FireServer(tRoot, CFrame.new(tRoot.Position)) end
                    if destroyGrabLineEvent then destroyGrabLineEvent:FireServer(tRoot) end
                end)
            end
        end
        task.wait(0.1)
    end
    
    task.wait(0.3)
    for _, p in ipairs(targets) do
        local tRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            pcall(function()
                blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(blob.LeftDetector, tRoot, blob.LeftDetector.LeftWeld)
                blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(blob.RightDetector, tRoot, blob.RightDetector.RightWeld)
            end)
        end
    end
    
    for _, p in ipairs(targets) do if p and p.Parent == Players then playerStatus[p.UserId] = "Kicked" end end
    myRoot.CFrame = CFrame.new(0, -50000, 0)
    for _, part in ipairs(blob:GetDescendants()) do
        if part:IsA("BasePart") then pcall(function() part.Anchored = false end) end
    end
    task.wait(1)
    isKickAllActive = false
    Library:Notify("Kick Allのシーケンスが完了しました", 3)
end

