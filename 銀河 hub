-- 移動・環境チート系制御
-- =====================================================
local function handleMovementLoop()
    Disconnect("MovementLoop")
    Disconnect("JumpHook")
    
    if Toggles.WalkSpeedEnabled.Value or Toggles.JumpPowerEnabled.Value then
        Connections["MovementLoop"] = RunService.Heartbeat:Connect(function()
            local hum = getHumanoid()
            local myRoot = GetRoot()
            if hum and myRoot then
                hum.WalkSpeed = Options.WalkSpeedValue.Value
                
                if Toggles.WalkSpeedEnabled.Value and hum.MoveDirection.Magnitude > 0 and Options.WalkSpeedValue.Value > 16 then
                    local boostFactor = (Options.WalkSpeedValue.Value - 16) / 100
                    myRoot.CFrame = myRoot.CFrame + (hum.MoveDirection * boostFactor)
                end
            end
        end)
    end

    if Toggles.JumpPowerEnabled.Value then
        Connections["JumpHook"] = UserInputService.JumpRequest:Connect(function()
            local hum = getHumanoid()
            local myRoot = GetRoot()
            if hum and myRoot and (hum:GetState() == Enum.HumanoidStateType.Running or hum:GetState() == Enum.HumanoidStateType.Freefall) then
                hum.JumpPower = Options.JumpPowerValue.Value
                hum.UseJumpPower = true
                local currentVel = myRoot.AssemblyLinearVelocity
                myRoot.AssemblyLinearVelocity = Vector3.new(currentVel.X, Options.JumpPowerValue.Value, currentVel.Z)
            end
        end)
    end
end

local function SetNoclipKick(enabled)
    Disconnect("NoclipKick")
    if enabled then
        Connections["NoclipKick"] = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    end
end

