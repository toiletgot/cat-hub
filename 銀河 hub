                if myRoot then myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.5) end
                Connections["KickV5Loop"] = RunService.Heartbeat:Connect(function()
                    pcall(function()
                        b.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(b.LeftDetector, tRoot, b.LeftDetector.LeftWeld)
                        b.BlobmanSeatAndOwnerScript.CreatureRelease:FireServer(b.LeftDetector.LeftWeld, tRoot)
                    end)
                end)
            end
        end
    end
})

