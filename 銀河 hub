    if Toggles.WalkSpeedEnabled then Toggles.WalkSpeedEnabled:SetValue(false) end
    if Toggles.JumpPowerEnabled then Toggles.JumpPowerEnabled:SetValue(false) end
    if Toggles.FlyToggle then Toggles.FlyToggle:SetValue(false) end
    if Toggles.NoclipToggle then Toggles.NoclipToggle:SetValue(false) end
    if Toggles.BlobmanKillAll then Toggles.BlobmanKillAll:SetValue(false) end
    if Toggles.BlobmanKillAura then Toggles.BlobmanKillAura:SetValue(false) end
    if Toggles.BlobmanSelectedKill then Toggles.BlobmanSelectedKill:SetValue(false) end
    if Toggles.ChatSpamToggle then Toggles.ChatSpamToggle:SetValue(false) end
    if Toggles.ESPToggle then Toggles.ESPToggle:SetValue(false) end
    if Toggles.StalkToggle then Toggles.StalkToggle:SetValue(false) end
    if Toggles.ThirdPersonToggle then Toggles.ThirdPersonToggle:SetValue(false) end
    
    Disconnect("MovementLoop")
    Disconnect("JumpHook")
    local hum = getHumanoid()
    if hum then hum.WalkSpeed = 16 hum.JumpPower = 50 hum.PlatformStand = false end
    Camera.FieldOfView = 70
    LocalPlayer.CameraMaxZoomDistance = 400
    LocalPlayer.CameraMode = Enum.CameraMode.Classic
end

