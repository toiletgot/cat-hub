local function isTargetable(player, respectWhitelist)
    if not player or player == LocalPlayer then return false end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return false end
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    
    if respectWhitelist and whitelistFriends then
        local isFriend = false
        pcall(function() isFriend = LocalPlayer:IsFriendsWith(player.UserId) end)
        if isFriend then return false end
    end
    return true
end

local function getHumanoid()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
end

local function GetRoot()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
end

-- =====================================================
-- Blobman 基本制御ロジック
-- =====================================================
local function GetSeatedBlobman()
    local hum = getHumanoid()
    local seat = hum and hum.SeatPart
    if not seat or not seat:IsA("VehicleSeat") then return nil end
    local obj = seat
    while obj do
        if obj:IsA("Model") and obj.Name == "CreatureBlobman" then return obj end
        obj = obj.Parent
    end
    return nil
end

function BlobmanKill.SpawnBlobman()
    local seated = GetSeatedBlobman()
    if seated then BlobmanKill.currentBlobman = seated return seated end

    if BlobmanKill.currentBlobman and BlobmanKill.currentBlobman.Parent then
        local blobmanPos = BlobmanKill.currentBlobman:GetPivot().Position
        local myRoot = GetRoot()
        if blobmanPos and myRoot and (blobmanPos - myRoot.Position).Magnitude < 600 then
            local seat = BlobmanKill.currentBlobman:FindFirstChild("VehicleSeat")
            local hum = getHumanoid()
            if seat and hum then seat:Sit(hum) task.wait(0.05) end
            return BlobmanKill.currentBlobman
        else
            pcall(function() BlobmanKill.currentBlobman:Destroy() end)
            BlobmanKill.currentBlobman = nil
        end
    end

    local myRoot = GetRoot()
    if not myRoot then return nil end
    local spawnPos = myRoot.CFrame * CFrame.new(0, 0, -5)
    
    pcall(function()
        if SpawnToyRemoteFunction then
            SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", spawnPos, Vector3.new(0, 127, 0))
        end
    end)

    local toyFolderName = LocalPlayer.Name .. "SpawnedInToys"
    local blobman = nil
    local startTime = tick()
    repeat
        local toyFolder = Workspace:FindFirstChild(toyFolderName)
        if toyFolder then blobman = toyFolder:FindFirstChild("CreatureBlobman") end
        if blobman then break end
        task.wait()
    until tick() - startTime > 2
    
    if not blobman then return nil end
    BlobmanKill.currentBlobman = blobman
    local seat = blobman:FindFirstChild("VehicleSeat")
    local hum = getHumanoid()
    if seat and hum then seat:Sit(hum) end
    task.wait(0.05)
    return blobman
end

-- =====================================================
-- キル機能コアロジック
-- =====================================================
function BlobmanKill.KillPlayer(targetPlayer)
    if not isTargetable(targetPlayer, false) then return false end
    local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    for _ = 1, 5 do
        local success = pcall(function()
            humanoid.BreakJointsOnDeath = false
            humanoid:ChangeState(Enum.HumanoidStateType.Dead)
            humanoid.Health = 0
        end)
        if success and humanoid.Health <= 0 then return true end
        task.wait(0.005)
    end
    return false
end

function BlobmanKill.GrabRelease(blobman, targetRoot)
    if not blobman or not targetRoot then return end
    pcall(function()
        local script = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
        local leftDetector = blobman:FindFirstChild("LeftDetector")
        if script and leftDetector then
            local leftWeld = leftDetector:FindFirstChild("LeftWeld")
            script.CreatureGrab:FireServer(leftDetector, targetRoot, leftWeld)
            script.CreatureRelease:FireServer(leftWeld)
        end
    end)
end

function BlobmanKill.ProcessPlayer(targetPlayer)
    if not isTargetable(targetPlayer, false) then return false end
    local targetRoot = targetPlayer.Character.HumanoidRootPart
    local myRoot = GetRoot()
    if not myRoot then return false end

    local blobman = GetSeatedBlobman() or BlobmanKill.SpawnBlobman()
    if not blobman then return false end

    local originalCFrame = myRoot.CFrame
    local originalVel = myRoot.AssemblyLinearVelocity
    local originalAngVel = myRoot.AssemblyAngularVelocity

    pcall(function()
        myRoot.CFrame = targetRoot.CFrame
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.015)
        BlobmanKill.KillPlayer(targetPlayer)
        BlobmanKill.GrabRelease(blobman, targetRoot)
    end)

    if myRoot and myRoot.Parent then
        myRoot.CFrame = originalCFrame
        myRoot.AssemblyLinearVelocity = originalVel
        myRoot.AssemblyAngularVelocity = originalAngVel
    end
    return true
end

function BlobmanKill.ProcessAllPlayers()
    local myRoot = GetRoot()
    if not myRoot then return end
    local blobman = GetSeatedBlobman() or BlobmanKill.SpawnBlobman()
    if not blobman then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if not BlobmanKill.isRunning then break end
        if isTargetable(player, true) then
            local targetRoot = player.Character.HumanoidRootPart
            local originalCFrame = myRoot.CFrame
            pcall(function()
                myRoot.CFrame = targetRoot.CFrame
                task.wait(0.015)
                BlobmanKill.KillPlayer(player)
                BlobmanKill.GrabRelease(blobman, targetRoot)
            end)
            myRoot.CFrame = originalCFrame
            task.wait(0.005)
        end
    end
end

