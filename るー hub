autoBarrierToggleObj = LeftGroupBB:AddToggle("AutoBarrier", {
    Text = "オート バリア破壊",
    Tooltip = "成功するまで自動でバリア破壊を繰り返します",
    Default = false,
    Callback = function(Value)
        autoBarrierRunning = Value
        if Value then
            Notify("開始", "成功するまで自動実行します", 2)
            task.spawn(function()
                while autoBarrierRunning do
                    local result = executeBarrierBreak()
                    if result then
                        if autoBarrierToggleObj then
                            autoBarrierToggleObj:SetValue(false)
                        end
                        break
                    end
                    task.wait(1)
                end
            end)
        else
            Notify("停止", "自動実行を停止しました", 2)
        end
    end,
})

