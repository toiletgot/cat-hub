-- オーナーシップスパム
local function NoBlobSpamOwnership(hrp)
    local ge = ReplicatedStorage:FindFirstChild("GrabEvents")
    if not ge then return end
    local setOwner = ge:FindFirstChild("SetNetworkOwner")
    if setOwner and hrp then
        pcall(function()
            setOwner:FireServer(hrp, hrp.CFrame)
        end)
    end
end

-- テレポート
local function NoBlobTeleportToPlayer(myHrp, targetHrp)
    if not myHrp or not targetHrp then return end
    pcall(function()
        myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 5, 5)
        myHrp.AssemblyLinearVelocity = Vector3.zero
    end)
end

-- グラブライン破棄
local function NoBlobDestroyLineOnPlayer(hrp)
    local ge = ReplicatedStorage:FindFirstChild("GrabEvents")
    if not ge then return end
    local createLine = ge:FindFirstChild("CreateGrabLine")
    local destroyLine = ge:FindFirstChild("DestroyGrabLine")
    if not createLine or not destroyLine then return end
    pcall(function()
        createLine:FireServer(hrp, CFrame.new(0, 1e9, 0))
        task.wait()
        destroyLine:FireServer(hrp)
    end)
end

-- ラインラグ開始
local function NoBlobStartLineLag()
    if noblob_line_lag_enabled then return end
    noblob_line_lag_enabled = true
    noblob_line_lag_thread = coroutine.create(function()
        local ge = ReplicatedStorage:FindFirstChild("GrabEvents")
        if not ge then return end
        local createLine = ge:FindFirstChild("CreateGrabLine")
        if not createLine then return end
        while noblob_line_lag_enabled do
            local spawnLocation = Workspace:FindFirstChild("SpawnLocation")
                or Workspace:FindFirstChild("Spawn")
                or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
            if spawnLocation then
                local randomX = math.random(-1e9, 1e9)
                local randomZ = math.random(-1e9, 1e9)
                local directions = {
                    CFrame.new(randomX, 0, randomZ),
                    CFrame.new(-randomX, 0, -randomZ),
                    CFrame.new(randomX, 0, -randomZ),
                    CFrame.new(-randomX, 0, randomZ)
                }
                for _, pos in pairs(directions) do
                    createLine:FireServer(spawnLocation, pos)
                end
            end
            task.wait()
        end
    end)
    coroutine.resume(noblob_line_lag_thread)
end

-- ラインラグ停止
local function NoBlobStopLineLag()
    noblob_line_lag_enabled = false
    if noblob_line_lag_thread then
        coroutine.close(noblob_line_lag_thread)
        noblob_line_lag_thread = nil
    end
end

-- ノーブロブキック実行
function ExecuteNoBlobKickAll()
    if noblob_is_running then
        Notify("ノーブロブキック", "既に実行中です", 2)
        return
    end
    
    noblob_is_running = true
    task.spawn(function()
        local height = (noblob_selected_height == "Heaven") and 1e9 or 35

        -- ラグ開始
        NoBlobStartLineLag()
        NoBlobNotify("ノーブロブキック", "ラグ開始", 2)
        task.wait(1)

        local players = NoBlobGetAllPlayers()
        if #players == 0 then
            NoBlobStopLineLag()
            NoBlobNotify("ノーブロブキック", "対象プレイヤーがいません", 3)
            noblob_is_running = false
            return
        end

        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then
            NoBlobStopLineLag()
            NoBlobNotify("ノーブロブキック", "自分のHRPが見つかりません", 3)
            noblob_is_running = false
            return
        end

        -- 対象のHRPを収集
        local playerData = {}
        for _, plr in ipairs(players) do
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                table.insert(playerData, {player = plr, hrp = hrp})
            end
        end

        if #playerData == 0 then
            NoBlobStopLineLag()
            NoBlobNotify("ノーブロブキック", "有効な対象がいません", 3)
            noblob_is_running = false
            return
        end

        NoBlobNotify("ノーブロブキック", #playerData .. "人をキック開始", 2)

        -- 各プレイヤーにテレポートしてオーナーシップをスパム
        for _, data in ipairs(playerData) do
            NoBlobTeleportToPlayer(myHrp, data.hrp)
            task.wait(0.2)
            NoBlobSpamOwnership(data.hrp)
            task.wait()
        end

        -- 円状に配置して固定
        local radius = 40
        local angleStep = (math.pi * 2) / #playerData
        for idx, data in ipairs(playerData) do
            local angle = (idx - 1) * angleStep
            local x = math.cos(angle) * radius
            local z = math.sin(angle) * radius

            pcall(function()
                data.hrp.CFrame = CFrame.new(x, height, z)
                data.hrp.AssemblyLinearVelocity = Vector3.zero
            end)

            -- BodyPositionで固定
            local bp = Instance.new("BodyPosition")
            bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bp.P = 40000000
            bp.Position = Vector3.new(x, height, z)
            bp.Parent = data.hrp
            task.delay(2, function()
                pcall(function() bp:Destroy() end)
            end)
            task.wait()
        end

        -- グラブラインでキック (8回ループ)
        for i = 1, 8 do
            for _, data in ipairs(playerData) do
                NoBlobDestroyLineOnPlayer(data.hrp)
            end
            task.wait(0.3)
        end

        NoBlobNotify("ノーブロブキック", #playerData .. "人キック完了！ラグ継続中", 3)
        noblob_is_running = false
    end)
end

-- ラグ停止関数
