-- 【最強の受信傍受イベント】
local function onChatted(player, message)
    if player == LocalPlayer or not Config.RecvEnabled then return end
    if not (Config.EveryoneMode or Config.SelectedPlayers[player.Name]) then return end
    
    task.spawn(function()
        if message:sub(1, 1) == "【" or message:sub(1, 1) == "[" then return end
        
        -- モールス信号のパターン判定を最適化 ( . , - , ー , ・ , / , ／ , スペース のみ)
        local cleanMsg = message:gsub("%s+", "")
        if cleanMsg:match("^[%.%-ー・/／]+$") and (cleanMsg:find("%.") or cleanMsg:find("-") or cleanMsg:find("ー") or cleanMsg:find("・")) then
            
            -- 他人の打ったモールス信号（どんな形式でも）テキストへデコード
            local decodedEnglish = morseToText(message)
            
            if decodedEnglish and decodedEnglish:gsub("%s+", "") ~= "" then
                -- 解読された英語を日本語へ翻訳
                local translatedJa, _ = translateExtended(decodedEnglish, "en", "ja")
                local finalResult = translatedJa and ("【モールス解読】" .. translatedJa) or ("【モールス英語】" .. decodedEnglish)
                
                LogSection:AddButton({
                    Name = player.Name .. ": " .. finalResult,
                    Callback = function() copyToClipboard(finalResult) end
                })
                
                OrionLib:MakeNotification({
                    Name = player.Name .. " (モールス信号を傍受)",
                    Content = finalResult,
                    Time = 6
                })
                return -- モールス解読が成功したため、通常の翻訳処理はスキップ
            end
        end
        
        -- 【通常会話】外国語 ➜ 日本語翻訳
        local translated, langName = translateExtended(message, "auto", "ja")
        if translated and translated:lower() ~= message:lower() and langName ~= "日本語" then
            LogSection:AddButton({
                Name = player.Name .. " (" .. tostring(langName) .. "): " .. translated,
                Callback = function() copyToClipboard(translated) end
            })
            OrionLib:MakeNotification({
                Name = player.Name .. " (" .. tostring(langName) .. ")",
                Content = translated,
                Time = 5
            })
        end
    end)
end

local function setupPlayer(p) p.Chatted:Connect(function(msg) onChatted(p, msg) end) end
for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
