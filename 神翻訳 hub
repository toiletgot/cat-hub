-- ===== 「ー・」および世界標準「-.」両対応 モールスエンジン =====
local MorseAlphabet = {
    ["A"] = "・ー",   ["B"] = "ーー・・", ["C"] = "ー・ー・", ["D"] = "ー・・",  ["E"] = "・",
    ["F"] = "・・ー・", ["G"] = "ーー・",  ["H"] = "・・・・", ["I"] = "・・",   ["J"] = "・ーーー",
    ["K"] = "ー・ー",  ["L"] = "・ー・・", ["M"] = "ーー",   ["N"] = "ー・",   ["O"] = "ーーー",
    ["P"] = "・ーー・", ["Q"] = "ーー・ー", ["R"] = "・ー・",  ["S"] = "・・・",  ["T"] = "ー",
    ["U"] = "・・ー",  ["V"] = "・・・ー", ["W"] = "・ーー",  ["X"] = "ー・・ー", ["Y"] = "ー・ーー",
    ["Z"] = "ーー・・",
    ["1"] = "・ーーーー", ["2"] = "・・ーーー", ["3"] = "・・・ーー", ["4"] = "・・・・ー", ["5"] = "・・・・・",
    ["6"] = "ー・・・・", ["7"] = "ーー・・・", ["8"] = "ーーー・・", ["9"] = "ーーーー・", ["0"] = "ーーーーー",
    ["."] = "・ー・ー・ー", [","] = "ーー・・ーー", ["?"] = "・・ーー・・", ["/"] = "ー・・ー・", ["-"] = "ー・・・・ー",
    [" "] = "／"
}

-- 解読用の逆引き辞書（内部で全て「・」と「ー」に統一して照合）
local InverseMorse = {}
for letter, morse in pairs(MorseAlphabet) do
    InverseMorse[morse] = letter
end

-- 送信用変換 (日本語 ➜ 英語 ➜ 「ー・」)
local function textToMorse(text)
    text = text:upper()
    local result = {}
    for i = 1, #text do
        local char = text:sub(i, i)
        local morse = MorseAlphabet[char]
        if morse then table.insert(result, morse) end
    end
    return table.concat(result, " ")
end

-- 【超強化】受信デコード用 (他人の「-.」も「ー・」も両方解読する)
local function morseToText(morseText)
    -- 相手が打ってきた文字を「・」と「ー」と「/」の表記にすべて強制置換（正規化）
    local normalized = morseText:gsub("%.", "・"):gsub("%-", "ー"):gsub("／", "/"):gsub("%s*/%s*", " / ")
    
    local result = {}
    -- スペースやスラッシュを基準に符号を切り出して解読
    for code in normalized:gmatch("[^%s]+") do
        if code == "/" then
            table.insert(result, " ")
        else
            local letter = InverseMorse[code]
            if letter then 
                table.insert(result, letter) 
            end
        end
    end
    return table.concat(result, "")
end

