local AUTO_TARGET = true

local NOSE_CORRECTION = CFrame.Angles(0, math.rad(-90), 0) * CFrame.Angles(math.rad(90), 0, 0)

local GRABBABLE_NAMES = {
    BombMissile = true,
    -- 必要に応じて追加
}

----------------------------------------------------------------
-- ユーティリティ
----------------------------------------------------------------
local function isGrabbable(part)
    if not part or not part:IsA("BasePart") then return false end
    if part.Anchored then return false end
    if GRABBABLE_NAMES[part.Name] then return true end
    local model = part:FindFirstAncestorOfClass("Model")
    if model and GRABBABLE_NAMES[model.Name] then return true end
    return false
end

local function isAlreadyControlled(root)
    for _, entry in ipairs(controlledMissiles) do
        if entry.root == root then return true end
    end
    return false
end

local function findNearbyMissiles()
    local char = player.Character
    if not char then return {} end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    local origin = hrp.Position

    local results, seen = {}, {}
    -- 軽量化のため、まずはWorkspace直下と主要フォルダを優先的に見る（必要に応じて調整）
    local searchRoots = {workspace}
    
    for _, searchRoot in ipairs(searchRoots) do
        for _, obj in ipairs(searchRoot:GetDescendants()) do
            if obj:IsA("BasePart") and isGrabbable(obj) then
                local root = obj.AssemblyRootPart or obj
                if not seen[root] then
                    seen[root] = true
                    local dist = (root.Position - origin).Magnitude
                    if dist <= GRAB_RADIUS and not isAlreadyControlled(root) then
                        table.insert(results, { root = root, dist = dist })
                    end
                end
            end
        end
    end

    table.sort(results, function(a, b) return a.dist < b.dist end)
    local roots = {}
    for _, r in ipairs(results) do
        table.insert(roots, r.root)
    end
    return roots
end

local function getMissileCenter()
    local avgPos, count = Vector3.zero, 0
    for _, entry in ipairs(controlledMissiles) do
        if entry.root and entry.root.Parent then
            avgPos = avgPos + entry.root.Position
            count = count + 1
        end
    end
    if count == 0 then return nil end
    return avgPos / count
end

local function findNearestTarget()
    local center = getMissileCenter()
    if not center then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - center).Magnitude
                if d < nearestDist then
                    nearest = p
                    nearestDist = d
                end
            end
        end
    end
    return nearest
end

local function getTargetPosition()
    if not targetPlayer then return nil end
    local char = targetPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil end
    return hrp.Position
end

