----------------------------------------------------------------
-- 毎フレーム更新
----------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not controlling or #controlledMissiles == 0 then
        return
    end

    -- 消滅したミサイルを掃除
    for i = #controlledMissiles, 1, -1 do
        local entry = controlledMissiles[i]
        if not entry.root or not entry.root.Parent then
            destroyMissileEntry(entry)
            table.remove(controlledMissiles, i)
        end
    end

    if #controlledMissiles == 0 then
        stopControl()
        stickBase.Visible = false
        resetKnob()
        return
    end

    updateThirdPersonCamera(dt)
    local camCF = camera.CFrame

    -- ターゲット管理
    if AUTO_TARGET and not LOCKED_TARGET then
        local cur = targetPlayer
        local valid = cur and cur.Character
            and cur.Character:FindFirstChild("HumanoidRootPart")
            and cur.Character:FindFirstChildOfClass("Humanoid")
            and cur.Character:FindFirstChildOfClass("Humanoid").Health > 0
        if not valid then
            targetPlayer = findNearestTarget()
            updateTargetMarker()
        end
    else
        if targetPlayer then
            local char = targetPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then
                targetPlayer = nil
                LOCKED_TARGET = false
                targetMarker.Enabled = false
            end
        end
    end

    local targetPos = getTargetPosition()

    for _, entry in ipairs(controlledMissiles) do
        if entry.linearVel and entry.linearVel.Parent then
            local desiredVel
            if targetPos then
                local dir = (targetPos - entry.root.Position)
                if dir.Magnitude > 0.1 then
                    desiredVel = dir.Unit * CURRENT_SPEED
                else
                    desiredVel = Vector3.zero
                end
            else
                local forwardVel = camCF.LookVector * CURRENT_SPEED
                local rightVel = camCF.RightVector * (stickInput.X * CURRENT_SPEED)
                local upVel = Vector3.new(0, 1, 0) * (-stickInput.Y * CURRENT_SPEED)
                desiredVel = forwardVel + rightVel + upVel
            end

            entry.linearVel.VectorVelocity = desiredVel

            if desiredVel.Magnitude > 0.5 then
                local lookCFrame = CFrame.lookAt(Vector3.zero, desiredVel.Unit) * NOSE_CORRECTION
                if entry.alignMover and entry.alignMover.Parent then
                    entry.alignMover.CFrame = lookCFrame
                end
            end
        end
    end
end)

