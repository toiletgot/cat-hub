local function refreshDropdown()
    local opts = {}
    local center = getMissileCenter()
        or (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local label = p.DisplayName
            if center and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - center).Magnitude
                    label = string.format("%s [%dm]", p.DisplayName, math.floor(d))
                end
            end
            table.insert(opts, label)
        end
    end
    playerDropdown:Refresh(opts, true)
end

