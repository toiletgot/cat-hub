                        if not blobman then
                            local spawned = false
                            local connection
                            connection = folder.ChildAdded:Connect(function(child)
                                if child.Name == "CreatureBlobman" then
                                    spawned = true
                                    if connection then connection:Disconnect() end
                                    local seat = child:WaitForChild("VehicleSeat", 5)
                                    if seat and hum.SeatPart == nil then
                                        hrp.CFrame = seat.CFrame
                                        task.wait()
                                        seat:Sit(hum)
                                    end
                                end
                            end)
                            
                            task.spawn(function()
                                game.ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", hrp.CFrame, Vector3.new(0, 0, 0))
                            end)
                            
                            local startTime = tick()
                            repeat task.wait() until spawned or (tick() - startTime > 3)
                            if connection then connection:Disconnect() end
                        else
                            if hum.SeatPart == nil then
                                local seat = blobman:FindFirstChild("VehicleSeat")
                                if seat then
                                    hrp.CFrame = seat.CFrame
                                    task.wait()
                                    seat:Sit(hum)
                                end
                            end
                        end
                        
                        local startTime = tick()
                        repeat 
                            task.wait() 
                            char = game.Players.LocalPlayer.Character
                            hum = char and char:FindFirstChildOfClass("Humanoid")
                        until (hum and hum.SeatPart and hum.SeatPart.Parent.Name == "CreatureBlobman") or not loopKickBlobActive or (tick() - startTime > 4)
                    end
                    
                    if loopKickBlobActive and selectedPlayers and #selectedPlayers > 0 then
                        for _, targetName in ipairs(selectedPlayers) do
                            if not loopKickBlobActive then break end
                            LoopKickBlobFunction(targetName)
                        end
                    end
                end)
            end
        end
    })
