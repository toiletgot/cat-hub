do
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local UserInputService = game:GetService("UserInputService")
    
    local LocalPlayer = Players.LocalPlayer

    local EnvData = { 
        IsActive = false, 
        IsLoopRunning = false, 
        RagdollSpeed = 35, 
        JumpPower = 52 
    }

    local WantToJump = false

    local function findRemote()
        local rem = ReplicatedStorage:FindFirstChild("RagdollRemote")
        if rem then return rem end
        
        local folder = ReplicatedStorage:FindFirstChild("CharacterEvents")
        if folder then
            rem = folder:FindFirstChild("RagdollRemote")
            if rem then return rem end
        end
        
        return game:FindFirstChild("RagdollRemote", true)
    end

    local function setRagdollState(state)
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local remote = findRemote()
            if remote and remote:IsA("RemoteEvent") then
                remote:FireServer(hrp, state and 1 or 0)
            else
                warn("Perm Ragdoll Error: 'RagdollRemote' not found.")
            end
        end
    end

    local jumpConn = UserInputService.JumpRequest:Connect(function()
        if EnvData.IsActive then
            WantToJump = true
        end
    end)

    local function startRagdollLoop()
        if EnvData.IsLoopRunning then return end
        EnvData.IsLoopRunning = true
        
        while EnvData.IsActive do
            local character = LocalPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChild("Humanoid")
            
            if hrp and humanoid then
                setRagdollState(true)
                
                local moveDir = humanoid.MoveDirection
                local velX = moveDir.X * EnvData.RagdollSpeed
                local velZ = moveDir.Z * EnvData.RagdollSpeed
                local velY = hrp.AssemblyLinearVelocity.Y
                
                if humanoid.Jump or WantToJump then
                    if math.abs(hrp.AssemblyLinearVelocity.Y) < 1.5 then
                        velY = EnvData.JumpPower
                    end
                    humanoid.Jump = false
                    WantToJump = false
                end

                if moveDir.Magnitude > 0 or velY == EnvData.JumpPower then
                    hrp.AssemblyLinearVelocity = Vector3.new(velX, velY, velZ)
                end
            end
            task.wait()
        end
        
        EnvData.IsLoopRunning = false
        WantToJump = false
        setRagdollState(false)
    end

    AntiTab:CreateSection("Anti Kill")

    AntiTab:CreateToggle({
        Name = "Perm Ragdoll",
        CurrentValue = false,
        Flag = "PermRagdoll",
        Callback = function(value)
            EnvData.IsActive = value
            if value then
                task.spawn(startRagdollLoop)
            end
        end
    })
end

