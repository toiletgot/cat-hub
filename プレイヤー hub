    local EnvData = { Connections = {}, IsActive = false }

    local function getPlayerData(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return nil end
        local character = targetPlayer.Character
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not (rootPart and humanoid) then return nil end
        if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then return nil end
        local inPlot = targetPlayer:FindFirstChild("InPlot")
        if inPlot and inPlot.Value == true then return nil end
        return {Character = character, Root = rootPart, Humanoid = humanoid}
    end

    local function executeKill(targetPlayer)
        local character = targetPlayer.Character
        if not character then return end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 0)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid or humanoid.Health <= 0 then return end
        
        local localCharacter = LocalPlayer.Character
        local localHand = localCharacter and (localCharacter:FindFirstChild("Right Arm") or localCharacter:FindFirstChild("RightHand"))
        if not localHand then return end
        local originalPivot = localCharacter:GetPivot()
        
        task.spawn(function()
            localCharacter:PivotTo(rootPart.CFrame * CFrame.new(0, 0, 1.5))
            local startTime = tick()
            while tick() - startTime < 0.4 do
                if not rootPart or not humanoid or humanoid.Health <= 0 then break end
                local targetCFrame = localCharacter:GetPivot() * CFrame.new(0, 0, -1.5)
                for _ = 1, 5 do
                    ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(rootPart, targetCFrame)
                    ReplicatedStorage.GrabEvents.CreateGrabLine:FireServer(rootPart, localHand)
                end
                
                local kp = KillPlayer or killPlayer or _G.KillPlayer or shared.KillPlayer
                if kp then kp(targetPlayer.Name) end
                
                RunService.Heartbeat:Wait()
            end
            ReplicatedStorage.GrabEvents.DestroyGrabLine:FireServer(rootPart)
            task.wait(0.02)
            if localCharacter:FindFirstChildOfClass("Humanoid") and localCharacter.Humanoid.Health > 0 then
                localCharacter:PivotTo(originalPivot)
            end
        end)
    end

    local function setupPlayerConnection(targetPlayer)
        if EnvData.Connections[targetPlayer] then EnvData.Connections[targetPlayer]:Disconnect() end
        EnvData.Connections[targetPlayer] = targetPlayer.CharacterAdded:Connect(function(character)
            if not EnvData.IsActive then return end
            
            local targets = selectedPlayers or _G.selectedPlayers or shared.selectedPlayers or {}
            local isTarget = false
            for _, name in pairs(targets) do
                if name == targetPlayer.Name then isTarget = true break end
            end
            if isTarget then
                task.spawn(executeKill, targetPlayer)
            end
        end)
    end

    for _, player in pairs(Players:GetPlayers()) do
