                                tDot.Size = UDim2.new(0, 5, 0, 5)
                                tDot.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
                                tDot.BorderSizePixel = 0
                                tDot.AnchorPoint = Vector2.new(0.5, 0.5)
                                tDot.ZIndex = 5
                                tDot.Parent = Viewport
                                Instance.new("UICorner", tDot).CornerRadius = UDim.new(1, 0)
                                toyDots[toy] = tDot
                            end
                            local sPos = MapCamera:WorldToViewportPoint(mPart.Position)
                            tDot.Position = UDim2.new(math.clamp(sPos.X, 0.02, 0.98), 0, math.clamp(sPos.Y, 0.02, 0.98), 0)
                            tDot.BackgroundTransparency = (sPos.X < 0 or sPos.X > 1 or sPos.Y < 0 or sPos.Y > 1) and 0.6 or 0
                            tDot.Visible = true
                        end
                    end
                end
            end

            for name, dot in pairs(dots) do
                if not game:GetService("Players"):FindFirstChild(name) then dot:Destroy(); dots[name] = nil end
            end
            for toy, tDot in pairs(toyDots) do
                if not toy.Parent then tDot:Destroy(); toyDots[toy] = nil end
            end
        end)
    end

