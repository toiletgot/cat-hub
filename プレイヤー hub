    local CE = RS:FindFirstChild("CharacterEvents")
    local SG = CE and CE:FindFirstChild("Struggle")
    local SV_F = RS:FindFirstChild("GameCorrectionEvents")
    local SV = SV_F and SV_F:FindFirstChild("StopAllVelocity")
    
    local conn = nil
    local tripConns = {}

    local function setAnc(char, state)
        if not char then return end
        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then 
                p.Anchored = state 
                if not state then p.Velocity = Vector3.new(0,0,0) end
            end
        end
    end

    local function recover(hum, root)
        if not (hum and root) then return end
        pcall(function() root.AssemblyLinearVelocity = Vector3.new(0,0,0) end)
        pcall(function() root.AssemblyAngularVelocity = Vector3.new(0,0,0) end)
        pcall(function() hum.PlatformStand = false end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
    end

    local function setupAntiTrip(char)
        for _, c in pairs(tripConns) do c:Disconnect() end
        tripConns = {}
        
        local hum = char:WaitForChild("Humanoid", 5)
        local root = char:WaitForChild("HumanoidRootPart", 5)
        if not (hum and root) then return end

        -- Seated (座る状態) の無効化を解除
        local states = {
            Enum.HumanoidStateType.FallingDown, 
            Enum.HumanoidStateType.Ragdoll, 
            Enum.HumanoidStateType.PlatformStanding
        }
        for _, st in ipairs(states) do
            pcall(function() hum:SetStateEnabled(st, false) end)
        end

        -- 状態変化ループから Seated を除外
        table.insert(tripConns, hum.StateChanged:Connect(function(_, new)
            if not _G.IsAntiGrabbing and (new == Enum.HumanoidStateType.FallingDown or new == Enum.HumanoidStateType.Ragdoll or new == Enum.HumanoidStateType.PlatformStanding) then
                recover(hum, root)
            end
        end))

        -- 常時監視ループから Seated を除外
        table.insert(tripConns, R.RenderStepped:Connect(function()
            if not _G.IsAntiGrabbing then
                local s = hum:GetState()
                if s == Enum.HumanoidStateType.FallingDown or s == Enum.HumanoidStateType.Ragdoll or s == Enum.HumanoidStateType.PlatformStanding then
                    recover(hum, root)
                end
            end
        end))
    end

    AntiTab:CreateToggle({
        Name = "Anti Grab",
        CurrentValue = false,
        Flag = "AntiGrabExtreme",
        Callback = function(v)
            if conn then conn:Disconnect() conn = nil end
            for _, c in pairs(tripConns) do c:Disconnect() end
            tripConns = {}

            if v then
                if LP.Character then setupAntiTrip(LP.Character) end
                table.insert(tripConns, LP.CharacterAdded:Connect(setupAntiTrip))

                conn = R.Heartbeat:Connect(function()
                    local char = LP.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChild("Humanoid")
                    if not hrp or not hum or _G.IsAntiGrabbing then return end
                    
                    local head = char:FindFirstChild("Head")
                    local po = head and head:FindFirstChild("PartOwner")
                    local ih = LP:FindFirstChild("IsHeld")
                    
                    local hasControlBP = hrp:FindFirstChild("ControlBP") or hrp:FindFirstChild("ControlBG") or char:FindFirstChildOfClass("BodyPosition") or char:FindFirstChildOfClass("BodyGyro")
                    
                    if (po or (ih and ih.Value == true) or hasControlBP) then
                        _G.IsAntiGrabbing = true
                        
                        local oldCF = hrp.CFrame
                        
                        local grabberName = po and po.Value or ""
                        if grabberName == "" and ih and ih:FindFirstChild("Player") then
                            grabberName = ih.Player.Value
                        end
                        
                        local struggleActive = true
                        task.spawn(function()
                            while struggleActive do
                                if (head:FindFirstChild("PartOwner") or (ih and ih.Value) or hrp:FindFirstChild("ControlBP")) then
                                    local targetPlayer = PS:FindFirstChild(grabberName)
                                    local targetChar = targetPlayer and targetPlayer.Character
                                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                                        for i = 1, 15 do
                                            if SG then SG:FireServer() end
                                        end
                                    end
                                end
                                task.wait()
                            end
                        end)

                        local startTime = tick()
                        local activeConnections = {}
                        
                        local function absoluteOverride()
                            for _, obj in pairs(char:GetDescendants()) do
                                if obj:IsA("BodyMover") or obj:IsA("BodyPosition") or obj:IsA("BodyGyro") or obj:IsA("BodyVelocity") or obj:IsA("BodyThrust") or obj:IsA("RocketPropulsion") then
                                    obj:Destroy()
                                elseif obj:IsA("Constraint") and not (obj:IsA("Weld") or obj:IsA("Motor6D")) then
                                    obj:Destroy()
                                end
                            end
                            
                            -- hum.Sit = false を削除し、座る状態を維持できるように修正
                            if hum then
                                hum.PlatformStand = false
                                hum.WalkSpeed = 16
                                hum.JumpPower = 50
                                pcall(function()
                                    hum:ChangeState(Enum.HumanoidStateType.None)
                                end)
                            end
                            
                            hrp.CFrame = oldCF
                            
                            for _, part in pairs(char:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                end
                            end
                            
                            local distance = (hrp.Position - oldCF.Position).Magnitude
                            if not (head:FindFirstChild("PartOwner") or (ih and ih.Value == true) or hrp:FindFirstChild("ControlBP")) and (distance < 0.2 or (tick() - startTime > 1.2)) then
                                struggleActive = false
                                for _, c in pairs(activeConnections) do c:Disconnect() end
                                recover(hum, hrp)
                                _G.IsAntiGrabbing = false
                            end
                        end

                        table.insert(activeConnections, R.RenderStepped:Connect(absoluteOverride))
                        table.insert(activeConnections, R.Heartbeat:Connect(absoluteOverride))
                        table.insert(activeConnections, R.Stepped:Connect(absoluteOverride))
                        
                    end
                end)
            else
                _G.IsAntiGrabbing = false
                if LP.Character then 
                    setAnc(LP.Character, false)
                    local hum = LP.Character:FindFirstChild("Humanoid")
                    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
                    if hum then recover(hum, hrp) end
                end
            end
        end,
    })
end

