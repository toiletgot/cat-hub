do
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    local Workspace = workspace

    local LocalPlayer = Players.LocalPlayer
    local playerToysFolderName = LocalPlayer.Name .. "SpawnedInToys"
    local targetObjectName = "FoodHamburger"

    local isAntiNetworkActive = false
    local teleportHeight = 15000000

    local function destroyTargetToy()
        local toyFolder = Workspace:FindFirstChild(playerToysFolderName)
        local targetToy = toyFolder and toyFolder:FindFirstChild(targetObjectName)
        if targetToy then
            local menuToys = ReplicatedStorage:FindFirstChild("MenuToys") or ReplicatedStorage.MenuToys
            menuToys.DestroyToy:FireServer(targetToy)
        end
    end

    RunService.Stepped:Connect(function()
        if isAntiNetworkActive then
            local toyFolder = Workspace:FindFirstChild(playerToysFolderName)
            local targetToy = toyFolder and toyFolder:FindFirstChild(targetObjectName)
            if targetToy then
                for _, part in pairs(targetToy:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.CanTouch = false
                    end
                end
            end
        end
    end)

    local function claimOwnership(toyObject)
        local holdPart = toyObject:FindFirstChild("HoldPart")
        if not holdPart then return end
        
        local holdRemote = holdPart:FindFirstChild("HoldItemRemoteFunction")
        local dropRemote = holdPart:FindFirstChild("DropItemRemoteFunction")
        
        if holdRemote and dropRemote then
            local targetCFrame = CFrame.new(Vector3.new(0, teleportHeight, 0))
            task.spawn(function()
                holdRemote:InvokeServer(toyObject, LocalPlayer.Character)
                dropRemote:InvokeServer(toyObject, targetCFrame, targetCFrame)
            end)
        end
    end

    AntiTab:CreateSection("Anti Network Ownership")

    AntiTab:CreateToggle({
        Name = "Anti Network Ownership",
        CurrentValue = false,
        Flag = "GhostToggle",
        Callback = function(inputValue)
            isAntiNetworkActive = inputValue
            
            if not inputValue then
                destroyTargetToy()
                return
            end

            task.spawn(function()
                while isAntiNetworkActive do
                    local toyFolder = Workspace:FindFirstChild(playerToysFolderName)
                    local targetToy = toyFolder and toyFolder:FindFirstChild(targetObjectName)
                    
                    if not targetToy then
                        local character = LocalPlayer.Character
                        local spawnCFrame = (character and character.PrimaryPart) and character.PrimaryPart.CFrame or CFrame.new(0, 5, 0)
                        
                        task.spawn(function()
                            local menuToys = ReplicatedStorage:FindFirstChild("MenuToys") or ReplicatedStorage.MenuToys
                            menuToys.SpawnToyRemoteFunction:InvokeServer(targetObjectName, spawnCFrame, Vector3.new(0, 90, 0))
                        end)
                        
                        local spawnedToy = nil
                        for _ = 1, 20 do
                            spawnedToy = toyFolder and toyFolder:FindFirstChild(targetObjectName)
                            if spawnedToy then break end
                            task.wait()
                        end
                        
                        if spawnedToy then 
                            claimOwnership(spawnedToy) 
                        end
                    else
                        claimOwnership(targetToy)
                    end
                    
                    task.wait()
                end
            end)

            task.spawn(function()
                while isAntiNetworkActive do
                    task.wait(12)
                    if isAntiNetworkActive then 
                        destroyTargetToy() 
                    end
                end
            end)
        end
    })
end

