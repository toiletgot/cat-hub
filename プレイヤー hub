local function SavePlayerPosition()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        savedCFrame = character.HumanoidRootPart.CFrame
        return true
    end
    return false
end

local function RestorePlayerPosition()
    if not savedCFrame then return false end
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    character.HumanoidRootPart.CFrame = savedCFrame
    return true
end

local function GetCharacter() return LocalPlayer.Character end
local function GetHumanoidRootPart() return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") end
local function GetHumanoid() return LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") end
local function GetSpawnedToysFolder() return workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys") end

local function SpawnToy(toyName, spawnCFrame)
    local success, result = pcall(function()
        return ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(toyName, spawnCFrame, Vector3.zero)
    end)
    return result
end

local function DestroyToy(toyInstance)
    pcall(function()
        ReplicatedStorage.MenuToys.DestroyToy:FireServer(toyInstance)
    end)
end

local function TriggerRagdoll()
    local hrp = GetHumanoidRootPart()
    if hrp then
        pcall(function()
            ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0)
        end)
    end
end

local function StartShortDelay()
    if isDelayActive then return end
    isDelayActive = true
    if delayTask then delayTask:Cancel() end
    delayTask = task.delay(0.1, function() delayTask = nil end)
end

local function GetCreatureBlobman()
    local toysFolder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    return toysFolder and toysFolder:FindFirstChild("CreatureBlobman")
end

local function GetTractorGreen()
    local toysFolder = GetSpawnedToysFolder()
    return toysFolder and toysFolder:FindFirstChild("TractorGreen")
end

local function GetTrainSeat()
    local trainModel = workspace.Map.AlwaysHereTweenedObjects.Train.Object.ObjectModel
    return trainModel and trainModel:FindFirstChildWhichIsA("Seat")
end

local function InitializeCreatureBlobman()
    if GetCreatureBlobman() then return true end
    local success = SpawnToy("CreatureBlobman", CFrame.new(0, 1000000, 0))
    if success then
        local blobman = GetCreatureBlobman()
        if blobman then
            task.spawn(function()
                for _, part in pairs(blobman:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Anchored = true
                        part.CFrame = CFrame.new(0, 1000000, 0)
                    end
                end
            end)
        end
    end
    return success
end

local function InitializeTractorGreen()
    if GetTractorGreen() then return true end
    local success = SpawnToy("TractorGreen", CFrame.new(0, 1000000, 0))
    if success then
        local tractor = GetTractorGreen()
        if tractor then
            task.spawn(function()
                for _, part in pairs(tractor:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Anchored = true
                        part.CFrame = CFrame.new(0, 1000000, 0)
                    end
                end
            end)
        end
    end
    return success
end

local function ForceSitOnSeat(seatInstance)
    if not seatInstance or not GetHumanoidRootPart() or not GetHumanoid() then return end
    SavePlayerPosition()
    
    GetHumanoidRootPart().CFrame = seatInstance.CFrame + Vector3.new(0, 0.5, 0)
    local sitSuccess = pcall(function() seatInstance:Sit(GetHumanoid()) end)
    
    if sitSuccess then
        task.wait(0.1)
        if GetHumanoid() then
            GetHumanoid():ChangeState(Enum.HumanoidStateType.Jumping)
            RestorePlayerPosition()
        end
    else
        RestorePlayerPosition()
    end
end

local function ResetAndClearAll()
    isLoopActive1 = false
    isLoopActive2 = false
    isLoopActive3 = false
    isLoopActive4 = false
    isDelayActive = false
    if delayTask then delayTask:Cancel() delayTask = nil end
    
    local toysFolder = GetSpawnedToysFolder()
    if toysFolder then
        local blobman = toysFolder:FindFirstChild("CreatureBlobman")
        if blobman then DestroyToy(blobman) end
        
        local tractor = toysFolder:FindFirstChild("TractorGreen")
        if tractor then DestroyToy(tractor) end
        
        local sleigh = toysFolder:FindFirstChild("SantaSleigh")
        if sleigh then DestroyToy(sleigh) end
    end
end

local isAntiSitEnabled = false
local selectedPlayerConnection = nil
local targetCharacterConnection = nil

local function SetupCharacterMonitor(characterInstance)
    local humanoid = characterInstance:WaitForChild("Humanoid", 5)
    local hrp = characterInstance:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not hrp then return end
    
    local firePart = hrp:FindFirstChild("FirePlayerPart")
    if firePart then firePart:Destroy() end
    
    humanoid.Changed:Connect(function(property)
        if isAntiSitEnabled and property == "Sit" and humanoid.Sit == true then
            if humanoid.SeatPart then
                local seatParent = humanoid.SeatPart.Parent
                if seatParent and tostring(seatParent) == "CreatureBlobman" then
                    return
                end
            end
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            humanoid.Sit = false
        end
    end)
end

