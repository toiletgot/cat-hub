                local myRot = myLookAngle + (-math.pi / 2)
                MapCamera.CFrame = CFrame.new(myPos + Vector3.new(0, 3000, 0), myPos) * CFrame.Angles(0, 0, myRot)

                for _, player in ipairs(allPlayers) do
                    local char = player.Character
