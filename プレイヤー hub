    createMiniMap()
    MiscTab:CreateToggle({
        Name = "MiniMap",
        CurrentValue = false,
        Flag = "MiniMapEnabled",
        Callback = function(Value)
            MiniMapEnabled = Value
        end
    })
end

MiscTab:CreateSection("Animation")

local SelectedAnimation = "Crouch"
local AnimationToggle = false
local CurrentAnimTrack = nil

local AnimPaths = {
    ["Crouch"] = game:GetService("ReplicatedFirst").Animations.Crouch,
    ["FireFlailAnimation"] = game:GetService("ReplicatedFirst").CatchFire.FireFlailAnimation,
    ["Flail"] = game:GetService("ReplicatedFirst").ThrowPlayers.Flail,
    ["Type"] = game:GetService("ReplicatedFirst").Typing.Type
}

local AnimationList = {"Crouch", "FireFlailAnimation", "Flail", "Type"}

local function stopAllTracks()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
            track:Stop()
        end
    end
end

local function playSelectedAnimation()
    if not AnimationToggle then return end
    
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local animObject = AnimPaths[SelectedAnimation]
    if animObject and animObject:IsA("Animation") then
        stopAllTracks()
        CurrentAnimTrack = humanoid:LoadAnimation(animObject)
        CurrentAnimTrack.Looped = true
        CurrentAnimTrack:Play()
    end
end

MiscTab:CreateDropdown({
    Name = "Animation",
    Options = AnimationList,
    CurrentOption = {"Crouch"},
    MultipleOptions = false,
    Flag = "SelectedAnim",
    Callback = function(Option)
        SelectedAnimation = Option[1]
        
        if AnimationToggle then
            playSelectedAnimation()
        end
    end
})

MiscTab:CreateToggle({
    Name = "Play Animation",
    CurrentValue = false,
    Flag = "AnimToggle",
    Callback = function(Value)
        AnimationToggle = Value
        if Value then
            playSelectedAnimation()
        else
            stopAllTracks()
            if CurrentAnimTrack then
                CurrentAnimTrack:Stop()
                CurrentAnimTrack = nil
            end
        end
    end
})

LocalPlayer.CharacterAdded:Connect(function(character)
    if AnimationToggle then
        local humanoid = character:WaitForChild("Humanoid", 10)
        if humanoid then
            task.wait(1)
            playSelectedAnimation()
        end
    end
end)

