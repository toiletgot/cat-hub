        end
        
        if Value then
            local function setupDetection(char)
                local head = char:WaitForChild("Head", 5)
                if not head then return end
                
                grabNotificationConn = head.ChildAdded:Connect(function(child)
                    if child.Name == "PartOwner" and _G.GrabDetectionEnabled then
                        task.wait(0.1)
                        local grabberName = child.Value
                        
                        if grabberName ~= "" and grabberName ~= lastGrabber then
                            lastGrabber = grabberName
                            
                            local displayToShow = grabberName
