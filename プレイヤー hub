                            end
                            dots[player.Name] = dot
                        end
                        local screenPos = MapCamera:WorldToViewportPoint(root.Position)
                        dot.Position = UDim2.new(math.clamp(screenPos.X, 0.05, 0.95), 0, math.clamp(screenPos.Y, 0.05, 0.95), 0)
                        dot.Visible = true
                    end
                end

