do
    local OrionKickAura = false
    local AuraBlobman = nil
    local COOLDOWN_TIME = 0.8
    local EnableFriendWhitelist = false

    local KickCooldown = {}
    local ForceDisabledPlayers = {}

    local service = {
        Players = game:GetService("Players"),
        ReplicatedStorage = game:GetService("ReplicatedStorage"),
        RunService = game:GetService("RunService")
    }

    local localPlayer = service.Players.LocalPlayer

    local function getLocalChar() return localPlayer.Character end
    local function getLocalHum() return getLocalChar() and getLocalChar():FindFirstChildOfClass("Humanoid") end
    local function getLocalRoot()
        local char = getLocalChar()
        return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    end

    local function SetNetworkOwner(part)
        local grabEvents = service.ReplicatedStorage:FindFirstChild("GrabEvents")
        local setOwner = grabEvents and grabEvents:FindFirstChild("SetNetworkOwner")
        if setOwner then
            setOwner:FireServer(part, getLocalRoot().CFrame)
        end
    end

    local function blobGrab(blob, target, side)
        local detector = blob:FindFirstChild(side .. "Detector")
        local weld = detector and detector:FindFirstChild(side .. "Weld")
        local scripts = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
        local grabEvent = scripts and scripts:FindFirstChild("CreatureGrab")
        
        if detector and weld and grabEvent then
            grabEvent:FireServer(detector, target, weld)
        end
    end

    local function ungrab(part)
        local grabEvents = service.ReplicatedStorage:FindFirstChild("GrabEvents")
        local destroyLine = grabEvents and grabEvents:FindFirstChild("DestroyGrabLine")
        if destroyLine then
            destroyLine:FireServer(part)
        end
    end

    local function blobKick(blob, target, side)
        blobGrab(blob, getLocalRoot(), side)
        task.wait(0.1)
        SetNetworkOwner(target)
        task.wait()
        target.CFrame = target.CFrame + Vector3.new(0, 10, 0)
        ungrab(target)
        task.wait(0.1)
        blobGrab(blob, target, side)
    end

    local function shouldProcessPlayer(player)
        if player == localPlayer then return false end
        if EnableFriendWhitelist and localPlayer:IsFriendsWith(player.UserId) then return false end
        if player:FindFirstChild("InPlot") and player.InPlot.Value then return false end
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0) then return false end
        local last = KickCooldown[player.UserId]
        if last and (os.clock() - last) < COOLDOWN_TIME then return false end
        return true
    end

    local function removeAllForces(character)
        for _, v in ipairs(character:GetDescendants()) do
            if v:IsA("BodyForce") or v:IsA("BodyVelocity") or v:IsA("BodyAngularVelocity") 
            or v:IsA("BodyGyro") or v:IsA("VectorForce") or v:IsA("LinearVelocity") 
            or v:IsA("AngularVelocity") or v:IsA("AlignPosition") or v:IsA("AlignOrientation") then
                v:Destroy()
            end
        end
    end

    local isSpawning = false
    local function ensureBlobmanAndSit()
        if isSpawning then return end
        local char = getLocalChar()
        local hum = getLocalHum()
        local hrp = getLocalRoot()
        if not hrp or not hum then return end

        local folder = workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        local currentBlob = folder and folder:FindFirstChild("CreatureBlobman")

        if not currentBlob or not currentBlob.Parent then
            isSpawning = true
            local spawnedConnection = nil
            spawnedConnection = folder.ChildAdded:Connect(function(child)
                if child.Name == "CreatureBlobman" then
                    spawnedConnection:Disconnect()
                    AuraBlobman = child
                    local seat = child:WaitForChild("VehicleSeat", 5)
                    if seat and hum then
                        hrp.CFrame = seat.CFrame
                        task.wait(0.1)
                        seat:Sit(hum)
                    end
                    isSpawning = false
                end
            end)
            pcall(function()
                service.ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", hrp.CFrame, Vector3.new(0, 0, 0))
            end)
            task.delay(5, function() isSpawning = false end)
        else
            AuraBlobman = currentBlob
            local seat = currentBlob:FindFirstChildOfClass("VehicleSeat")
            if seat and not hum.Sit then
                hrp.CFrame = seat.CFrame
                task.wait(0.1)
                seat:Sit(hum)
            end
        end
    end

    local auraLoop = nil
    local function startAuraLoop()
        if auraLoop then auraLoop:Disconnect() end
        auraLoop = service.RunService.Heartbeat:Connect(function()
            if not OrionKickAura then return end
            
            ensureBlobmanAndSit()
            
            if not AuraBlobman or not AuraBlobman.Parent then return end
            if not getLocalHum().Sit then return end

            local root = getLocalRoot()
            if not root then return end

            for _, player in ipairs(service.Players:GetPlayers()) do
                if shouldProcessPlayer(player) then
                    local char = player.Character
                    local tRoot = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
                    if tRoot then
                        blobKick(AuraBlobman, tRoot, "Left")
                        ForceDisabledPlayers[player] = true
                        removeAllForces(char)
                        KickCooldown[player.UserId] = os.clock()
                        break
                    end
                end
            end
        end)
    end

    service.RunService.Heartbeat:Connect(function()
        if OrionKickAura then
            for player in pairs(ForceDisabledPlayers) do
                if player.Character then removeAllForces(player.Character) end
            end
        end
    end)

    BlobmanTab:CreateToggle({
        Name = "Blobman Kick Aura",
        CurrentValue = false,
        Flag = "BlobmanKickAura",
        Callback = function(v)
            OrionKickAura = v
            if v then
                startAuraLoop()
            else
                if auraLoop then auraLoop:Disconnect() auraLoop = nil end
                ForceDisabledPlayers = {}
            end
        end
    })

    BlobmanTab:CreateToggle({
        Name = "Friend Whitelist",
        CurrentValue = false,
        Flag = "BlobmanFriendWhitelist",
        Callback = function(v)
            EnableFriendWhitelist = v
        end
    })
end

