-- ================= Blobkill タブ =================
local BlobkillGroup = Tabs.Blobkill:AddLeftGroupbox("Blobkill")

local blobkillPlayerMap = {}

local function getBlobkillPlayerNames()
    local names = {}
    blobkillPlayerMap = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local displayStr = player.DisplayName .. " (@" .. player.Name .. ")"
            table.insert(names, displayStr)
            blobkillPlayerMap[displayStr] = player.Name
        end
    end
    return names
end

local BlobkillTargetDropdown = BlobkillGroup:AddDropdown("BlobkillTarget", {
    Values = getBlobkillPlayerNames(),
    Default = 1,
    Text = "ターゲットを選択",
    Callback = function(selected) end
})

