-- プレイヤー選択セクション
local PlayerSection = MainTab:AddSection({
    Name = "Players"
})

-- プレイヤー追加用ドロップダウン
local PlayerDropdown = nil
PlayerDropdown = MainTab:AddDropdown({
    Name = "Select Player",
    Default = "",
    Options = {},
    Callback = function(value)
        if value and value ~= "" then
            local name = string.split(value, " ")[1]
            if not table.find(LoopPlayers, name) then
                table.insert(LoopPlayers, name)
                OrionLib:MakeNotification({
                    Name = "Added",
                    Content = "✅ " .. name .. " を追加しました",
                    Image = "rbxassetid://7733964640",
                    Time = 2,
                })
                UpdateLoopList()
            else
                OrionLib:MakeNotification({
                    Name = "Error",
                    Content = "⚠️ " .. name .. " は既にリストにいます",
                    Image = "rbxassetid://4483345998",
                    Time = 2,
                })
            end
        end
    end
})

-- ループリスト表示用
local LoopListDropdown = nil
LoopListDropdown = MainTab:AddDropdown({
    Name = "Players in Loop",
    Default = "",
    Options = {},
    Callback = function(value)
        -- 削除用に選択を保存
        _G.SelectedLoopPlayer = value
    end
})

function UpdateLoopList()
    local names = {}
    for _, name in ipairs(LoopPlayers) do
        table.insert(names, name)
    end
    table.sort(names, function(a, b) return a:lower() < b:lower() end)
    LoopListDropdown:Refresh(names, true)
end

-- 追加ボタン
