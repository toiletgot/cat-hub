        local value = PlayerDropdown:GetValue()
        if value and value ~= "" then
            local name = string.split(value, " ")[1]
            if not table.find(LoopPlayers, name) then
                table.insert(LoopPlayers, name)
                OrionLib:MakeNotification({
                    Name = "Added",
                    Content = "✅ " .. name .. " を追加しました",
                    Image = "rbxassetid://7733964640",
                    Time = 2,
                })
                UpdateLoopList()
            end
        end
    end
})

-- 削除ボタン
MainTab:AddButton({
    Name = "Remove Selected Player",
    Callback = function()
        local value = _G.SelectedLoopPlayer
        if value and value ~= "" then
            for i, name in ipairs(LoopPlayers) do
                if name == value then
                    table.remove(LoopPlayers, i)
                    OrionLib:MakeNotification({
                        Name = "Removed",
                        Content = "❌ " .. value .. " を削除しました",
                        Image = "rbxassetid://4483345998",
                        Time = 2,
                    })
                    UpdateLoopList()
                    break
                end
            end
        end
    end
})

