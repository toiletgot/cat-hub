-- 安全なスクリプト読み込み関数
local function SafeLoadScript(url, scriptName)
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))
    end)
    
    if success and type(result) == "function" then
        local execSuccess, execErr = pcall(result)
        if execSuccess then
            Library:Notify(scriptName .. " を読み込みました！", 3)
            return true
        else
            Library:Notify(scriptName .. " の実行に失敗しました", 5)
            warn("[" .. scriptName .. " Exec Error]:", execErr)
            return false
        end
    else
        Library:Notify(scriptName .. " の取得・解析に失敗しました", 5)
        warn("[" .. scriptName .. " Load Error]:", result)
        return false
    end
end

-- クリップボードコピーの互換関数
local function SafeSetClipboard(text)
    if setclipboard then
        setclipboard(text)
        return true
    elseif toclipboard then
        toclipboard(text)
        return true
    end
    return false
end

